#!/usr/bin/env bash
# Create a project's build root for the runner: $ROOT/projects/<name>/app is the environment
# repository and, when the shop/application code is a separate repository, app/public is its clone.
# <name> defaults to the repository's slug, so a pipeline finds it without configuration:
# BUILD_ROOT=${BUILD_ROOT:-$SETUP_SERVER_ROOT/projects/$BITBUCKET_REPO_SLUG}. Nobody works in it by hand.
# Git access: Bitbucket repositories (and --shared-key) use the account's key ($ROOT/.ssh/id_ed25519,
# added read-only to each repository). GitHub does not accept one deploy key on several repositories
# (the account's key is the setup repository's already), so a github.com SSH URL gets its own key
# $ROOT/.ssh/github-<owner>.<repository> and the host alias github.com-<owner>.<repository> in
# $ROOT/.ssh/config, and is cloned through that alias.
# The deploy target is the server's, not the project's: target.env in the build root (setup reads it on
# every deploy) names DEPLOY_CONTEXT, DEPLOY_SSH, DEPLOY_PATH, APP_UID and APP_GID. It is always named:
# --target local is this host, the build root itself and the account's ids; ssh://USER@HOST/PATH a remote server (a Docker
# context setup-<name> of the account), ENV=... one environment only (target.<env>.env). A rerun keeps
# the clones and the registered target unless --target is given. --remove-target ENV --name NAME deletes one
# environment's own target.<env>.env (and its Docker context), which then deploys to the shared target.env;
# it needs no URL and refuses to leave the environment without a target.
# --monorepo: one repository holds both, app/ (the environment) and app/public/ (the code); it is cloned as the
# build root itself, so $ROOT/projects/<name>/app is still the environment directory setup expects.
set -euo pipefail

ROOT=${SETUP_SERVER_ROOT:-/srv/setup-server}
ACCOUNT=${SETUP_SERVER_USER:-setup}

check=0
shared_key=0
monorepo=0
given_name=
targets=()
usage() {
    cat <<EOF
Usage: sudo $0 [--check] [--shared-key] [--monorepo] [--target [ENV=]local|ssh://USER@HOST/PATH] [--name NAME|NAME] ENV_REPO_URL [CODE_REPO_URL]
       sudo $0 [--check] --remove-target ENV --name NAME|NAME
  NAME          directory under $ROOT/projects; defaults to the repository slug of ENV_REPO_URL,
                 which is what pipelines use (BITBUCKET_REPO_SLUG; on GitHub the repository name in
                 lower case) — give it only to deviate, or when the slug is no NAME (gamma.example: --name gamma)
  --name NAME    the same as NAME in front of the URL
  ENV_REPO_URL   git URL of the environment repository (cloned into app/)
  CODE_REPO_URL  git URL of a separate code repository (cloned into app/public/); omit when the
                 environment repository already contains public/
  --monorepo     ENV_REPO_URL holds the environment in app/ and the code in app/public/: it is cloned as the
                 build root itself (no CODE_REPO_URL; app/Makefile required). Each environment needs a target
                 of its own outside the checkout (stage=local:/PATH, prod=local:/PATH or ssh://), not local
  --shared-key   GitHub: clone with the account's own key (a machine user that reads every repository)
                 instead of a deploy key per repository
  --target       where stage/prod deploy (target.env), required for a new project: local = this host, the build root, the
                 account's ids; local:/PATH = this host, project root PATH (created for $ACCOUNT, or writable by it);
                 ssh://USER@HOST/PATH = a server reached as USER (key: $ROOT/.ssh/id_ed25519),
                 project root PATH. ENV=... registers one environment (target.<env>.env): stage, prod or one
                 of the project's STAGE_ENVIRONMENTS (e.g. demo=...; without its own target an environment
                 deploys to target.env).
                 Repeatable. Without it a rerun keeps the registered target.
  --remove-target ENV
                 delete the environment's own target (target.<env>.env, and its Docker context setup-NAME-ENV) of
                 the project NAME: ENV then deploys to the shared target.env, which must exist (it is never
                 removed this way). No URLs; not with --target, --shared-key or --monorepo
EOF
}
args=()
remove_target=
while [ $# -gt 0 ]; do
    case "$1" in
        --check) check=1 ;;
        --remove-target) remove_target=${2:?--remove-target needs ENV}; shift ;;
        --shared-key) shared_key=1 ;;
        --monorepo) monorepo=1 ;;
        --name) given_name=${2:?--name needs NAME}; shift ;;
        --target) targets+=("${2:?--target needs local or ssh://USER@HOST/PATH}"); shift ;;
        -h|--help) usage; exit 0 ;;
        -*) usage >&2; exit 64 ;;
        *) args+=("$1") ;;
    esac
    shift
done
is_url() { [[ "$1" == *:* || "$1" == */* ]]; }
# Run from a directory the account can read: a caller's home (0750 on Ubuntu) makes git fail early.
as_account() { if [ "$(id -u)" = 0 ]; then (cd "$ROOT" 2>/dev/null || cd /; sudo -u "$ACCOUNT" -H "$@"); else "$@"; fi; }
target_summary() {  # target_summary FILE — the DEPLOY_*/APP_* lines of a target file, indented
    sed -nE 's/^((DEPLOY_[A-Z_]+|APP_[UG]ID)=.*)/    \1/p' "$1" 2>/dev/null || echo "    (not readable without sudo)"
}

# --remove-target ENV: one environment's own target goes; the shared target.env stays and is then its target.
if [ -n "$remove_target" ]; then
    if [ ${#targets[@]} -gt 0 ] || [ "$shared_key" = 1 ] || [ "$monorepo" = 1 ]; then
        echo "--remove-target removes a registered target: not with --target, --shared-key or --monorepo" >&2
        exit 64
    fi
    for given in "${args[@]}"; do
        ! is_url "$given" || { echo "--remove-target takes the project's NAME, no repository URL ($given)" >&2; exit 64; }
    done
    [ ${#args[@]} -le 1 ] || { usage >&2; exit 64; }
    name=${args[0]:-$given_name}
    [ -z "$given_name" ] || [ "$given_name" = "$name" ] || { echo "--name $given_name and NAME $name differ: give one" >&2; exit 64; }
    [ -n "$name" ] || { echo "--remove-target $remove_target: give the project's NAME (--name NAME)" >&2; exit 64; }
    [[ "$name" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || { echo "NAME must be lowercase letters, digits, _ or -" >&2; exit 65; }
    # The names --target ENV= accepts (split_target): stage, prod or one of the project's STAGE_ENVIRONMENTS.
    [[ "$remove_target" =~ ^[a-z][a-z0-9]{1,15}$ ]] \
        || { echo "--remove-target $remove_target: ENV is stage, prod or an extra environment (lowercase letters and digits, 2-16)" >&2; exit 64; }
    case "$remove_target" in local|test) echo "--remove-target $remove_target: $remove_target is not a deploy environment" >&2; exit 64 ;; esac
    if [ "$check" = 0 ] && [ "$(id -u)" != 0 ]; then
        echo "Run with sudo (or use --check)" >&2
        exit 77
    fi
    build_root="$ROOT/projects/$name"
    if [ -L "$build_root" ] || [ ! -d "$build_root" ]; then
        echo "No build root $build_root (projects: $(ls "$ROOT/projects" 2>/dev/null | tr '\n' ' '))" >&2
        exit 65
    fi
    file="$build_root/target.$remove_target.env" shared="$build_root/target.env"
    [ ! -L "$file" ] || { echo "$file is a symlink; not removed" >&2; exit 65; }
    if [ ! -f "$file" ]; then
        if [ -f "$shared" ] && [ ! -L "$shared" ]; then
            echo "$remove_target has no target of its own ($file): it deploys to the shared $shared, which is not removed this way" >&2
        else
            echo "$remove_target has no target of its own ($file)" >&2
        fi
        exit 65
    fi
    if [ -L "$shared" ] || [ ! -f "$shared" ]; then
        echo "$remove_target would have no target (there is no shared $shared); register another with --target $remove_target=… first" >&2
        exit 65
    fi
    # The Docker context a remote target of this environment got (setup-<name>-<env>); the shared one's is setup-<name>.
    context=$(sed -n 's/^DEPLOY_CONTEXT=//p' "$file" 2>/dev/null | tail -n 1)
    [ "$context" = "setup-$name-$remove_target" ] && as_account docker context inspect "$context" >/dev/null 2>&1 || context=
    if [ "$check" = 1 ]; then
        echo "==> would remove the deploy target of $remove_target: $file"
        target_summary "$file"
        [ -z "$context" ] || echo "==> would remove the Docker context $context"
        echo "==> $remove_target would then deploy to the shared $shared:"
        target_summary "$shared"
        exit 0
    fi
    summary=$(target_summary "$file")
    as_account rm -f -- "$file"
    echo "==> removed the deploy target of $remove_target: $file"
    echo "$summary"
    if [ -n "$context" ]; then
        as_account docker context rm -f "$context" >/dev/null && echo "==> removed the Docker context $context" \
            || echo "==> could not remove the Docker context $context (docker context rm $context)"
    fi
    echo "==> $remove_target now deploys to the shared $shared:"
    target_summary "$shared"
    exit 0
fi

if [ ${#args[@]} -ge 1 ] && ! is_url "${args[0]}"; then
    name=${args[0]}; args=("${args[@]:1}")
    [ -z "$given_name" ] || [ "$given_name" = "$name" ] || { echo "--name $given_name and NAME $name differ: give one" >&2; exit 64; }
else
    name=$given_name
fi
[ ${#args[@]} -ge 1 ] && [ ${#args[@]} -le 2 ] || { usage >&2; exit 64; }
if [ "$monorepo" = 1 ] && [ ${#args[@]} -gt 1 ]; then
    echo "--monorepo: the repository holds the code in app/public/ itself; no CODE_REPO_URL (${args[1]})" >&2
    exit 64
fi
# Bitbucket serves git over SSH at ssh.bitbucket.org from 2026-11-12 (bitbucket.org then refuses SSH): an
# old-host URL is cloned through the new name - the same repository, the same host keys (bin/prepare-host).
bitbucket_ssh() { sed -E 's#^git@bitbucket\.org:#git@ssh.bitbucket.org:#; s#^ssh://git@bitbucket\.org/#ssh://git@ssh.bitbucket.org/#' <<<"$1"; }
env_repo=$(bitbucket_ssh "${args[0]}"); code_repo=$(bitbucket_ssh "${args[1]:-}")
for given in "${args[@]}"; do
    [ "$(bitbucket_ssh "$given")" = "$given" ] || echo "==> note: $given is cloned as $(bitbucket_ssh "$given") (Bitbucket's SSH host from 2026-11-12)"
done
slug=$(basename "${env_repo%/}" .git | tr '[:upper:]' '[:lower:]')
if [ -z "$name" ] && ! [[ "$slug" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then
    suggestion=$(sed -E 's/\..*//; s/[^a-z0-9_-]+/-/g; s/^[^a-z0-9]+//' <<<"$slug")
    echo "The repository name '$slug' is no NAME (lowercase letters, digits, _ or -): give one${suggestion:+, e.g. --name $suggestion}" >&2
    exit 65
fi
name=${name:-$slug}
[[ "$name" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || { echo "NAME must be lowercase letters, digits, _ or -" >&2; exit 65; }
if [ "$check" = 0 ] && [ "$(id -u)" != 0 ]; then
    echo "Run with sudo (or use --check)" >&2
    exit 77
fi

build_root="$ROOT/projects/$name"
github_repository() {  # github_repository URL — "owner repository" of a github.com SSH URL
    [[ "$1" =~ ^(git@github\.com:|ssh://git@github\.com/)([A-Za-z0-9][A-Za-z0-9-]*)/([A-Za-z0-9._-]+)$ ]] || return 1
    echo "${BASH_REMATCH[2]} ${BASH_REMATCH[3]%.git}"
}
scope_of() { printf '%s.%s' "$1" "$2" | tr '[:upper:]' '[:lower:]'; }
clone_url() {  # clone_url URL — the URL to clone: through the repository's host alias on GitHub
    local owner repository
    if [ "$shared_key" = 0 ] && read -r owner repository < <(github_repository "$1"); then
        echo "git@github.com-$(scope_of "$owner" "$repository"):$owner/$repository.git"
    else
        echo "$1"
    fi
}
deploy_key() {  # deploy_key URL — the per-repository key and host alias of a GitHub URL, once it can read
    local owner repository scope key alias config="$ROOT/.ssh/config"
    [ "$shared_key" = 0 ] && read -r owner repository < <(github_repository "$1") || return 0
    scope=$(scope_of "$owner" "$repository")
    key="$ROOT/.ssh/github-$scope" alias="github.com-$scope"
    if [ "$check" = 1 ]; then
        echo "==> would create the deploy key $key (unless present) and the host alias $alias in $config"
        return
    fi
    install -d -o "$ACCOUNT" -g "$ACCOUNT" -m 0700 "$ROOT/.ssh"
    if [ ! -f "$key" ]; then
        as_account ssh-keygen -q -t ed25519 -N '' -C "$ACCOUNT@$(hostname) github.com/$owner/$repository" -f "$key"
        echo "==> created the deploy key $key"
    fi
    if ! as_account grep -qx "Host $alias" "$config" 2>/dev/null; then
        # HostName github.com: the host key recorded for github.com (bin/prepare-host) is the one checked.
        printf '\n# bin/add-project: read-only deploy key of github.com/%s/%s\nHost %s\n    HostName github.com\n    User git\n    IdentityFile %s\n    IdentitiesOnly yes\n' \
            "$owner" "$repository" "$alias" "$key" | as_account tee -a "$config" >/dev/null
        as_account chmod 0600 "$config"
        echo "==> added the host alias $alias to $config"
    fi
    if ! as_account git ls-remote -q "$(clone_url "$1")" >/dev/null 2>&1; then
        echo "==> Needs attention: the deploy key cannot read github.com/$owner/$repository yet. Add it at"
        echo "    https://github.com/$owner/$repository/settings/keys (Add deploy key; leave \"Allow write access\" off),"
        echo "    fingerprint $(ssh-keygen -lf "$key.pub" | cut -d' ' -f2), then run this again:"
        sed 's/^/    /' "$key.pub"
        exit 1
    fi
}
clone() {  # clone URL DIRECTORY — an existing checkout of the same remote is kept as it is
    local clone_url remote
    clone_url=$(clone_url "$1")
    if [ -d "$2/.git" ]; then
        remote=$(as_account git -C "$2" remote get-url origin)
        if [ "$remote" != "$1" ] && [ "$(bitbucket_ssh "$remote")" = "$1" ]; then
            echo "==> $([ "$check" = 1 ] && echo would move || echo moving) $2 to $1 (Bitbucket's SSH host from 2026-11-12)"
            [ "$check" = 1 ] || as_account git -C "$2" remote set-url origin "$1"
            remote=$1
        fi
        [ "$remote" = "$1" ] || [ "$remote" = "$clone_url" ] || { echo "$2 already holds $remote, not $1" >&2; exit 65; }
        echo "==> $2: present"
        return
    fi
    [ ! -e "$2" ] || { echo "$2 exists and is not a git checkout; preserved" >&2; exit 65; }
    deploy_key "$1"
    echo "==> $([ "$check" = 1 ] && echo would clone || echo cloning) $clone_url into $2"
    [ "$check" = 1 ] || as_account git clone -q "$clone_url" "$2"
}
tracked_targets() {  # the target.env / target.<env>.env files the monorepo clone's commit has in its top directory
    as_account git -C "$build_root" ls-tree --name-only HEAD 2>/dev/null | grep -E '^target(\..+)?\.env$' || true
}
clone_monorepo() {  # clone_monorepo URL — the repository as the build root; an existing clone of it is kept
    if [ -e "$build_root" ] && [ ! -d "$build_root/.git" ] && [ -n "$(ls -A "$build_root" 2>/dev/null)" ]; then
        if [ -d "$build_root/app/.git" ]; then
            echo "$build_root holds a project of separate repositories (app/ is a clone of its own); preserved." >&2
            echo "Run without --monorepo, or remove it first (bin/remove-project $name)." >&2
        else
            echo "$build_root exists and is not a git checkout; preserved" >&2
        fi
        exit 65
    fi
    if [ -d "$build_root/.git" ]; then
        clone "$1" "$build_root"
    else
        deploy_key "$1"
        echo "==> $([ "$check" = 1 ] && echo would clone || echo cloning) $(clone_url "$1") into $build_root (--monorepo: the repository is the build root, its app/ the environment)"
        if [ "$check" = 1 ]; then
            echo "==> would require app/Makefile and no tracked target*.env in it"
            return
        fi
        [ -d "$build_root" ] || install -d -o "$ACCOUNT" -g "$ACCOUNT" -m 0750 "$build_root"
        as_account git clone -q --no-checkout "$(clone_url "$1")" "$build_root"
        # Checked before any file is checked out: a repository of another layout leaves nothing behind.
        if ! as_account git -C "$build_root" cat-file -e HEAD:app/Makefile 2>/dev/null; then
            rm -rf -- "$build_root"
            echo "$1 has no app/Makefile: --monorepo needs the environment in app/ (and the code in app/public/); nothing was kept" >&2
            exit 65
        fi
        if [ -n "$(tracked_targets)" ]; then
            echo "$1 tracks $(tracked_targets | tr '\n' ' ')in its top directory, where setup-server keeps the deploy targets" >&2
            echo "(a checkout would put them back over the registered ones): remove them from the repository; nothing was kept" >&2
            rm -rf -- "$build_root"
            exit 65
        fi
        as_account git -C "$build_root" reset -q --hard
    fi
    [ "$check" = 1 ] && [ ! -d "$build_root/.git" ] && return
    [ -f "$build_root/app/Makefile" ] || { echo "$build_root/app/Makefile is missing: --monorepo needs the environment in app/" >&2; exit 65; }
    if [ -n "$(tracked_targets)" ]; then
        echo "$build_root tracks $(tracked_targets | tr '\n' ' ')in its top directory, where setup-server keeps the deploy targets:" >&2
        echo "remove them from the repository first; nothing was changed" >&2
        exit 65
    fi
    # target*.env lie in the checkout's top directory; git status there stays clean.
    local exclude="$build_root/.git/info/exclude"
    if ! as_account grep -qx '/target\*.env' "$exclude" 2>/dev/null; then
        if [ "$check" = 1 ]; then
            echo "==> would add /target*.env to $exclude"
        else
            as_account mkdir -p "${exclude%/*}"
            printf '# bin/add-project: deploy targets of this server\n/target*.env\n' | as_account tee -a "$exclude" >/dev/null
        fi
    fi
}

# A path with its symlinks resolved; a tail that does not exist yet is kept as written below its nearest existing parent.
canonical() { realpath -m -- "$1"; }
inside() { [ "$1" = "$2" ] || [[ "$1" == "$2/"* ]]; }  # inside PATH DIRECTORY (or the directory itself)
monorepo_refusal() {  # monorepo_refusal TARGET WHY
    echo "--target $1: $2" >&2
    echo "With --monorepo the build root is the repository's checkout, which every deploy moves to its commit:" >&2
    echo "give each environment its own directory outside it, e.g. --target stage=local:/PATH/stage --target prod=local:/PATH/prod" >&2
    exit 64
}
local_path() {  # local_path ENV SPEC — the project root of a local target, checked; nothing is created
    local environment=$1 spec=$2 path real
    # --monorepo: a project root in the checkout would mount the files of whichever commit was deployed last.
    [ "$monorepo" = 0 ] || [ "$spec" != local ] || monorepo_refusal "${environment:+$environment=}$spec" "the build root itself"
    if [ "$spec" = local ]; then
        echo "$build_root"
        return
    fi
    path=${spec#local:}
    path=${path%/}
    [[ "$path" =~ ^/[A-Za-z0-9._/-]+$ && "/$path/" != */../* && "/$path/" != */./* ]] \
        || { echo "--target $spec: expected local:/ABSOLUTE/PATH" >&2; exit 64; }
    [ "${path##*/}" != app ] || { echo "--target $spec: PATH is the project root, which holds app/ and data/; give ${path%/app}" >&2; exit 64; }
    # Compared as the deploy will reach them: a symlink into the build root or $ROOT is inside it.
    real=$(canonical "$path")
    if [ "$monorepo" = 1 ] && inside "$real" "$(canonical "$build_root")"; then
        monorepo_refusal "${environment:+$environment=}$spec" "inside the build root $build_root$([ "$real" = "$path" ] || echo " (it resolves to $real)")"
    fi
    if inside "$real" "$(canonical "$ROOT")" && [ "$real" != "$(canonical "$build_root")" ]; then
        echo "--target $spec: inside $ROOT, which belongs to setup-server$([ "$real" = "$path" ] || echo " (it resolves to $real)")" >&2
        exit 64
    fi
    echo "$path"
}
target_lines() {  # target_lines ENV SPEC — the target.env lines of one target (reaches a remote server once)
    local environment=$1 spec=$2 user host path ssh context ids
    if [ "$spec" = local ] || [[ "$spec" == local:* ]]; then
        # This host. local: the build root is the project root; local:/PATH another directory, which the
        # deploys fill (code, data and the environment files, setup 2.7.0+) as $ACCOUNT, owner of the files.
        path=$(local_path "$environment" "$spec") || exit  # a refusal ends the script (errexit is off in $(...))
        if [ "$spec" != local ]; then
            if [ "$check" = 1 ]; then
                [ -e "$path" ] || echo "==> would create $path ($ACCOUNT, 0750)" >&2
            elif [ ! -e "$path" ]; then
                install -d -o "$ACCOUNT" -g "$ACCOUNT" -m 0750 "$path"
                echo "==> created $path ($ACCOUNT, 0750)" >&2
            elif ! as_account test -d "$path" -a -w "$path"; then
                echo "$path is not a directory $ACCOUNT can reach and write (a home directory is often closed to others)." >&2
                echo "Either let $ACCOUNT own it (chown $ACCOUNT: $path; every directory above it must let $ACCOUNT through)," >&2
                echo "or deploy as its owner, who then owns the files and runs the containers: --target ssh://OWNER@localhost$path" >&2
                exit 65
            fi
        fi
        printf 'DEPLOY_CONTEXT=default\nDEPLOY_SSH=\nDEPLOY_PATH=%s\nAPP_UID=%s\nAPP_GID=%s\n' \
            "$path" "$(id -u "$ACCOUNT" 2>/dev/null || echo 1000)" "$(id -g "$ACCOUNT" 2>/dev/null || echo 1000)"
        return
    fi
    [[ "$spec" =~ ^ssh://([a-z_][a-z0-9_.-]*@)?([A-Za-z0-9.-]+)(/[A-Za-z0-9._/-]+)$ ]] \
        || { echo "--target $spec: expected local, local:/PATH or ssh://USER@HOST/ABSOLUTE/PATH" >&2; exit 64; }
    user=${BASH_REMATCH[1]%@} host=${BASH_REMATCH[2]} path=${BASH_REMATCH[3]%/}
    [ "${path##*/}" != app ] || { echo "--target $spec: PATH is the project root, which holds app/ and data/; give ${path%/app}" >&2; exit 64; }
    ssh=${user:+$user@}$host
    context="setup-$name${environment:+-$environment}"
    if [ "$check" = 1 ]; then
        printf 'DEPLOY_CONTEXT=%s\nDEPLOY_SSH=%s\nDEPLOY_PATH=%s\nAPP_UID=<id -u of %s>\nAPP_GID=<id -g>\n' \
            "$context" "$ssh" "$path" "${user:-the login}"
        return
    fi
    # The account's own key; a new host key is recorded on first contact and shown below.
    if ! ids=$(as_account ssh -o BatchMode=yes -o ConnectTimeout=15 -o StrictHostKeyChecking=accept-new "$ssh" \
               "id -u; id -g; docker version --format '{{.Server.Version}}' 2>/dev/null || echo no-docker; test -d '$path' && test -w '$path' && echo writable || echo not-writable" 2>&1); then
        echo "==> Needs attention: $ACCOUNT cannot log in to $ssh without a password." >&2
        echo "    Add this key to ~${user:-<user>}/.ssh/authorized_keys on $host, then run this again:" >&2
        sed 's/^/    /' "$ROOT/.ssh/id_ed25519.pub" >&2 2>/dev/null || echo "    (no $ROOT/.ssh/id_ed25519.pub: run bin/prepare-host)" >&2
        echo "    ssh said: $(echo "$ids" | tail -n 1)" >&2
        exit 1
    fi
    mapfile -t ids <<< "$ids"
    [[ "${ids[0]:-}" =~ ^[0-9]+$ && "${ids[1]:-}" =~ ^[0-9]+$ ]] || { echo "Unexpected answer from $ssh: ${ids[*]}" >&2; exit 1; }
    [ "${ids[2]:-}" != no-docker ] || { echo "$ssh: docker does not answer for ${user:-the login} (install Docker, add the user to the docker group)" >&2; exit 1; }
    [ "${ids[3]:-}" = writable ] || { echo "$ssh: $path is missing or not writable for ${user:-the login}; create it" >&2; exit 1; }
    if as_account docker context inspect "$context" >/dev/null 2>&1; then
        as_account docker context update "$context" --docker "host=ssh://$ssh" >/dev/null
    else
        as_account docker context create "$context" --docker "host=ssh://$ssh" >/dev/null
    fi
    echo "==> Docker context $context: ssh://$ssh (Docker ${ids[2]}; host key $(as_account ssh-keygen -F "$host" 2>/dev/null | awk '!/^#/ {print $2; exit}'))" >&2
    printf 'DEPLOY_CONTEXT=%s\nDEPLOY_SSH=%s\nDEPLOY_PATH=%s\nAPP_UID=%s\nAPP_GID=%s\n' "$context" "$ssh" "$path" "${ids[0]}" "${ids[1]}"
}
split_target() {  # split_target [ENV=]SPEC — sets environment (empty: every environment) and spec of the caller
    environment= spec=$1
    # ENV= in front: stage, prod or a stage-class environment the project lists (setup's STAGE_ENVIRONMENTS, e.g. demo).
    if [[ "$spec" =~ ^([a-z][a-z0-9]{1,15})=(.*)$ ]]; then
        environment=${BASH_REMATCH[1]} spec=${BASH_REMATCH[2]}
        case "$environment" in local|test) echo "--target $1: $environment is not a deploy environment" >&2; exit 64 ;; esac
    fi
}
place_of() {  # place_of ENV SPEC — where a target deploys, comparable between environments: this host's directories resolved
    local spec=$2 path
    if [ "$spec" = local ] || [[ "$spec" == local:* ]]; then
        path=$(local_path "$1" "$spec") || exit
        echo "local $(canonical "$path")"
    elif [[ "$spec" =~ ^ssh://([a-z_][a-z0-9_.-]*@)?(localhost|127\.0\.0\.1)(/.*)$ ]]; then
        echo "local $(canonical "${BASH_REMATCH[3]%/}")"
    else
        echo "remote ${spec%/}"
    fi
}
check_monorepo_targets() {  # with --monorepo: each environment its own place, the given targets and the registered ones
    local target environment spec file place envs=() places=() i j a b
    for target in "${targets[@]}"; do
        split_target "$target"
        [ -n "$environment" ] || monorepo_refusal "$target" "no environment in front (stage=, prod=): one place for every environment"
        place=$(place_of "$environment" "$spec") || exit
        envs+=("$environment") places+=("$place")
    done
    [ ! -f "$build_root/target.env" ] || { echo "$build_root/target.env is one target for every environment; with --monorepo each has its own (target.<env>.env): remove it" >&2; exit 65; }
    for file in "$build_root"/target.*.env; do
        [ -f "$file" ] || continue
        environment=${file##*/target.} environment=${environment%.env}
        [[ " ${envs[*]} " != *" $environment "* ]] || continue  # given again: replaced
        spec=$(sed -n 's/^DEPLOY_PATH=//p' "$file" 2>/dev/null | tail -n 1)
        [ -n "$spec" ] || continue
        a=$(sed -n 's/^DEPLOY_SSH=//p' "$file" 2>/dev/null | tail -n 1)
        if [ -n "$a" ]; then spec="ssh://$a$spec"; else spec="local:$spec"; fi
        place=$(place_of "$environment" "$spec") || exit
        envs+=("$environment") places+=("$place")
    done
    for i in "${!places[@]}"; do
        for j in "${!places[@]}"; do
            [ "$i" -lt "$j" ] || continue
            a=${places[$i]} b=${places[$j]}
            if [ "$a" = "$b" ] || { [ "${a%% *}" = local ] && [ "${b%% *}" = local ] && { inside "${a#local }" "${b#local }" || inside "${b#local }" "${a#local }"; }; }; then
                echo "--monorepo: ${envs[$i]} and ${envs[$j]} would deploy to the same place (${a#* }, ${b#* }); give each its own directory" >&2
                exit 64
            fi
        done
    done
}
planned_files=() planned_environments=() planned_lines=()
prepare_target() {  # prepare_target [ENV=]SPEC — check a target and work out its lines before any clone
    local environment spec lines
    split_target "$1"
    lines=$(target_lines "$environment" "$spec")
    planned_files+=("$build_root/target${environment:+.$environment}.env")
    planned_environments+=("$environment")
    planned_lines+=("$lines")
}
write_target() {  # write_target INDEX — target.env or target.<env>.env of one prepared target
    local file=${planned_files[$1]} environment=${planned_environments[$1]} lines=${planned_lines[$1]}
    if [ "$check" = 1 ]; then
        echo "==> would write $file:"
        echo "$lines" | sed 's/^/    /'
        return
    fi
    { echo "# bin/add-project: where ${environment:-stage and prod} of $name deploy$([ -z "$environment" ] || echo s) (setup-server; not secret, not in git)."
      echo "$lines"; } | as_account tee "$file.new" >/dev/null
    as_account chmod 0640 "$file.new"
    as_account mv -f "$file.new" "$file"
    echo "==> deploy target ${environment:-stage/prod}: $file"
    echo "$lines" | sed 's/^/    /'
}

# The target is always named: nothing is created for a project without one (target.env, or target.<env>.env
# for each environment it deploys).
registered=
for file in "$build_root/target.env" "$build_root"/target.*.env; do
    if [ -f "$file" ]; then registered+="$file "; fi
done
if [ ${#targets[@]} -eq 0 ] && [ -z "$registered" ]; then
    echo "Name the deploy target: --target local (this host, the build root $build_root) or" >&2
    echo "--target ssh://USER@HOST/PATH (another server); stage=/prod=/demo= in front for one environment." >&2
    exit 64
fi
if [ "$monorepo" = 0 ] && [ -d "$build_root/.git" ]; then
    echo "$build_root is a monorepo clone (the repository is the build root): add --monorepo" >&2
    exit 65
fi
# Every target is checked (and a remote one reached) before anything of the project is created.
[ "$monorepo" = 0 ] || check_monorepo_targets
for target in "${targets[@]}"; do prepare_target "$target"; done
if [ "$monorepo" = 1 ]; then
    clone_monorepo "$env_repo"
else
    [ "$check" = 1 ] || [ -d "$build_root" ] || install -d -o "$ACCOUNT" -g "$ACCOUNT" -m 0750 "$build_root"
    clone "$env_repo" "$build_root/app"
    [ -z "$code_repo" ] || clone "$code_repo" "$build_root/app/public"
fi
if [ ${#targets[@]} -gt 0 ]; then
    for index in "${!planned_files[@]}"; do write_target "$index"; done
else
    echo "==> deploy target kept: $registered(change it with --target)"
fi
echo "==> Build root: $build_root$([ "$monorepo" = 0 ] || echo " (monorepo: environment app/, code app/public/)")"
if [[ "$env_repo" == *github.com[:/]* ]]; then
    if [ "$name" = "$slug" ]; then
        echo "    Workflows of '$slug' find it themselves (\$SETUP_SERVER_ROOT/projects/<repository name in lower case>)."
    else
        echo "    The name differs from the repository name '$slug': set the Actions variable BUILD_ROOT=$build_root."
    fi
    echo "    Fill $([ "$monorepo" = 0 ] || echo app/)env/<stage|prod>.env.example (no secrets, no DEPLOY_*/APP_UID/APP_GID: the target is in target.env)"
    echo "    and add the secrets as GitHub environment secrets."
else
    if [ "$name" = "$slug" ]; then
        echo "    Pipelines of '$slug' find it themselves (\$SETUP_SERVER_ROOT/projects/\$BITBUCKET_REPO_SLUG)."
    else
        echo "    The name differs from the repository slug '$slug': set the repository variable BUILD_ROOT=$build_root."
    fi
    echo "    Fill env/<stage|prod>.env.example (no secrets, no DEPLOY_*/APP_UID/APP_GID: the target is in target.env)"
    echo "    and add the secrets as Deployment variables (Secured)."
fi
