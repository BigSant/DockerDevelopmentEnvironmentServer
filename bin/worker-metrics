#!/usr/bin/python3
"""The worker's Prometheus /metrics: backups, deploys, runner and disk, read-only, from its own files.

bin/install-metrics installs this as /usr/local/sbin/setup-server-metrics and runs it as the systemd
service setup-server-metrics of the setup account (the owner of the build roots). There is no proxy in
front: the service answers HTTP itself on METRICS_ADDRESS (default 127.0.0.1; the VPN address for
Prometheus), checks the client address against METRICS_ALLOWED_IPS (403) and then the bearer token
METRICS_TOKEN (401), like the target /metrics of setup. It changes nothing: it reads the build roots
under $SETUP_SERVER_ROOT/projects, asks systemd for the runner's state and the filesystem for its size.

Groups (setup_metrics_group_up{group} is 0 when a part of the group could not be read; details in the journal):
  backups  per project and ENV: age and size of the newest worker-<env>-…Z.sql.gz backup, how many are kept
  deploys  per project and ENV: the last entry of .generated/release/<env>/deployments.json
  runner   the systemd state of setup-server-runner.service
  disk     the filesystem holding $SETUP_SERVER_ROOT

Usage: setup-server-metrics            serve (settings from the environment, see bin/install-metrics)
       setup-server-metrics --check    validate the settings and show where it would listen
       setup-server-metrics --once     print the exposition once (no server, no token)
"""

from datetime import datetime, timezone
import hmac
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import ipaddress
import json
import math
import os
from pathlib import Path
import re
import socket
import subprocess
import sys
import time
from urllib.parse import urlsplit

ROOT = Path(os.environ.get('SETUP_SERVER_ROOT', '/srv/setup-server'))
PROJECTS = ROOT / 'projects'
RUNNER_UNIT = os.environ.get('SETUP_SERVER_RUNNER_UNIT', 'setup-server-runner.service')
ENVIRONMENTS = ('stage', 'prod')
# NAME, SERIES and environment_directory are identical in bin/backup-projects (tests/test_metrics.py).
NAME = re.compile(r'[a-z0-9][a-z0-9_-]*')
SERIES = re.compile(r'worker-(stage|prod)-(\d{8}T\d{6})Z\.sql\.gz')
TOKEN_MINIMUM = 24
DEFAULT_PORT = 9101
CONFIGURATION_ERROR = 78  # EX_CONFIG: systemd does not restart the service for it
CONTENT_TYPE = 'text/plain; version=0.0.4; charset=utf-8'


def log(text):
    print(text, file=sys.stderr, flush=True)


# --- Exposition ----------------------------------------------------------------------------------
class Metrics:
    def __init__(self):
        self.families = {}

    def add(self, name, help_text, value, labels=None):
        """One sample; the first call for a name fixes its HELP text (every family here is a gauge)."""
        family = self.families.setdefault(name, (help_text, []))
        family[1].append((labels or {}, value))

    def render(self):
        lines = []
        for name, (help_text, samples) in self.families.items():
            lines.append(f'# HELP {name} ' + help_text.replace('\\', '\\\\').replace('\n', '\\n'))
            lines.append(f'# TYPE {name} gauge')
            for labels, value in samples:
                pairs = ','.join(f'{key}="' + str(text).replace('\\', '\\\\').replace('"', '\\"').replace('\n', '\\n') + '"'
                                 for key, text in labels.items())
                lines.append(f'{name}{{{pairs}}} {number(value)}' if pairs else f'{name} {number(value)}')
        return '\n'.join(lines) + '\n'


def number(value):
    if isinstance(value, bool):
        return '1' if value else '0'
    if isinstance(value, int):
        return str(value)
    if math.isnan(value):
        return 'NaN'
    if math.isinf(value):
        return '+Inf' if value > 0 else '-Inf'
    if value.is_integer() and abs(value) < 1e15:
        return str(int(value))
    return repr(value)


# --- What the worker knows -----------------------------------------------------------------------
def environment_directory(build_root):
    """The environment repository of a build root: app/, or app/docker/ in older layouts."""
    for directory in (build_root / 'app', build_root / 'app/docker'):
        if (directory / 'Makefile').is_file() and (directory / 'env').is_dir():
            return directory
    return None


def projects():
    """[(name, environment directory)] of the build roots; anything else under projects/ is skipped."""
    found = []
    for build_root in sorted(PROJECTS.iterdir()) if PROJECTS.is_dir() else []:
        if build_root.is_symlink() or not build_root.is_dir() or not NAME.fullmatch(build_root.name):
            continue
        directory = environment_directory(build_root)
        if directory is not None:
            found.append((build_root.name, directory))
    return found


def backups(metrics, found, now):
    """Nightly and "backup now" backups (worker-<env>-…Z.sql.gz); pre-deploy backups do not count, so a
    deploy never hides a stopped timer. An ENV deployed from here (env/<env>.env) without any backup
    gets a count of 0 and no age."""
    complete = True
    for name, directory in found:
        try:
            folder = directory / '.generated/backups'
            series = {}
            if folder.is_dir() and not folder.is_symlink():
                with os.scandir(folder) as entries:
                    for item in entries:
                        match = SERIES.fullmatch(item.name)
                        if match and item.is_file(follow_symlinks=False):
                            info = item.stat(follow_symlinks=False)
                            series.setdefault(match[1], []).append((info.st_mtime, info.st_size))
            declared = {env for env in ENVIRONMENTS if (directory / f'env/{env}.env').is_file()}
        except OSError as error:
            log(f'backups {name}: {error}')
            complete = False
            continue
        for environment in sorted(set(series) | declared):
            labels = {'project': name, 'environment': environment}
            files = series.get(environment, [])
            metrics.add('setup_worker_backups', 'Backups of the worker kept for the project and environment '
                        '(nightly and "backup now"; pre-deploy backups excluded)', len(files), labels)
            if files:
                modified, size = max(files)
                metrics.add('setup_worker_backup_newest_age_seconds',
                            'Seconds since the newest backup of the project and environment was written',
                            round(max(0.0, now - modified)), labels)
                metrics.add('setup_worker_backup_newest_size_bytes', 'Size of the newest backup in bytes', size, labels)
    return complete


def timestamp(text):
    """Unix time of a deployments.json "at" (ISO 8601 with an offset; Python 3.10 has no "Z")."""
    moment = datetime.fromisoformat(text[:-1] + '+00:00' if text.endswith('Z') else text)
    if moment.tzinfo is None:
        moment = moment.replace(tzinfo=timezone.utc)
    return int(moment.timestamp())


def deploys(metrics, found, now):
    """The last deploy of each project and ENV from setup's history (make deploy writes it: ref, commit,
    at, rollback, and "failed": "after-rsync" when the code reached the target but the deploy stopped)."""
    complete = True
    for name, directory in found:
        for environment in ENVIRONMENTS:
            path = directory / f'.generated/release/{environment}/deployments.json'
            try:
                if not path.is_file():
                    continue
                entries = json.loads(path.read_text())
                if not isinstance(entries, list) or not all(isinstance(entry, dict) for entry in entries):
                    raise ValueError('not a list of deploys')
                if not entries:
                    continue
                last = entries[-1]
                at = timestamp(str(last['at']))
                completed = [entry for entry in entries if not entry.get('failed')]
                last_success = timestamp(str(completed[-1]['at'])) if completed else None
                ref, commit = str(last.get('ref', ''))[:64], str(last.get('commit', ''))[:12]
            except (OSError, ValueError, KeyError, TypeError) as error:
                log(f'deploys {name} {environment}: {path}: {error}')
                complete = False
                continue
            labels = {'project': name, 'environment': environment}
            metrics.add('setup_worker_deploy_last_timestamp_seconds', 'Unix time of the last deploy, failed or not', at, labels)
            metrics.add('setup_worker_deploy_last_success',
                        'Whether the last deploy completed (0: it stopped after the code reached the target)',
                        0 if last.get('failed') else 1, labels)
            metrics.add('setup_worker_deploy_last_rollback', 'Whether the last deploy was a rollback (rollback=1)',
                        1 if last.get('rollback') else 0, labels)
            if last_success is not None:
                metrics.add('setup_worker_deploy_last_success_timestamp_seconds',
                            'Unix time of the last deploy that completed', last_success, labels)
            metrics.add('setup_worker_deploy_last_info', 'Ref and commit (12 characters) of the last deploy', 1,
                        {**labels, 'ref': ref, 'commit': commit})
    return complete


def runner(metrics, found, now):
    """systemctl show only: the service is read, never started, stopped or restarted."""
    try:
        result = subprocess.run(['systemctl', 'show', '--property=LoadState,ActiveState,SubState,NRestarts', RUNNER_UNIT],
                                capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired) as error:
        log(f'runner: systemctl: {error}')
        return False
    properties = dict(line.partition('=')[::2] for line in result.stdout.splitlines())
    load, active = properties.get('LoadState'), properties.get('ActiveState')
    if result.returncode or not load or not active:
        log(f'runner: systemctl show {RUNNER_UNIT} exit {result.returncode}: {result.stderr.strip()}')
        return False
    metrics.add('setup_worker_runner_up', f'Whether {RUNNER_UNIT} is active', 1 if active == 'active' else 0)
    metrics.add('setup_worker_runner_state', f'State of {RUNNER_UNIT} (systemd ActiveState, or LoadState such as '
                'not-found when it is not installed)', 1, {'state': active if load == 'loaded' else load})
    if properties.get('NRestarts', '').isdigit():
        metrics.add('setup_worker_runner_restarts', f'Automatic restarts of {RUNNER_UNIT} since it was last started',
                    int(properties['NRestarts']))
    return True


def disk(metrics, found, now):
    """statvfs, as df: size, used (by anyone) and available to the unprivileged accounts."""
    try:
        stats = os.statvfs(ROOT)
    except OSError as error:
        log(f'disk: {ROOT}: {error}')
        return False
    labels = {'path': str(ROOT)}
    metrics.add('setup_worker_disk_size_bytes', 'Size of the filesystem holding the worker root', stats.f_blocks * stats.f_frsize, labels)
    metrics.add('setup_worker_disk_used_bytes', 'Used bytes of that filesystem (as df Used)',
                (stats.f_blocks - stats.f_bfree) * stats.f_frsize, labels)
    metrics.add('setup_worker_disk_available_bytes', 'Bytes of that filesystem available to unprivileged accounts (as df Avail)',
                stats.f_bavail * stats.f_frsize, labels)
    return True


GROUPS = (('backups', backups), ('deploys', deploys), ('runner', runner), ('disk', disk))


def collect():
    metrics = Metrics()
    now = time.time()
    try:
        found = projects()
        listed = True
    except OSError as error:
        log(f'projects: {PROJECTS}: {error}')
        found, listed = [], False
    states = {}
    for group, part in GROUPS:
        try:
            states[group] = part(metrics, found, now) and (listed or group not in ('backups', 'deploys'))
        except Exception as error:  # one group never takes the others down
            log(f'{group}: {type(error).__name__}: {error}')
            states[group] = False
    for group, complete in states.items():
        metrics.add('setup_metrics_group_up', 'Whether every part of the metrics group was collected', 1 if complete else 0,
                    {'group': group})
    return metrics.render()


# --- Settings and the server ---------------------------------------------------------------------
class Refused(Exception):
    """Settings the service will not start with (exit 78)."""


def allowlist(text):
    """IPs/CIDRs separated by spaces or commas, as the target's METRICS_ALLOWED_IPS."""
    networks = []
    for address in text.replace(',', ' ').split():
        if not re.fullmatch(r'[0-9a-fA-F:.]+(/[0-9]{1,3})?', address) or ('.' not in address and ':' not in address):
            raise Refused(f'Invalid IP/CIDR in METRICS_ALLOWED_IPS: {address}')
        try:
            networks.append(ipaddress.ip_network(address, strict=False))
        except ValueError:
            raise Refused(f'Invalid IP/CIDR in METRICS_ALLOWED_IPS: {address}') from None
    if not networks:
        raise Refused('METRICS_ALLOWED_IPS is empty: list the Prometheus address (IP/CIDR)')
    return networks


def settings():
    token = os.environ.get('METRICS_TOKEN', '')
    if len(token) < TOKEN_MINIMUM:
        raise Refused(f'METRICS_TOKEN ({TOKEN_MINIMUM}+ characters) is not configured')
    address = os.environ.get('METRICS_ADDRESS') or '127.0.0.1'
    try:
        ipaddress.ip_address(address)
    except ValueError:
        raise Refused(f'METRICS_ADDRESS must be an IPv4 or IPv6 address (e.g. the VPN address); got {address!r}') from None
    port = os.environ.get('METRICS_PORT') or str(DEFAULT_PORT)
    if not port.isdigit() or not 0 <= int(port) <= 65535:
        raise Refused(f'METRICS_PORT must be a TCP port number; got {port!r}')
    return token, address, int(port), allowlist(os.environ.get('METRICS_ALLOWED_IPS', ''))


class Server(ThreadingHTTPServer):
    daemon_threads = True

    def server_bind(self):
        # The VPN address may come up after this service: bind to it anyway (IP_FREEBIND).
        try:
            self.socket.setsockopt(socket.SOL_IP, getattr(socket, 'IP_FREEBIND', 15), 1)
        except OSError:
            pass
        super().server_bind()


def handler(token, networks):
    expected = f'Bearer {token}'.encode()

    class Handler(BaseHTTPRequestHandler):
        server_version = 'setup-server-metrics'
        sys_version = ''
        timeout = 30

        def reply(self, status, body, headers=()):
            data = body.encode()
            self.send_response(status)
            self.send_header('Content-Type', CONTENT_TYPE if status == 200 else 'text/plain; charset=utf-8')
            self.send_header('Content-Length', str(len(data)))
            self.send_header('Cache-Control', 'no-store')
            for header in headers:
                self.send_header(*header)
            self.end_headers()
            if self.command != 'HEAD':
                self.wfile.write(data)

        def do_GET(self):
            client = ipaddress.ip_address(self.client_address[0].split('%')[0])
            if getattr(client, 'ipv4_mapped', None):
                client = client.ipv4_mapped
            # Clients connect directly (no proxy): X-Forwarded-For is theirs to invent and is ignored.
            if not any(client in network for network in networks):
                log(f'refused {client}: not in METRICS_ALLOWED_IPS (403)')
                return self.reply(403, 'forbidden\n')
            given = self.headers.get('Authorization', '').encode('utf-8', 'surrogateescape')
            if not hmac.compare_digest(expected, given):
                log(f'refused {client}: no or wrong token (401)')
                return self.reply(401, 'unauthorized\n', [('WWW-Authenticate', 'Bearer')])
            if urlsplit(self.path).path != '/metrics':
                return self.reply(404, 'not found\n')
            self.reply(200, collect())

        do_HEAD = do_GET

        def log_message(self, format, *arguments):  # refusals and errors only (log() above)
            pass

    return Handler


def main(arguments):
    if arguments == ['--once']:
        sys.stdout.write(collect())
        return 0
    if arguments not in ([], ['--check']):
        log(__doc__.split('\n\n')[-1])
        return 64
    try:
        token, address, port, networks = settings()
    except Refused as error:
        log(str(error))
        return CONFIGURATION_ERROR
    host = f'[{address}]' if ':' in address else address
    if arguments == ['--check']:
        print(f'would listen on http://{host}:{port}/metrics for {" ".join(map(str, networks))} '
              f'(token {len(token)} characters)')
        return 0
    Server.address_family = socket.AF_INET6 if ':' in address else socket.AF_INET
    try:
        server = Server((address, port), handler(token, networks))
    except OSError as error:
        log(f'Cannot listen on {host}:{port}: {error}')
        return 1
    log(f'listening on {host}:{server.server_address[1]} for {" ".join(map(str, networks))}')
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
