def guide_values(query, status_data):
    """(choice, values, errors, given, key known): the chosen options, the values steps fill in, what was not accepted
    and what was typed. A field the choice does not ask for is ignored."""
    choice, errors = {}, []
    for key, _, options in GUIDE_OPTIONS:
        text = query.get(key, [''])[0]
        allowed = [value for value, _ in options]
        if text and text not in allowed:
            errors.append(f'Netinkamas pasirinkimas „{key}“.')
        choice[key] = text if text in allowed else allowed[0]
    given = {}
    for field in GUIDE_FIELDS:
        text = query.get(field.key, [''])[0].strip()
        if text and field.applies(choice):
            valid = field.pattern.fullmatch(text) and '..' not in text and (field.key != 'port' or 1 <= int(text) <= 65535)
            if valid and field.address:
                try:
                    ipaddress.ip_address(text)
                except ValueError:
                    valid = False
            if not valid:
                errors.append(f'Netinkama reikšmė lauke „{field.label}“: {text[:60]}')
                text = ''
        given[field.key] = text
    directadmin, private = choice['panel'] == 'directadmin', choice['panel'] == 'none' and choice['ssl'] == 'none'
    public = choice['panel'] == 'none' and not private
    applies = lambda key: next(field for field in GUIDE_FIELDS if field.key == key).applies(choice)
    pick = lambda key: given[key] if applies(key) else ''
    user = (pick('da_user') or 'DA_VARTOTOJAS') if directadmin else (pick('user') or 'deploy')
    domain = pick('domain') or 'DOMENAS'
    path = (pick('path') or f'/home/{user}/{domain}').rstrip('/')
    if path.endswith('/app'):
        errors.append('Projekto katalogas negali baigtis /app: jame bus app/ ir data/.')
    port = '80' if public else pick('port') or '8081'
    port_ssl = '443' if public else str(int(port) + 1) if int(port) < 65535 else '8082'
    address = '127.0.0.1' if directadmin else (pick('vpn_address') or 'TAIKINIO_VPN_IP') if private else \
        (pick('public_address') or 'TAIKINIO_IP')
    key = (status_data or {}).get('deploy_key')
    allow = ('ALLOWED_IPS="BIURO_IP"' if choice['env'] == 'stage' else
             'PMA_ALLOWED_IPS="BIURO_IP"\nCRON_ALLOWED_IPS="BIURO_IP"\nBACKUP_ALLOWED_IPS="BIURO_IP"')
    # The form link needs real values: what the step's target is made of must be typed or derived from typed ones.
    complete = bool(pick('host') and pick('domain') and (pick('da_user') if directadmin else True))
    values = {'host': pick('host') or 'SERVERIS', 'user': user, 'path': path, 'domain': domain,
              'port': port, 'port_ssl': port_ssl, 'worker': pick('worker') or 'WORKER_IP', 'address': address,
              'env': choice['env'], 'key': key or 'SETUP_RAKTAS', 'root': str(ROOT), 'distribution': choice['os'],
              'deployment': 'Production' if choice['env'] == 'prod' else 'Staging',
              'certbot_install': 'dnf install -y epel-release && dnf install -y certbot' if choice['os'] == 'centos'
              else 'apt-get install -y certbot',
              'https_line': 'HTTP_FORCE_HTTPS=off' if choice['ssl'] == 'none' else '# HTTP_FORCE_HTTPS=on (numatyta stage/prod)',
              'allow_lines': allow,
              'release': 'prod – iš release tag\'o (REF = vX.Y.Z, setup ant vX.Y.Z tag\'o); vėlesni – su BACKUP.' if choice['env'] == 'prod'
              else 'stage tinka bet kuris commit\'as.'}
    return choice, values, errors, given, key is not None, complete


def steps_word(count):
    """Lithuanian plural: 1 žingsnis, 2–9 žingsniai, 10–20 žingsnių, 21 žingsnis…"""
    if count % 10 == 1 and count % 100 != 11:
        return 'žingsnis'
    return 'žingsniai' if 2 <= count % 10 <= 9 and not 12 <= count % 100 <= 19 else 'žingsnių'


def guide_fill(text, values):
    for key, value in values.items():
        text = text.replace('{' + key + '}', value)
    return text


def guide_step(step, values, link=''):
    """One numbered step of the guide or the example: title and where, warning tape, text, commands and source."""
    text = re.sub(r'`([^`]+)`', r'<code>\1</code>', e(guide_fill(step.text, values)))
    blocks = ''.join((f'<p class="block-label">{e(label)}</p>' if label else '') +
                     f'<pre class="cmd">{e(guide_fill(chr(10).join(lines), values))}</pre>' for label, lines in step.blocks)
    warning = f'<div class="tape"><span>{e(step.warning)}</span></div>' if step.warning else ''
    source = f'<p class="source">Šaltinis: {e(step.source)}</p>' if step.source else ''
    return (f'<li class="step{" is-warn" if step.warning else ""}"><h3>{e(guide_fill(step.title, values))}'
            f'{badge(WHERE[step.where], "muted")}</h3>{warning}<p>{text}</p>{blocks}{link}{source}</li>')


# --- HTML ----------------------------------------------------------------------------------------
def e(text):
    return html.escape(str(text), quote=True)


