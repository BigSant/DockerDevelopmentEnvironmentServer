def unit_sections(unit):
    """The sections whose "manage" lets a unit be started, stopped or restarted."""
    return ('overview', 'runners') if unit == 'runner' or unit.startswith('github-runner@') else ('overview',)


def action_sections(action, form=None):
    if action == 'unit' and form is not None:
        return unit_sections(form.get('unit', ''))
    return ACTION_SECTIONS.get(action, ())


def group_id(title):
    """A new group's id from its title: Lithuanian letters as ASCII, anything else as -."""
    ascii_title = title.lower().translate(str.maketrans('ąčęėįšųūž', 'aceeisuuz'))
    return re.sub(r'[^a-z0-9]+', '-', ascii_title).strip('-')[:32]


def login_password(form, key, label):
    password = form.get(key, '')
    if not LOGIN_PASSWORD[0] <= len(password) <= LOGIN_PASSWORD[1] or any(ord(character) < 32 for character in password):
        raise Invalid(f'{label}: {LOGIN_PASSWORD[0]}–{LOGIN_PASSWORD[1]} characters, no control characters.')
    return password


class Accounts:
    """The UI's users and groups ($STATE_DIRECTORY/accounts.json) and its sessions (sessions.json, which keeps only
    the sha256 of each session cookie). One lock; every change is written at once, atomically, 0600.

    The first start makes the default groups and the ui.env login (UI_USER, UI_PASSWORD_HASH) the first
    administrator. A new ui.env password later (sudo bin/install-ui --new-password: root's way back in) gives
    that login back: enabled, an administrator, with that password, its sessions closed."""

    def __init__(self, directory, env_user, env_hash):
        self.directory = directory
        self.path, self.sessions_path = directory / 'accounts.json', directory / 'sessions.json'
        self.lock = threading.RLock()
        # An unknown or disabled user is checked against this: the time does not tell which names exist.
        self.dummy = password_hash(secrets.token_urlsafe(18), iterations=int(env_hash.split(':')[1]))
        try:
            self.data = json.loads(self.path.read_text())
            if not isinstance(self.data, dict) or not isinstance(self.data.get('users', {}), dict):
                raise ValueError('not a JSON object of users and groups')
        except FileNotFoundError:
            self.data = {}
        except (OSError, ValueError) as error:
            raise Refused(f'{self.path}: unreadable ({error}); fix it, or move it away and the ui.env login '
                          'becomes the first administrator again') from error
        try:
            sessions = json.loads(self.sessions_path.read_text())
            self.sessions = sessions if isinstance(sessions, dict) else {}
        except (OSError, ValueError):
            self.sessions = {}
        self.recovered = self.sync(env_user, env_hash)

    def sync(self, env_user, env_hash):
        """The groups and the ui.env login, as the class says; True when that login was (re)set."""
        with self.lock:
            data, before = self.data, json.dumps(self.data, sort_keys=True)
            data.setdefault('groups', json.loads(json.dumps(DEFAULT_GROUPS)))
            data.setdefault('users', {})
            data.setdefault('tokens', {})
            # The default groups renamed since: each moves to its new id (the users' memberships with it), its
            # title too unless someone changed it; when both ids exist, the old one's members join the new one.
            for old, (new, old_title) in RENAMED_GROUPS.items():
                if old not in data['groups']:
                    continue
                group = data['groups'].pop(old)
                if new not in data['groups']:
                    if group.get('title') == old_title:
                        group['title'] = DEFAULT_GROUPS[new]['title']
                    data['groups'][new] = group
                for user in data['users'].values():
                    if old in user.get('groups', []):
                        user['groups'] = sorted({new if group_name == old else group_name for group_name in user['groups']})
            # A section added since: each existing group gets the level it has for the section it came from.
            known = data.get('sections') or [key for key, _, _ in SECTIONS if key not in NEW_SECTIONS_FROM]
            for section, origin in NEW_SECTIONS_FROM.items():
                if section not in known:
                    for group in data['groups'].values():
                        sections = group.get('sections') or {}
                        level = sections.get(origin) or ('view' if sections.get(NEW_SECTIONS_VIEW_FROM.get(section)) else '')
                        if level:
                            group.setdefault('sections', {})[section] = level
            data['sections'] = [key for key, _, _ in SECTIONS]
            # Administrators always manage everything, sections added later too: nobody can lock everyone out.
            data['groups'][ADMINISTRATORS] = json.loads(json.dumps(DEFAULT_GROUPS[ADMINISTRATORS]))
            recovered = data.get('env_hash') != env_hash
            if recovered:
                now = int(time.time())
                user = data['users'].setdefault(env_user, {'full_name': '', 'created': now, 'groups': []})
                user.update(password=env_hash, disabled=False, password_changed=now)
                user['groups'] = sorted({*user.get('groups', []), ADMINISTRATORS})
                data['env_hash'] = env_hash
                self.drop_sessions(env_user)
            if json.dumps(data, sort_keys=True) != before:
                self.write(self.path, data)
            return recovered

    def write(self, path, data):
        self.directory.mkdir(parents=True, exist_ok=True, mode=0o700)
        temporary = path.with_name(path.name + '.tmp')
        descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
        with os.fdopen(descriptor, 'w') as handle:
            json.dump(data, handle, indent=1, sort_keys=True)
            handle.write('\n')
        os.replace(temporary, path)

    def write_sessions(self):
        try:
            self.write(self.sessions_path, self.sessions)
        except OSError as error:  # the sessions still work; a restart would end them
            log(f'{self.sessions_path}: {error}')

    # --- Reading ---
    def snapshot(self):
        """A copy of the users, groups and API tokens (no lock needed by the caller)."""
        with self.lock:
            return json.loads(json.dumps({'users': self.data['users'], 'groups': self.data['groups'],
                                          'tokens': self.data.get('tokens', {})}))

    def password_of(self, name):
        """The stored hash of an enabled user, or None."""
        with self.lock:
            user = self.data['users'].get(name)
            return user['password'] if user and not user.get('disabled') else None

    def authenticate(self, name, password):
        stored = self.password_of(name)
        matched = password_matches(password, stored or self.dummy)  # outside the lock: PBKDF2 is slow on purpose
        return matched and stored is not None and self.password_of(name) == stored

    def permissions(self, name, kind='users'):
        """section -> 'view' or 'manage': the highest level any of the user's (kind 'tokens': the API token's) groups
        gives."""
        with self.lock:
            user = self.data[kind].get(name)
            if not user or user.get('disabled'):
                return {}
            levels = {}
            for group in user.get('groups', []):
                for section, level in ((self.data['groups'].get(group) or {}).get('sections') or {}).items():
                    if level in PERMISSION_LEVELS and PERMISSION_LEVELS.index(level) > PERMISSION_LEVELS.index(levels.get(section, '')):
                        levels[section] = level
            return levels

    # --- Sessions ---
    @staticmethod
    def digest(token):
        return hashlib.sha256(token.encode()).hexdigest()

    def open_session(self, name, client):
        token, now = secrets.token_urlsafe(32), int(time.time())
        with self.lock:
            self.sessions = {key: entry for key, entry in self.sessions.items()
                             if now - entry.get('seen', 0) <= SESSION_IDLE and now - entry.get('created', 0) <= SESSION_LIFETIME}
            self.sessions[self.digest(token)] = {'user': name, 'client': client, 'created': now, 'seen': now}
            self.data['users'][name]['last_login'] = now
            self.write_sessions()
            self.write(self.path, self.data)
        return token

    def session_user(self, token):
        if not token or len(token) > 100:
            return None
        key, now = self.digest(token), int(time.time())
        with self.lock:
            entry = self.sessions.get(key)
            if entry is None:
                return None
            user = self.data['users'].get(entry.get('user'))
            if (not user or user.get('disabled') or now - entry.get('seen', 0) > SESSION_IDLE or
                    now - entry.get('created', 0) > SESSION_LIFETIME):
                del self.sessions[key]
                self.write_sessions()
                return None
            if now - entry['seen'] > 300:  # a write every few minutes of use, not every request
                entry['seen'] = now
                self.write_sessions()
            return entry['user']

    def close_session(self, token):
        with self.lock:
            if token and self.sessions.pop(self.digest(token), None) is not None:
                self.write_sessions()

    def drop_sessions(self, name, keep=None):
        """End a user's sessions (a new password, disabled, deleted), all but `keep` (a cookie)."""
        with self.lock:
            kept = self.digest(keep) if keep else None
            remaining = {key: entry for key, entry in self.sessions.items() if entry.get('user') != name or key == kept}
            if len(remaining) != len(self.sessions):
                self.sessions = remaining
                self.write_sessions()

    def session_count(self, name):
        with self.lock:
            return sum(1 for entry in self.sessions.values() if entry.get('user') == name)

    # --- API tokens ---
    def token_name(self, token):
        """The enabled API token a Bearer token is, or None. Every stored digest is compared (in constant time), so
        the time does not tell how close a guess came."""
        if not API_TOKEN.fullmatch(token or ''):
            return None
        key, found, now = self.digest(token), None, int(time.time())
        with self.lock:
            for name, entry in self.data['tokens'].items():
                if hmac.compare_digest(entry.get('digest', ''), key) and not entry.get('disabled'):
                    found = name
            if found and now - self.data['tokens'][found].get('last_used', 0) > TOKEN_SEEN:
                self.data['tokens'][found]['last_used'] = now
                try:
                    self.write(self.path, self.data)
                except OSError as error:  # the token still works; only "last used" is late
                    log(f'{self.path}: {error}')
        return found

    def save_token(self, name, new, groups, disabled):
        """A new API token (its text, shown once) or a token's groups and state (None)."""
        with self.lock:
            tokens = json.loads(json.dumps(self.data['tokens']))
            if new and name in tokens:
                raise Invalid(f'The API token {name} already exists.')
            if not new and name not in tokens:
                raise Invalid(f'There is no API token {name}.')
            unknown = [group for group in groups if group not in self.data['groups']]
            if unknown:
                raise Invalid(f'There is no group {unknown[0]}.')
            text = None
            entry = tokens.setdefault(name, {'created': int(time.time())})
            entry.update(groups=sorted(groups), disabled=disabled)
            if new:
                text = 'ops_' + secrets.token_urlsafe(32)
                entry['digest'] = self.digest(text)
            self.data['tokens'] = tokens
            self.write(self.path, self.data)
            return text

    def regenerate_token(self, name):
        """A new text for an API token (shown once); the old one stops working at once."""
        with self.lock:
            if name not in self.data['tokens']:
                raise Invalid(f'There is no API token {name}.')
            text = 'ops_' + secrets.token_urlsafe(32)
            self.data['tokens'][name].update(digest=self.digest(text), regenerated=int(time.time()))
            self.write(self.path, self.data)
            return text

    def delete_token(self, name):
        with self.lock:
            if name not in self.data['tokens']:
                raise Invalid(f'There is no API token {name}.')
            del self.data['tokens'][name]
            self.write(self.path, self.data)

    # --- Changes: each checks that an enabled administrator remains, then writes ---
    def commit(self, users, groups):
        if not any(ADMINISTRATORS in user.get('groups', []) and not user.get('disabled') for user in users.values()):
            raise Invalid('At least one enabled user must remain in the group "Administrators".')
        self.data['users'], self.data['groups'] = users, groups
        self.write(self.path, self.data)

    def save_user(self, name, new, full_name, groups, person, disabled, hashed):
        with self.lock:
            snapshot = self.snapshot()
            users, known = snapshot['users'], snapshot['groups']
            if new and name in users:
                raise Invalid(f'User {name} already exists.')
            if not new and name not in users:
                raise Invalid(f'There is no user {name}.')
            unknown = [group for group in groups if group not in known]
            if unknown:
                raise Invalid(f'There is no group {unknown[0]}.')
            now = int(time.time())
            user = users.setdefault(name, {'created': now})
            user.update(full_name=full_name, groups=sorted(groups), person=person, disabled=disabled)
            if hashed:
                user.update(password=hashed, password_changed=now)
            if 'password' not in user:
                raise Invalid('A new user needs a password.')
            self.commit(users, known)

    def set_password(self, name, hashed):
        with self.lock:
            snapshot = self.snapshot()
            snapshot['users'][name].update(password=hashed, password_changed=int(time.time()))
            self.commit(snapshot['users'], snapshot['groups'])

    def delete_user(self, name):
        with self.lock:
            snapshot = self.snapshot()
            if snapshot['users'].pop(name, None) is None:
                raise Invalid(f'There is no user {name}.')
            self.commit(snapshot['users'], snapshot['groups'])
            self.drop_sessions(name)

    def save_group(self, identifier, title, sections):
        """A new group when `identifier` is None (its id from the title); the group's id."""
        with self.lock:
            snapshot = self.snapshot()
            groups = snapshot['groups']
            if identifier is None:
                identifier = group_id(title)
                if not GROUP_ID.fullmatch(identifier):
                    raise Invalid('A group name needs at least one letter or digit.')
                if identifier in groups:
                    raise Invalid(f'The group "{groups[identifier]["title"]}" already exists.')
            elif identifier not in groups:
                raise Invalid('There is no such group.')
            if identifier == ADMINISTRATORS:
                raise Invalid('"Administrators" always manage everything: this group cannot be changed.')
            groups[identifier] = {'title': title, 'sections': {key: level for key, level in sections.items() if level}}
            self.commit(snapshot['users'], groups)
            return identifier

    def delete_group(self, identifier):
        with self.lock:
            snapshot = self.snapshot()
            if identifier == ADMINISTRATORS:
                raise Invalid('The group "Administrators" cannot be deleted.')
            if snapshot['groups'].pop(identifier, None) is None:
                raise Invalid('There is no such group.')
            for user in [*snapshot['users'].values(), *self.data['tokens'].values()]:
                user['groups'] = [group for group in user.get('groups', []) if group != identifier]
            self.commit(snapshot['users'], snapshot['groups'])


# --- The action log ------------------------------------------------------------------------------
def record(user, client, kind, text):
    """One line in ui-actions.log (append only, never through a symlink); raises OSError when it cannot."""
    stamp = datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
    line = f'{stamp} user={user} client={client} {kind} {text}'.replace('\n', ' ')[:4000] + '\n'
    descriptor = os.open(ACTIONS_LOG, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o640)
    with os.fdopen(descriptor, 'a') as handle:
        handle.write(line)


# --- Form values ---------------------------------------------------------------------------------
def value(form, key, pattern=None, label=None, required=False, limit=200):
    text = form.get(key, '').strip()
    if not text:
        if required:
            raise Invalid(f'Fill in the field "{label or key}".')
        return ''
    if len(text) > limit or (pattern is not None and not pattern.fullmatch(text)):
        raise Invalid(f'Invalid value in the field "{label or key}": {text[:80]}')
    return text


def git_ref(form, key, label, required=False):
    text = value(form, key, REF, label, required)
    if text and ('..' in text or '//' in text or text.endswith(('/', '.lock', '.'))):
        raise Invalid(f'Invalid value in the field "{label}": {text[:80]}')
    return text


def git_url(form, key, label, required=False):
    text = value(form, key, GIT_URL, label, required, limit=300)
    if text.endswith('.git.git'):
        raise Invalid(f'Invalid value in the field "{label}": {text[:80]}')
    return text


def networks(text, label):
    found = []
    for part in [part for part in re.split(r'[\s,]+', text) if part]:
        try:
            network = ipaddress.ip_network(part, strict=False)
        except ValueError:
            raise Invalid(f'"{label}": {part[:60]} is not an IP address or network.') from None
        if network.prefixlen == 0:
            raise Invalid(f'"{label}": give a specific network, not all addresses.')
        found.append(part)
    return found


def flag(form, key):
    return form.get(key) == 'yes'


# --- Actions: what each form runs ----------------------------------------------------------------
class Plan:
    """One action: the --check command, the command "Run" runs, and its stdin (kept in memory only)."""

    def __init__(self, action, title, check, run, stdin=None, timeout=600, run_codes=(0,), danger=None):
        self.action, self.title, self.check, self.run = action, title, check, run
        self.stdin, self.timeout, self.run_codes = stdin, timeout, run_codes
        self.danger = danger  # what can go wrong, shown above "Run"
        self.kind = 'command'
        self.changes = []  # (kind, text) the preview lists above the command: what the run changes
        self.back = ('/actions', 'actions')  # where "Cancel" leads, and the page's navigation section


class PipelinePlan:
    """A Bitbucket custom pipeline: the request is shown first, sent on "Run"."""

    def __init__(self, project, workspace, slug, pipeline, branch, variables):
        self.action, self.kind = 'pipeline', 'pipeline'
        self.project, self.workspace, self.slug = project, workspace, slug
        self.pipeline, self.branch, self.variables = pipeline, branch, variables
        self.title = f'{pipeline_title(pipeline)}: {project}'
        self.path = f'/repositories/{quote(workspace)}/{quote(slug)}/pipelines/'
        self.body = {'target': {'type': 'pipeline_ref_target', 'ref_type': 'branch', 'ref_name': branch,
                                'selector': {'type': 'custom', 'pattern': pipeline}},
                     'variables': [{'key': key, 'value': text} for key, text in variables]}


def command(script, arguments):
    """sudo of a root-owned copy in $LIBRARY/bin: (with --check, without)."""
    base = ['sudo', '-n', str(LIBRARY / 'bin' / script)]
    return base + ['--check'] + arguments, base + arguments


def target_place(form, key, label, required=False, mode_key=None):
    """Where one environment deploys (bin/add-project's target after ENV=); with the form's type "Files only" (mode_key)
    a files-only target: files: in front."""
    text = value(form, key, label=label, required=required)
    mode = form.get(mode_key, 'docker') if mode_key else 'docker'
    if mode not in dict(TARGET_MODES):
        raise Invalid(f'Target type of "{label}": Docker stack or Files only.')
    if text and mode == 'files' and not text.startswith('files:'):
        if text == 'local':
            raise Invalid(f'A files-only target needs its own directory in the field "{label}": local:/PATH or '
                          'ssh://USER@SERVER/PATH (the build root holds the clones).')
        text = 'files:' + text
    if text and not TARGET_PLACE.fullmatch(text):
        raise Invalid(f'Invalid target in the field "{label}": {text[:80]} ({TARGET_HINT}).')
    return text


def target_scope(target):
    """The environment of a [ENV=]target, '' for the target every environment shares (target.env)."""
    return target.split('=', 1)[0] if '=' in target else ''


def plan_add_project(form, status):
    name = value(form, 'name', NAME, 'Name')
    env_repo = git_url(form, 'env_repo', 'Environment repo', required=True)
    code_repo = git_url(form, 'code_repo', 'Code repo')
    monorepo = flag(form, 'monorepo')
    if monorepo and code_repo:
        raise Invalid('A monorepo holds the code in app/public/ itself: leave "Code repo URL" empty.')
    # The target every environment shares, prod's and stage's own, then any further ENV=target lines.
    targets = [target_place(form, 'target_all', 'Every environment', mode_key='mode_all')]
    targets += [f'{environment}={place}' if place else '' for environment in ('prod', 'stage')
                for place in (target_place(form, f'target_{environment}', environment, mode_key=f'mode_{environment}'),)]
    targets = [target for target in targets if target]
    for line in [line.strip() for line in form.get('targets', '').splitlines() if line.strip()]:
        if len(line) > 200 or not TARGET.fullmatch(line):
            raise Invalid(f'Invalid target: {line[:80]} (ENV= in front of {TARGET_HINT}; ENV is lowercase letters and '
                          'digits, 2–16, not local or test).')
        targets.append(line)
    if len(targets) > 10:
        raise Invalid('At most ten targets.')
    scopes = [target_scope(target) for target in targets]
    for scope in scopes:
        if scopes.count(scope) > 1:
            raise Invalid(f'Two targets for {scope or "every environment"}: give one.')
    arguments = (['--shared-key'] if flag(form, 'shared_key') else []) + (['--monorepo'] if monorepo else [])
    arguments += [part for target in targets for part in ('--target', target)]
    arguments += ([name] if name else []) + [env_repo] + ([code_repo] if code_repo else [])
    plan = Plan('add-project', 'Add a project', *command('add-project', arguments), timeout=1800)
    plan.back = ('/projects/new', 'projects')
    return plan


def project_entry(form, status, key='project', label='Project'):
    """A project's name from the form and its entry in the status (what its repositories and targets are)."""
    name = value(form, key, NAME, label, required=True)
    if status is None:
        raise Invalid('Could not read the status of the projects: try again.')
    entry = next((item for item in status.get('projects', []) if item.get('name') == name), None)
    if entry is None:
        raise Invalid(f'There is no project {name}.')
    return name, entry


def status_url(entry, key, label):
    """A repository URL as the status read it from a checkout, checked as a typed one would be."""
    url = entry.get(key) or ''
    if url and (len(url) > 300 or not GIT_URL.fullmatch(url) or url.endswith('.git.git')):
        raise Invalid(f'{label} of {entry["name"]} ({url[:80]}) is not a URL the UI passes on: run bin/add-project by hand.')
    return url


def plan_project_target(form, status):
    """A project environment's own target (target.<env>.env): set it (bin/add-project --target ENV=TARGET, a rerun with the
    project's own repositories, which keeps the clones) or remove it (bin/add-project --remove-target ENV)."""
    name, entry = project_entry(form, status)
    if any((state or {}).get('development') for state in (entry.get('environments') or {}).values()):
        raise Invalid(f'{name} is a development checkout: it has no deploy target.')
    environment = value(form, 'environment', ENVIRONMENT, 'Environment', required=True, limit=16)
    operation = form.get('operation', 'set')
    if operation == 'remove':
        if environment not in entry.get('target_files', []):
            raise Invalid(f'{name} {environment} has no target of its own (target.{environment}.env) to remove.')
        if 'all' not in (entry.get('targets') or {}):
            raise Invalid(f'{name} has no shared target.env: without target.{environment}.env {environment} would have no target '
                          'left. Change the target instead, or remove the project.')
        plan = Plan('project-target', f'Remove the target of {name} {environment}',
                    *command('add-project', ['--remove-target', environment, '--name', name]),
                    danger=f'{environment} then deploys to the shared target.env; what runs on the old target stays there.')
    elif operation == 'set':
        place = target_place(form, 'target', 'Target', required=True, mode_key='mode')
        repository = status_url(entry, 'repository', 'The environment repo')
        if not repository:
            raise Invalid(f'The status names no environment repo of {name}: run bin/add-project by hand.')
        code = '' if entry.get('monorepo') else status_url(entry, 'code_repository', 'The code repo')
        arguments = (['--monorepo'] if entry.get('monorepo') else []) + ['--target', f'{environment}={place}', name, repository]
        arguments += [code] if code else []
        known = environment in (entry.get('environments') or {}) or environment in (entry.get('targets') or {})
        title = f'Change the target of {name} {environment}' if known else f'Add the environment {environment} to {name}'
        plan = Plan('project-target', title, *command('add-project', arguments), timeout=1800,
                    danger='The next prod deploy goes to the new target; the old one keeps running until it is stopped.'
                    if environment == 'prod' and known else None)
    else:
        raise Invalid('Unknown operation: set or remove.')
    plan.back = (f'/project/{quote(name)}#settings', 'projects')
    return plan


def plan_remove_project(form, status):
    name = value(form, 'name', NAME, 'Project', required=True)
    with_backups = flag(form, 'with_backups')
    arguments = (['--with-backups'] if with_backups else []) + [name]
    plan = Plan('remove-project', f'Remove the project {name}', *command('remove-project', arguments),
                danger='The build directory is deleted' + (' together with the DB backups and the deploy history.' if with_backups else '.'))
    plan.back = ('/projects', 'projects')
    return plan


def plan_install_runner(form, status):
    provider = form.get('provider', 'bitbucket')
    if provider not in ('bitbucket', 'github'):
        raise Invalid('Runner: bitbucket or github.')
    name = value(form, 'runner_name', RUNNER_NAME, 'Name on GitHub') if provider == 'github' else ''
    instance = value(form, 'instance', re.compile(r'[2-9]'), 'Instance') if provider == 'github' else ''
    if instance and not name:
        raise Invalid('An extra instance needs its own name on GitHub (otherwise it would take over the first one\'s registration).')
    tarball = value(form, 'tarball', TARBALL, 'Archive', limit=420)
    if tarball and ('..' in tarball.split('/') or tarball.startswith('//')):
        raise Invalid(f'Invalid value in the field "Archive": {tarball[:80]}')
    sha256 = value(form, 'sha256', SHA256, 'SHA-256')
    if sha256 and provider != 'github':
        raise Invalid('SHA-256 is given for a GitHub runner only (the Atlassian link itself checks the Bitbucket archive).')
    if sha256 and not tarball:
        raise Invalid('SHA-256 only together with an archive (without one the pinned release is used, its hash is known).')
    text = form.get('dialog', '')
    if not text.strip():
        raise Invalid('Paste the text of the Bitbucket dialog (the GitHub page).')
    if len(text) > 64 * 1024:
        raise Invalid('The text is too long.')
    arguments = ['--provider', provider] + (['--name', name] if name else []) + (['--instance', instance] if instance else []) + \
        (['--tarball', tarball] if tarball else []) + (['--sha256', sha256] if sha256 else [])
    title = 'Install a GitHub runner' if provider == 'github' else 'Install the Bitbucket runner'
    plan = Plan('install-runner', title, *command('install-runner', arguments), stdin=text, timeout=1800)
    plan.back = ('/runners', 'runners')
    return plan


def plan_remove_runner(form, status):
    """Remove a runner: a registered GitHub runner (its scope) or the Bitbucket one; GitHub's Remove dialog
    text, when pasted, also unregisters it there."""
    provider = form.get('provider', '')
    if provider == 'github':
        scope = value(form, 'scope', SCOPE, 'Runner', required=True)
        if status is not None and scope not in status.get('github_runners', []):
            raise Invalid(f'There is no GitHub runner {scope} on this server.')
        text = form.get('dialog', '')
        if len(text) > 16 * 1024:
            raise Invalid('The text is too long.')
        arguments, title = ['--provider', 'github', '--remove', '--scope', scope], f'Remove the GitHub runner {scope}'
    elif provider == 'bitbucket':
        text, arguments, title = '', ['--remove'], 'Remove the Bitbucket runner'
    else:
        raise Invalid('Runner: bitbucket or github.')
    plan = Plan('remove-runner', title, *command('install-runner', arguments), stdin=text, timeout=900,
                danger='The runner is stopped and its directory deleted; the command does not remove a GitHub runner '
                       'that is running a job (the preview shows it).')
    plan.back = ('/runners', 'runners')
    return plan


def plan_install_backups(form, status):
    at = value(form, 'at', re.compile(r'([01][0-9]|2[0-3]):[0-5][0-9]'), 'Time')
    full_at = value(form, 'full_at', re.compile(r'(Mon|Tue|Wed|Thu|Fri|Sat|Sun) ([01][0-9]|2[0-3]):[0-5][0-9]'),
                    'DB full backup day and time')
    files_at = value(form, 'files_at', re.compile(r'([01][0-9]|2[0-3]):[0-5][0-9]'), 'Files backup time')
    arguments = (['--at', at] if at else []) + (['--full-at', full_at] if full_at else []) + \
        (['--files-at', files_at] if files_at else [])
    return Plan('install-backups', 'Backups (nightly DB short, weekly DB full and files)', *command('install-backups', arguments))


def plan_install_metrics(form, status):
    arguments = []
    address = value(form, 'address', re.compile(r'[0-9a-fA-F:.]{2,45}'), 'Address')
    if address:
        try:
            ipaddress.ip_address(address)
        except ValueError:
            raise Invalid(f'"Address": {address} is not an IP address.') from None
        arguments += ['--address', address]
    allow = networks(form.get('allow', ''), 'Allowed addresses')
    if allow:
        arguments += ['--allow', ' '.join(allow)]
    port = value(form, 'port', re.compile(r'[0-9]{1,5}'), 'Port')
    if port:
        arguments += ['--port', port]
    token = form.get('token', 'keep')
    if token not in ('keep', 'new', 'none'):
        raise Invalid('Token: keep, new or none.')
    arguments += {'keep': [], 'new': ['--new-token'], 'none': ['--no-token']}[token]
    return Plan('install-metrics', 'Worker metrics', *command('install-metrics', arguments))


def plan_backup_local(form, status):
    name = value(form, 'project', NAME, 'Project')
    environment = form.get('environment', '')
    if environment and not ENVIRONMENT.fullmatch(environment):
        raise Invalid('Environment: stage, prod or one of the project\'s STAGE_ENVIRONMENTS (e.g. demo).')
    if environment and not name:
        raise Invalid('An environment is given only together with a project.')
    full, files = flag(form, 'full'), flag(form, 'files')
    if full and files:
        raise Invalid('A files backup is not a DB backup: do not tick "full" with it.')
    arguments = (['--full'] if full else ['--files'] if files else []) + ([name] if name else []) + \
        ([environment] if environment else [])
    what = ' '.join(part for part in (name or 'all projects', environment) if part)
    title = f'{"DB full backup" if full else "Files backup" if files else "DB short backup"} now: {what}'
    return Plan('backup-local', title, *command('backup-projects', arguments), timeout=12 * 3600)


def plan_backup_policy(form, status):
    """How often each backup series of one project environment is made: bin/backup-projects --set PROJECT ENV db-short=…
    db-full=… files=… (its --check says what changes)."""
    name, entry = project_entry(form, status)
    environment = value(form, 'environment', ENVIRONMENT, 'Environment', required=True, limit=16)
    state = (entry.get('environments') or {}).get(environment)
    if state is None:
        raise Invalid(f'{name} has no environment {environment}.')
    if state.get('development'):
        raise Invalid(f'{name} is a development checkout: the application manages its backups.')
    policy = {}
    for series, choices in BACKUP_POLICY.items():
        policy[series] = form.get(series, '')
        if policy[series] not in choices:
            raise Invalid(f'{BACKUP_SERIES[series]} ({series}): {", ".join(choices)}.')
    arguments = ['--set', name, environment, *(f'{series}={frequency}' for series, frequency in policy.items())]
    base = ['sudo', '-n', str(LIBRARY / 'bin' / 'backup-projects')]
    # --check after the items, as bin/backup-projects --set documents it.
    plan = Plan('backup-policy', f'Backup policy of {name} {environment}', base + arguments + ['--check'], base + arguments)
    before = environment_policy(state)
    plan.changes = [('bad' if policy[series] == 'off' else 'warn', f'{series}: {before[series]} → {policy[series]}')
                    for series in BACKUP_POLICY if policy[series] != before[series]] or [('muted', 'nothing changes')]
    if policy['db-short'] == policy['db-full'] == 'off' and (before['db-short'], before['db-full']) != ('off', 'off'):
        plan.danger = f'{name} {environment} gets no DB backups any more: the kept ones are rotated away as usual.'
    plan.back = (f'/project/{quote(name)}#backup-{environment}', 'projects')
    return plan


def plan_unit(form, status):
    unit, operation = form.get('unit', ''), form.get('operation', '')
    scope = unit[len('github-runner@'):] if unit.startswith('github-runner@') else None
    allowed = ('start', 'stop', 'restart') if scope and SCOPE.fullmatch(scope) else UNIT_OPERATIONS.get(unit)
    if not allowed:
        raise Invalid('Unknown service.')
    if operation not in allowed:
        raise Invalid(f'The service "{unit}" allows only: {", ".join(allowed)}.')
    title = f'{OPERATION_TITLES[operation]}: ' + (f'GitHub runner {scope}' if scope else UNIT_TITLES[unit])
    danger = None
    if operation in ('stop', 'restart') and unit != 'ui' and unit != 'metrics':
        danger = 'A running pipeline step would be cut off (the preview shows whether there is one).'
    if operation == 'stop' and unit == 'metrics':
        danger = 'Prometheus gets no worker metrics until the service is started again.'
    plan = Plan('unit', title, *command('server-unit', [operation, unit]),
                timeout=12 * 3600 if unit.startswith('backup') else 600, danger=danger)
    plan.fields = {'unit': unit}
    if 'runners' in unit_sections(unit):
        plan.back = ('/runners', 'runners')
    return plan


def plan_install_ssh(form, status):
    sources = networks(form.get('sources', ''), 'Networks')
    arguments = ['--from', ','.join(sources)] if sources else []
    return Plan('install-ssh', 'SSH from the VPN (bin/install-ssh)', *command('install-ssh', arguments), timeout=1800,
                danger='From other networks sshd accepts keys only. You reach this UI through an SSH tunnel: check that your '
                       'network is in the list or that you connect with a key.')


def stored_key(status, name):
    return next((item for item in (status or {}).get('keys', []) if item.get('name') == name), None)


def text_grants(form, kind='access'):
    """{(project, env): level} of a free text field: PROJECT[:ENV]=LEVEL, without ENV both stage and prod."""
    field, levels, _, title, _ = KINDS[kind]
    found = {}
    for grant in form.get(f'{field}s', '').replace(',', ' ').split():
        if not (GRANT if kind == 'access' else PULL).fullmatch(grant):
            raise Invalid(f'"{title}": {grant} – write PROJECT[:ENV]=LEVEL (environment stage, prod, demo…; without it '
                          f'stage and prod), level {", ".join(levels)}.')
        target, level = grant.split('=')
        project, _, environment = target.partition(':')
        for one in [environment] if environment else ['stage', 'prod']:
            found[(project, one)] = level
    return found


def grant_changes(before, after, kind='access'):
    """What a key's grants become: (kind, text) lines for the preview, a project environment per line."""
    changes, prefix = [], '' if kind == 'access' else 'backups: '
    for item in sorted(set(before) | set(after), key=lambda pair: (pair[0], environment_order(pair[1]))):
        old, new = before.get(item), after.get(item)
        if old == new:
            continue
        where = f'{prefix}{item[0]} {item[1]}'
        if new is None:
            changes.append(('bad', f'− {where}: {LEVEL_LABELS[old]} removed'))
        elif old is None:
            changes.append(('ok', f'+ {where}: {LEVEL_LABELS[new]}'))
        else:
            changes.append(('warn', f'~ {where}: {LEVEL_LABELS[old]} → {LEVEL_LABELS[new]}'))
    return changes


def key_plan(name, stored, granted, pulls, pull_all, public_key, sources, title):
    """bin/add-backup-key with the key's whole lists (written explicitly, so nothing depends on what it kept);
    the preview lists what changes."""
    arguments = (['-'] if public_key else []) + ['--name', name] + (['--from', ','.join(sources)] if sources else [])
    arguments += ['--pull-all', pull_all]
    arguments += [word for (project, environment), level in sorted(pulls.items())
                  for word in ('--pull', f'{project}:{environment}={level}')] or ['--no-pulls']
    arguments += [word for (project, environment), level in sorted(granted.items())
                  for word in ('--grant', f'{project}:{environment}={level}')] or ['--no-grants']
    plan = Plan('add-backup-key', title, *command('add-backup-key', arguments), stdin=public_key + '\n' if public_key else None)
    plan.changes = grant_changes(key_grants(stored), granted) + grant_changes(key_grants(stored, 'backups'), pulls, 'backups')
    before = (stored or {}).get('pull_all', 'none')
    if before != pull_all:
        plan.changes.append(('warn' if stored else 'ok', 'backups, every project (new ones too): '
                             f'{LEVEL_LABELS.get(before, "none")} → {LEVEL_LABELS.get(pull_all, "none")}'))
    if stored is not None:
        if sources and sources != stored.get('sources'):
            plan.changes.append(('warn', f'from: {", ".join(stored.get("sources", []))} → {", ".join(sources)}'))
        if public_key:
            plan.changes.append(('warn', 'the key is replaced by a new one'))
    plan.back = (f'/access/{quote(name)}' if stored else '/access/new', 'access')
    return plan


def plan_add_backup_key(form, status):
    """A new developer key, or a change of an existing one. A key page sends merge=yes: the cells it shows change
    those project environments only (a filtered list keeps the rest). Without a pasted key the stored key stays,
    with the networks left empty its networks; pull_all, when sent, sets every project's backups."""
    lines = [line.strip() for line in form.get('public_key', '').splitlines() if line.strip()]
    name = value(form, 'key_name', KEY_NAME, 'Name', required=True)
    stored = stored_key(status, name)
    if lines and (len(lines) != 1 or not PUBLIC_KEY.fullmatch(lines[0])):
        raise Invalid('Paste one public key (a .pub line, e.g. "ssh-ed25519 AAAA… name"), not a private one.')
    if not lines and stored is None:
        raise Invalid('Paste the public key (a .pub line): there is no key named ' + name + ' on the server yet.')
    if stored is not None and form.get('new') == 'yes':
        raise Invalid(f'A key named {name} already exists: change it on its page.')
    sources = networks(form.get('sources', ''), 'From')
    if not sources and stored is None:
        raise Invalid('"From": give the VPN network, e.g. 10.8.0.0/24.')
    merge = flag(form, 'merge')
    found = {'access': dict(key_grants(stored)) if merge else {},
             'backups': dict(key_grants(stored, 'backups')) if merge else {}}
    pull_all = form.get('pull_all', (stored or {}).get('pull_all', 'none') if merge else 'none') or 'none'
    if pull_all not in ('none', *PULL_LEVELS):
        raise Invalid(f'"Backups": unknown level {pull_all}.')
    columns = access_columns(status)
    for kind, (field, levels, _, title, _) in KINDS.items():
        for environment in ('prod', 'stage'):  # a new key's starting level for every project environment of that name
            level = form.get(f'start:{field}:{environment}', '')
            if level and level not in levels:
                raise Invalid(f'"{title}": unknown level {level}.')
            if level:
                found[kind].update({(project, environment): level for project, one in columns if one == environment})
    for key, chosen in form.items():
        match = GRANT_FIELD.fullmatch(key)
        if key.startswith(('grant:', 'pull:')) and not match:
            raise Invalid('"Access": invalid project or environment.')
        if match:
            kind = 'access' if match[1] == 'grant' else 'backups'
            if chosen and chosen not in KINDS[kind][1]:
                raise Invalid(f'"{KINDS[kind][3]}": unknown level {chosen}.')
            if chosen:
                found[kind][(match[2], match[3])] = chosen
            else:
                found[kind].pop((match[2], match[3]), None)
    found['access'].update(text_grants(form))
    found['backups'].update(text_grants(form, 'backups'))
    title = f'New key {name}' if stored is None else f'Change of the key {name}'
    return key_plan(name, stored, found['access'], found['backups'], pull_all, lines[0] if lines else '', sources, title)


def plan_key_bulk(form, status):
    """One level of access or backups for every prod, every stage or every environment of an existing key, or only
    where it already has some."""
    name = value(form, 'key_name', KEY_NAME, 'Name', required=True)
    stored = stored_key(status, name)
    if stored is None:
        raise Invalid(f'There is no key named {name}.')
    kind = form.get('kind', 'access')
    scope, level, only = form.get('scope', ''), form.get('level', ''), form.get('only') == 'existing'
    if kind not in KINDS or scope not in ('prod', 'stage', 'other', 'all') or (level and level not in KINDS[kind][1]):
        raise Invalid('Choose the environments (prod, stage, other, all) and a level.')
    granted, pulls = dict(key_grants(stored)), dict(key_grants(stored, 'backups'))
    changed = granted if kind == 'access' else pulls
    before = dict(changed)
    for item in access_columns(status):
        wanted = scope == 'all' or item[1] == scope or (scope == 'other' and item[1] not in ('prod', 'stage'))
        if wanted and (not only or item in before):
            if level:
                changed[item] = level
            else:
                changed.pop(item, None)
    what = {'prod': 'every prod', 'stage': 'every stage', 'other': 'other environments', 'all': 'every environment'}[scope]
    title = (f'{name}: {KINDS[kind][3].lower()}, {what} → {LEVEL_LABELS.get(level, "no permission")}' +
             (' (only where it already has some)' if only else ''))
    plan = key_plan(name, stored, granted, pulls, stored.get('pull_all', 'none'), '', [], title)
    if not plan.changes:
        plan.changes = [('muted', 'nothing changes')]
    return plan


def tool_state(status):
    return (status or {}).get('tool_access') or {}


def tool_user(status, name):
    return (tool_state(status).get('users') or {}).get(name) or {}


def full_names(status):
    """A key's name -> the person's full name, for the keys that have one (bin/tool-access --full-name)."""
    return {name: user['full_name'] for name, user in (tool_state(status).get('users') or {}).items() if user.get('full_name')}


def plan_tool_access(form, status):
    """The project environments whose tools a key's user opens: the cells the page shows change, the rest stays."""
    name = value(form, 'key_name', KEY_NAME, 'Name', required=True)
    if stored_key(status, name) is None:
        raise Invalid(f'There is no key named {name}.')
    user = tool_user(status, name)
    before = set(user.get('projects', []))
    after = set(before)
    for key, chosen in form.items():
        if not key.startswith('tool:'):
            continue
        match = TOOL_FIELD.fullmatch(key)
        if not match or chosen not in ('', 'tools'):
            raise Invalid('"Tools": invalid project or environment.')
        (after.add if chosen else after.discard)(f'{match[1]}:{match[2]}')
    return tool_plan(name, user, before, after, f'{name}: tools')


def plan_tool_bulk(form, status):
    """Tools for every prod, every stage, the other or all environments of a key's user at once."""
    name = value(form, 'key_name', KEY_NAME, 'Name', required=True)
    if stored_key(status, name) is None:
        raise Invalid(f'There is no key named {name}.')
    scope, level = form.get('scope', ''), form.get('level', '')
    if scope not in ('prod', 'stage', 'other', 'all') or level not in ('', 'tools'):
        raise Invalid('Choose the environments (prod, stage, other, all) and a level.')
    user = tool_user(status, name)
    before = set(user.get('projects', []))
    after = set(before)
    for project, environment in access_columns(status):
        # local and test never run on a target: no tools there to open.
        if environment in ('local', 'test'):
            continue
        if scope == 'all' or environment == scope or (scope == 'other' and environment not in ('prod', 'stage')):
            (after.add if level else after.discard)(f'{project}:{environment}')
    what = {'prod': 'every prod', 'stage': 'every stage', 'other': 'other environments', 'all': 'every environment'}[scope]
    return tool_plan(name, user, before, after, f'{name}: tools, {what} → {LEVEL_LABELS["tools"] if level else "no permission"}')


def tool_plan(name, user, before, after, title):
    arguments = ['--name', name] + ([word for item in sorted(after) for word in ('--tools', item)] or ['--no-tools'])
    plan = Plan('tool-access', title, *command('tool-access', arguments), timeout=3600)
    plan.changes = ([('bad', f'− {item.replace(":", " ")}: the tools no longer let in') for item in sorted(before - after)] +
                    [('ok', f'+ {item.replace(":", " ")}: the tools let in') for item in sorted(after - before)])
    if not plan.changes:
        plan.changes = [('muted', 'nothing changes')]
    if after and not user.get('password'):
        plan.changes.append(('warn', 'no password set: until there is one, the tools do not let this user in'))
    plan.back = (f'/access/{quote(name)}?tab=tools', 'access')
    return plan


def plan_tool_password(form, status):
    """The tools password of a key's user, set by the administrator; it reaches bin/tool-access on stdin only."""
    name = value(form, 'key_name', KEY_NAME, 'Name', required=True)
    if stored_key(status, name) is None:
        raise Invalid(f'There is no key named {name}.')
    if flag(form, 'remove'):
        plan = Plan('tool-password', f'{name}: remove the tools password', *command('tool-access', ['--name', name, '--no-password']),
                    timeout=3600, danger=f'{name} will no longer get into any project\'s tools.')
    else:
        password = form.get('tool_password', '')
        if not TOOL_PASSWORD[0] <= len(password) <= TOOL_PASSWORD[1] or any(ord(character) < 32 for character in password):
            raise Invalid(f'Password: {TOOL_PASSWORD[0]}–{TOOL_PASSWORD[1]} characters, no control characters.')
        plan = Plan('tool-password', f'{name}: tools password', *command('tool-access', ['--name', name, '--password', '-']),
                    stdin=password + '\n', timeout=3600)
        plan.changes = [('warn' if tool_user(status, name).get('password') else 'ok',
                         'the password is replaced by a new one' if tool_user(status, name).get('password') else 'new password')]
    plan.back = (f'/access/{quote(name)}?tab=tools', 'access')
    return plan


def plan_tool_person(form, status):
    """A key's person: the full name the pages show and the login the tools ask for (empty: the key's name)."""
    name = value(form, 'key_name', KEY_NAME, 'Name', required=True)
    if stored_key(status, name) is None:
        raise Invalid(f'There is no key named {name}.')
    full = ' '.join(form.get('full_name', '').split())
    if len(full) > FULL_NAME_LENGTH or any(ord(character) < 32 or ord(character) == 127 for character in full):
        raise Invalid(f'Full name: up to {FULL_NAME_LENGTH} characters.')
    login = value(form, 'login', TOOL_LOGIN, 'Login', limit=128)
    others = {other['name'] for other in (status or {}).get('keys', []) if other.get('name') != name}
    taken = {other.lower(): other for other in others}
    taken.update({(user.get('login') or other).lower(): other
                  for other, user in (tool_state(status).get('users') or {}).items() if other != name})
    if login and login.lower() in taken:
        raise Invalid(f'The login {login} is already taken (key {taken[login.lower()]}).')
    user = tool_user(status, name)
    plan = Plan('tool-person', f'{name}: name and login',
                *command('tool-access', ['--name', name, '--full-name', full, '--login', login]), timeout=3600)
    before = user.get('login') or name
    plan.changes = [('ok', f'name: {full}' if full else 'no name shown')] if full != (user.get('full_name') or '') else []
    if (login or name) != before:
        plan.changes.append(('warn', f'the tools ask for {login or name} instead of {before}' +
                             (': the change is sent to the targets at once' if user.get('projects') else '')))
    plan.back = (f'/access/{quote(name)}', 'access')
    return plan


def plan_tool_ips(form, status):
    """This server's addresses every managed target lets reach its tools."""
    addresses = networks(form.get('allowed_ips', ''), 'Addresses')
    arguments = ['--allowed-ips', ','.join(addresses)] if addresses else ['--no-allowed-ips']
    plan = Plan('tool-ips', 'Tools addresses', *command('tool-access', arguments), timeout=3600)
    plan.back = ('/access#tools', 'access')
    return plan


def plan_tool_apply(form, status):
    plan = Plan('tool-apply', 'Tool access – send again', *command('tool-access', ['--apply']), timeout=3600)
    plan.back = ('/access#tools', 'access')
    return plan


def plan_remove_backup_key(form, status):
    name = value(form, 'key_name', KEY_NAME, 'Name', required=True)
    plan = Plan('remove-backup-key', f'Revoke the key {name}', *command('add-backup-key', ['--remove', name]),
                danger=f'The key {name} will no longer download backups or log in to the targets.')
    plan.back = (f'/access/{quote(name)}', 'access')
    return plan


def plan_list_backup_keys(form, status):
    # Read-only: the listing is the preview, nothing runs after it.
    return Plan('list-backup-keys', 'Backup keys', ['sudo', '-n', str(LIBRARY / 'bin/add-backup-key'), '--list'], None)


def plan_prepare_host(form, status):
    ref = git_ref(form, 'setup_ref', 'setup tag')
    # Exit 1 of --check is "Needs attention" (e.g. less RAM): the run still prepares the rest.
    return Plan('prepare-host', 'Prepare the server', *command('prepare-host', ['--setup-ref', ref] if ref else []),
                timeout=3600, run_codes=(0, 1))


def plan_move_bitbucket_ssh(form, status):
    return Plan('move-bitbucket-ssh', 'Bitbucket remotes to ssh.bitbucket.org', *command('move-bitbucket-ssh', []), timeout=1800)


def plan_update(form, status):
    where = installation()
    if not where['checkout']:
        raise Invalid('Unknown admin clone: run sudo bin/install-ui from it.')
    server_ref = git_ref(form, 'server_ref', 'Server OPS ref')
    setup_ref = git_ref(form, 'setup_ref', 'setup ref')
    if flag(form, 'latest'):
        server_ref = server_ref or 'origin/master'  # the newest Server OPS: the repository has no release tags
    if not server_ref and not setup_ref:
        raise Invalid('Give at least one ref (Server OPS or setup).')
    arguments = (['--server-ref', server_ref] if server_ref else []) + (['--setup-ref', setup_ref] if setup_ref else [])
    base = ['sudo', '-n', '-H', '-u', where['admin'], f"{where['checkout']}/bin/update"]
    return Plan('update', 'Update', base + ['--check'] + arguments, base + arguments, timeout=3600)


def plan_update_setup(form, status):
    """setup to the newest release of its MAJOR version (setup releases every merge to master: it is master), or to
    the release tag given."""
    tag = value(form, 'setup_tag', re.compile(r'v[0-9]+\.[0-9]+\.[0-9]+'), 'setup tag')
    return Plan('update-setup', f'Update setup {"to " + tag if tag else "to the newest"}',
                *command('update-setup', [tag] if tag else []), timeout=600)


def plan_pipeline(form, status):
    name = value(form, 'project', NAME, 'Project', required=True)
    entry = next((item for item in (status or {}).get('projects', []) if item.get('name') == name), None)
    if entry is None:
        raise Invalid(f'There is no project {name}.')
    repository = bitbucket_repository(entry.get('repository') or '')
    if repository is None:
        raise Invalid('Pipelines are started for Bitbucket projects only (GitHub is not supported yet).')
    pipeline = form.get('pipeline', '')
    extra = EXTRA_DEPLOY.fullmatch(pipeline)
    if pipeline not in PIPELINES and not (extra and extra[1] in entry.get('environments', {})):
        raise Invalid('Unknown pipeline.')
    branch = git_ref(form, 'branch', 'Branch') or entry.get('branch') or 'master'
    variables = []
    if pipeline in DEPLOY_PIPELINES or extra:
        ref = git_ref(form, 'ref', 'REF')
        if ref:
            variables.append(('REF', ref))
        for key in ('IMAGES', 'ROLLBACK', 'BACKUP'):
            variables.append((key, 'yes' if flag(form, key.lower()) else 'no'))
        # Sent only when asked for: without it the pipeline's CACHE=auto clears the cache when the deploy needs it
        # (setup 5.2.0+).
        if flag(form, 'cache'):
            variables.append(('CACHE', 'yes'))
    elif pipeline == 'backup-now' and flag(form, 'full'):
        # Sent only when asked for: a project whose backup-now predates FULL keeps working as it did.
        variables.append(('FULL', 'yes'))
    return PipelinePlan(name, *repository, pipeline, branch, variables)


ACTIONS = {'add-project': plan_add_project, 'remove-project': plan_remove_project, 'project-target': plan_project_target,
           'install-runner': plan_install_runner, 'remove-runner': plan_remove_runner, 'install-backups': plan_install_backups,
           'install-metrics': plan_install_metrics, 'add-backup-key': plan_add_backup_key, 'key-bulk': plan_key_bulk,
           'remove-backup-key': plan_remove_backup_key, 'list-backup-keys': plan_list_backup_keys,
           'prepare-host': plan_prepare_host, 'update': plan_update, 'update-setup': plan_update_setup,
           'pipeline': plan_pipeline, 'backup-local': plan_backup_local, 'backup-policy': plan_backup_policy, 'unit': plan_unit, 'install-ssh': plan_install_ssh,
           'move-bitbucket-ssh': plan_move_bitbucket_ssh, 'tool-access': plan_tool_access,
           'tool-bulk': plan_tool_bulk, 'tool-password': plan_tool_password,
           'tool-person': plan_tool_person, 'tool-ips': plan_tool_ips, 'tool-apply': plan_tool_apply}


# --- Running commands ----------------------------------------------------------------------------
def hidden_values(stdin, action=''):
    """The secrets of a pasted runner dialog or page (--OAuthClientSecret, --token), or a typed tools password: never
    shown back."""
    if action == 'tool-password':
        return [line for line in (stdin or '').splitlines() if line]
    return [found for found in re.findall(r'(?:--OAuthClientSecret|--token)[\s=]+([^\s\\]+)', stdin or '') if len(found) >= 4]


def redact(text, hidden):
    for secret in hidden:
        text = text.replace(secret, '<hidden>')
    return text


def check(plan):
    """The --check run: (exit code, output); a secret of its stdin never appears in the output."""
    try:
        process = subprocess.Popen(plan.check, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                   text=True, errors='replace', env=child_environment(), start_new_session=True)
    except OSError as error:
        return 126, f'{plan.check[0]}: {error.strerror}'
    try:
        output, _ = process.communicate(plan.stdin or '', timeout=CHECK_TIMEOUT)
        code = process.returncode
    except subprocess.TimeoutExpired:
        stop(process)
        output, code = f'(no answer within {CHECK_TIMEOUT} s; stopped)', 124
    return code, redact(output, hidden_values(plan.stdin, plan.action))


def stop(process, grace=30):
    """SIGTERM to the command's process group (sudo relays it to the command), then SIGKILL."""
    for sent, wait in ((signal.SIGTERM, grace), (signal.SIGKILL, 10)):
        try:
            os.killpg(process.pid, sent)
        except (ProcessLookupError, PermissionError):
            pass
        try:
            process.wait(timeout=wait)
            return
        except subprocess.TimeoutExpired:
            continue


def job_main(directory):
    """--job DIR: run job.json's argv with this process's stdin, write output.log and result.json, log the end."""
    directory = Path(directory)
    meta = json.loads((directory / 'job.json').read_text())
    given = sys.stdin.buffer.read()  # e.g. a runner dialog: kept in memory, never written anywhere
    (directory / 'pid').write_text(f'{os.getpid()}\n')
    started = time.time()
    hidden = [found.encode() for found in hidden_values(given.decode('utf-8', 'replace'), meta.get('action', ''))]
    with open(directory / 'output.log', 'ab', buffering=0) as output:
        try:
            process = subprocess.Popen(meta['argv'], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                       stderr=subprocess.STDOUT, start_new_session=True, env=child_environment())
        except OSError as error:
            output.write(f'{meta["argv"][0]}: {error.strerror}\n'.encode())
            code = 126
        else:
            def feed():
                try:
                    process.stdin.write(given)
                    process.stdin.close()
                except OSError:
                    pass
            expired = threading.Event()
            timer = threading.Timer(meta['timeout'], lambda: (expired.set(), stop(process)))
            threading.Thread(target=feed, daemon=True).start()
            timer.start()
            # Line by line, so that a secret of the stdin is masked before it reaches the file.
            for line in process.stdout:
                for secret in hidden:
                    line = line.replace(secret, b'<hidden>')
                output.write(line)
            code = process.wait()
            timer.cancel()
            if expired.is_set():
                output.write(f'\n(stopped after {meta["timeout"] // 60} min.)\n'.encode())
                code = 124
    (directory / 'result.json').write_text(json.dumps({'exit': code, 'finished': int(time.time()),
                                                       'seconds': int(time.time() - started)}))
    try:
        record(meta['user'], meta['client'], 'finished', f'job={directory.name} {meta["action"]} -> exit {code}')
    except OSError as error:
        log(f'ui-actions.log: {error}')
    return 0


def job_state(directory):
    """(meta, result or None, running?) of a job directory."""
    meta = json.loads((directory / 'job.json').read_text())
    try:
        return meta, json.loads((directory / 'result.json').read_text()), False
    except (OSError, ValueError):
        pass
    try:
        os.kill(int((directory / 'pid').read_text()), 0)
        return meta, None, True
    except (OSError, ValueError):
        # Started a moment ago (no pid yet) or gone without a result (killed).
        return meta, None, time.time() - meta['started'] < 30


def jobs(limit=None):
    if not JOBS.is_dir():
        return []
    found = sorted((path for path in JOBS.iterdir() if JOB_ID.fullmatch(path.name)), reverse=True)
    return found[:limit] if limit else found


def running_job():
    for directory in jobs(20):
        try:
            if job_state(directory)[2]:
                return directory.name
        except (OSError, ValueError, KeyError):
            continue
    return None


def start_job(plan, identifier, user, client):
    JOBS.mkdir(parents=True, exist_ok=True, mode=0o700)
    for old in jobs()[KEEP_JOBS:]:
        if (old / 'result.json').exists():
            shutil.rmtree(old, ignore_errors=True)
    directory = JOBS / identifier
    directory.mkdir(mode=0o700)
    (directory / 'job.json').write_text(json.dumps({'argv': plan.run, 'action': plan.action, 'title': plan.title,
                                                    'user': user, 'client': client, 'timeout': plan.timeout,
                                                    'started': int(time.time()), 'back': plan.back}))
    process = subprocess.Popen([sys.executable, PROGRAM, '--job', str(directory)], stdin=subprocess.PIPE,
                               stdout=subprocess.DEVNULL, start_new_session=True, env=child_environment())
    try:
        process.stdin.write((plan.stdin or '').encode())
        process.stdin.close()
    except OSError:
        pass
    threading.Thread(target=process.wait, daemon=True).start()  # reaped here; it outlives a restart of the UI


# --- Status --------------------------------------------------------------------------------------
class Cache:
    def __init__(self):
        self.lock = threading.Lock()
        self.values = {}

    def get(self, key, ttl, compute, fresh=False, since=None):
        """The stored value while younger than ttl, and (since given) computed after that wall-clock time."""
        with self.lock:
            stored = self.values.get(key)
            if stored and not fresh and time.monotonic() - stored[0] < ttl and (since is None or stored[2] > since):
                return stored[1]
        computed = time.time()
        result = compute()
        with self.lock:
            self.values[key] = (time.monotonic(), result, computed)
        return result

    def forget(self, key):
        with self.lock:
            self.values.pop(key, None)

    def peek(self, key):
        """What is stored, however old; None when nothing is (nothing is computed)."""
        with self.lock:
            stored = self.values.get(key)
        return stored[1] if stored else None


CACHE = Cache()


def helper(*arguments, timeout=150):
    """The read-only status helper through its sudo rule: (JSON, None) or (None, error)."""
    argv = ['sudo', '-n', str(LIBRARY / 'bin/server-status'), *arguments]
    try:
        result = subprocess.run(argv, capture_output=True, text=True, timeout=timeout, env=child_environment())
    except (OSError, subprocess.TimeoutExpired) as error:
        return None, f'server-status: {error}'
    if result.returncode:
        return None, f'server-status: exit {result.returncode}: {result.stderr.strip()[:300]}'
    try:
        return json.loads(result.stdout), None
    except ValueError:
        return None, 'server-status: no JSON'


def status(fresh=False):
    # A status read while an action ran may miss what it changed: read again once one has finished since.
    return CACHE.get('status', STATUS_TTL, helper, fresh, since=last_job_end())


def last_job_end():
    """When the newest finished action finished (its result.json), or None."""
    for directory in jobs(3):
        try:
            return (directory / 'result.json').stat().st_mtime
        except OSError:
            continue
    return None


# --- Bitbucket -----------------------------------------------------------------------------------
class NoRedirect(urllib.request.HTTPRedirectHandler):
    """A redirect is an error: the token is never sent anywhere but the configured API."""

    def redirect_request(self, request, fp, code, message, headers, url):
        return None


OPENER = urllib.request.build_opener(NoRedirect)


def github_actions_link(entry):
    match = re.fullmatch(r'(?:git@github\.com:|https://github\.com/)([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+)',
                         entry.get('repository') or '')
    if not match:
        return None
    repository = match[2].removesuffix('.git')
    return f'https://github.com/{quote(match[1])}/{quote(repository)}/actions'


def bitbucket_repository(url):
    match = BITBUCKET_URL.fullmatch(url.strip())
    return (match[1], match[2]) if match else None


def token_for(project):
    """(variable, token) for a build root: BITBUCKET_ACCESS_TOKEN_<NAME>, else BITBUCKET_ACCESS_TOKEN."""
    for variable in (f'{TOKEN_VARIABLE}_{re.sub(r"[^A-Z0-9]", "_", project.upper())}', TOKEN_VARIABLE):
        token = os.environ.get(variable, '')
        if token and re.fullmatch(r'[A-Za-z0-9._~+/=-]{8,512}', token):
            return variable, token
    return None, None


def bitbucket(method, path, token, body=None, timeout=20):
    """(HTTP status, JSON or None, error text or None); the token is only in the Authorization header."""
    data = json.dumps(body).encode() if body is not None else None
    request = urllib.request.Request(bitbucket_api() + path, data=data, method=method)
    request.add_header('Authorization', f'Bearer {token}')
    request.add_header('Accept', 'application/json')
    request.add_header('User-Agent', 'setup-server-ui')
    if data is not None:
        request.add_header('Content-Type', 'application/json')
    try:
        with OPENER.open(request, timeout=timeout) as response:
            return response.status, json.loads(response.read(2 * 1024 * 1024) or b'null'), None
    except urllib.error.HTTPError as error:
        try:
            message = json.loads(error.read(65536)).get('error', {}).get('message', '')
        except (ValueError, AttributeError, OSError):
            message = ''
        text = f'HTTP {error.code}' + (f': {message}' if message else '') + \
            (' (redirect not followed)' if 300 <= error.code < 400 else '')
        return error.code, None, text.replace(token, '<token>')[:300]
    except (urllib.error.URLError, OSError, ValueError) as error:
        return None, None, str(getattr(error, 'reason', error)).replace(token, '<token>')[:300]


def pipeline_runs(project, repository, fresh=False):
    """The 10 newest pipeline runs of a repository: (runs, error)."""
    variable, token = token_for(project)
    if not token:
        return None, f'no token ({TOKEN_VARIABLE}_{re.sub(r"[^A-Z0-9]", "_", project.upper())} or {TOKEN_VARIABLE})'

    def compute():
        code, data, error = bitbucket('GET', f'/repositories/{quote(repository[0])}/{quote(repository[1])}'
                                             '/pipelines/?sort=-created_on&pagelen=10', token, timeout=8)
        if error or not isinstance(data, dict):
            return None, error or f'HTTP {code}'
        return data.get('values', []), None
    return CACHE.get(('pipelines', project), PIPELINES_TTL, compute, fresh)


def pull_requests(project, repository, fresh=False):
    """The 10 most recently updated pull requests of a repository, open, merged, declined or superseded: (list, error)."""
    variable, token = token_for(project)
    if not token:
        return None, f'no token ({TOKEN_VARIABLE}_{re.sub(r"[^A-Z0-9]", "_", project.upper())} or {TOKEN_VARIABLE})'

    def compute():
        code, data, error = bitbucket('GET', f'/repositories/{quote(repository[0])}/{quote(repository[1])}/pullrequests'
                                             '?state=OPEN&state=MERGED&state=DECLINED&state=SUPERSEDED&sort=-updated_on&pagelen=10',
                                      token, timeout=8)
        if error or not isinstance(data, dict):
            return None, error or f'HTTP {code}'
        return data.get('values', []), None
    return CACHE.get(('pull-requests', project, repository), PIPELINES_TTL, compute, fresh)


# --- Instructions: preparing a server as a deploy target ------------------------------------------
# What a server needs before bin/add-project --target ENV=ssh://USER@HOST/PATH and a first deploy, step by
# step for the chosen OS, panel, environment and certificate. Facts come from setup's docs and code and
# from bin/add-project; where setup documents nothing (CentOS, the DirectAdmin proxy, a certificate without a
# panel) the step says so instead of pretending.
GUIDE_OPTIONS = (
    ('os', 'OS', (('ubuntu', 'Ubuntu 22.04 / 24.04'), ('debian', 'Debian 12'),
                  ('centos', 'CentOS Stream / AlmaLinux / Rocky (untested)'))),
    ('panel', 'Control panel', (('directadmin', 'DirectAdmin'), ('none', 'No panel'))),
    ('env', 'Environment', (('prod', 'prod'), ('stage', 'stage'))),
    ('ssl', 'SSL', (('letsencrypt', "Let's Encrypt"), ('own', 'Own certificate'), ('none', 'No SSL (VPN only, HTTP)'))),
)
class Field:
    """A value the guide asks for. `when`: alternatives of {option: values} under which it is asked (none: always);
    `more`: an optional override, kept under "Optional"; `address`: an IP address."""

    def __init__(self, key, label, pattern, hint, when=(), more=False, address=False):
        self.key, self.label, self.pattern, self.hint = key, label, pattern, hint
        self.when, self.more, self.address = when, more, address

    def applies(self, choice):
        return not self.when or any(all(choice[key] in values for key, values in case.items()) for case in self.when)


NAME_PATTERN = re.compile(r'[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?')
ACCOUNT_PATTERN = re.compile(r'[a-z_][a-z0-9_.-]{0,31}')
ADDRESS_PATTERN = re.compile(r'[0-9a-fA-F:.]{2,45}')
PUBLIC = {'panel': ('none',), 'ssl': ('letsencrypt', 'own')}
VPN = {'panel': ('none',), 'ssl': ('none',)}
DIRECTADMIN = {'panel': ('directadmin',)}
GUIDE_FIELDS = (
    Field('host', 'Server', NAME_PATTERN, 'the address the worker connects to over SSH'),
    Field('domain', 'Domain', NAME_PATTERN, "the site's domain (DOMAIN)"),
    Field('da_user', 'DirectAdmin user', ACCOUNT_PATTERN, "the domain's owner in DirectAdmin", when=(DIRECTADMIN,)),
    Field('vpn_address', 'Target VPN IP', ADDRESS_PATTERN, 'on the target: ip -4 addr show tun0', when=(VPN,), address=True),
    Field('public_address', 'Target public IP', ADDRESS_PATTERN, 'on the target: curl -4 -s https://ifconfig.me/ip; for the DNS records',
          when=(PUBLIC, DIRECTADMIN), address=True),
    Field('worker', 'Worker IP', ADDRESS_PATTERN, "for the firewall: over VPN – the worker's VPN address; over the internet – "
          'curl -4 -s https://ifconfig.me on the worker', address=True),
    Field('user', 'SSH user', ACCOUNT_PATTERN, 'default deploy', when=({'panel': ('none',)},), more=True),
    Field('path', 'Project directory', re.compile(r'/[A-Za-z0-9._/-]{1,200}'),
          'default /home/USER/docker/ENV', more=True),
    Field('port', 'Project port', re.compile(r'[0-9]{2,5}'), 'default 8081; stage and prod on one server – different ones',
          when=(DIRECTADMIN, VPN), more=True),
)


def guide_css():
    """Hide a field while the chosen options do not ask for it: CSS :has() on the selected options, so the form
    follows a choice at once without any script. A browser without :has() shows every field; the server ignores
    the ones that do not apply either way."""
    rules = []
    for field in GUIDE_FIELDS:
        keys = sorted({key for case in field.when for key in case})
        options = {key: [value for value, _ in next(item for item in GUIDE_OPTIONS if item[0] == key)[2]] for key in keys}
        combinations = [{}]
        for key in keys:
            combinations = [{**combination, key: value} for combination in combinations for value in options[key]]
        for combination in combinations:
            if not field.applies({**{key: None for key, _, _ in GUIDE_OPTIONS}, **combination}):
                selector = ''.join(f':has(select[name="{key}"] option[value="{value}"]:checked)'
                                   for key, value in combination.items())
                rules.append(f'.guide-form{selector} .field-{field.key}')
    return (','.join(rules) + '{display:none}') if rules else ''


