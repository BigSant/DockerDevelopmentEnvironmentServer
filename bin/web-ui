NAVIGATION = (('overview', '/', 'Apžvalga'), ('access', '/access', 'Prieiga'), ('files', '/files', 'Failai'),
              ('update', '/update', 'Atnaujinimas'),
              ('actions', '/actions', 'Veiksmai'), ('instructions', '/instructions', 'Instrukcijos'),
              ('logs', '/logs', 'Žurnalai'), ('metrics', '/worker-metrics', 'Metrikos'))


def ago(moment, now=None):
    seconds = max(0, int((now or time.time()) - moment))
    if seconds < 3600:
        return f'prieš {seconds // 60} min.'
    if seconds < 48 * 3600:
        return f'prieš {seconds // 3600} val.'
    return f'prieš {seconds // 86400} d.'


def size(count):
    for unit in ('B', 'KB', 'MB', 'GB', 'TB'):
        if count < 1024 or unit == 'TB':
            return (f'{count:.1f}'.replace('.', ',') if unit != 'B' else str(count)) + f' {unit}'
        count /= 1024


def local_time(moment):
    return time.strftime('%Y-%m-%d %H:%M', time.localtime(moment))


def badge(text, kind):
    return f'<span class="chip {kind}">{e(text)}</span>'


def lamp(kind):
    return f'<span class="lamp {kind}"></span>'


def file_text(content):
    """A backed-up file's content as text, or None when it is binary (a NUL byte or not UTF-8)."""
    if b'\0' in content:
        return None
    try:
        return content.decode('utf-8')
    except UnicodeDecodeError:
        return None


def diff_term(lines):
    """A unified diff on the dark terminal: added lines green, removed red."""
    def kind(line):
        if line.startswith(('+++', '---', '@@')):
            return ' class="hunk"'
        return ' class="add"' if line.startswith('+') else ' class="del"' if line.startswith('-') else ''
    return '<div class="term diff"><ol>' + ''.join(f'<li{kind(line)}>{e(line)}</li>' for line in lines) + '</ol></div>'


def term(text, empty='(tuščia)'):
    """Output as numbered lines on the dark terminal."""
    lines = str(text).splitlines() or [empty]
    return '<div class="term"><ol>' + ''.join(f'<li>{e(line)}</li>' for line in lines) + '</ol></div>'


def facts(rows):
    return '<table class="facts">' + ''.join(f'<tr><th>{e(name)}</th><td>{cell}</td></tr>' for name, cell in rows) + '</table>'


def unit_kind(units, name):
    unit = units.get(name)
    if not unit or unit.get('LoadState') == 'not-found':
        return 'muted'
    active = unit.get('ActiveState', '?')
    return 'ok' if active == 'active' else 'bad' if active == 'failed' else 'warn'


def installed(units, name):
    return unit_kind(units, name) != 'muted'


def unit_state(units, name):
    unit = units.get(name)
    if not unit or unit.get('LoadState') == 'not-found':
        return badge('neįdiegta', 'muted')
    active = unit.get('ActiveState', '?')
    text = {'active': 'veikia', 'inactive': 'neveikia', 'failed': 'klaida', 'activating': 'paleidžiama'}.get(active, active)
    return badge(text, unit_kind(units, name)) + (f' <span class="muted">nuo {e(unit["ActiveEnterTimestamp"])}</span>'
                                                  if active == 'active' and unit.get('ActiveEnterTimestamp') else '')


def environment_kind(state):
    """The stripe of a project environment's row: bad when something needs a look, idle when not deployed from here."""
    deploys = state.get('deploys') or {}
    newest = (state.get('backups') or {}).get('newest')
    unhealthy = any(item.get('health') == 'unhealthy' for item in state.get('containers', []))
    if (deploys.get('last') or {}).get('failed') or state.get('secrets') == 'stopped' or unhealthy or \
            (state.get('declared') and (not newest or time.time() - newest['time'] >= 26 * 3600)):
        return 'bad'
    return 'ok' if state.get('declared') else 'idle'


def level_chip(level):
    if level not in LEVEL_NOTES:
        return '<span class="lv lv-none">·</span>'
    return f'<span class="lv lv-{level}" title="{e(LEVEL_NOTES[level])}">{e(LEVEL_LABELS[level])}</span>'


def environment_order(name):
    """prod first, then stage, then any other environment by name."""
    return (('prod', 'stage').index(name) if name in ('prod', 'stage') else 2, name)


def access_columns(data):
    """[(project, env)] a key may be granted: every environment the status shows, and any a key already has."""
    found = {(entry['name'], environment) for entry in (data or {}).get('projects', [])
             for environment in entry.get('environments', {})}
    found |= {(grant['project'], grant['environment']) for key in (data or {}).get('keys', [])
              for grant in key.get('grants', []) + key.get('pulls', [])}
    return sorted(found, key=lambda item: (item[0], environment_order(item[1])))


def project_rows(columns):
    """[(project, [env, …])]: the columns grouped by project, in their order."""
    rows = []
    for project, environment in columns:
        if rows and rows[-1][0] == project:
            rows[-1][1].append(environment)
        else:
            rows.append((project, [environment]))
    return rows


ACTIVITY_WORDS = {'latest': 'kopijos vardas', 'info': 'kopijos dydis', 'get': 'parsisiuntė kopiją', 'fresh': 'užsakė šviežią kopiją',
                  'access': 'prieigos sąrašas', 'shell': 'shell', 'exec': 'komanda', 'host': 'serveris', 'docker': 'docker',
                  '': 'prisijungė'}


def key_grants(key, kind='access'):
    """{(project, env): level} of a key's access grants (make ssh) or its backups of single environments."""
    return {(grant['project'], grant['environment']): grant['level']
            for grant in (key or {}).get('grants' if kind == 'access' else 'pulls', [])}


def pull_level(key, project, environment):
    """The backups a key gets of one project environment: every project's level, or that environment's above it."""
    levels = ('none', *PULL_LEVELS)
    return max((key or {}).get('pull_all', 'none'), key_grants(key, 'backups').get((project, environment), 'none'),
               key=levels.index)


def git_line(state, tag_word=True):
    """A checkout's commit, its release tag and how far origin's master is ahead (as of its last fetch)."""
    if not state:
        return '<span class="muted">nežinoma</span>'
    text = f'<code>{e(state["commit"])}</code> '
    if tag_word:
        text += badge(state['tag'], 'ok') if state.get('tag') else badge('ne release tag\'as', 'warn')
    behind = state.get('behind')
    if behind is None:
        text += ' ' + badge('origin/master nežinomas', 'muted')
    elif behind:
        text += ' ' + badge(f'master +{behind}', 'warn')
    else:
        text += ' ' + badge('naujausias', 'ok')
    if state.get('fetched'):
        text += f' <span class="muted">patikrinta {e(ago(state["fetched"]))}</span>'
    return text


class Page:
    """Renders the pages; `token` is the CSRF token of the logged-in user."""

    def __init__(self, user, token):
        self.user, self.token = user, token

    def layout(self, title, body, refresh=None, section=None):
        head = f'<meta http-equiv="refresh" content="{int(refresh)}">' if refresh else ''
        marks = self.marks()
        navigation = ''.join(f'<a class="btn{" on" if key == section else ""}" href="{href}">{e(label)}{marks.get(key, "")}</a>'
                             for key, href, label in NAVIGATION)
        busy = running_job()
        busy = (f'<a class="busy" href="/job/{e(busy)}">{lamp("run")}veiksmas eina</a>') if busy else ''
        return (f'<!doctype html><html lang="lt"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">'
                f'{head}<title>{e(title)} · setup-server</title><link rel="stylesheet" href="/ui.css"></head><body>'
                f'<header class="top"><a class="mark" href="/">SETUP-SERVER<small>{e(socket.gethostname())}</small></a>'
                f'<nav class="nav">{navigation}</nav><span class="spacer"></span>{busy}'
                f'<div class="who"><b>{e(time.strftime("%H:%M"))}</b>{e(self.user)}</div></header>'
                f'<main><h1>{e(title)}</h1>{body}</main></body></html>')

    @staticmethod
    def marks():
        """Small marks on the navigation from the last status read (nothing is read for them): the number of
        developer keys, and whether an update waits or setup is off a release tag."""
        data = (CACHE.peek('status') or (None, None))[0]
        if not data:
            return {}
        versions = data.get('versions') or {}
        setup, server = versions.get('setup_git') or {}, versions.get('checkout_git') or {}
        marks = {'access': f'<i class="count">{len(data.get("keys", []))}</i>'}
        if setup and not setup.get('tag'):
            marks['update'] = '<i class="dot bad"></i>'
        elif setup.get('behind') or server.get('behind'):
            marks['update'] = '<i class="dot warn"></i>'
        return marks

    def hidden(self, action, fields=()):
        return (f'<input type="hidden" name="csrf" value="{e(self.token)}"><input type="hidden" name="action" value="{e(action)}">' +
                ''.join(f'<input type="hidden" name="{e(key)}" value="{e(text)}">' for key, text in fields))

    def form(self, action, title, fields, button='Peržiūrėti', note='', command='', danger=False):
        return (f'<form id="form-{e(action)}" class="action{" danger" if danger else ""}" method="post" action="/preview">'
                f'<h3>{e(title)}{f"<small>{e(command)}</small>" if command else ""}</h3>{self.hidden(action)}{fields}'
                f'<div class="form-foot"><p class="note">{note}</p><button>{e(button)}</button></div></form>')

    def button(self, action, fields, label, kind=''):
        """A one-button form (a unit's start/stop/restart): it leads to the same preview as any action."""
        return (f'<form method="post" action="/preview">{self.hidden(action, fields.items())}'
                f'<button class="{kind}">{e(label)}</button></form>')

    def unit_controls(self, unit, operations):
        return ''.join(self.button('unit', {'unit': unit, 'operation': operation}, OPERATION_TITLES[operation],
                                   'stop' if operation == 'stop' else '') for operation in operations)

    @staticmethod
    def tile(name, kind, state, detail='', controls=''):
        detail = f'<div class="detail">{detail}</div>' if detail else ''
        controls = f'<div class="controls">{controls}</div>' if controls else ''
        return f'<div class="unit is-{kind}"><div class="name">{lamp(kind)}{e(name)}</div><div class="state">{state}</div>{detail}{controls}</div>'

    # --- Overview ---
    def overview(self, data, error):
        if data is None:
            return self.layout('Apžvalga', f'<div class="callout bad"><p>Būsenos nepavyko gauti: {e(error)}</p></div>',
                               section='overview')
        units = data.get('units', {})
        versions = data.get('versions') or {}
        projects = data.get('projects', [])
        disk = data.get('disk') or {}
        share = disk['available'] / disk['size'] if disk.get('size') else None
        stats = [(len(projects), 'projektai'), (sum(len(item.get('environments', {})) for item in projects), 'aplinkos'),
                 (f'{share:.0%}' if share is not None else '?', 'laisva diske'),
                 (versions.get('installed') or '?', 'setup-server'), (versions.get('setup') or '?', 'setup')]
        body = '<div class="stats">' + ''.join(f'<div class="stat"><b>{e(number)}</b><span>{e(label)}</span></div>'
                                               for number, label in stats) + '</div>'
        body += self.attention(data)
        tiles = []
        installed_version, checkout = versions.get('installed'), versions.get('checkout')
        differs = checkout and installed_version and checkout != installed_version
        server_git, setup_git = versions.get('checkout_git') or {}, versions.get('setup_git') or {}
        tiles.append(self.tile('setup-server', 'warn' if differs or server_git.get('behind') else 'ok', e(installed_version or '?'),
                               (f'klonas: {e(checkout)}; ' if differs else '') + git_line(server_git or None, False),
                               '<a class="btn" href="/update">Atnaujinti</a>'))
        tiles.append(self.tile("setup (bendras checkout'as)", 'bad' if setup_git and not setup_git.get('tag') else
                               'warn' if not versions.get('setup') or setup_git.get('behind') else 'ok',
                               e(versions.get('setup') or '?'), git_line(setup_git or None),
                               '<a class="btn" href="/update">Atnaujinti</a>'))
        runner = 'setup-server-runner.service'
        tiles.append(self.tile("Bitbucket runner'is", unit_kind(units, runner), unit_state(units, runner),
                               controls=self.unit_controls('runner', UNIT_OPERATIONS['runner']) if installed(units, runner)
                               else '<a class="btn" href="/actions#form-install-runner">Įdiegti</a>'))
        for scope in data.get('github_runners', []):
            name = f'setup-server-github-runner@{scope}.service'
            tiles.append(self.tile(f"GitHub runner'is {scope}", unit_kind(units, name), unit_state(units, name),
                                   controls=self.unit_controls(f'github-runner@{scope}', ('start', 'stop', 'restart'))))
        for unit, label, operation in (('setup-server-backup', 'Naktinės DB kopijos', 'backup'),
                                       ('setup-server-backup-full', 'Savaitinės pilnos DB kopijos', 'backup-full'),
                                       ('setup-server-backup-files', 'Naktinės failų kopijos', 'backup-files')):
            timer, service = units.get(f'{unit}.timer', {}), units.get(f'{unit}.service', {})
            if timer and timer.get('LoadState') != 'not-found':
                result = service.get('Result')
                last = timer.get('LastTriggerUSec') or service.get('ExecMainExitTimestamp')
                kind = 'bad' if result and result != 'success' else unit_kind(units, f'{unit}.timer')
                if service.get('ActiveState') == 'activating':
                    kind = 'run'
                text = unit_state(units, f'{unit}.timer')
                if result:
                    text += ' ' + (badge('pavyko', 'ok') if result == 'success' else badge(f'nepavyko ({result})', 'bad'))
                detail = (f'paskutinė {e(last)}' if last else 'dar nevyko') + \
                    (f'<br>kita {e(timer["NextElapseUSecRealtime"])}' if timer.get('NextElapseUSecRealtime') else '')
                controls = self.button('unit', {'unit': operation, 'operation': 'start'}, 'Paleisti dabar') \
                    if installed(units, f'{unit}.service') else ''
                tiles.append(self.tile(label, kind, text, detail, controls))
            else:
                tiles.append(self.tile(label, 'muted', badge('neįdiegtos', 'muted'),
                                       controls='<a class="btn" href="/actions#form-install-backups">įdiegti</a>'))
        metrics = 'setup-server-metrics.service'
        tiles.append(self.tile('Metrikos (/metrics)', unit_kind(units, metrics), unit_state(units, metrics),
                               controls=(self.unit_controls('metrics', UNIT_OPERATIONS['metrics']) +
                                         '<a class="btn" href="/worker-metrics">Rodyti</a>') if installed(units, metrics)
                               else '<a class="btn" href="/actions#form-install-metrics">Įdiegti</a>'))
        ui = 'setup-server-ui.service'
        tiles.append(self.tile('Valdymo sąsaja', unit_kind(units, ui), unit_state(units, ui),
                               "perkrovus perskaitomi ui.env token'ai; peržiūros formos dingsta",
                               self.unit_controls('ui', UNIT_OPERATIONS['ui']) if installed(units, ui) else ''))
        if disk.get('size'):
            tiles.append(self.tile(f'Diskas ({disk["path"]})', 'ok' if share > 0.15 else 'bad',
                                   badge(f'laisva {size(disk["available"])} iš {size(disk["size"])} ({share:.0%})',
                                         'ok' if share > 0.15 else 'bad')))
        body += '<h2>Serveris</h2><div class="units">' + ''.join(tiles) + '</div>'
        body += '<h2>Projektai</h2>' + self.projects_table(data)
        if data.get('errors'):
            body += '<h2>Ko nepavyko perskaityti</h2><div class="callout warn">' + \
                ''.join(f'<p>{e(item)}</p>' for item in data['errors']) + '</div>'
        body += (f'<p class="foot">Būsena: {e(local_time(data.get("generated", time.time())))} · '
                 '<a href="/?fresh=1">Atnaujinti</a></p>')
        return self.layout('Apžvalga', body, section='overview')

    @staticmethod
    def attention(data):
        """What needs a look, gathered from the whole status: each with where to act on it."""
        items = []
        units = data.get('units', {})
        for name, unit in sorted(units.items()):
            if unit.get('ActiveState') == 'failed':
                items.append(('bad', f'{e(name)}: klaida', '/logs'))
            elif name.endswith('.service') and unit.get('Result') not in (None, '', 'success') and unit.get('LoadState') != 'not-found':
                items.append(('bad', f'{e(name)}: paskutinis paleidimas nepavyko ({e(unit["Result"])})', '/logs'))
        versions = data.get('versions') or {}
        setup = versions.get('setup_git') or {}
        if setup and not setup.get('tag'):
            items.append(('bad', 'setup ne ant release tag\'o: prod deploy\'ai neveiks', '/update'))
        updates = [label for label, state in (('setup', setup), ('setup-server', versions.get('checkout_git') or {}))
                   if state.get('behind')]
        if updates:
            items.append(('warn', 'Yra naujesnis ' + ' ir '.join(updates), '/update'))
        disk = data.get('disk') or {}
        if disk.get('size') and disk['available'] / disk['size'] <= 0.15:
            items.append(('bad', f'Diske laisva tik {size(disk["available"])}', '/'))
        for entry in data.get('projects', []):
            link = f'/project/{quote(entry["name"])}'
            for environment, state in entry.get('environments', {}).items():
                where = f'{e(entry["name"])} {e(environment)}'
                last = ((state.get('deploys') or {}).get('last') or {})
                if last.get('failed'):
                    items.append(('bad', f'{where}: deploy\'us nepavyko ({e(last["failed"])})', link))
                if state.get('secrets') == 'stopped':
                    items.append(('bad', f'{where}: secret store sustojęs', link))
                unhealthy = [item['name'] for item in state.get('containers', []) if item.get('health') == 'unhealthy']
                if unhealthy:
                    items.append(('bad', f'{where}: nesveiki {e(", ".join(unhealthy))}', link))
                newest = (state.get('backups') or {}).get('newest')
                if state.get('declared') and (not newest or time.time() - newest['time'] >= 26 * 3600):
                    items.append(('bad', f'{where}: naujausia kopija ' + (e(ago(newest['time'])) if newest else 'nėra'), link))
                newest = (state.get('files_backups') or {}).get('newest')
                if state.get('declared') and state.get('file_paths') and installed(units, 'setup-server-backup-files.timer') and \
                        (not newest or time.time() - newest['time'] >= 26 * 3600):
                    items.append(('bad', f'{where}: naujausia failų kopija ' + (e(ago(newest['time'])) if newest else 'nėra'),
                                  f'/files/{quote(entry["name"])}/{quote(environment)}'))
        if not items:
            return f'<div class="attention calm">{lamp("ok")}<span>Viskas tvarkoje: nieko, kam reikėtų dėmesio.</span></div>'
        return ('<div class="attention"><p class="attention-title">Reikia dėmesio · ' + str(len(items)) + '</p><ul>' +
                ''.join(f'<li><a href="{e(href)}">{lamp(kind)}<span>{text}</span></a></li>' for kind, text, href in items) + '</ul></div>')

    def projects_table(self, data):
        projects = data.get('projects', [])
        if not projects:
            return '<div class="empty">Projektų dar nėra. <a href="/actions#add-project">Pridėti projektą</a></div>'
        rows = []
        for entry in projects:
            environments = entry.get('environments', {}) or {'': None}
            repository = bitbucket_repository(entry.get('repository') or '')
            runs = ''
            if repository:
                found, error = pipeline_runs(entry['name'], repository)
                runs = self.run_cell(found[0], repository) if found else e(error) if error else 'dar nebuvo'
            elif entry.get('repository'):
                runs = '<span class="muted">GitHub: dar nepalaikoma</span>'
            for index, (environment, state) in enumerate(environments.items()):
                first = index == 0
                cells = (f'<td class="project"><a href="/project/{e(entry["name"])}">{e(entry["name"])}</a>'
                         f'<small>{e(entry.get("repository") or "?")}</small>'
                         f'{"<small>" + e(entry["code_repository"]) + "</small>" if entry.get("code_repository") else ""}</td>') if first \
                    else '<td></td>'
                if state is None:
                    kind = 'idle'
                    cells += '<td colspan="5" class="muted">nedeploy\'inta iš čia (nėra env/stage.env ar env/prod.env)</td>'
                else:
                    kind = environment_kind(state)
                    cells += (f'<td><span class="sign {e(environment)}">{e(environment)}</span></td>'
                              f'<td class="target">{self.target(entry, environment)}</td><td>{self.deploy_cell(state)}</td>'
                              f'<td><span class="line"><b>naktinė</b> {self.backup_cell(state)}</span>'
                              f'<span class="line"><b>pilna</b> {self.full_backup_cell(state)}</span></td>'
                              f'<td><span class="line"><b>secrets</b> {self.secrets_cell(state)}</span>'
                              f'<span class="line"><b>visi</b> {self.containers_cell(state)}</span></td>')
                cells += f'<td>{runs if first else ""}</td>'
                rows.append(f'<tr class="is-{kind}">{cells}</tr>')
        return ('<div class="scroll"><table class="board"><thead><tr><th>Projektas · repo</th><th>Aplinka</th><th>Taikinys</th>'
                '<th>Paskutinis deploy\'us</th><th>Naujausia kopija</th><th>Konteineriai</th>'
                '<th>Pipeline</th></tr></thead><tbody>' + ''.join(rows) + '</tbody></table></div>')

    @staticmethod
    def target(entry, environment):
        targets = entry.get('targets', {})
        values = {**targets.get('all', {}), **targets.get(environment, {})}
        if not values:
            return badge('neįregistruotas', 'warn')
        if values.get('DEPLOY_CONTEXT', 'default') == 'default':
            return 'šis serveris'
        return e(f'{values.get("DEPLOY_SSH", "?")}:{values.get("DEPLOY_PATH", "?")}')

    @staticmethod
    def deploy_cell(state):
        deploys = state.get('deploys')
        if not deploys:
            return '<span class="muted">nebuvo</span>'
        last = deploys['last']
        text = f'{e(last["ref"] or "?")} <span class="muted">{e(last["commit"])}</span> {e(ago(last["at"]))}'
        if last.get('failed'):
            text += ' ' + badge(f'nepavyko ({last["failed"]})', 'bad')
        else:
            text += ' ' + badge('pavyko', 'ok')
        if last.get('rollback'):
            text += ' ' + badge('rollback', 'warn')
        return text

    @staticmethod
    def backup_cell(state):
        backups = state.get('backups') or {}
        newest = backups.get('newest')
        if not newest:
            return badge('nėra', 'bad' if state.get('declared') else 'muted')
        age = time.time() - newest['time']
        return badge(ago(newest['time']), 'ok' if age < 26 * 3600 else 'bad') + \
            f' {e(size(newest["size"]))}, laikoma {backups.get("count", 0)}'

    @staticmethod
    def full_backup_cell(state):
        """The weekly full series (full-<env>): fine up to 8 days, so a missed week shows."""
        backups = state.get('full_backups') or {}
        newest = backups.get('newest')
        if not newest:
            return badge('nėra', 'muted')
        age = time.time() - newest['time']
        return badge(ago(newest['time']), 'ok' if age < 8 * 24 * 3600 else 'bad') + \
            f' {e(size(newest["size"]))}, laikoma {backups.get("count", 0)}'

    @staticmethod
    def fresh_backup_cell(state):
        backups = state.get('fresh_backups') or {}
        newest = backups.get('newest')
        if not newest:
            return '<span class="muted">nebuvo</span>'
        return f'{e(ago(newest["time"]))}, {e(size(newest["size"]))}, laikoma {backups.get("count", 0)}'

    @staticmethod
    def secrets_cell(state):
        return {'running': badge('veikia', 'ok'), 'stopped': badge('sustojęs', 'bad')}.get(
            state.get('secrets'), badge('nėra', 'warn' if state.get('declared') else 'muted'))

    @staticmethod
    def containers_cell(state):
        found = state.get('containers', [])
        if not found:
            return '<span class="muted">nėra</span>'
        running = sum(1 for item in found if item['state'] == 'running')
        unhealthy = [item['name'] for item in found if item.get('health') == 'unhealthy']
        text = badge(f'{running}/{len(found)} veikia', 'ok' if running == len(found) else 'warn')
        return text + (' ' + badge('nesveiki: ' + ', '.join(unhealthy), 'bad') if unhealthy else '')

    @staticmethod
    def run_cell(run, repository):
        state = run.get('state', {}) or {}
        result = (state.get('result') or {}).get('name') or state.get('name', '?')
        kind = 'ok' if result == 'SUCCESSFUL' else 'bad' if result in ('FAILED', 'ERROR') else 'warn'
        target = run.get('target', {}) or {}
        pattern = (target.get('selector') or {}).get('pattern') or target.get('ref_name') or ''
        link = f'{BITBUCKET_WEB}/{quote(repository[0])}/{quote(repository[1])}/pipelines/results/{int(run.get("build_number", 0))}'
        return (f'<a href="{e(link)}">#{e(run.get("build_number", "?"))}</a> {e(pattern)} {badge(result, kind)} '
                f'<span class="muted when">{e((run.get("created_on") or "")[:16].replace("T", " "))}</span>')

    # --- One project ---
    def project(self, data, name):
        entry = next((item for item in (data or {}).get('projects', []) if item.get('name') == name), None)
        if entry is None:
            return None
        body = facts([('Aplinkos repo', e(entry.get('repository') or '?')),
                      ('Kodo repo', e(entry.get('code_repository') or '—')),
                      ('Build katalogas', f'{e(data.get("root", ""))}/projects/{e(name)}/{e(entry.get("layout") or "")}'),
                      ('PROJECT_NAME', e(entry.get('project_name')))])
        for environment, state in entry.get('environments', {}).items():
            body += f'<h2><span class="sign {e(environment)}">{e(environment)}</span> aplinka</h2>'
            rows = [('Taikinys', f'{self.target(entry, environment)} <span class="muted">(Docker context {e(state["context"])})</span>'),
                    ("Paskutinis deploy'us", self.deploy_cell(state))]
            success = (state.get('deploys') or {}).get('last_success')
            if success and success != state['deploys']['last']:
                rows.append(('Paskutinis pavykęs', f'{e(success["ref"])} {e(success["commit"])} {e(ago(success["at"]))}'))
            newest = lambda key: (f' <span class="muted">{e(state[key]["newest"]["name"])}</span>'
                                  if (state.get(key) or {}).get('newest') else '')
            rows += [('Naujausia kopija', self.backup_cell(state) + newest('backups')),
                     ('Pilna kopija (savaitinė)', self.full_backup_cell(state) + newest('full_backups')),
                     ('Šviežia kopija (db-pull fresh=1)', self.fresh_backup_cell(state)),
                     *([('Failų kopija (BACKUP_FILE_PATHS)', self.files_cell(state) +
                         f' <a class="btn" href="/files/{e(quote(name))}/{e(environment)}">Peržiūrėti</a>')]
                       if state.get('file_paths') or (state.get('files_backups') or {}).get('count') else []),
                     ('Secret store', f'{self.secrets_cell(state)} <span class="muted">{e(state["compose_project"])}-secrets</span>')]
            body += facts(rows)
            if state.get('containers'):
                body += ('<table class="board"><thead><tr><th>Konteineris</th><th>Būsena</th><th>Sveikata</th><th>Status</th>'
                         '<th>Log\'ai</th></tr></thead><tbody>' + ''.join(
                             f'<tr class="is-{"ok" if item["state"] == "running" and item.get("health") != "unhealthy" else "bad"}">'
                             f'<td>{e(item["name"])}</td><td>{badge(item["state"], "ok" if item["state"] == "running" else "warn")}</td>'
                             f'<td>{badge(item.get("health") or "—", {"healthy": "ok", "unhealthy": "bad"}.get(item.get("health"), "muted"))}</td>'
                             f'<td class="muted">{e(item["status"])}</td>'
                             f'<td><a class="btn" href="/project/{e(name)}/logs?env={e(quote(environment))}&amp;container={e(quote(item["name"]))}">'
                             'Rodyti</a></td></tr>' for item in state['containers']) + '</tbody></table>')
            body += self.backup_list(state)
            body += '<div class="deck">' + self.form(
                'backup-local', 'Kopija dabar serveryje',
                f'<input type="hidden" name="project" value="{e(name)}"><input type="hidden" name="environment" value="{e(environment)}">'
                '<label class="check"><input type="checkbox" name="full" value="yes"> pilna – visų lentelių duomenys (--full)</label>',
                note='Be Bitbucket: veikia ir GitHub projektams. Peržiūra parodo secret store ir ką rotacija ištrintų.',
                command=f'setup-server-backup [--full] {name} {environment}') + '</div>'
        body += '<h2>Prieiga</h2>' + self.project_access(data, name)
        body += '<h2>Pipeline\'ai</h2>' + self.pipelines(entry)
        body += '<h2>Pašalinti</h2><div class="deck">' + self.form(
            'remove-project', f'Pašalinti build katalogą {name}',
            f'<input type="hidden" name="name" value="{e(name)}">'
            '<label class="check"><input type="checkbox" name="with_backups" value="yes"> kartu su DB kopijomis ir '
            'deploy\'ų istorija (dingsta rollback\'as)</label>',
            note='Peržiūra (--check) parodo dydį, kopijas ir ar katalogą naudoja konteineris.',
            command=f'bin/remove-project {name}', danger=True) + '</div>'
        return self.layout(f'Projektas {name}', body, section='overview')

    @staticmethod
    def backup_list(state):
        files = state.get('backup_files') or []
        if not files:
            return ''
        return (f'<details><summary>Visos kopijos ({len(files)})</summary><div class="inner"><table class="list">'
                '<tr><th>Rūšis</th><th>Failas</th><th>Laikas</th><th>Dydis</th></tr>' +
                ''.join(f'<tr><td>{badge(BACKUP_KINDS.get(item["kind"], item["kind"]), "muted")}</td><td>{e(item["name"])}</td>'
                        f'<td>{e(local_time(item["time"]))} <span class="muted">{e(ago(item["time"]))}</span></td>'
                        f'<td>{e(size(item["size"]))}</td></tr>' for item in files) +
                '</table><p class="note">Parsisiųsti: make db-pull (raktas – bin/add-backup-key).</p></div></details>')

    def pipelines(self, entry):
        repository = bitbucket_repository(entry.get('repository') or '')
        if repository is None:
            return ('<div class="callout warn"><p>Pipeline\'ų paleidimas – tik Bitbucket projektams; GitHub dar nepalaikomas. '
                    'Deploy\'us paleisk GitHub Actions; kopiją dabar – formoje „Kopija dabar serveryje“.</p></div>')
        found, error = pipeline_runs(entry['name'], repository)
        body = ''
        if error:
            body += f'<div class="callout warn"><p>Bitbucket: {e(error)}</p></div>'
        elif found:
            body += '<table class="board"><thead><tr><th>Nr. · pipeline\'as · rezultatas</th><th>Kas</th></tr></thead><tbody>' + ''.join(
                f'<tr class="is-idle"><td>{self.run_cell(run, repository)}</td>'
                f'<td>{e(((run.get("creator") or {}).get("display_name")) or "")}</td></tr>' for run in found) + '</tbody></table>'
        name, branch = e(entry['name']), e(entry.get('branch') or 'master')
        hidden = f'<input type="hidden" name="project" value="{name}">'
        branch_field = f'<label><span>Šaka (pipeline\'o apibrėžimas)</span><input type="text" name="branch" value="{branch}"></label>'
        forms = []
        extra = [f'deploy-{environment}' for environment in sorted(entry.get('environments', {}), key=environment_order)
                 if EXTRA_DEPLOY.fullmatch(f'deploy-{environment}')]
        for pipeline in (*DEPLOY_PIPELINES, *extra):
            forms.append(self.form('pipeline', pipeline_title(pipeline),
                                   hidden + f'<input type="hidden" name="pipeline" value="{pipeline}">' + branch_field +
                                   '<label><span>REF (tag\'as ar commit\'as)</span><input type="text" name="ref" autocomplete="off"></label>'
                                   '<label class="check"><input type="checkbox" name="images" value="yes"> IMAGES – perkurti image\'us</label>'
                                   '<label class="check"><input type="checkbox" name="backup" value="yes" checked> BACKUP – kopija prieš deploy\'ų</label>'
                                   '<label class="check"><input type="checkbox" name="rollback" value="yes"> ROLLBACK – grįžti į ankstesnį</label>'
                                   '<label class="check"><input type="checkbox" name="cache" value="yes"> CACHE – išvalyti cache '
                                   '(be varnelės – tik kai deploy\'us jį keičia)</label>',
                                   note='Istorija lieka Bitbucket Deployments.', command=f'custom pipeline {pipeline}'))
        forms.append(self.form('pipeline', PIPELINES['backup-now'],
                               hidden + '<input type="hidden" name="pipeline" value="backup-now">' + branch_field +
                               '<label class="check"><input type="checkbox" name="full" value="yes"> FULL – pilna kopija (visų lentelių duomenys)</label>',
                               note='Be FULL – kopija pagal lentelių registrą (kaip naktinė).', command='custom pipeline backup-now'))
        forms.append(self.form('pipeline', PIPELINES['runner-test'],
                               hidden + '<input type="hidden" name="pipeline" value="runner-test">' + branch_field,
                               command='custom pipeline runner-test'))
        return body + '<div class="deck">' + ''.join(forms) + '</div>'

    def container_logs(self, name, environment, container, lines, data, error):
        choices = ''.join(f'<option value="{count}"{" selected" if count == lines else ""}>{count} eil.</option>'
                          for count in CONTAINER_LINES)
        body = (f'<p><a href="/project/{e(name)}">← {e(name)}</a> · <span class="sign {e(environment)}">{e(environment)}</span> · '
                f'<code>docker logs --timestamps --tail {e(lines)} {e(container)}</code></p>'
                f'<form class="subnav" method="get" action="/project/{e(name)}/logs">'
                f'<input type="hidden" name="env" value="{e(environment)}"><input type="hidden" name="container" value="{e(container)}">'
                f'<select name="lines">{choices}</select><button>Rodyti</button></form>')
        problem = error or (data or {}).get('error')
        if problem:
            body += f'<div class="callout bad"><p>{e(problem)}</p></div>'
        else:
            body += term('\n'.join(data.get('lines', [])))
        return self.layout(f'Log\'ai: {container}', body, section='overview')

    def worker_metrics(self, data, error):
        problem = error or (data or {}).get('error')
        if problem:
            return self.layout('Metrikos', f'<div class="callout bad"><p>{e(problem)}</p></div>', section='metrics')
        text = data.get('text', '')
        groups = re.findall(r'(?m)^setup_metrics_group_up\{group="([^"]+)"\} (\S+)$', text)
        samples = sum(1 for line in text.splitlines() if line and not line.startswith('#'))
        body = ('<div class="stats">' + ''.join(f'<div class="stat"><b>{lamp("ok" if up == "1" else "bad")} {e(group)}</b>'
                                                f'<span>{"surinkta" if up == "1" else "trūksta"}</span></div>' for group, up in groups) +
                f'<div class="stat"><b>{samples}</b><span>reikšmės</span></div></div>'
                '<p class="note">setup-server-metrics --once kaip setup paskyra: tai, ką mato Prometheus (be token\'o).</p>' + term(text))
        return self.layout('Metrikos', body, section='metrics')

    # --- Files backups (BACKUP_FILE_PATHS) ---
    @staticmethod
    def files_environments(data):
        """(project, environment, state) of every environment with BACKUP_FILE_PATHS or files backups kept."""
        return [(entry['name'], environment, state) for entry in (data or {}).get('projects', [])
                for environment, state in sorted(entry.get('environments', {}).items(), key=lambda item: environment_order(item[0]))
                if state.get('file_paths') or (state.get('files_backups') or {}).get('count')]

    @staticmethod
    def files_cell(state):
        """The newest files backup: fine up to 26 hours, as the nightly database one."""
        backups = state.get('files_backups') or {}
        newest = backups.get('newest')
        if not newest:
            return badge('nėra', 'bad' if state.get('file_paths') and state.get('declared') else 'muted')
        age = time.time() - newest['time']
        return badge(ago(newest['time']), 'ok' if age < 26 * 3600 else 'bad') + \
            f' {e(size(newest["size"]))}, laikoma {backups.get("count", 0)}'

    @staticmethod
    def file_paths(state):
        return ' '.join(f'<code>{e(item)}</code>' for item in state.get('file_paths') or []) or '<span class="muted">nenurodyta</span>'

    def files(self, data, error):
        if data is None:
            return self.layout('Failų kopijos', f'<div class="callout bad"><p>Būsenos nepavyko gauti: {e(error)}</p></div>',
                               section='files')
        found = self.files_environments(data)
        body = ('<p class="note">Kodo medžio failai, kurių nėra git\'e (pvz. vertimai), kuriuos projektas išvardija '
                '<code>BACKUP_FILE_PATHS</code>: kas naktį worker\'is juos nuskaito iš taikinio (setup <code>make files-backup</code>) '
                'ir laiko <code>files-&lt;env&gt;-…Z.tar.gz</code> (7 dienos + 4 savaitės). Čia jie tik peržiūrimi: taikinys nekeičiamas.</p>')
        if not found:
            body += ('<div class="empty">Nė vienas projektas nenurodo BACKUP_FILE_PATHS. Įrašyk jį į projekto env/common.env '
                     '(pvz. <code>BACKUP_FILE_PATHS="modules/*/translations/"</code>).</div>')
            return self.layout('Failų kopijos', body, section='files')
        rows = ''.join(
            f'<tr class="is-{"ok" if (state.get("files_backups") or {}).get("newest") else "idle"}">'
            f'<td class="project"><a href="/project/{e(quote(name))}">{e(name)}</a></td>'
            f'<td><span class="sign {e(environment)}">{e(environment)}</span></td><td>{self.file_paths(state)}</td>'
            f'<td>{self.files_cell(state)}</td>'
            f'<td><a class="btn" href="/files/{e(quote(name))}/{e(environment)}">Kopijos</a></td></tr>'
            for name, environment, state in found)
        body += ('<div class="scroll"><table class="board"><thead><tr><th>Projektas</th><th>Aplinka</th><th>Keliai</th>'
                 '<th>Naujausia kopija</th><th></th></tr></thead><tbody>' + rows + '</tbody></table></div>')
        return self.layout('Failų kopijos', body, section='files')

    @staticmethod
    def files_archives(state):
        """The files backups of an environment, newest first."""
        return [item for item in state.get('backup_files') or [] if item.get('kind') == 'files']

    def files_environment(self, data, name, environment):
        entry = next((item for item in (data or {}).get('projects', []) if item.get('name') == name), None)
        state = (entry or {}).get('environments', {}).get(environment)
        if state is None:
            return None
        archives = self.files_archives(state)
        body = f'<p><a href="/files">← Failų kopijos</a> · <a href="/project/{e(quote(name))}">{e(name)}</a></p>'
        body += facts([('Keliai (BACKUP_FILE_PATHS)', self.file_paths(state)),
                       ('Naujausia kopija', self.files_cell(state)),
                       ('Iš kur', self.target(entry, environment))])
        if not state.get('file_paths'):
            body += ('<div class="callout warn"><p>Projektas BACKUP_FILE_PATHS šiai aplinkai nebenurodo: naujų failų kopijų '
                     'nedaroma, esamos laikomos, kol jas ištrins rotacija ar žmogus.</p></div>')
        if archives:
            body += ('<table class="list"><tr><th>Kopija</th><th>Laikas</th><th>Dydis</th></tr>' + ''.join(
                f'<tr><td><a href="/files/{e(quote(name))}/{e(environment)}/{e(item["name"])}">{e(item["name"])}</a></td>'
                f'<td>{e(local_time(item["time"]))} <span class="muted">{e(ago(item["time"]))}</span></td>'
                f'<td>{e(size(item["size"]))}</td></tr>' for item in archives) + '</table>')
        else:
            body += '<div class="empty">Failų kopijų dar nėra.</div>'
        if state.get('file_paths'):
            body += '<div class="deck">' + self.form(
                'backup-local', 'Failų kopija dabar',
                f'<input type="hidden" name="project" value="{e(name)}"><input type="hidden" name="environment" value="{e(environment)}">'
                '<input type="hidden" name="files" value="yes">',
                note='Tas pats, ką daro naktinis failų laikmatis. Taikinys tik skaitomas.',
                command=f'setup-server-backup --files {name} {environment}') + '</div>'
        return self.layout(f'Failai: {name} {environment}', body, section='files')

    @staticmethod
    def file_changes(entries, previous):
        """({path: 'nauja'|'pakeista'}, [paths gone]) of an archive's files against the previous archive, or ({}, [])."""
        if previous is None:
            return {}, []
        before = {item['path']: item for item in previous if item['type'] != 'dir'}
        marks = {}
        for item in entries:
            if item['type'] == 'dir':
                continue
            old = before.pop(item['path'], None)
            if old is None:
                marks[item['path']] = 'nauja'
            elif (old['size'], old['time'], old.get('link')) != (item['size'], item['time'], item.get('link')):
                marks[item['path']] = 'pakeista'
        return marks, sorted(before)

    def files_archive(self, name, environment, archive, listing, previous, query, changed_only, error):
        base = f'/files/{quote(name)}/{environment}'
        body = (f'<p><a href="{e(base)}">← {e(name)} <span class="sign {e(environment)}">{e(environment)}</span></a> · '
                f'<code>{e(archive)}</code></p>')
        problem = error or (listing or {}).get('error')
        if problem:
            body += f'<div class="callout bad"><p>{e(problem)}</p></div>'
            return self.layout('Failų kopija', body, section='files')
        entries = listing.get('entries', [])
        old = previous.get('entries') if previous and not previous.get('error') else None
        marks, gone = self.file_changes(entries, old)
        files = [item for item in entries if item['type'] != 'dir']
        stats = [(len(files), 'failai'), (size(sum(item['size'] for item in files)), 'nesuspausta'),
                 (size(listing.get('size', 0)), 'kopija')]
        if old is not None:
            stats += [(sum(1 for mark in marks.values() if mark == 'nauja'), 'nauji'),
                      (sum(1 for mark in marks.values() if mark == 'pakeista'), 'pakeisti'), (len(gone), 'dingo')]
        body += '<div class="stats">' + ''.join(f'<div class="stat"><b>{e(number)}</b><span>{e(label)}</span></div>'
                                               for number, label in stats) + '</div>'
        body += (f'<p class="note">Palyginta su ankstesne kopija <code>{e(previous["archive"])}</code> (dydis ir laikas).</p>'
                 if old is not None else '<p class="note">Ankstesnės kopijos nėra: palyginti nėra su kuo.</p>')
        if listing.get('truncated'):
            body += f'<div class="callout warn"><p>Kopijoje daugiau nei {len(entries)} įrašų: rodomi pirmieji.</p></div>'
        wanted = query.lower()
        shown = [item for item in files if wanted in item['path'].lower() and (not changed_only or item['path'] in marks)]
        body += (f'<div class="toolbar"><form class="search" method="get" action="{e(base)}/{e(archive)}">'
                 f'<input type="text" name="q" value="{e(query)}" placeholder="kelio dalis" autocomplete="off">'
                 f'<label class="check"><input type="checkbox" name="changed" value="1"{" checked" if changed_only else ""}> '
                 'tik nauji ir pakeisti</label><button>Rodyti</button></form></div>')
        view = f'{base}/{archive}/view?path='
        rows = ''.join(
            f'<tr><td>' + (f'<a href="{e(view + quote(item["path"]))}">{e(item["path"])}</a>' if item['type'] == 'file' else
                           f'{e(item["path"])} <span class="muted">→ {e(item.get("link") or "")}</span>') + '</td>'
            f'<td class="num">{e(size(item["size"]))}</td><td>{e(local_time(item["time"]))}</td>'
            f'<td>{badge(marks[item["path"]], "warn" if marks[item["path"]] == "pakeista" else "ok") if item["path"] in marks else ""}</td></tr>'
            for item in shown[:FILE_ROWS])
        if shown:
            body += ('<div class="scroll"><table class="list"><tr><th>Failas</th><th>Dydis</th><th>Laikas</th><th></th></tr>' +
                     rows + '</table></div>')
            if len(shown) > FILE_ROWS:
                body += f'<p class="note">Rodoma {FILE_ROWS} iš {len(shown)}: susiaurink paiešką.</p>'
        else:
            body += '<div class="empty">Nė vienas failas neatitinka.</div>'
        if gone:
            older = f'/files/{quote(name)}/{environment}/{previous["archive"]}/view?path='
            body += (f'<details><summary>Dingo nuo ankstesnės kopijos ({len(gone)})</summary><div class="inner"><table class="list">' +
                     ''.join(f'<tr><td><a href="{e(older + quote(path))}">{e(path)}</a></td></tr>' for path in gone) +
                     '</table></div></details>')
        return self.layout(f'Failų kopija {archive}', body, section='files')

    def files_view(self, name, environment, archive, path, data, previous, error):
        base = f'/files/{quote(name)}/{environment}/{archive}'
        body = f'<p><a href="{e(base)}">← <code>{e(archive)}</code></a></p>'
        problem = error or (data or {}).get('error')
        if problem:
            body += f'<div class="callout bad"><p>{e(problem)}</p></div>'
            return self.layout('Failas', body, section='files')
        content = base64.b64decode(data.get('content', ''))
        text = file_text(content)
        download = '' if data.get('truncated') else f' <a class="btn" href="{e(base)}/download?path={e(quote(path))}">Atsisiųsti</a>'
        body += facts([('Failas', f'<code>{e(path)}</code>{download}'), ('Dydis', e(size(data.get('size', 0)))),
                       ('Laikas', f'{e(local_time(data.get("time", 0)))} <span class="muted">(failo taikinyje)</span>'),
                       ('Kopija', f'<code>{e(archive)}</code> <span class="muted">{e(name)} {e(environment)}</span>')])
        if data.get('truncated'):
            body += (f'<div class="callout warn"><p>Failas didesnis nei {e(size(len(content)))}: rodoma tik pradžia, atsisiųsti '
                     'neleidžiama (serveryje: tar -xzf kopija failas).</p></div>')
        if previous is not None:
            if previous.get('error'):
                body += (f'<p class="note">Ankstesnėje kopijoje <code>{e(previous["archive"])}</code> šio failo nėra '
                         f'<span class="muted">({e(previous["error"])})</span>.</p>')
            else:
                old = file_text(base64.b64decode(previous.get('content', '')))
                if old == text and previous.get('size') == data.get('size'):
                    body += f'<p class="note">Nepasikeitė nuo ankstesnės kopijos <code>{e(previous["archive"])}</code>.</p>'
                elif old is not None and text is not None:
                    lines = list(difflib.unified_diff(old.splitlines(), text.splitlines(), previous['archive'], archive,
                                                      lineterm='', n=2))
                    body += f'<h2>Skirtumai nuo {e(previous["archive"])}</h2>' + diff_term(lines)
                else:
                    body += f'<p class="note">Skiriasi nuo ankstesnės kopijos <code>{e(previous["archive"])}</code> (dvejetainis).</p>'
        body += '<h2>Turinys</h2>' + (term(text) if text is not None else
                                      '<div class="empty">Dvejetainis failas: atsisiųsk, kad peržiūrėtum.</div>')
        return self.layout(path.rsplit('/', 1)[-1], body, section='files')

    # --- Instructions ---
    def instructions(self, choice, values, errors, given, key_known, complete):
        selects =''.join(
            f'<label><span>{e(label)}</span><select name="{key}">' +
            ''.join(f'<option value="{value}"{" selected" if choice[key] == value else ""}>{e(title)}</option>'
                    for value, title in options) + '</select></label>' for key, label, options in GUIDE_OPTIONS)
        def field(item):
            return (f'<label class="field-{item.key}"><span>{e(item.label)}</span><input type="text" name="{item.key}" '
                    f'value="{e(given[item.key])}" autocomplete="off"><small>{e(item.hint)}</small></label>')
        required = ''.join(field(item) for item in GUIDE_FIELDS if not item.more)
        optional = ''.join(field(item) for item in GUIDE_FIELDS if item.more)
        opened = ' open' if any(given[item.key] for item in GUIDE_FIELDS if item.more) else ''
        body = ('<p class="note">Ką padaryti serveryje, kad jis taptų projekto taikiniu (bin/add-project --target '
                'ENV=ssh://VARTOTOJAS@SERVERIS/KELIAS). Rodomi tik tam pasirinkimui reikalingi laukai; užpildyti įrašomi '
                'į komandas, tušti lieka DIDŽIOSIOMIS. Viso projekto pridėjimas su tikrais vardais – '
                '<a href="/instructions/example">pavyzdys</a>.</p>'
                f'<form class="action guide-form" method="get" action="/instructions"><div class="guide">{selects}{required}</div>'
                f'<details class="more"{opened}><summary>Nebūtina: pakeisti numatytas reikšmes</summary>'
                f'<div class="inner guide">{optional}</div></details>'
                '<div class="form-foot"><p class="note">Nieko nevykdo: tik parodo žingsnius.</p><button>Rodyti žingsnius</button></div></form>')
        if errors:
            body += '<div class="callout bad">' + ''.join(f'<p>{e(item)}</p>' for item in errors) + '</div>'
        if not key_known:
            body += ('<div class="callout warn"><p>Worker\'io rakto nepavyko perskaityti: SETUP_RAKTAS – '
                     f'<code>sudo cat {e(ROOT)}/.ssh/id_ed25519.pub</code>.</p></div>')
        steps = [step for step in GUIDE if step.applies(choice)]
        labels = {key: dict(options)[choice[key]] for key, _, options in GUIDE_OPTIONS}
        body += ('<div class="chosen">' + ''.join(badge(label, 'warn' if key == 'os' and choice['os'] == 'centos' else 'muted')
                                                  for key, label in labels.items()) +
                 f'<span class="note">{len(steps)} {steps_word(len(steps))}</span></div><ol class="steps">')
        for step in steps:
            link = ''
            if step.link and complete:
                target = f'{choice["env"]}=ssh://{values["user"]}@{values["host"]}{values["path"]}'
                if TARGET.fullmatch(target):
                    link = (f'<p><a class="btn" href="/actions?target={e(quote(target, safe=""))}#add-project">'
                            'Atidaryti formą su šiuo taikiniu</a></p>')
            body += guide_step(step, values, link)
        return self.layout('Instrukcijos: serverio paruošimas', body + '</ol>', section='instructions')

    def instructions_example(self):
        values = {'root': str(ROOT)}
        intro = re.sub(r'`([^`]+)`', r'<code>\1</code>', e(EXAMPLE_INTRO))
        body = (f'<p class="note">{intro}</p><p><a class="btn" href="/instructions">← Serverio paruošimas</a></p>'
                f'<div class="chosen"><span class="note">{len(EXAMPLE)} {steps_word(len(EXAMPLE))}</span></div>'
                '<ol class="steps">' + ''.join(guide_step(step, values) for step in EXAMPLE) + '</ol>')
        return self.layout('Instrukcijos: projekto pridėjimo pavyzdys', body, section='instructions')

    # --- Access: developer keys and what each may reach ---
    @staticmethod
    def seg(name, current, levels=LEVELS, none='—'):
        """A segmented choice of a level (radios: no script needed); '' is none."""
        return '<div class="seg">' + ''.join(
            f'<label class="lv-{level or "none"}"><input type="radio" name="{e(name)}" value="{e(level)}"'
            f'{" checked" if level == current else ""}><span>{e(LEVEL_LABELS.get(level, none))}</span></label>'
            for level in ('', *levels)) + '</div>'

    @staticmethod
    def last_use(key):
        last = key.get('last')
        if not last:
            return '<span class="muted">nebuvo</span>'
        what = 'prieiga' if last['log'] == 'access' else 'kopijos'
        return f'{e(ago(last["at"]))} <span class="muted">{e(what)} · {e(last["from"])}</span>'

    @staticmethod
    def summary(granted, wanted=lambda environment: True, levels=LEVELS):
        """How many environments (of one kind: prod, stage, the others) a key has at each level."""
        counts = {}
        for (_, environment), level in granted.items():
            if wanted(environment):
                counts[level] = counts.get(level, 0) + 1
        if not counts:
            return '<span class="muted">—</span>'
        return ' '.join(f'<span class="tallied"><span class="tally">{count}</span>{level_chip(level)}</span>'
                        for level, count in sorted(counts.items(), key=lambda item: -levels.index(item[0])))

    def backups_summary(self, key, granted=None):
        """Every project's backup level and the environments raised above it."""
        everything = key.get('pull_all', 'none')
        text = (f'<span class="tallied"><span class="tally">visi</span>{level_chip(everything)}</span>'
                if everything != 'none' else '')
        pulls = key_grants(key, 'backups') if granted is None else granted
        raised = {item: level for item, level in pulls.items()
                  if PULL_LEVELS.index(level) > (PULL_LEVELS.index(everything) if everything in PULL_LEVELS else -1)}
        if raised:
            text += ' ' + self.summary(raised, levels=PULL_LEVELS)
        if key.get('legacy'):
            text += ' <span class="chip muted" title="įrašas iš prieš kopijų leidimus: pakeitus taps aiškus">senas</span>'
        return text.strip() or '<span class="muted">—</span>'

    def access(self, data, error, query=''):
        if data is None:
            return self.layout('Prieiga', f'<div class="callout bad"><p>Būsenos nepavyko gauti: {e(error)}</p></div>',
                               section='access')
        keys, columns = data.get('keys', []), access_columns(data)
        wanted = query.strip().lower()
        reaches = lambda key: {project for project, _ in [*key_grants(key), *key_grants(key, 'backups')]}
        people = full_names(data)
        # The key, its person and their tools login: who it is, by any name.
        named = lambda key: wanted in ' '.join([key['name'], people.get(key['name'], ''),
                                                tool_user(data, key['name']).get('login') or '']).lower()
        shown = [key for key in keys if not wanted or named(key) or
                 any(wanted in project for project in reaches(key)) or key.get('pull_all', 'none') != 'none']
        with_access = sum(1 for key in keys if key.get('grants'))
        everything = sum(1 for key in keys if key.get('pull_all', 'none') != 'none')
        stats = [(len(keys), 'raktai'), (with_access, 'su prieiga'), (everything, 'visų kopijos'),
                 (len(project_rows(columns)), 'projektai'), (len(columns), 'aplinkos')]
        body = '<div class="stats">' + ''.join(f'<div class="stat"><b>{e(number)}</b><span>{e(label)}</span></div>'
                                               for number, label in stats) + '</div>'
        body += ('<ol class="ramp">' + ''.join(f'<li class="lv-{level}"><b>{e(LEVEL_LABELS[level])}</b>'
                                               f'<span>{e(LEVEL_NOTES[level])}</span></li>' for level in LEVELS) + '</ol>'
                 '<ol class="ramp backups">' + ''.join(f'<li class="lv-{level}"><b>{e(LEVEL_LABELS[level])}</b>'
                                                       f'<span>{e(LEVEL_NOTES[level])}</span></li>' for level in PULL_LEVELS) +
                 '</ol>')
        body += ('<div class="toolbar"><form class="search" method="get" action="/access">'
                 f'<input type="text" name="q" value="{e(query)}" placeholder="žmogus, raktas ar projektas" autocomplete="off">'
                 '<button>Ieškoti</button></form><a class="btn go" href="/access/new">+ Pridėti raktą</a></div>')
        if not keys:
            body += '<div class="empty">Raktų dar nėra. <a href="/access/new">Pridėti raktą</a></div>'
        elif not shown:
            body += f'<div class="empty">Nė vienas raktas neatitinka „{e(query)}“. <a href="/access">Visi</a></div>'
        else:
            rows = []
            for key in shown:
                granted, pulls = key_grants(key), key_grants(key, 'backups')
                if wanted and not named(key):
                    granted = {item: level for item, level in granted.items() if wanted in item[0]}
                    pulls = {item: level for item, level in pulls.items() if wanted in item[0]}
                rows.append(f'<tr class="is-{"ok" if key.get("grants") or key.get("pulls") or key.get("pull_all", "none") != "none" else "idle"}">'
                            f'<td class="keyname"><a href="/access/{e(quote(key["name"]))}">{e(people.get(key["name"]) or key["name"])}</a>'
                            f'<small>{e(key["name"] + " · " if key["name"] in people else "")}{e(key.get("fingerprint", ""))}</small></td>'
                            f'<td>{self.summary(granted, lambda name: name == "prod")}</td>'
                            f'<td>{self.summary(granted, lambda name: name == "stage")}</td>'
                            f'<td>{self.summary(granted, lambda name: name not in ("prod", "stage"))}</td>'
                            f'<td>{self.backups_summary(key, pulls)}</td><td>{self.tools_summary(data, key["name"])}</td>'
                            f'<td>{" ".join(badge(source, "muted") for source in key.get("sources", []))}</td>'
                            f'<td>{self.last_use(key)}</td></tr>')
            body += ('<div class="scroll"><table class="board keys"><thead><tr><th>Raktas</th><th>prieiga prod</th>'
                     '<th>stage</th><th>kitos</th><th>Kopijos (db-pull)</th><th>Įrankiai</th><th>Iš kur</th><th>Paskutinį kartą</th></tr></thead>'
                     '<tbody>' + ''.join(rows) + '</tbody></table></div>')
            if wanted:
                body += (f'<p class="note">Rodoma, kur raktai pasiekia „{e(query)}“ (ir raktai su visų projektų kopijomis). '
                         '<a href="/access">Visi raktai</a></p>')
        body += self.tools_section(data)
        body += '<h2>Paskutinė veikla</h2>' + self.activity_table(self.recent, keys=True, limit=25, people=people)
        body += '<p class="note"><a href="/logs#activity">Visa veikla – Žurnalai</a></p>'
        return self.layout('Prieiga', body, section='access')

    recent = None  # the activity of every key, set by the handler before access() and logs()

    @staticmethod
    def tools_summary(data, name):
        """How many project environments' tools a key's user opens, and whether it has a password."""
        user = (((data or {}).get('tool_access') or {}).get('users') or {}).get(name) or {}
        count = len(user.get('projects', []))
        if not count:
            return '<span class="muted">—</span>'
        text = f'<span class="tallied"><span class="tally">{count}</span>{level_chip("tools")}</span>'
        return text + ('' if user.get('password') else ' ' + badge('be slaptažodžio', 'warn'))

    def tools_section(self, data):
        """This server's addresses the targets let reach their tools, and how the last sending went (bin/tool-access)."""
        tools = (data or {}).get('tool_access') or {}
        addresses, managed = tools.get('allowed_ips') or [], tools.get('managed') or []
        applied = tools.get('applied') or {}
        failed = sorted(item for item, result in applied.items() if result.get('ok') is False)
        waiting = sorted(item for item, result in applied.items() if result.get('ok') is None)
        rows = [('Adresai', ' '.join(badge(address, 'muted') for address in addresses) or
                 '<span class="muted">nenurodyti: įleidžia tik projekto ALLOWED_IPS</span>'),
                ('Aplinkos su slaptažodžiais', e(len(managed)))]
        if failed:
            rows.append(('Nepritaikyta', ' '.join(f'<span class="chip bad" title="{e(applied[item].get("note", ""))}">'
                                                  f'{e(item.replace(":", " "))}</span>' for item in failed)))
        if waiting:
            rows.append(('Laukia deploy\'aus', ' '.join(f'<span class="chip warn" title="{e(applied[item].get("note", ""))}">'
                                                         f'{e(item.replace(":", " "))}</span>' for item in waiting)))
        field = (f'<label><span>setup-server adresai (IP ar CIDR, per kablelį)</span><input type="text" name="allowed_ips" '
                 f'value="{e(",".join(addresses))}" placeholder="198.51.100.7" autocomplete="off"></label>')
        return ('<h2 id="tools">Įrankių prieiga</h2>' + facts(rows) +
                '<p class="note">Kas kurios aplinkos įrankius atidaro – rakto puslapio skirtuke „Įrankiai“. Adresai pridedami prie '
                'kiekvieno įrankio IP sąrašo (ne svetainės) tose aplinkose, kurias saugo slaptažodžiai; pakeitimas galioja iš karto.</p>'
                '<div class="deck">' + self.form('tool-ips', 'Adresai', field, note='Pvz. VPN serverio viešas IP: per jį eina '
                                                 'programuotojų srautas į taikinius.', command='bin/tool-access --allowed-ips') +
                self.form('tool-apply', 'Siųsti iš naujo', '', note='Visų aplinkų vartotojų failai ir adresai – į taikinius '
                          'dar kartą (pvz. po nepavykusio siuntimo ar setup atnaujinimo).', command='bin/tool-access --apply') +
                '</div>')

    def new_key(self, data, error):
        if data is None:
            return self.layout('Naujas raktas', f'<div class="callout bad"><p>Būsenos nepavyko gauti: {e(error)}</p></div>',
                               section='access')
        keys = data.get('keys', [])
        common = max((source for key in keys for source in key.get('sources', [])),
                     key=lambda source: sum(source in key.get('sources', []) for key in keys), default='')
        text = lambda name, label, placeholder='', value='': (
            f'<label><span>{e(label)}</span><input type="text" name="{name}" value="{e(value)}" placeholder="{e(placeholder)}" '
            'autocomplete="off"></label>')
        start = lambda field, levels: ''.join(
            f'<tr><td><span class="sign {environment}">{environment}</span></td>'
            f'<td>{self.seg(f"start:{field}:{environment}", "", levels)}</td></tr>' for environment in ('prod', 'stage'))
        fields = ('<input type="hidden" name="new" value="yes">'
                  '<label><span>Viešasis raktas (.pub)</span><textarea name="public_key" spellcheck="false" '
                  'placeholder="ssh-ed25519 AAAA… vardas@kompiuteris"></textarea></label>' +
                  text('key_name', 'Vardas (žurnaluose)', 'tomas') + text('sources', 'Iš kur (VPN tinklas)', '10.8.0.0/24', common) +
                  '<p class="block-label">Kopijos (make db-pull)</p><table class="grants">'
                  f'<tr><td><span class="chip muted">visi projektai</span></td><td>{self.seg("pull_all", "", PULL_LEVELS)}</td></tr>' +
                  start('pull', PULL_LEVELS) + '</table>'
                  '<p class="block-label">Prieiga (make ssh)</p><table class="grants">' + start('grant', LEVELS) + '</table>'
                  '<p class="note">„Visi projektai“ galioja ir naujiems; prod/stage – visiems dabartiniams. Atskiriems projektams '
                  'pakeisi rakto puslapyje.</p>'
                  '<details class="more"><summary>Tik konkretūs projektai</summary><div class="inner">' +
                  text('pulls', 'Kopijos', 'shop:prod=db shop:stage=fresh') +
                  text('grants', 'Prieiga', 'shop:prod=phpfpm-readonly shop:stage=docker') + '</div></details>')
        body = '<p><a href="/access">← Prieiga</a></p><div class="deck wide">' + self.form(
            'add-backup-key', 'Naujas raktas', fields, note='Be pasirinkimų raktas nepasiekia nieko. Peržiūra parodo, ką raktas '
            'gaus; „Vykdyti“ įrašo jį į authorized_keys.', command='bin/add-backup-key') + '</div>'
        return self.layout('Naujas raktas', body, section='access')

    def key_page(self, data, name, events, query='', only_granted=False, tab='access'):
        key = next((item for item in (data or {}).get('keys', []) if item.get('name') == name), None)
        if key is None:
            return None
        tab = tab if tab in KINDS or tab == 'tools' else 'access'
        access = key_grants(key)
        person = full_names(data).get(name)
        body = ('<p><a href="/access">← Prieiga</a></p><div class="keyhead">'
                f'<div><p class="plate-name">{"žmogus · raktas " + e(name) if person else "raktas"}</p>'
                f'<p class="keytitle">{e(person or name)}</p>'
                f'<p class="plate-line">{e(key.get("type", ""))} <code>{e(key.get("fingerprint", ""))}</code></p></div>'
                f'<div><p class="plate-name">iš kur</p><p>{" ".join(badge(source, "muted") for source in key.get("sources", []))}</p></div>'
                f'<div><p class="plate-name">kopijos</p><p>{self.backups_summary(key)}</p></div>'
                f'<div><p class="plate-name">prieiga prod</p><p>{self.summary(access, lambda one: one == "prod")}</p></div>'
                f'<div><p class="plate-name">prieiga stage</p><p>{self.summary(access, lambda one: one == "stage")}</p></div>'
                f'<div><p class="plate-name">paskutinį kartą</p><p>{self.last_use(key)}</p></div></div>')
        link = lambda kind: f'/access/{quote(name)}?tab={kind}' + (f'&amp;q={quote(query)}' if query else '') + \
            ('&amp;granted=1' if only_granted else '') + '#projects'
        tabs = [(kind, label, command_) for kind, (_, _, _, label, command_) in KINDS.items()] + \
            [('tools', 'Įrankiai', 'pma, cron…')]
        body += ('<nav class="tabs" id="projects">' + ''.join(
            f'<a class="{"on" if kind == tab else ""}" href="{link(kind)}">{e(label)} <small>{e(command_)}</small></a>'
            for kind, label, command_ in tabs) + '</nav>')
        if tab == 'tools':
            body += self.tools_tab(data, name, query, only_granted)
        else:
            body += self.grants_tab(data, key, name, tab, query, only_granted)
        body += self.key_settings(key, name, events, tool_user(data, name))
        return self.layout(f'Raktas {name}' + (f' – {person}' if person else ''), body, section='access')

    def grants_tab(self, data, key, name, tab, query, only_granted):
        """A key's access (make ssh) or backups (make db-pull): every prod/stage at once, then one row per project."""
        field, levels = KINDS[tab][:2]
        granted, columns = key_grants(key, tab), access_columns(data)
        body = ''
        if tab == 'backups':
            everything = key.get('pull_all', 'none')
            body += (f'<form class="bulk everything" method="post" action="/preview">'
                     f'{self.hidden("add-backup-key", [("key_name", name), ("merge", "yes")])}'
                     f'<span class="bulk-scope"><span class="chip muted">visi projektai</span></span>'
                     f'{self.seg("pull_all", "" if everything == "none" else everything, PULL_LEVELS)}'
                     '<span class="note">ir nauji; projekto aplinkos leidimas gali būti tik didesnis</span>'
                     '<button>Peržiūrėti</button></form>')
            if key.get('legacy'):
                body += ('<div class="callout warn"><p>Šis įrašas sukurtas prieš kopijų leidimus: jis gali traukti visų projektų '
                         f'kopijas ({e(everything)}). Pirmas pakeitimas tai įrašys aiškiai („visi projektai“).</p></div>')
        # Every prod, every stage or every environment at once.
        bulk = []
        others = sorted({environment for _, environment in columns if environment not in ('prod', 'stage')})
        scopes = [('prod', '<span class="sign prod">prod</span>'), ('stage', '<span class="sign stage">stage</span>')]
        if others:
            scopes.append(('other', f'<span class="sign" title="{e(", ".join(others))}">kitos</span>'))
        for scope, label in scopes + [('all', '<span class="chip muted">visos</span>')]:
            bulk.append(f'<form class="bulk" method="post" action="/preview">'
                        f'{self.hidden("key-bulk", [("key_name", name), ("scope", scope), ("kind", tab)])}'
                        f'<span class="bulk-scope">{label}</span>{self.seg("level", "", levels)}'
                        '<span class="bulk-only"><label class="check"><input type="radio" name="only" value="all" checked> visiems projektams'
                        '</label><label class="check"><input type="radio" name="only" value="existing"> tik kur jau turi</label></span>'
                        '<button>Peržiūrėti</button></form>')
        body += ('<div class="bulkbox"><p class="block-label">Visoms iš karto</p>' + ''.join(bulk) +
                 '<p class="note">„—“ atima. Peržiūra parodo kiekvieną pasikeisiančią aplinką; nieko nekeičia, kol nespaudi '
                 '„Vykdyti“.</p></div>')
        # One row per project, its environments side by side; a filter narrows a long list. Without a level of its
        # own a project environment has every project's backups: the empty choice says which.
        everything = key.get('pull_all', 'none') if tab == 'backups' else 'none'
        inherited = f'visi: {everything}' if everything != 'none' else '—'
        wanted = query.strip().lower()
        rows = [(project, environments) for project, environments in project_rows(columns)
                if (not wanted or wanted in project) and
                (not only_granted or any((project, one) in granted for one in environments))]
        body += (f'<form class="toolbar search" method="get" action="/access/{e(quote(name))}#projects">'
                 f'<input type="hidden" name="tab" value="{e(tab)}">'
                 f'<input type="text" name="q" value="{e(query)}" placeholder="projektas" autocomplete="off">'
                 f'<label class="check"><input type="checkbox" name="granted" value="1"{" checked" if only_granted else ""}> '
                 f'tik su leidimu</label><button>Rodyti</button><span class="note">{len(rows)} iš {len(project_rows(columns))}</span></form>')
        if rows:
            def slot(project, environment, environments):
                # prod and stage keep their place in every row, so the levels line up down the list.
                if environment not in environments:
                    return '<div class="env"></div>'
                return (f'<div class="env"><span class="sign {e(environment)}">{e(environment)}</span>'
                        f'{self.seg(f"{field}:{project}:{environment}", granted.get((project, environment), ""), levels, inherited)}</div>')
            lines = ''.join(
                f'<tr><td class="id">{e(project)}</td><td><div class="envs {e(tab)}">' +
                ''.join(slot(project, environment, environments)
                        for environment in ('prod', 'stage', *[one for one in environments if one not in ('prod', 'stage')])) +
                '</div></td></tr>' for project, environments in rows)
            note = ('Keičiamos tik rodomos aplinkos; filtro paslėptos lieka kaip yra.' +
                    (' „—“ kopijoms – lieka „visi projektai“ lygis.' if tab == 'backups' else ''))
            body += (f'<form class="action" method="post" action="/preview">{self.hidden("add-backup-key", [("key_name", name), ("merge", "yes")])}'
                     f'<table class="grants projects">{lines}</table><div class="form-foot"><p class="note">{note}</p>'
                     '<button>Peržiūrėti pakeitimus</button></div></form>')
        else:
            body += '<div class="empty">Nė vienas projektas neatitinka filtro.</div>'
        return body

    def key_settings(self, key, name, events, user=None):
        """The key itself (networks, a new public key, a project not on this server yet), its person and its activity."""
        hidden = lambda fields: ''.join(f'<input type="hidden" name="{e(name_)}" value="{e(text)}">' for name_, text in fields)
        body = ''
        text = lambda field_, label, placeholder='', current='': (
            f'<label><span>{e(label)}</span><input type="text" name="{field_}" value="{e(current)}" placeholder="{e(placeholder)}" '
            'autocomplete="off"></label>')
        settings = (hidden([('key_name', name), ('merge', 'yes')]) +
                    text('sources', 'Iš kur (VPN tinklai)', '10.8.0.0/24', ','.join(key.get('sources', []))) +
                    text('pulls', 'Kopijos projektui, kurio čia dar nėra', 'shop:prod=db') +
                    text('grants', 'Prieiga projektui, kurio čia dar nėra', 'shop:prod=phpfpm-readonly') +
                    '<label><span>Naujas viešasis raktas</span><textarea name="public_key" spellcheck="false" '
                    'placeholder="tuščia – lieka dabartinis"></textarea></label>')
        user = user or {}
        person = (hidden([('key_name', name)]) +
                  text('full_name', 'Vardas ir pavardė (rodoma puslapiuose)', 'Vardenis Pavardenis', user.get('full_name') or '') +
                  text('login', 'Prisijungimo vardas įrankiams', f'{name} arba vardas@imone.lt',
                       user.get('login') if user.get('login') not in (None, name) else ''))
        body += ('<h2 id="person">Rakto nustatymai</h2><div class="deck">' +
                 self.form('tool-person', 'Žmogus', person, note='Prisijungimo vardas – vardas ar el. paštas, kurio klaus pma, '
                           f'cron ir kiti įrankiai (didžiosios ir mažosios raidės skiriasi); tuščias – rakto vardas {name}. '
                           'Žurnaluose raktas lieka raktu.', command=f'bin/tool-access --name {name} --full-name … --login …') +
                 self.form('add-backup-key', 'Tinklai, raktas', settings,
                           note='Naujas raktas galioja visoms šio rakto aplinkoms iš karto.', command=f'bin/add-backup-key --name {name}') +
                 self.form('remove-backup-key', f'Atimti raktą {name}', f'<input type="hidden" name="key_name" value="{e(name)}">',
                           note='Raktas nebegalės nei parsisiųsti kopijų, nei prisijungti prie taikinių, nei atidaryti įrankių.',
                           command=f'bin/add-backup-key --remove {name}', danger=True) + '</div>')
        body += '<h2 id="activity">Veikla</h2>' + self.activity_table(events, keys=False, limit=200)
        return body

    def tools_tab(self, data, name, query, only_granted):
        """The key's tools password and the project environments whose tools it opens (bin/tool-access): a change holds
        at once, setup-server sends the user file to the target and reloads its nginx-proxy."""
        tools = (data or {}).get('tool_access') or {}
        user = (tools.get('users') or {}).get(name) or {}
        granted = set(user.get('projects', []))
        applied = tools.get('applied') or {}
        addresses = tools.get('allowed_ips') or []
        state = (f'{badge("nustatytas", "ok")} <span class="muted">{e(user.get("password_set") or "")}</span>'
                 if user.get('password') else badge('nenustatytas', 'warn'))
        body = ('<div class="callout"><p>Pažymėtų aplinkų pma, cron, mailpit, backup, metrics ir projekto PROXY_TOOLS paklaus '
                f'vardo <code>{e(user.get("login") or name)}</code> (<a href="#person">keisti</a>) ir šio slaptažodžio. Įleidžiama tik iš setup-server adresų '
                f'({e(", ".join(addresses)) if addresses else "nenurodyti – tik projekto ALLOWED_IPS"}; '
                '<a href="/access#tools">keisti</a>). Pakeitimas galioja iš karto, be deploy\'aus.</p></div>')
        fields = (f'<input type="hidden" name="key_name" value="{e(name)}"><p>Slaptažodis: {state}</p>'
                  f'<label><span>Naujas slaptažodis ({TOOL_PASSWORD[0]}+ simbolių)</span><input type="password" name="tool_password" '
                  f'autocomplete="new-password" minlength="{TOOL_PASSWORD[0]}" maxlength="{TOOL_PASSWORD[1]}"></label>' +
                  ('<label class="check"><input type="checkbox" name="remove" value="yes"> pašalinti slaptažodį '
                   '(įrankiai neįleis niekur)</label>' if user.get('password') else ''))
        body += '<div class="deck">' + self.form(
            'tool-password', 'Įrankių slaptažodis', fields, note='Slaptažodį sugalvoja ir perduoda administratorius; serveryje '
            'lieka tik jo hash\'as.', command=f'bin/tool-access --name {name} --password -') + '</div>'
        # Every prod, every stage or every environment at once.
        columns = access_columns(data)
        others = sorted({environment for _, environment in columns if environment not in ('prod', 'stage', 'local', 'test')})
        scopes = [('prod', '<span class="sign prod">prod</span>'), ('stage', '<span class="sign stage">stage</span>')]
        if others:
            scopes.append(('other', f'<span class="sign" title="{e(", ".join(others))}">kitos</span>'))
        bulk = ''.join(f'<form class="bulk tools" method="post" action="/preview">'
                       f'{self.hidden("tool-bulk", [("key_name", name), ("scope", scope)])}'
                       f'<span class="bulk-scope">{label}</span>{self.seg("level", "", ("tools",))}<button>Peržiūrėti</button></form>'
                       for scope, label in scopes + [('all', '<span class="chip muted">visos</span>')])
        body += ('<div class="bulkbox"><p class="block-label">Visoms iš karto</p>' + bulk +
                 '<p class="note">„—“ atima. Peržiūra parodo kiekvieną pasikeisiančią aplinką; nieko nekeičia, kol nespaudi '
                 '„Vykdyti“.</p></div>')
        wanted = query.strip().lower()
        rows = [(project, environments) for project, environments in project_rows(columns)
                if (not wanted or wanted in project) and
                (not only_granted or any(f'{project}:{one}' in granted for one in environments))]
        body += (f'<form class="toolbar search" method="get" action="/access/{e(quote(name))}#projects">'
                 '<input type="hidden" name="tab" value="tools">'
                 f'<input type="text" name="q" value="{e(query)}" placeholder="projektas" autocomplete="off">'
                 f'<label class="check"><input type="checkbox" name="granted" value="1"{" checked" if only_granted else ""}> '
                 f'tik su leidimu</label><button>Rodyti</button><span class="note">{len(rows)} iš {len(project_rows(columns))}</span></form>')
        if not rows:
            return body + '<div class="empty">Nė vienas projektas neatitinka filtro.</div>'

        def slot(project, environment, environments):
            if environment not in environments:
                return '<div class="env"></div>'
            item = f'{project}:{environment}'
            result = applied.get(item) or {}
            mark = ''
            if item in granted and result.get('ok') is False:
                mark = f' <span class="chip bad" title="{e(result.get("note", ""))}">nepritaikyta</span>'
            elif item in granted and result.get('ok') is None and result:
                mark = f' <span class="chip warn" title="{e(result.get("note", ""))}">laukia deploy\'aus</span>'
            return (f'<div class="env"><span class="sign {e(environment)}">{e(environment)}</span>'
                    f'{self.seg(f"tool:{project}:{environment}", "tools" if item in granted else "", ("tools",))}{mark}</div>')
        lines = ''.join(
            f'<tr><td class="id">{e(project)}</td><td><div class="envs tools">' +
            ''.join(slot(project, environment, environments)
                    for environment in ('prod', 'stage', *[one for one in environments if one not in ('prod', 'stage')])) +
            '</div></td></tr>' for project, environments in rows)
        body += (f'<form class="action" method="post" action="/preview">{self.hidden("tool-access", [("key_name", name)])}'
                 f'<table class="grants projects">{lines}</table><div class="form-foot"><p class="note">Keičiamos tik rodomos '
                 'aplinkos. Aplinka, kurioje kas nors kada nors turėjo įrankių leidimą, lieka saugoma slaptažodžiu: atėmus '
                 'paskutinį, neįleidžiamas niekas.</p><button>Peržiūrėti pakeitimus</button></div></form>')
        return body

    @staticmethod
    def activity_table(events, keys=True, limit=100, people=None):
        """Logins, downloads, shells and commands: newest first, a shell with how long it ran and its session."""
        if events is None:
            return '<div class="callout warn"><p>Veiklos nepavyko perskaityti.</p></div>'
        if not events:
            return '<div class="empty">Veiklos dar nebuvo.</div>'
        rows = []
        for event in events[:limit]:
            words = event['request'].split()
            what = ACTIVITY_WORDS.get(event['verb'], event['verb'])
            target = ' '.join(words[1:3]) if event['verb'] not in ('', 'access') else ''
            detail = ' '.join(words[3:]).removeprefix('-- ')
            state = {'ok': badge('pavyko', 'ok'), 'failed': badge(f'kodas {event.get("exit", "?")}', 'bad'),
                     'refused': badge('atmesta', 'bad'), 'running': badge('vyksta', 'run')}.get(event['state'], '')
            reason = (f'<small class="muted">{e(event["answer"].split(":", 1)[-1].strip())}</small>'
                      if event['state'] in ('refused', 'failed') and 'exit' not in event else '')
            took = ''
            if event.get('ended') is not None:
                seconds = event['ended'] - event['at']
                took = f'{seconds // 60} min.' if seconds >= 60 else f'{seconds} s'
            session = (f'<a class="btn" href="/access/{e(quote(event["key"]))}/session/{e(event["session"])}">Seansas</a>'
                       if event.get('session') else '')
            person = (people or {}).get(event['key'])
            title = f' title="{e(event["key"])}"' if person else ''
            who = (f'<td><a href="/access/{e(quote(event["key"]))}#activity"{title}>{e(person or event["key"])}</a></td>'
                   if keys else '')
            rows.append(f'<tr class="is-{"bad" if event["state"] in ("failed", "refused") else "idle"}">'
                        f'<td class="when">{e(local_time(event["at"]))}<small>{e(ago(event["at"]))}</small></td>{who}'
                        f'<td class="what">{e(what)}{" " + level_chip(event["level"]) if event.get("level") else ""}</td>'
                        f'<td class="text">{e(target)}{f" <code>{e(detail)}</code>" if detail else ""}{reason}</td>'
                        f'<td>{state}</td><td class="num">{e(took)}</td><td>{session}</td>'
                        f'<td class="muted">{e(event["from"])}</td></tr>')
        return ('<div class="scroll"><table class="board activity"><thead><tr><th>Laikas</th>' + ('<th>Raktas</th>' if keys else '') +
                '<th>Kas</th><th>Kur · komanda</th><th>Rezultatas</th><th>Truko</th><th></th><th>Iš kur</th></tr></thead><tbody>' +
                ''.join(rows) + '</tbody></table></div>')

    def session_page(self, name, data, error, event):
        problem = error or (data or {}).get('error')
        body = f'<p><a href="/access/{e(quote(name))}#activity">← {e(name)}</a></p>'
        if event:
            body += facts([('Prašymas', f'<code>{e(event["request"])}</code>'),
                           ('Pradėta', f'{e(local_time(event["at"]))} iš {e(event["from"])}'),
                           ('Truko', e(f'{(event["ended"] - event["at"]) // 60} min.' if event.get('ended') is not None else 'vyksta ar nutrūko')),
                           ('Lygis', level_chip(event.get('level')))])
        if problem:
            body += f'<div class="callout bad"><p>{e(problem)}</p></div>'
        else:
            body += ('<p class="note">Tai, ką žmogus surinko (ne tai, ką rodė ekranas): Enter – nauja eilutė, taisymai pritaikyti, '
                     'rodyklės ir istorija praleistos.</p>' +
                     '<div class="term typed"><ol>' + ''.join(f'<li>{e(line)}</li>' for line in data.get('lines', [])) + '</ol></div>')
        return self.layout(f'Seansas {name}', body, section='access')

    # --- Update: setup-server and setup to their newest ---
    def update_page(self, data, error, where):
        if data is None:
            return self.layout('Atnaujinimas', f'<div class="callout bad"><p>Būsenos nepavyko gauti: {e(error)}</p></div>',
                               section='update')
        versions = data.get('versions') or {}
        setup, server = versions.get('setup_git'), versions.get('checkout_git')
        body = ''
        if setup and not setup.get('tag'):
            body += ('<div class="tape"><span>setup ne ant release tag\'o: make release ENV=prod atsisako, todėl prod '
                     'deploy\'ai neveiks, kol setup negrįš į tag\'ą („Atnaujinti į naujausią“ žemiau).</span></div>')
        plate_server = (f'<div class="plate"><p class="plate-name">setup-server</p><p class="plate-version">'
                        f'{e(versions.get("installed") or "?")}</p><p class="plate-line">įdiegtos kopijos</p>'
                        f'<p class="plate-line">klonas {e(versions.get("checkout") or "?")} · {git_line(server, False)}</p>')
        if where['checkout']:
            plate_server += ('<div class="plate-actions">' + self.button('update', {'latest': 'yes'}, 'Atnaujinti į naujausią', 'go') +
                             f'</div><p class="note">origin/master per {e(where["checkout"])}, vykdo {e(where["admin"])} '
                             '(jo sudo turi veikti be slaptažodžio). Kartu perrašomos įdiegtos kopijos ir patikrinama '
                             'sveikata; nepavykus grąžinama. Sąsaja persikrauna, darbas tęsiasi.</p>')
        else:
            plate_server += '<div class="callout warn"><p>Nežinomas administratoriaus klonas: paleisk sudo bin/install-ui iš jo.</p></div>'
        plate_server += '</div>'
        plate_setup = (f'<div class="plate"><p class="plate-name">setup (bendras checkout\'as)</p><p class="plate-version">'
                       f'{e(versions.get("setup") or "?")}</p><p class="plate-line">{e(ROOT)}/setup</p>'
                       f'<p class="plate-line">{git_line(setup)}</p><div class="plate-actions">' +
                       self.button('update-setup', {}, 'Atnaujinti į naujausią', 'go') + '</div>'
                       '<p class="note">Naujausias to paties MAJOR release\'as. setup kiekvieną sujungimą į master išleidžia '
                       'pats (release tag\'as po sėkmingo CI), todėl tai ir yra master. Be slaptažodžio, kaip paskyra '
                       'setup; ne tada, kai vyksta pipeline\'o žingsnis. Naujas MAJOR – tik nurodžius tag\'ą žemiau.</p></div>')
        body += '<div class="plates">' + plate_server + plate_setup + '</div>'
        body += ('<p class="note">„master +N“ – kiek naujų commit\'ų buvo origin/master per paskutinį fetch (setup – kiek '
                 'naujesnis naujausias release\'as). Kiekvienas mygtukas pirmiausia paleidžia --check: jis parsiunčia naujausią '
                 'ir parodo commit\'ų sąrašą, tik tada „Vykdyti“.</p>')
        text = lambda name, label, placeholder: (f'<label><span>{e(label)}</span><input type="text" name="{name}" '
                                                 f'placeholder="{e(placeholder)}" autocomplete="off"></label>')
        body += '<details class="more"><summary>Konkreti versija ar ref\'as</summary><div class="inner deck">' + self.form(
            'update-setup', 'setup į release tag\'ą', text('setup_tag', 'setup tag\'as', 'v2.15.0'),
            note='Tik release tag\'ai (vX.Y.Z); ir naujas MAJOR ar grįžimas atgal.', command='bin/update-setup vX.Y.Z')
        if where['checkout']:
            body += self.form('update', 'setup-server ir setup kartu',
                              text('server_ref', 'setup-server ref\'as', 'origin/master') + text('setup_ref', 'setup ref\'as', 'v2.14.1'),
                              note='Tag\'as, origin šaka ar commit\'as; su sveikatos patikra ir grąžinimu.', command='bin/update')
        body += '</div></details>'
        return self.layout('Atnaujinimas', body, section='update')

    def project_access(self, data, name):
        """Who reaches this project's environments through the worker."""
        environments = sorted({environment for project, environment in access_columns(data) if project == name},
                              key=environment_order)
        rows, people = [], full_names(data)
        for key in (data or {}).get('keys', []):
            granted = {environment: level for (project, environment), level in key_grants(key).items() if project == name}
            pulls = {environment: pull_level(key, name, environment) for environment in environments}
            if granted or any(level != 'none' for level in pulls.values()):
                rows.append(f'<tr><td class="id"><a href="/access/{e(quote(key["name"]))}?q={e(quote(name))}#projects">{e(people.get(key["name"]) or key["name"])}</a></td>' +
                            ''.join(f'<td>{level_chip(granted.get(environment))} {level_chip(pulls[environment])}</td>'
                                    for environment in environments) + '</tr>')
        if not rows:
            return '<div class="empty">Šio projekto niekas nepasiekia nei per make ssh, nei per make db-pull. <a href="/access">Prieiga</a></div>'
        return ('<table class="list"><tr><th>Raktas</th>' +
                ''.join(f'<th><span class="sign {e(environment)}">{e(environment)}</span> <small class="muted">prieiga · kopijos</small></th>'
                        for environment in environments) +
                '</tr>' + ''.join(rows) + '</table><p class="note"><a href="/access">Keisti – Prieiga</a></p>')

    # --- Actions ---
    def actions(self, scopes=(), target=''):
        def text(name, label, placeholder='', value=''):
            # autocomplete off: a browser must not fill in a value typed for another project (a build root name).
            return (f'<label><span>{e(label)}</span><input type="text" name="{name}" value="{e(value)}" '
                    f'placeholder="{e(placeholder)}" autocomplete="off"></label>')
        sections = (('add-project', 'Projektai'), ('runners', 'Runner\'iai'), ('backups', 'Kopijos'),
                    ('access', 'SSH ir metrikos'), ('units', 'Paslaugos'), ('server', 'Serveris'))
        index = ('<nav class="index"><p class="block-label">Skyriai</p>' +
                 ''.join(f'<a href="#{key}">{e(label)}</a>' for key, label in sections) +
                 '<p class="block-label">Kituose puslapiuose</p><a href="/access">Raktai ir prieiga →</a>'
                 '<a href="/update">Atnaujinimas →</a><p class="note">Kiekvienas veiksmas pirmiausia paleidžiamas su --check: '
                 'matai, ką jis darytų, ir tik tada spaudi „Vykdyti“.</p></nav>')
        body = '<h2 id="add-project">Projektai</h2><div class="deck">' + self.form(
            'add-project', 'Pridėti projektą',
            text('env_repo', 'Aplinkos repo URL', 'git@ssh.bitbucket.org:darbo-erdve/projektas.git') +
            text('code_repo', 'Kodo repo URL (nebūtina)', 'git@ssh.bitbucket.org:darbo-erdve/kodas.git') +
            text('name', 'Vardas (nebūtina)', 'numatyta – repo vardas') +
            '<label><span>Taikinys (po vieną eilutėje)</span><textarea name="targets" placeholder="local&#10;local:/home/vartotojas/projektas&#10;prod=ssh://deploy@shop.example/home/deploy/shop">'
            f'{e(target)}</textarea></label>'
            '<label class="check"><input type="checkbox" name="shared_key" value="yes"> GitHub: paskyros raktas (--shared-key)</label>',
            note='Naujam projektui taikinys privalomas (local – šis serveris). Esamam tuščias laukas taikinio nekeičia. '
                 'Pašalinimas – projekto puslapyje.', command='bin/add-project') + '</div>'
        body += '<h2 id="runners">Runner\'iai</h2><div class="deck">' + self.form(
            'install-runner', 'Įdiegti runner\'į',
            '<label><span>Runner\'is</span><select name="provider"><option value="bitbucket">Bitbucket</option>'
            '<option value="github">GitHub Actions</option></select></label>' +
            text('runner_name', 'Vardas GitHub\'e (nebūtina)', 'numatyta – serverio vardas') +
            text('tarball', 'Archyvas (nebūtina)', 'https://… arba /kelias/runner.tar.gz') +
            text('sha256', 'Archyvo SHA-256 (GitHub)', 'būtina GitHub archyvui, kuris ne pin\'intas') +
            '<label><span>Dialogo / puslapio tekstas</span><textarea name="dialog" autocomplete="off" spellcheck="false"></textarea></label>',
            note='Įklijuok visą Bitbucket „Runner installation“ dialogo arba GitHub „New self-hosted runner“ puslapio tekstą. '
                 'Jis perduodamas per stdin, niekur neįrašomas ir nerodomas. Archyvas: Bitbucket – numatyta nuoroda iš dialogo, '
                 'GitHub – pin\'intas release\'as.', command='bin/install-runner') + '</div>'
        body += '<h2 id="backups">Kopijos</h2><div class="deck">' + self.form(
            'backup-local', 'Kopija dabar serveryje',
            text('project', 'Projektas (nebūtina)', 'tuščia – visi projektai') +
            '<label><span>Aplinka</span><select name="environment"><option value="">visos projekto</option>'
            '<option value="stage">stage</option><option value="prod">prod</option></select></label>'
            '<label class="check"><input type="checkbox" name="full" value="yes"> pilna – visų lentelių duomenys (--full)</label>'
            '<label class="check"><input type="checkbox" name="files" value="yes"> failai – BACKUP_FILE_PATHS, ne DB (--files)</label>',
            note='Tas pats, ką daro naktinis (be --full), savaitinis (su --full) ar failų (--files) laikmatis; be Bitbucket, '
                 'veikia ir GitHub projektams.',
            command='setup-server-backup [--full|--files] [PROJEKTAS [ENV]]')
        body += self.form(
            'install-backups', 'Kopijų laikmačiai',
            text('at', 'Naktinės kopijos laikas', '03:30') +
            text('full_at', 'Savaitinės pilnos diena ir laikas', 'Sun 04:30') +
            text('files_at', 'Failų kopijos laikas', 'kaip naktinės'),
            note='Naktinė – pagal lentelių registrą (7 dienos + 4 savaitės), savaitinė – visų lentelių duomenys (laikomos 2), '
                 'failų – BACKUP_FILE_PATHS keliai iš taikinio (7 dienos + 4 savaitės). Be reikšmių paliekamos įdiegtos '
                 '(numatyta 03:30, Sun 04:30, failų – kaip naktinės).', command='bin/install-backups')
        body += ('<div class="pointer"><h3>Kopijų ir prieigos raktai</h3><p class="note">Programuotojų raktai (make db-pull, '
                 'make ssh) ir kas kokią prieigą turi – atskirame puslapyje.</p><a class="btn" href="/access">Prieiga →</a></div>')
        body += '</div>'
        body += '<h2 id="access">SSH ir metrikos</h2><div class="deck">' + self.form(
            'install-ssh', 'SSH iš VPN',
            text('sources', 'Tinklai (per kablelį)', '10.8.0.0/24'),
            note='Įdiegia openssh-server, iš kitų tinklų – tik raktai, ufw taisyklė (jei ufw įjungtas). Tuščia – įdiegti tinklai.',
            command='bin/install-ssh', danger=True)
        body += self.form(
            'install-metrics', 'Worker\'io metrikos',
            text('address', 'Adresas (nebūtina)', '10.8.0.14') + text('allow', 'Leidžiami adresai', '10.8.0.20') +
            text('port', 'Port\'as (nebūtina)', '9101') +
            '<label><span>Token\'as</span><select name="token"><option value="keep">palikti, kaip yra</option>'
            '<option value="new">naujas (--new-token)</option><option value="none">be token\'o (--no-token)</option></select></label>',
            note='Nenurodyti nustatymai paliekami iš /etc/setup-server/metrics.env. <a href="/worker-metrics">Ką mato Prometheus</a>.',
