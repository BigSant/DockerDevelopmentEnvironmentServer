    Step('Passwords in Bitbucket', 'repo',
         'Repository settings → Deployments → Staging, Secured: `DATABASE_PASSWORD`, `DATABASE_ROOT_PASSWORD` and the PS keys '
         'from the existing site\'s `app/config/parameters.php` (`cookie_key`, `cookie_iv`, `new_cookie_key`, `secret`, '
         '`api_private_key`, `api_public_key`; `%%` becomes `%`, the API keys base64 – the export command is in the guide\'s '
         'step "Passwords in Bitbucket") – otherwise the encrypted values in the DB backup no longer work. The env repo, not '
         'the code repo.',
         blocks=((None, ('make deploy-variables ENV=stage names=1',)),),
         source='setup doc/lt/09-aplinkos.md "Deployment variables"'),
    Step('The first deploy and content', 'worker',
         'Pipelines → Run pipeline → `deploy-stage` (or the project\'s page): `REF` – a commit of the code repo, `IMAGES=yes`. '
         'Then the DB and the content from the existing site: `img/`, language packs, module translations, `.htaccess` (a '
         'deploy never writes them).',
         source='setup doc/lt/09-aplinkos.md (code deploys)'),
    Step('If it must be undone', 'worker',
         'Removes the build directory with `target.stage.env` and the Docker context. Does not touch: the key in the target\'s '
         '`authorized_keys`, the `docker` group, the directory on the target, the host key (`sudo -u setup -H ssh-keygen -R '
         'server.example.lt`) and the access keys.',
         blocks=((None, ('sudo bin/remove-project --check shop_docker', 'sudo bin/remove-project shop_docker')),),
         source='README "Steps", step 5'),
)


def guide_values(query, status_data):
    """(choice, values, errors, given, key known): the chosen options, the values steps fill in, what was not accepted
    and what was typed. A field the choice does not ask for is ignored."""
    choice, errors = {}, []
    for key, _, options in GUIDE_OPTIONS:
        text = query.get(key, [''])[0]
        allowed = [value for value, _ in options]
        if text and text not in allowed:
            errors.append(f'Invalid choice "{key}".')
        choice[key] = text if text in allowed else allowed[0]
    given = {}
    for field in GUIDE_FIELDS:
        text = query.get(field.key, [''])[0].strip()
        if text and field.applies(choice):
            valid = field.pattern.fullmatch(text) and '..' not in text and (field.key != 'port' or 1 <= int(text) <= 65535)
            if valid and field.address:
                try:
                    ipaddress.ip_address(text)
                except ValueError:
                    valid = False
            if not valid:
                errors.append(f'Invalid value in the field "{field.label}": {text[:60]}')
                text = ''
        given[field.key] = text
    directadmin, private = choice['panel'] == 'directadmin', choice['panel'] == 'none' and choice['ssl'] == 'none'
    public = choice['panel'] == 'none' and not private
    applies = lambda key: next(field for field in GUIDE_FIELDS if field.key == key).applies(choice)
    pick = lambda key: given[key] if applies(key) else ''
    user = (pick('da_user') or 'DA_USER') if directadmin else (pick('user') or 'deploy')
    domain = pick('domain') or 'DOMAIN'
    path = (pick('path') or f'/home/{user}/docker/{choice["env"]}').rstrip('/')
    if path.endswith('/app'):
        errors.append('The project directory cannot end in /app: app/ and data/ go into it.')
    port = '80' if public else pick('port') or '8081'
    port_ssl = '443' if public else str(int(port) + 1) if int(port) < 65535 else '8082'
    address = '127.0.0.1' if directadmin else (pick('vpn_address') or 'TARGET_VPN_IP') if private else \
        (pick('public_address') or 'TARGET_IP')
    key = (status_data or {}).get('deploy_key')
    allow = ('ALLOWED_IPS="OFFICE_IP"' if choice['env'] == 'stage' else
             'PMA_ALLOWED_IPS="OFFICE_IP"\nCRON_ALLOWED_IPS="OFFICE_IP"\nBACKUP_ALLOWED_IPS="OFFICE_IP"')
    # The form link needs real values: what the step's target is made of must be typed or derived from typed ones.
    complete = bool(pick('host') and pick('domain') and (pick('da_user') if directadmin else True))
    values = {'host': pick('host') or 'SERVER', 'user': user, 'path': path, 'domain': domain,
              'port': port, 'port_ssl': port_ssl, 'worker': pick('worker') or 'WORKER_IP', 'address': address,
              'env': choice['env'], 'key': key or 'SETUP_KEY', 'root': str(ROOT), 'distribution': choice['os'],
              'deployment': 'Production' if choice['env'] == 'prod' else 'Staging',
              'certbot_install': 'dnf install -y epel-release && dnf install -y certbot' if choice['os'] == 'centos'
              else 'apt-get install -y certbot',
              'https_line': 'HTTP_FORCE_HTTPS=off' if choice['ssl'] == 'none' else '# HTTP_FORCE_HTTPS=on (the stage/prod default)',
              'allow_lines': allow, 'public': pick('public_address') or 'TARGET_IP',
              'buffer_text': 'Stage on a shared server – a small buffer pool, so that it takes no RAM while idle.'
              if choice['env'] == 'stage' else '',
              'buffer_line': 'DATABASE_BUFFER_POOL=512M\n' if choice['env'] == 'stage' else '',
              'release': 'prod – from a release tag (REF = vX.Y.Z, setup on the vX.Y.Z tag); later ones – with BACKUP.' if choice['env'] == 'prod'
              else 'for stage any commit works.'}
    return choice, values, errors, given, key is not None, complete


def steps_word(count):
    """The plural of "step": 1 step, 2 steps."""
    return 'step' if count == 1 else 'steps'


def guide_fill(text, values):
    for key, value in values.items():
        text = text.replace('{' + key + '}', value)
    return text


def guide_step(step, values, link=''):
    """One numbered step of the guide or the example: title and where, warning tape, text, commands and source."""
    text = re.sub(r'`([^`]+)`', r'<code>\1</code>', e(guide_fill(step.text, values)))
    blocks = ''.join((f'<p class="block-label">{e(label)}</p>' if label else '') +
                     f'<pre class="cmd">{e(guide_fill(chr(10).join(lines), values))}</pre>' for label, lines in step.blocks)
    warning = f'<div class="tape"><span>{e(step.warning)}</span></div>' if step.warning else ''
    source = f'<p class="source">Source: {e(step.source)}</p>' if step.source else ''
    return (f'<li class="step{" is-warn" if step.warning else ""}"><h3>{e(guide_fill(step.title, values))}'
            f'{badge(WHERE[step.where], "muted")}</h3>{warning}<p>{text}</p>{blocks}{link}{source}</li>')


# --- HTML ----------------------------------------------------------------------------------------
def e(text):
    return html.escape(str(text), quote=True)


