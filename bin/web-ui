def ago(moment, now=None):
    seconds = max(0, int((now or time.time()) - moment))
    if seconds < 3600:
        return f'prieš {seconds // 60} min.'
    if seconds < 48 * 3600:
        return f'prieš {seconds // 3600} val.'
    return f'prieš {seconds // 86400} d.'


def size(count):
    for unit in ('B', 'KB', 'MB', 'GB', 'TB'):
        if count < 1024 or unit == 'TB':
            return (f'{count:.1f}'.replace('.', ',') if unit != 'B' else str(count)) + f' {unit}'
        count /= 1024


def local_time(moment):
    return time.strftime('%Y-%m-%d %H:%M', time.localtime(moment))


def badge(text, kind):
    return f'<span class="{kind}">{e(text)}</span>'


def unit_state(units, name):
    unit = units.get(name)
    if not unit or unit.get('LoadState') == 'not-found':
        return badge('neįdiegta', 'muted')
    active = unit.get('ActiveState', '?')
    kind = 'ok' if active == 'active' else 'bad' if active == 'failed' else 'warn'
    text = {'active': 'veikia', 'inactive': 'neveikia', 'failed': 'klaida', 'activating': 'paleidžiama'}.get(active, active)
    return badge(text, kind) + (f' <span class="muted">nuo {e(unit["ActiveEnterTimestamp"])}</span>'
                                if active == 'active' and unit.get('ActiveEnterTimestamp') else '')


class Page:
    """Renders the pages; `token` is the CSRF token of the logged-in user."""

    def __init__(self, user, token):
        self.user, self.token = user, token

    def layout(self, title, body, refresh=None):
        head = f'<meta http-equiv="refresh" content="{int(refresh)}">' if refresh else ''
        return (f'<!doctype html><html lang="lt"><head><meta charset="utf-8">{head}<title>{e(title)} · setup-server</title>'
                f'<link rel="stylesheet" href="/ui.css"></head><body><header><strong>setup-server · {e(socket.gethostname())}</strong>'
                '<a href="/">Apžvalga</a><a href="/actions">Veiksmai</a><a href="/logs">Žurnalai</a>'
                f'<span class="muted">{e(self.user)}</span></header><main><h1>{e(title)}</h1>{body}</main></body></html>')

    def form(self, action, title, fields, button='Peržiūrėti', note=''):
        return (f'<form id="form-{e(action)}" class="action" method="post" action="/preview"><h3>{e(title)}</h3>'
                f'<input type="hidden" name="csrf" value="{e(self.token)}"><input type="hidden" name="action" value="{e(action)}">'
                f'{fields}{f"<p class=note>{note}</p>" if note else ""}<button>{e(button)}</button></form>')

    # --- Overview ---
    def overview(self, data, error):
        if data is None:
            return self.layout('Apžvalga', f'<p class="bad">Būsenos nepavyko gauti: {e(error)}</p>')
        units = data.get('units', {})
        versions = data.get('versions') or {}
        rows = []
        installed, checkout = versions.get('installed'), versions.get('checkout')
        server = e(installed or '?') + (f' <span class="warn">(klonas: {e(checkout)}; '
                                        'įdiegtos kopijos atnaujinamos per bin/update)</span>'
                                        if checkout and installed and checkout != installed else '')
        rows.append(('setup-server', server))
        rows.append(('setup (bendras checkout\'as)', e(versions.get('setup') or '?') +
                     ' <a href="/actions#form-update-setup">atnaujinti</a>'))
        rows.append(("Bitbucket runner'is", unit_state(units, 'setup-server-runner.service')))
        for scope in data.get('github_runners', []):
            rows.append((f"GitHub runner'is {scope}", unit_state(units, f'setup-server-github-runner@{scope}.service')))
        timer, service = units.get('setup-server-backup.timer', {}), units.get('setup-server-backup.service', {})
        if timer and timer.get('LoadState') != 'not-found':
            result = service.get('Result')
            last = timer.get('LastTriggerUSec') or service.get('ExecMainExitTimestamp')
            text = unit_state(units, 'setup-server-backup.timer') + (f'; paskutinė {e(last)}' if last else '; dar nevyko')
            if result:
                text += ' – ' + (badge('pavyko', 'ok') if result == 'success' else badge(f'nepavyko ({result})', 'bad'))
            if timer.get('NextElapseUSecRealtime'):
                text += f'; kita {e(timer["NextElapseUSecRealtime"])}'
        else:
            text = badge('neįdiegtos', 'muted')
        rows.append(('Naktinės DB kopijos', text))
        rows.append(('Metrikos (/metrics)', unit_state(units, 'setup-server-metrics.service')))
        disk = data.get('disk')
        if disk and disk.get('size'):
            share = disk['available'] / disk['size']
            rows.append((f'Diskas ({e(disk["path"])})', badge(f'laisva {size(disk["available"])} iš {size(disk["size"])} '
                                                            f'({share:.0%})', 'ok' if share > 0.15 else 'bad')))
        body = '<h2>Serveris</h2><table>' + ''.join(f'<tr><th>{e(name)}</th><td>{cell}</td></tr>' for name, cell in rows) + '</table>'
        body += '<h2>Projektai</h2>' + self.projects_table(data)
        if data.get('errors'):
            body += '<h2>Ko nepavyko perskaityti</h2><ul>' + ''.join(f'<li class="warn">{e(item)}</li>' for item in data['errors']) + '</ul>'
        body += f'<p class="muted">Būsena: {e(local_time(data.get("generated", time.time())))}. <a href="/?fresh=1">Atnaujinti</a></p>'
        return self.layout('Apžvalga', body)

    def projects_table(self, data):
        projects = data.get('projects', [])
        if not projects:
            return '<p>Projektų dar nėra. <a href="/actions#add-project">Pridėti projektą</a></p>'
        rows = []
        for entry in projects:
            environments = entry.get('environments', {}) or {'': None}
            repository = bitbucket_repository(entry.get('repository') or '')
            runs = ''
            if repository:
                found, error = pipeline_runs(entry['name'], repository)
                runs = self.run_cell(found[0], repository) if found else e(error) if error else 'dar nebuvo'
            elif entry.get('repository'):
                runs = '<span class="muted">GitHub: dar nepalaikoma</span>'
            first = True
            for environment, state in environments.items():
                cells = ''
                if first:
                    span = len(environments)
                    cells += (f'<td rowspan="{span}"><a href="/project/{e(entry["name"])}">{e(entry["name"])}</a></td>'
                              f'<td rowspan="{span}">{e(entry.get("repository") or "?")}'
                              f'{"<br>" + e(entry["code_repository"]) if entry.get("code_repository") else ""}</td>')
                if state is None:
                    cells += '<td colspan="6" class="muted">nedeploy\'inta iš čia (nėra env/stage.env ar env/prod.env)</td>'
                else:
                    cells += (f'<td>{e(environment)}</td><td>{self.target(entry, environment)}</td><td>{self.deploy_cell(state)}</td>'
                              f'<td>{self.backup_cell(state)}</td><td>{self.secrets_cell(state)}</td><td>{self.containers_cell(state)}</td>')
                if first:
                    cells += f'<td rowspan="{len(environments)}">{runs}</td>'
                    first = False
                rows.append(f'<tr>{cells}</tr>')
        return ('<table><tr><th>Projektas</th><th>Repo</th><th>Aplinka</th><th>Taikinys</th><th>Paskutinis deploy\'us</th>'
                '<th>Naujausia kopija</th><th>Secrets</th><th>Konteineriai</th><th>Pipeline</th></tr>' + ''.join(rows) + '</table>')

    @staticmethod
    def target(entry, environment):
        targets = entry.get('targets', {})
        values = {**targets.get('all', {}), **targets.get(environment, {})}
        if not values:
            return badge('neįregistruotas', 'warn')
        if values.get('DEPLOY_CONTEXT', 'default') == 'default':
            return 'šis serveris'
        return e(f'{values.get("DEPLOY_SSH", "?")}:{values.get("DEPLOY_PATH", "?")}')

    @staticmethod
    def deploy_cell(state):
        deploys = state.get('deploys')
        if not deploys:
            return '<span class="muted">nebuvo</span>'
        last = deploys['last']
        text = f'{e(last["ref"] or "?")} <span class="muted">{e(last["commit"])}</span> {e(ago(last["at"]))}'
        if last.get('failed'):
            text += ' ' + badge(f'nepavyko ({last["failed"]})', 'bad')
        else:
            text += ' ' + badge('pavyko', 'ok')
        if last.get('rollback'):
            text += ' ' + badge('rollback', 'warn')
        return text

    @staticmethod
    def backup_cell(state):
        backups = state.get('backups') or {}
        newest = backups.get('newest')
        if not newest:
            return badge('nėra', 'bad' if state.get('declared') else 'muted')
        age = time.time() - newest['time']
        return badge(ago(newest['time']), 'ok' if age < 26 * 3600 else 'bad') + \
            f', {e(size(newest["size"]))}, laikoma {backups.get("count", 0)}'

    @staticmethod
    def secrets_cell(state):
        return {'running': badge('veikia', 'ok'), 'stopped': badge('sustojęs', 'bad')}.get(
            state.get('secrets'), badge('nėra', 'warn' if state.get('declared') else 'muted'))

    @staticmethod
    def containers_cell(state):
        found = state.get('containers', [])
        if not found:
            return '<span class="muted">nėra</span>'
        running = sum(1 for item in found if item['state'] == 'running')
        unhealthy = [item['name'] for item in found if item.get('health') == 'unhealthy']
        text = badge(f'{running}/{len(found)} veikia', 'ok' if running == len(found) else 'warn')
        return text + (' ' + badge('nesveiki: ' + ', '.join(unhealthy), 'bad') if unhealthy else '')

    @staticmethod
    def run_cell(run, repository):
        state = run.get('state', {}) or {}
        result = (state.get('result') or {}).get('name') or state.get('name', '?')
        kind = 'ok' if result == 'SUCCESSFUL' else 'bad' if result in ('FAILED', 'ERROR') else 'warn'
        target = run.get('target', {}) or {}
        pattern = (target.get('selector') or {}).get('pattern') or target.get('ref_name') or ''
        link = f'{BITBUCKET_WEB}/{quote(repository[0])}/{quote(repository[1])}/pipelines/results/{int(run.get("build_number", 0))}'
        return (f'<a href="{e(link)}">#{e(run.get("build_number", "?"))}</a> {e(pattern)} {badge(result, kind)} '
                f'<span class="muted">{e((run.get("created_on") or "")[:16].replace("T", " "))}</span>')

    # --- One project ---
    def project(self, data, name):
        entry = next((item for item in (data or {}).get('projects', []) if item.get('name') == name), None)
        if entry is None:
            return None
        body = (f'<table><tr><th>Aplinkos repo</th><td>{e(entry.get("repository") or "?")}</td></tr>'
                f'<tr><th>Kodo repo</th><td>{e(entry.get("code_repository") or "—")}</td></tr>'
                f'<tr><th>Build katalogas</th><td>{e(data.get("root", ""))}/projects/{e(name)}/{e(entry.get("layout") or "")}</td></tr>'
                f'<tr><th>PROJECT_NAME</th><td>{e(entry.get("project_name"))}</td></tr></table>')
        for environment, state in entry.get('environments', {}).items():
            body += (f'<h2>{e(environment)}</h2><table><tr><th>Taikinys</th><td>{self.target(entry, environment)}'
                     f' <span class="muted">(Docker context {e(state["context"])})</span></td></tr>'
                     f'<tr><th>Paskutinis deploy\'us</th><td>{self.deploy_cell(state)}</td></tr>')
            success = (state.get('deploys') or {}).get('last_success')
            if success and success != state['deploys']['last']:
                body += f'<tr><th>Paskutinis pavykęs</th><td>{e(success["ref"])} {e(success["commit"])} {e(ago(success["at"]))}</td></tr>'
            body += (f'<tr><th>Naujausia kopija</th><td>{self.backup_cell(state)}'
                     f'{" <span class=muted>" + e(state["backups"]["newest"]["name"]) + "</span>" if (state.get("backups") or {}).get("newest") else ""}</td></tr>'
                     f'<tr><th>Secret store</th><td>{self.secrets_cell(state)} <span class="muted">{e(state["compose_project"])}-secrets</span></td></tr></table>')
            if state.get('containers'):
                body += '<table><tr><th>Konteineris</th><th>Būsena</th><th>Sveikata</th><th>Status</th></tr>' + ''.join(
                    f'<tr><td>{e(item["name"])}</td><td>{badge(item["state"], "ok" if item["state"] == "running" else "warn")}</td>'
                    f'<td>{badge(item.get("health") or "—", {"healthy": "ok", "unhealthy": "bad"}.get(item.get("health"), "muted"))}</td>'
                    f'<td class="muted">{e(item["status"])}</td></tr>' for item in state['containers']) + '</table>'
        body += '<h2>Pipeline\'ai</h2>' + self.pipelines(entry)
        body += '<h2>Pašalinti</h2>' + self.form('remove-project', f'Pašalinti build katalogą {name}',
                                                  f'<input type="hidden" name="name" value="{e(name)}">'
                                                  '<label><input type="checkbox" name="with_backups" value="yes"> kartu su DB kopijomis ir '
                                                  'deploy\'ų istorija (dingsta rollback\'as)</label>',
                                                  note='Peržiūra (--check) parodo dydį, kopijas ir ar katalogą naudoja konteineris.')
        return self.layout(f'Projektas {name}', body)

    def pipelines(self, entry):
        repository = bitbucket_repository(entry.get('repository') or '')
        if repository is None:
            return ('<p class="muted">Pipeline\'ų paleidimas – tik Bitbucket projektams; GitHub dar nepalaikomas. '
                    'Deploy\'us paleisk GitHub Actions.</p>')
        found, error = pipeline_runs(entry['name'], repository)
        body = ''
        if error:
            body += f'<p class="warn">Bitbucket: {e(error)}</p>'
        elif found:
            body += '<table><tr><th>Nr.</th><th>Pipeline\'as</th><th>Rezultatas</th><th>Kas</th></tr>' + ''.join(
                f'<tr><td colspan="3">{self.run_cell(run, repository)}</td><td>{e(((run.get("creator") or {}).get("display_name")) or "")}</td></tr>'
                for run in found) + '</table>'
        name, branch = e(entry['name']), e(entry.get('branch') or 'master')
        hidden = f'<input type="hidden" name="project" value="{name}">'
        branch_field = f'<label><span>Šaka (pipeline\'o apibrėžimas)</span><input type="text" name="branch" value="{branch}"></label>'
        for pipeline in DEPLOY_PIPELINES:
            body += self.form('pipeline', PIPELINES[pipeline],
                              hidden + f'<input type="hidden" name="pipeline" value="{pipeline}">' + branch_field +
                              '<label><span>REF (tag\'as ar commit\'as)</span><input type="text" name="ref"></label>'
                              '<label><input type="checkbox" name="images" value="yes"> IMAGES – perkurti image\'us</label>'
                              '<label><input type="checkbox" name="backup" value="yes" checked> BACKUP – kopija prieš deploy\'ų</label>'
                              '<label><input type="checkbox" name="rollback" value="yes"> ROLLBACK – grįžti į ankstesnį</label>',
                              note=f'Custom pipeline\'as {pipeline} per Bitbucket API: istorija lieka Bitbucket Deployments.')
        for pipeline in ('backup-now', 'runner-test'):
            body += self.form('pipeline', PIPELINES[pipeline], hidden + f'<input type="hidden" name="pipeline" value="{pipeline}">' + branch_field,
                              note=f'Custom pipeline\'as {pipeline}.')
        return body

    # --- Actions ---
    def actions(self, where):
        def text(name, label, placeholder='', value=''):
            # autocomplete off: a browser must not fill in a value typed for another project (a build root name).
            return (f'<label><span>{e(label)}</span><input type="text" name="{name}" value="{e(value)}" '
                    f'placeholder="{e(placeholder)}" autocomplete="off"></label>')
        body = '<p class="note">Kiekvienas veiksmas pirmiausia paleidžiamas su --check: matai, ką jis darytų, ir tik tada spaudi „Vykdyti“.</p>'
        body += '<h2 id="add-project">Projektai</h2>' + self.form(
            'add-project', 'Pridėti projektą (bin/add-project)',
            text('env_repo', 'Aplinkos repo URL', 'git@bitbucket.org:darbo-erdve/projektas.git') +
            text('code_repo', 'Kodo repo URL (nebūtina)', 'git@bitbucket.org:darbo-erdve/kodas.git') +
            text('name', 'Vardas (palik tuščią: repo vardas, kurį randa pipeline\'as)', 'numatyta – repo vardas') +
            '<label><span>Taikinys (po vieną eilutėje)</span><textarea name="targets" placeholder="local&#10;local:/home/vartotojas/projektas&#10;prod=ssh://deploy@shop.example/home/deploy/shop"></textarea></label>'
            '<label><input type="checkbox" name="shared_key" value="yes"> GitHub: paskyros raktas (--shared-key)</label>',
            note='Naujam projektui taikinys privalomas (local – šis serveris). Esamam tuščias laukas taikinio nekeičia. Projekto pašalinimas – projekto puslapyje.')
        body += '<h2>Runner\'iai</h2>' + self.form(
            'install-runner', 'Įdiegti runner\'į (bin/install-runner)',
            '<label><span>Runner\'is</span><select name="provider"><option value="bitbucket">Bitbucket</option>'
            '<option value="github">GitHub Actions</option></select></label>' +
            text('runner_name', 'Vardas GitHub\'e (nebūtina)', 'numatyta – serverio vardas') +
            '<label><span>Dialogo / puslapio tekstas</span><textarea name="dialog" autocomplete="off" spellcheck="false"></textarea></label>',
            note='Įklijuok visą Bitbucket „Runner installation“ dialogo arba GitHub „New self-hosted runner“ puslapio tekstą. '
                 'Jis perduodamas komandai per stdin, niekur neįrašomas ir nerodomas; paslaptis lieka tik serverio atmintyje iki „Vykdyti“.')
        body += '<h2>Kopijos ir metrikos</h2>' + self.form(
            'install-backups', 'Naktinės DB kopijos (bin/install-backups)', text('at', 'Laikas (nebūtina)', '03:30'),
            note='Be laiko paliekamas įdiegtas (numatyta 03:30).')
        body += self.form(
            'install-metrics', 'Worker\'io metrikos (bin/install-metrics)',
            text('address', 'Adresas (nebūtina)', '10.8.0.14') + text('allow', 'Leidžiami adresai', '10.8.0.20') +
            text('port', 'Port\'as (nebūtina)', '9101') +
            '<label><span>Token\'as</span><select name="token"><option value="keep">palikti, kaip yra</option>'
            '<option value="new">naujas (--new-token)</option><option value="none">be token\'o (--no-token)</option></select></label>',
            note='Nenurodyti nustatymai paliekami iš /etc/setup-server/metrics.env.')
        body += self.form(
            'add-backup-key', 'Kopijų atsisiuntimo raktas (bin/add-backup-key)',
            '<label><span>Viešasis raktas (.pub)</span><textarea name="public_key" spellcheck="false"></textarea></label>' +
            text('key_name', 'Vardas', 'tomas') + text('sources', 'Iš kur (VPN tinklas)', '10.8.0.0/24'))
        body += self.form('remove-backup-key', 'Atimti kopijų raktą', text('key_name', 'Vardas', 'tomas'))
        body += self.form('list-backup-keys', 'Kopijų raktai (--list)', '', button='Rodyti')
        body += '<h2>Serveris</h2>' + self.form(
            'prepare-host', 'Paruošti serverį (bin/prepare-host)', text('setup_ref', 'setup tag\'as (nebūtina)', 'v2.6.0'),
            note='Paketai, Docker, paskyra setup, git raktas, setup checkout\'as. Esamas Docker nekeičiamas.')
        body += self.form(
            'update-setup', 'Atnaujinti setup (bin/update-setup)', text('setup_tag', 'setup tag\'as (tuščia – naujausias)', 'v2.7.0'),
            note='Tik bendras setup checkout\'as, tik release tag\'ai; be slaptažodžio. Peržiūra parodo dabartinę ir naują versiją. '
                 'Deploy\'us tai daro ir pats, kai projektui reikia naujesnio setup (tas pats MAJOR).')
        if where['checkout']:
            body += self.form(
                'update', 'Atnaujinti (bin/update)',
                text('server_ref', 'setup-server ref\'as', 'v0.3.0') + text('setup_ref', 'setup ref\'as', 'v2.6.0'),
                note=f'Vykdoma kaip {e(where["admin"])} iš {e(where["checkout"])}. Jo sudo turi veikti be slaptažodžio '
                     '(be terminalo jo paklausti negalima); kitaip – terminale. Sąsaja atnaujinimo metu persikrauna, darbas tęsiasi.')
        else:
            body += '<p class="warn">bin/update: nežinomas administratoriaus klonas (paleisk sudo bin/install-ui iš jo).</p>'
        return self.layout('Veiksmai', body)

    def invalid(self, message):
        return self.layout('Netinkami duomenys', f'<p class="bad">{e(message)}</p><p><a href="/actions">Atgal į veiksmus</a></p>')

    def preview(self, plan, code, output, pending):
        body = f'<p>Komanda: <code>{e(shlex.join(plan.check))}</code></p>'
        if plan.stdin and plan.action == 'install-runner':
            body += '<p class="note">Įklijuotas tekstas perduotas per stdin (nerodomas).</p>'
        body += f'<p>Kodas: {badge("—" if code is None else code, "ok" if code == 0 else "bad")}</p><pre>{e(output)}</pre>'
        if plan.run is None:
            return self.layout(plan.title, body)
        if pending:
            body += (f'<form method="post" action="/run"><input type="hidden" name="csrf" value="{e(self.token)}">'
                     f'<input type="hidden" name="pending" value="{e(pending)}">'
                     f'<p>Vykdys: <code>{e(shlex.join(plan.run))}</code></p><button class="run">Vykdyti</button> '
                     '<a href="/actions">Atšaukti</a></form>')
        else:
            body += '<p class="bad">Peržiūra baigėsi klaida: vykdyti negalima. Pataisyk, ką ji rodo, ir bandyk dar kartą.</p>'
        return self.layout(f'Peržiūra: {plan.title}', body)

    def pipeline_preview(self, plan, pending, token_variable):
        body = (f'<p>Bitbucket repo: <code>{e(plan.workspace)}/{e(plan.slug)}</code>; token\'as: '
                f'{e(token_variable) if token_variable else badge("nėra (" + TOKEN_VARIABLE + ")", "bad")}</p>'
                f'<p>Užklausa: <code>POST {e(bitbucket_api() + plan.path)}</code></p><pre>{e(json.dumps(plan.body, indent=2))}</pre>')
        if token_variable:
            body += (f'<form method="post" action="/run"><input type="hidden" name="csrf" value="{e(self.token)}">'
                     f'<input type="hidden" name="pending" value="{e(pending)}"><button class="run">Vykdyti</button> '
                     f'<a href="/project/{e(plan.project)}">Atšaukti</a></form>')
        return self.layout(f'Peržiūra: {plan.title}', body)

    def pipeline_result(self, plan, code, data, error):
        if error or code != 201 or not isinstance(data, dict):
            body = f'<p class="bad">Bitbucket atsakė: {e(error or f"HTTP {code}")}</p>'
        else:
            number = data.get('build_number')
            link = f'{BITBUCKET_WEB}/{quote(plan.workspace)}/{quote(plan.slug)}/pipelines/results/{int(number or 0)}'
            body = f'<p class="ok">Paleista: <a href="{e(link)}">#{e(number)}</a> ({e(plan.pipeline)}, šaka {e(plan.branch)}).</p>'
        body += f'<p><a href="/project/{e(plan.project)}">Atgal į projektą</a></p>'
        return self.layout(plan.title, body)

    def job(self, identifier, meta, result, running, output):
        if running:
            state = badge('vykdoma', 'warn')
        elif result is None:
            state = badge('nutrūko (be rezultato)', 'bad')
        else:
            state = badge(f'baigta, kodas {result["exit"]}', 'ok' if result['exit'] == 0 else 'bad')
        body = (f'<p>{state} · pradėta {e(local_time(meta["started"]))} · {e(meta["user"])}</p>'
                f'<p><code>{e(shlex.join(meta["argv"]))}</code></p><pre>{e(output)}</pre>')
        if running:
            body += '<p class="muted">Puslapis atsinaujina kas 3 s.</p>'
        return self.layout(meta.get('title', 'Veiksmas'), body, refresh=3 if running else None)

    def logs(self, actions, recent, data, error):
        body = '<h2>Paskutiniai veiksmai</h2>'
        if recent:
            body += '<table><tr><th>Pradėta</th><th>Veiksmas</th><th>Kas</th><th>Būsena</th></tr>' + ''.join(
                f'<tr><td><a href="/job/{e(name)}">{e(local_time(meta["started"]))}</a></td><td>{e(meta.get("title", ""))}</td>'
                f'<td>{e(meta["user"])}</td><td>{state}</td></tr>' for name, meta, state in recent) + '</table>'
        body += f'<h2>ui-actions.log</h2><pre>{e(actions)}</pre>'
        if data is None:
            body += f'<p class="bad">{e(error)}</p>'
        else:
            body += f'<h2>backup-pulls.log</h2><pre>{e(chr(10).join(data.get("backup_pulls", [])) or "(tuščia)")}</pre>'
            for unit, lines in data.get('journal', {}).items():
                body += f'<h2>journalctl -u {e(unit)}</h2><pre>{e(chr(10).join(lines) or "(tuščia)")}</pre>'
        return self.layout('Žurnalai', body)


# --- HTTP ----------------------------------------------------------------------------------------
class Pending:
    """Previewed actions waiting for "Vykdyti": in memory only (a restart forgets them), single use."""

    def __init__(self):
        self.lock = threading.Lock()
        self.items = {}

    def add(self, plan, user):
        key = secrets.token_urlsafe(18)
        with self.lock:
            now = time.monotonic()
            self.items = {name: item for name, item in self.items.items() if now - item[2] < PENDING_TTL}
            self.items[key] = (plan, user, now)
        return key

    def take(self, key, user):
        with self.lock:
            item = self.items.pop(key, None)
        if item and item[1] == user and time.monotonic() - item[2] < PENDING_TTL:
            return item[0]
        return None


def tail(path, limit=200):
    try:
        with open(path, 'rb') as handle:
            handle.seek(0, os.SEEK_END)
            handle.seek(max(0, handle.tell() - 256 * 1024))
            return '\n'.join(handle.read().decode('utf-8', 'replace').splitlines()[-limit:])
    except OSError as error:
        return f'({error.strerror})'


def handler(user, stored):
    csrf_key = secrets.token_bytes(32)
    verified = set()  # sha256 of Authorization headers already checked: PBKDF2 runs once per login
    pending = Pending()
    lock = threading.Lock()

    class Handler(BaseHTTPRequestHandler):
        server_version = 'setup-server-ui'
        sys_version = ''
        timeout = 60

        def reply(self, status, body, content_type='text/html; charset=utf-8', headers=()):
            data = body.encode()
            self.send_response(status)
            self.send_header('Content-Type', content_type)
            self.send_header('Content-Length', str(len(data)))
            self.send_header('Cache-Control', 'no-store')
            self.send_header('X-Frame-Options', 'DENY')
            self.send_header('X-Content-Type-Options', 'nosniff')
            # same-origin: with no-referrer a browser posts the forms with Origin: null, which the POST check refuses.
            self.send_header('Referrer-Policy', 'same-origin')
            self.send_header('Content-Security-Policy', "default-src 'none'; style-src 'self'; form-action 'self'; "
                                                        "frame-ancestors 'none'; base-uri 'none'")
            for header in headers:
                self.send_header(*header)
            self.end_headers()
            if self.command != 'HEAD':
                self.wfile.write(data)

        def client(self):
            return self.client_address[0]

        def login(self):
            """The user of a valid Basic-auth header, or None (the reply is sent)."""
            host = self.headers.get('Host', '')
            if re.sub(r':[0-9]+$', '', host) not in LOOPBACK_HOSTS:
                log(f'refused {self.client()}: Host {host[:60]!r} (400)')
                self.reply(400, 'Unexpected Host\n', 'text/plain; charset=utf-8')
                return None
            header = self.headers.get('Authorization', '')
            digest = hashlib.sha256(header.encode('utf-8', 'surrogateescape')).digest()
            with lock:
                known = digest in verified
            if not known:
                given_user, given_password = '', ''
                if header.startswith('Basic '):
                    try:
                        given_user, _, given_password = base64.b64decode(header[6:], validate=True).decode().partition(':')
                    except (ValueError, UnicodeDecodeError):
                        pass
                # Both are compared, whatever the first gives: the time tells nothing about the user name.
                user_ok = hmac.compare_digest(given_user.encode(), user.encode())
                password_ok = password_matches(given_password, stored)
                if not (user_ok and password_ok):
                    if header:
                        log(f'refused {self.client()}: wrong login (401)')
                    self.reply(401, self.page_text('Reikia prisijungti.'),
                               headers=[('WWW-Authenticate', 'Basic realm="setup-server", charset="UTF-8"')])
                    return None
                with lock:
                    if len(verified) > 64:
                        verified.clear()
                    verified.add(digest)
            return user

        @staticmethod
        def page_text(text):
            return f'<!doctype html><html lang="lt"><meta charset="utf-8"><p>{e(text)}</p></html>'

        def token(self, name):
            return hmac.new(csrf_key, b'csrf\0' + name.encode(), hashlib.sha256).hexdigest()

        def do_GET(self):
            name = self.login()
            if name is None:
                return
            page = Page(name, self.token(name))
            url = urlsplit(self.path)
            path, query = url.path, parse_qs(url.query)
            if path == '/ui.css':
                return self.reply(200, STYLE, 'text/css; charset=utf-8')
            if path == '/':
                data, error = status(fresh='fresh' in query)
                return self.reply(200, page.overview(data, error))
            match = re.fullmatch(r'/project/([a-z0-9][a-z0-9_-]{0,63})', path)
            if match:
                data, error = status(fresh='fresh' in query)
                rendered = page.project(data, match[1]) if data else page.layout('Projektas', f'<p class="bad">{e(error)}</p>')
                return self.reply(200, rendered) if rendered else self.reply(404, page.layout('Nėra projekto', ''))
            if path == '/actions':
                return self.reply(200, page.actions(installation()))
            if path == '/logs':
                recent = []
                for directory in jobs(20):
                    try:
                        meta, result, running = job_state(directory)
                    except (OSError, ValueError, KeyError):
                        continue
                    state = badge('vykdoma', 'warn') if running else badge('nutrūko', 'bad') if result is None else \
                        badge(f'kodas {result["exit"]}', 'ok' if result['exit'] == 0 else 'bad')
                    recent.append((directory.name, meta, state))
                data, error = helper('--logs', '50')
                return self.reply(200, page.logs(tail(ACTIONS_LOG), recent, data, error))
            match = re.fullmatch(r'/job/(' + JOB_ID.pattern + ')', path)
            if match and (JOBS / match[1] / 'job.json').is_file():
                meta, result, running = job_state(JOBS / match[1])
                return self.reply(200, page.job(match[1], meta, result, running, tail(JOBS / match[1] / 'output.log', 3000)))
            self.reply(404, page.layout('Nerasta', '<p><a href="/">Į apžvalgą</a></p>'))

        do_HEAD = do_GET

        def do_POST(self):
            name = self.login()
            if name is None:
                return
            origin = self.headers.get('Origin')
            if origin is not None and (urlsplit(origin).hostname or '') not in ('127.0.0.1', 'localhost', '::1'):
                log(f'refused {self.client()}: POST from Origin {origin[:60]!r} (403)')
                return self.reply(403, self.page_text('Užklausa ne iš šios sąsajos.'))
            length = self.headers.get('Content-Length', '')
            if not length.isdigit() or int(length) > BODY_LIMIT:
                return self.reply(413, self.page_text('Per didelė užklausa.'))
            fields = parse_qs(self.rfile.read(int(length)).decode('utf-8', 'replace'), keep_blank_values=True)
            form = {key: values[0] for key, values in fields.items()}
            if not hmac.compare_digest(form.get('csrf', '').encode(), self.token(name).encode()):
                log(f'refused {self.client()}: POST {urlsplit(self.path).path} without a valid CSRF token (403)')
                return self.reply(403, self.page_text('Pasenusi forma: atnaujink puslapį ir bandyk dar kartą.'))
            page = Page(name, self.token(name))
            path = urlsplit(self.path).path
            if path == '/preview':
                return self.preview(page, name, form)
            if path == '/run':
                return self.run(page, name, form)
            self.reply(404, page.layout('Nerasta', ''))

        def preview(self, page, name, form):
            builder = ACTIONS.get(form.get('action', ''))
            if builder is None:
                return self.reply(400, page.invalid('Nežinomas veiksmas.'))
            try:
                plan = builder(form, status()[0] if form.get('action') == 'pipeline' else None)
            except Invalid as error:
                return self.reply(400, page.invalid(str(error)))
            if plan.kind == 'pipeline':
                variable, _ = token_for(plan.project)
                return self.reply(200, page.pipeline_preview(plan, pending.add(plan, name), variable))
            kind = 'read' if plan.run is None else 'check'
            code, output = check(plan)
            try:
                record(name, self.client(), kind, f'{plan.action}: {shlex.join(plan.check)} -> exit {code}')
            except OSError as error:
                # Nothing runs without its line in the log: no "Vykdyti" either.
                output += f'\n\n(ui-actions.log: {error.strerror}; vykdyti negalima)'
                code = None
            key = pending.add(plan, name) if plan.run is not None and code in plan.run_codes else None
            self.reply(200, page.preview(plan, code, output, key))

        def run(self, page, name, form):
            plan = pending.take(form.get('pending', ''), name)
            if plan is None:
                return self.reply(400, page.invalid('Peržiūra nebegalioja (pasibaigė, jau vykdyta ar sąsaja persikrovė): pradėk iš naujo.'))
            if plan.kind == 'pipeline':
                return self.pipeline(page, name, plan)
            busy = running_job()
            if busy:
                return self.reply(409, page.layout('Užimta', f'<p class="warn">Dar vykdomas kitas veiksmas: '
                                                            f'<a href="/job/{e(busy)}">{e(busy)}</a>. Palauk, kol baigsis.</p>'))
            identifier = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ') + '-' + secrets.token_hex(3)
            try:
                record(name, self.client(), 'run', f'job={identifier} {plan.action}: {shlex.join(plan.run)}')
            except OSError as error:
                return self.reply(500, page.invalid(f'Veiksmų žurnalas {ACTIONS_LOG} neįrašomas ({error.strerror}): nieko nevykdyta.'))
            start_job(plan, identifier, name, self.client())
            CACHE.forget('status')
            self.send_response(303)
            self.send_header('Location', f'/job/{identifier}')
            self.send_header('Content-Length', '0')
            self.end_headers()

        def pipeline(self, page, name, plan):
            variable, token = token_for(plan.project)
            if not token:
                return self.reply(400, page.invalid(f'Nėra Bitbucket token\'o ({TOKEN_VARIABLE}).'))
            what = (f'POST {plan.path} {plan.pipeline} branch={plan.branch} ' +
                    ' '.join(f'{key}={text}' for key, text in plan.variables) + f' (token {variable})')
            try:
                record(name, self.client(), 'pipeline', f'{plan.project}: {what} (sending)')
            except OSError as error:
                return self.reply(500, page.invalid(f'Veiksmų žurnalas {ACTIONS_LOG} neįrašomas ({error.strerror}): nieko nevykdyta.'))
            code, data, error = bitbucket('POST', plan.path, token, plan.body)
            number = data.get('build_number') if isinstance(data, dict) else None
            try:
                record(name, self.client(), 'pipeline', f'{plan.project}: {what} -> ' +
                       (f'HTTP {code} #{number}' if not error else error))
            except OSError as failure:
                log(f'ui-actions.log: {failure}')
            CACHE.forget(('pipelines', plan.project))
            self.reply(200 if not error else 502, page.pipeline_result(plan, code, data, error))

        def log_message(self, format, *arguments):  # refusals and errors only (log() above)
            pass

    return Handler


class Server(ThreadingHTTPServer):
    daemon_threads = True


def main(arguments):
    if arguments[:1] == ['--job'] and len(arguments) == 2:
        return job_main(arguments[1])
    if arguments == ['--hash']:
        password = sys.stdin.readline().rstrip('\n')
        if len(password) < 12:
            log('The password needs 12+ characters')
            return 65
        print(password_hash(password))
        return 0
    if arguments not in ([], ['--check']):
        log(__doc__.split('\n\n')[-1])
        return 64
    try:
        user, stored, port = settings()
    except Refused as error:
        log(str(error))
        return CONFIGURATION_ERROR
    tokens = sorted(key for key in os.environ if key.startswith(TOKEN_VARIABLE) and os.environ[key])
    if arguments == ['--check']:
        print(f'would listen on http://{ADDRESS}:{port}/ for {user} (Bitbucket tokens: {", ".join(tokens) or "none"})')
        return 0
    try:
        server = Server((ADDRESS, port), handler(user, stored))
    except OSError as error:
        log(f'Cannot listen on {ADDRESS}:{port}: {error}')
        return 1
    log(f'listening on {ADDRESS}:{server.server_address[1]} (Bitbucket tokens: {", ".join(tokens) or "none"})')
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
