        body = f'<div class="split">{index}<div class="sections">{body}</div></div>'
        return self.layout('Actions', body, section='actions')

    # --- Runners --------------------------------------------------------------------------------
    @staticmethod
    def runner_facts(unit, busy=None):
        """State, job, boot and restarts of a runner's unit (systemctl show)."""
        boot = {'enabled': 'yes', 'disabled': 'no'}.get(unit.get('UnitFileState'), unit.get('UnitFileState') or '—')
        job = '—' if busy is None else badge('running a job', 'run') if busy else badge('idle', 'ok') \
            if unit.get('ActiveState') == 'active' else '—'
        return job, boot, unit.get('NRestarts', '0')

    def runners(self, data, error):
        if data is None:
            return self.layout('Runners', f'<div class="callout bad"><p>Could not get the status: {e(error)}</p></div>', section='runners')
        units, details = data.get('units') or {}, data.get('github_runner_details') or {}
        scopes = data.get('github_runners', [])
        groups = {}
        for scope in scopes:
            groups.setdefault((details.get(scope) or {}).get('url') or '', []).append(scope)
        unit_of = lambda scope: units.get(f'setup-server-github-runner@{scope}.service') or {}
        active = sum(1 for scope in scopes if unit_of(scope).get('ActiveState') == 'active')
        busy = sum(1 for scope in scopes if (details.get(scope) or {}).get('busy'))
        bitbucket = units.get('setup-server-runner.service') or {}
        bitbucket_installed = installed(units, 'setup-server-runner.service')
        stats = [(len(scopes), 'GitHub runners'), (active, 'running'), (busy, 'running a job'), (len(groups), 'repos and organizations'),
                 ('yes' if bitbucket_installed else 'no', 'Bitbucket runner')]
        body = '<div class="stats">' + ''.join(f'<div class="stat"><b>{e(number)}</b><span>{e(label)}</span></div>'
                                               for number, label in stats) + '</div>'
        if self.may('install-runner'):
            body += '<div class="toolbar"><a class="btn go" href="/runners/new">+ Add a runner</a></div>'
        body += '<h2>GitHub Actions</h2>'
        if not scopes:
            body += '<div class="empty">No GitHub runners yet. <a href="/runners/new">Add</a></div>'
        for url, members in sorted(groups.items()):
            base = runner_base(url)
            members.sort(key=lambda scope: (runner_instance(scope, base) or 99, scope))
            label = url.replace('https://github.com/', '') if url else 'unknown organization or repo'
            link = f' <a class="muted" href="{e(github_runners_page(url))}">GitHub settings ↗</a>' if github_runners_page(url) else ''
            rows = ''
            for scope in members:
                info, unit = details.get(scope) or {}, unit_of(scope)
                job, boot, restarts = self.runner_facts(unit, info.get('busy'))
                rows += (f'<tr><td><a href="/runners/github/{quote(scope)}">{e(info.get("name") or scope)}</a>'
                         f'<small class="muted"> {e(scope)}</small></td>'
                         f'<td>{unit_state(units, f"setup-server-github-runner@{scope}.service")}</td><td>{job}</td>'
                         f'<td>{e(info.get("version") or "?")}</td><td>{e(boot)}</td><td>{e(restarts)}</td>'
                         f'<td><div class="controls">{self.unit_controls(f"github-runner@{scope}", ("start", "stop", "restart"))}</div></td></tr>')
            body += (f'<h3>{e(label)} <small>{len(members)} runner{"" if len(members) == 1 else "s"}</small>{link}</h3>'
                     '<div class="scroll"><table class="list runners"><tr><th>Runner</th><th>State</th><th>Job</th><th>Version</th>'
                     f'<th>On boot</th><th>Restarts</th><th>Control</th></tr>{rows}</table></div>')
        body += '<h2>Bitbucket Pipelines</h2>'
        if bitbucket_installed:
            job, boot, restarts = self.runner_facts(bitbucket)
            body += ('<div class="scroll"><table class="list runners"><tr><th>Runner</th><th>State</th><th>On boot</th><th>Restarts</th>'
                     f'<th>Control</th></tr><tr><td><a href="/runners/bitbucket">Bitbucket runner</a>'
                     f'<small class="muted"> setup-server-runner</small></td><td>{unit_state(units, "setup-server-runner.service")}</td>'
                     f'<td>{e(boot)}</td><td>{e(restarts)}</td><td><div class="controls">'
                     f'{self.unit_controls("runner", UNIT_OPERATIONS["runner"])}</div></td></tr></table></div>')
        else:
            body += '<div class="empty">The Bitbucket runner is not installed. <a href="/runners/new#bitbucket">Install</a></div>'
        body += ('<p class="note">Job – whether the runner is running a GitHub job right now (its Runner.Worker process). On boot – '
                 'whether the service starts when the server boots. Stopping or restarting a runner that runs a job cuts the job off.</p>')
        return self.layout('Runners', body, section='runners')

    def runner_install_fields(self, provider, url='', name='', instances=(), dialog=''):
        text = lambda key, label, placeholder='', current='': (
            f'<label><span>{e(label)}</span><input type="text" name="{key}" value="{e(current)}" placeholder="{e(placeholder)}" '
            'autocomplete="off"></label>')
        fields = f'<input type="hidden" name="provider" value="{provider}">'
        if provider == 'github':
            fields += text('runner_name', 'Name on GitHub', 'default – the server name', name)
            if instances:
                fields += ('<label><span>Instance</span><select name="instance">' +
                           ''.join(f'<option value="{number}">{number}</option>' for number in instances) + '</select></label>')
            else:
                fields += ('<label><span>Instance</span><select name="instance"><option value="">first (1)</option>' +
                           ''.join(f'<option value="{number}">{number}</option>' for number in range(2, 10)) + '</select></label>')
            fields += text('sha256', 'Archive SHA-256', 'only for an archive that is not pinned')
        fields += text('tarball', 'Archive (optional)', 'https://… or /path/runner.tar.gz')
        label = 'The line from the GitHub page' if provider == 'github' else 'The Bitbucket dialog text'
        return fields + (f'<label><span>{label}</span><textarea name="dialog" autocomplete="off" spellcheck="false">'
                         f'{e(dialog)}</textarea></label>')

    def runner_new(self):
        steps = ('<ol class="steps-list"><li>GitHub: the organization\'s or repo\'s <b>Settings → Actions → Runners → New self-hosted '
                 'runner</b>, Linux, x64.</li><li>Copy the line <code>./config.sh --url … --token …</code> (the token '
                 'is valid for an hour and registers once).</li><li>Paste it below. The archive – the pinned release, '
                 'checked by SHA-256; the runner gets the label <code>setup.build</code>.</li></ol>')
        body = ('<h2 id="github">GitHub Actions</h2>' + steps + '<div class="deck">' +
                self.form('install-runner', 'New GitHub runner', self.runner_install_fields('github'),
                          note='One runner per organization or repo; instance 2–9 – an extra runner of the same organization '
                               'or repo for parallel jobs (needs its own name).',
                          command='bin/install-runner --provider github') + '</div>')
        body += ('<h2 id="bitbucket">Bitbucket Pipelines</h2><p class="note">Bitbucket: <b>Workspace settings → Runners → Add runner</b> '
                 '(Linux Shell). Paste the whole dialog text: the download line and the <code>./start.sh …</code> command. One '
                 'Bitbucket runner runs on the server; a new one replaces the existing one.</p><div class="deck">' +
                 self.form('install-runner', 'Bitbucket runner', self.runner_install_fields('bitbucket'),
                           note='The text is passed on stdin, never written anywhere or shown.', command='bin/install-runner') + '</div>')
        body += '<p><a href="/runners">← Runners</a></p>'
        return self.layout('Add a runner', body, section='runners')

    def github_runner(self, data, scope):
        scopes = data.get('github_runners', [])
        if scope not in scopes:
            return None
        units, info = data.get('units') or {}, (data.get('github_runner_details') or {}).get(scope) or {}
        unit_name = f'setup-server-github-runner@{scope}.service'
        unit, url = units.get(unit_name) or {}, info.get('url') or ''
        job, boot, restarts = self.runner_facts(unit, info.get('busy'))
        settings = github_runners_page(url)
        agent = info.get('agent_id')
        rows = [('Name on GitHub', e(info.get('name') or '?')),
                ('Organization or repo', f'<a href="{e(url)}">{e(url.replace("https://github.com/", ""))} ↗</a>' if url else '?'),
                ('State', unit_state(units, unit_name)), ('Job now', job), ('Version', e(info.get('version') or '?')),
                ('Starts on boot', e(boot)), ('Restarts', e(restarts)),
                ('GitHub ID', f'<a href="{e(github_runners_page(url, f"/{agent}"))}">{agent} ↗</a>' if agent and settings else '—'),
                ('Service', f'<code>{e(unit_name)}</code>'),
                ('Directory', f'<code>{e(data.get("root", ""))}/github-runner/{e(scope)}</code>')]
        body = facts(rows)
        controls = self.unit_controls(f'github-runner@{scope}', ('start', 'stop', 'restart'))
        if controls:
            body += f'<div class="controls">{controls}</div>'
        base = runner_base(url)
        used = {runner_instance(item, base) for item in scopes}
        free = [number for number in range(2, 10) if number not in used]
        first = (data.get('github_runner_details') or {}).get(base) or {}
        stem = re.sub(r'-[2-9]$', '', first.get('name') or info.get('name') or '')
        body += '<h2>Change</h2><div class="deck">'
        if base and free and self.may('install-runner'):
            new_page = github_runners_page(url, '/new')
            body += self.form('install-runner', f'Add an instance ({len(used - {None})} → {len(used - {None}) + 1})',
                              self.runner_install_fields('github', url, f'{stem}-{free[0]}' if stem else '', free,
                                                         f'./config.sh --url {url} --token '),
                              note=f'One more {e(url.replace("https://github.com/", ""))} runner – jobs run in parallel. '
                                   f'The token comes from <a href="{e(new_page)}">GitHub "New self-hosted runner" ↗</a>: paste it '
                                   'at the end of the line.', command='bin/install-runner --provider github --instance N')
        removal = github_runners_page(url, f'/{agent}') if agent else settings
        body += self.form('remove-runner', f'Remove {info.get("name") or scope}',
                          f'<input type="hidden" name="provider" value="github"><input type="hidden" name="scope" value="{e(scope)}">'
                          '<label><span>GitHub "Remove" command (optional)</span><textarea name="dialog" autocomplete="off" '
                          'spellcheck="false" placeholder="./config.sh remove --token …"></textarea></label>',
                          note=('With the command from ' + (f'<a href="{e(removal)}">the runner\'s page on GitHub ↗</a>' if removal else 'GitHub') +
                                ' ("Remove") the runner is unregistered on GitHub too; without it – only here, and on GitHub it stays "Offline" '
                                'until you remove it there. A runner that is running a job is not removed.'),
                          command=f'bin/install-runner --provider github --remove --scope {scope}', danger=True)
        body += ('</div><p class="note">The name and labels on GitHub cannot be changed here: GitHub changes them only on a new '
                 'registration – remove it and add it with a new name.</p><p><a href="/runners">← Runners</a></p>')
        return self.layout(f'Runner {info.get("name") or scope}', body, section='runners')

    def bitbucket_runner(self, data):
        units = data.get('units') or {}
        unit_name = 'setup-server-runner.service'
        unit = units.get(unit_name) or {}
        present = installed(units, unit_name)
        body = ''
        if present:
            _, boot, restarts = self.runner_facts(unit)
            body += facts([('State', unit_state(units, unit_name)), ('Starts on boot', e(boot)), ('Restarts', e(restarts)),
                           ('Service', f'<code>{unit_name}</code>'), ('Directory', f'<code>{e(data.get("root", ""))}/runner</code>')])
            controls = self.unit_controls('runner', UNIT_OPERATIONS['runner'])
            if controls:
                body += f'<div class="controls">{controls}</div>'
        else:
            body += '<div class="callout"><p>The Bitbucket runner is not installed.</p></div>'
        body += '<h2>Change</h2><div class="deck">' + self.form(
            'install-runner', 'Replace (a new dialog)' if present else 'Install', self.runner_install_fields('bitbucket'),
            note='Bitbucket: Workspace settings → Runners → Add runner (Linux Shell); the whole dialog text. The text is never written anywhere.',
            command='bin/install-runner')
        if present:
            body += self.form('remove-runner', 'Remove the Bitbucket runner', '<input type="hidden" name="provider" value="bitbucket">',
                              note='Stops the service, deletes the runner\'s directory, its unit and runner.env. In Bitbucket the runner stays '
                                   'until you remove it there (Workspace settings → Runners). A running step would be cut off.',
                              command='bin/install-runner --remove', danger=True)
        body += '</div><p><a href="/runners">← Runners</a></p>'
        return self.layout('Bitbucket runner', body, section='runners')

    # --- Login, users and groups -----------------------------------------------------------------
    @staticmethod
    def login_page(error='', name='', target='/'):
        message = f'<div class="callout bad"><p>{e(error)}</p></div>' if error else ''
        return ('<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">'
                '<title>Sign in · Server OPS</title><link rel="stylesheet" href="/ui.css"></head><body>'
                f'<main class="login"><p class="mark">OPS<small>{e(socket.gethostname())}</small></p>{message}'
                '<form class="action" method="post" action="/login">'
                f'<input type="hidden" name="next" value="{e(target)}">'
                f'<label><span>User</span><input type="text" name="user" value="{e(name)}" autocomplete="username" '
                f'{"" if name else "autofocus "}required></label>'
                f'<label><span>Password</span><input type="password" name="password" autocomplete="current-password" '
                f'{"autofocus " if name else ""}required></label>'
                '<div class="form-foot"><p class="note">Server OPS control</p><button class="run">Sign in</button></div>'
                '</form></main></body></html>')

    @staticmethod
    def group_titles(groups, names):
        return ', '.join(groups.get(name, {}).get('title', name) for name in names) or '—'

    @staticmethod
    def permission_summary(sections):
        shown = [f'{SECTION_TITLES[key]}{" ✎" if sections.get(key) == "manage" else ""}' for key, _, _ in SECTIONS if sections.get(key)]
        return ', '.join(shown) or 'nothing'

    @staticmethod
    def person_link(person):
        return f'<a href="/access/{quote(person)}">{e(person)}</a>' if person else '—'

    def saved(self, query):
        return '<div class="callout"><p>Saved.</p></div>' if query.get('saved') == ['1'] else ''

    def users_page(self, accounts, query):
        users, groups = accounts['users'], accounts['groups']
        manage = self.can('users', 'manage')
        rows = ''.join(
            f'<tr><td><a href="/users/{quote(name)}">{e(name)}</a></td><td>{e(user.get("full_name") or "")}</td>'
            f'<td>{e(self.group_titles(groups, user.get("groups", [])))}</td><td>{self.person_link(user.get("person"))}</td>'
            f'<td>{badge("disabled", "bad") if user.get("disabled") else badge("active", "ok")}</td>'
            f'<td>{e(ago(user["last_login"])) if user.get("last_login") else "never"}</td></tr>'
            for name, user in sorted(users.items()))
        members = lambda group: sum(1 for user in users.values() if group in user.get('groups', []))
        group_rows = ''.join(
            f'<tr><td><a href="/groups/{quote(identifier)}">{e(group["title"])}</a></td><td>{members(identifier)}</td>'
            f'<td>{e(self.permission_summary(group.get("sections") or {}))}</td></tr>'
            for identifier, group in sorted(groups.items(), key=lambda item: (item[0] != ADMINISTRATORS, item[1]['title'])))
        stats = [(len(users), 'users'), (sum(1 for user in users.values() if not user.get('disabled')), 'active'),
                 (len(groups), 'groups')]
        body = self.saved(query) + '<div class="stats">' + ''.join(
            f'<div class="stat"><b>{number}</b><span>{e(label)}</span></div>' for number, label in stats) + '</div>'
        body += ('<h2>Users</h2>' + ('<div class="toolbar"><a class="btn go" href="/users/new">+ New user</a></div>' if manage else '') +
                 '<table class="list"><tr><th>Name</th><th>Full name</th><th>Groups</th><th>Access person</th>'
                 f'<th>State</th><th>Last login</th></tr>{rows}</table>')
        body += ('<h2>Groups</h2>' + ('<div class="toolbar"><a class="btn go" href="/groups/new">+ New group</a></div>' if manage else '') +
                 f'<table class="list"><tr><th>Group</th><th>Members</th><th>Sections (✎ – manage)</th></tr>{group_rows}</table>'
                 '<p class="note">A user sees and manages what at least one of their groups allows. "Administrators" always manage '
                 'everything; at least one enabled member of it must remain.</p>')
        body += self.tokens_section(accounts)
        return self.layout('Users', body, section='users')

    def tokens_section(self, accounts):
        """The Users page's API tokens: the agents' and scripts' read access to /api/v1."""
        tokens, groups = accounts.get('tokens') or {}, accounts['groups']
        manage = self.can('users', 'manage')
        rows = ''.join(
            f'<tr><td><a href="/tokens/{quote(name)}">{e(name)}</a></td><td>{e(self.group_titles(groups, token.get("groups", [])))}</td>'
            f'<td>{e(self.permission_summary(self.token_permissions(groups, token)))}</td>'
            f'<td>{badge("disabled", "bad") if token.get("disabled") else badge("active", "ok")}</td>'
            f'<td>{e(ago(token["created"])) if token.get("created") else "—"}</td>'
            f'<td>{e(ago(token["last_used"])) if token.get("last_used") else "never"}</td></tr>'
            for name, token in sorted(tokens.items()))
        body = '<h2 id="tokens">API tokens</h2>' + (
            '<div class="toolbar"><a class="btn go" href="/tokens/new">+ New token</a></div>' if manage else '')
        if rows:
            body += ('<div class="scroll"><table class="list"><tr><th>Name</th><th>Groups</th><th>Reads (✎ – manage)</th><th>State</th>'
                     f'<th>Created</th><th>Last used</th></tr>{rows}</table></div>')
        else:
            body += '<div class="empty">No API tokens yet.</div>'
        return body + (f'<p class="note">An agent or script reads the JSON API <code>{API_PREFIX}</code> with '
                       '<code>Authorization: Bearer ops_…</code>: what its groups let it see, read-only. The token is shown once, '
                       'when it is made; only its sha256 is kept. Every request is logged (api-access.log). README: API for agents.</p>')

    @staticmethod
    def token_permissions(groups, token):
        """section -> level an API token's groups give it (as Accounts.permissions; disabled: none)."""
        levels = {}
        if token.get('disabled'):
            return levels
        for group in token.get('groups', []):
            for section, level in ((groups.get(group) or {}).get('sections') or {}).items():
                if level in PERMISSION_LEVELS and PERMISSION_LEVELS.index(level) > PERMISSION_LEVELS.index(levels.get(section, '')):
                    levels[section] = level
        return levels

    def token_groups(self, groups, chosen):
        return ''.join(f'<label class="check"><input type="checkbox" name="group:{e(identifier)}" value="1"'
                       f'{" checked" if identifier in chosen else ""}><span>{e(group["title"])}'
                       f'<small class="muted"> — {e(self.permission_summary(group.get("sections") or {}))}</small></span></label>'
                       for identifier, group in sorted(groups.items(), key=lambda item: (item[0] != ADMINISTRATORS, item[1]['title'])))

    def token_page(self, accounts, name, query):
        """An API token's settings (name None: a new token)."""
        groups = accounts['groups']
        token = (accounts.get('tokens') or {}).get(name, {}) if name else {}
        manage = self.can('users', 'manage')
        facts_rows = [('Groups', e(self.group_titles(groups, token.get('groups', [])))),
                      ('Reads', e(self.permission_summary(self.token_permissions(groups, token)))),
                      ('State', badge('disabled', 'bad') if token.get('disabled') else badge('active', 'ok')),
                      ('Created', e(local_time(token['created'])) if token.get('created') else '—'),
                      ('Regenerated', e(local_time(token['regenerated'])) if token.get('regenerated') else '—'),
                      ('Last used', e(local_time(token['last_used'])) if token.get('last_used') else 'never')]
        if not manage:
            return self.layout(f'API token {name}', facts(facts_rows) + '<p><a href="/users#tokens">← Users</a></p>', section='users')
        fields = (self.csrf_field() + f'<input type="hidden" name="new" value="{"" if name else "1"}">' +
                  (f'<input type="hidden" name="name" value="{e(name)}">' if name else
                   '<label><span>Name (who uses it, e.g. an agent)</span><input type="text" name="name" autocomplete="off" required '
                   'pattern="[A-Za-z0-9._\\-]{1,32}"></label>') +
                  '<div class="block-label">Groups (what it may read)</div>' + self.token_groups(groups, set(token.get('groups', []))) +
                  (f'<label class="check"><input type="checkbox" name="disabled" value="1"{" checked" if token.get("disabled") else ""}>'
                   '<span>Disabled (its requests are refused)</span></label>' if name else ''))
        body = self.saved(query) + (facts(facts_rows) if name else '')
        body += ('<div class="deck">'
                 f'<form class="action" method="post" action="/tokens/save"><h3>{"Settings" if name else "New API token"}</h3>{fields}'
                 '<div class="form-foot"><p class="note">The API is read-only; a token reads the sections its groups give "view" '
                 '(Overview, Projects). ' + ('' if name else 'The token is shown once, on the next page.') +
                 f'</p><button class="run">{"Save" if name else "Create"}</button></div></form>')
        if name:
            body += (f'<form class="action" method="post" action="/tokens/regenerate"><h3>Regenerate</h3>{self.csrf_field()}'
                     f'<input type="hidden" name="name" value="{e(name)}"><div class="form-foot"><p class="note">A new token, shown once; '
                     'the old one stops working at once.</p><button class="run">Regenerate</button></div></form>'
                     f'<form class="action danger" method="post" action="/tokens/delete"><h3>Delete {e(name)}</h3>{self.csrf_field()}'
                     f'<input type="hidden" name="name" value="{e(name)}"><div class="form-foot"><p class="note">Its requests are refused '
                     'from now on; its lines stay in api-access.log.</p><button class="stop">Delete</button></div></form>')
        body += '</div><p><a href="/users#tokens">← Users</a></p>'
        return self.layout(f'API token {name}' if name else 'New API token', body, section='users')

    def token_shown(self, name, text, accounts, regenerated=False):
        """The one page that shows an API token: right after it was made or regenerated (never stored, never again)."""
        token = (accounts.get('tokens') or {}).get(name, {})
        body = (f'<div class="callout warn"><p>Copy the token now: it is shown only this once. '
                f'{"The old one no longer works. " if regenerated else ""}Lost – regenerate it.</p></div>'
                + facts([('Name', e(name)), ('Groups', e(self.group_titles(accounts['groups'], token.get('groups', []))))]) +
                '<h2>Token</h2>' f'<pre class="cmd">{e(text)}</pre>'
                '<h2>Use</h2>' f'<pre class="cmd">export OPS_TOKEN={e(text)}\n'
                f'curl -s -H "Authorization: Bearer $OPS_TOKEN" https://ops.local{API_PREFIX}\n'
                f'curl -s -H "Authorization: Bearer $OPS_TOKEN" https://ops.local{API_PREFIX}/projects</pre>'
                f'<p class="note"><code>{API_PREFIX}</code> lists every endpoint; <code>{API_PREFIX}/openapi.json</code> describes them.</p>'
                f'<p><a class="btn" href="/tokens/{quote(name)}">Done</a></p>')
        return self.layout(f'API token {name}', body, section='users')

    def user_page(self, accounts, name, people, query, sessions=0):
        """A user's settings (name None: a new user)."""
        users, groups = accounts['users'], accounts['groups']
        user = users.get(name, {}) if name else {}
        manage = self.can('users', 'manage')
        if not manage:
            rows = [('Name', e(name)), ('Full name', e(user.get('full_name') or '—')),
                    ('Groups', e(self.group_titles(groups, user.get('groups', [])))), ('Access person', self.person_link(user.get('person'))),
                    ('State', badge('disabled', 'bad') if user.get('disabled') else badge('active', 'ok'))]
            return self.layout(f'User {name}', facts(rows) + '<p><a href="/users">← Users</a></p>', section='users')
        text = lambda key, label, current='', extra='': (
            f'<label><span>{e(label)}</span><input type="text" name="{key}" value="{e(current)}" autocomplete="off" {extra}></label>')
        secret = lambda key, label, hint: (
            f'<label><span>{e(label)}</span><input type="password" name="{key}" placeholder="{e(hint)}" autocomplete="new-password"></label>')
        chosen = set(user.get('groups', []))
        checks = ''.join(f'<label class="check"><input type="checkbox" name="group:{e(identifier)}" value="1"'
                         f'{" checked" if identifier in chosen else ""}><span>{e(group["title"])}'
                         f'<small class="muted"> — {e(self.permission_summary(group.get("sections") or {}))}</small></span></label>'
                         for identifier, group in sorted(groups.items(), key=lambda item: (item[0] != ADMINISTRATORS, item[1]['title'])))
        person = user.get('person') or ''
        options = ['<option value="">— not linked —</option>'] + [
            f'<option value="{e(key)}"{" selected" if key == person else ""}>{e(key)}{f" ({e(full)})" if full else ""}</option>'
            for key, full in sorted({**people, **({person: ''} if person and person not in people else {})}.items())]
        hint = 'empty – the current one stays' if name else f'{LOGIN_PASSWORD[0]}–{LOGIN_PASSWORD[1]} characters'
        fields = (self.csrf_field() + f'<input type="hidden" name="new" value="{"" if name else "1"}">' +
                  (f'<input type="hidden" name="name" value="{e(name)}">' if name else
                   text('name', 'Name (to sign in)', '', 'required pattern="[A-Za-z0-9._\\-]{1,32}"')) +
                  text('full_name', 'Full name', user.get('full_name') or '') +
                  secret('password', 'Password' if not name else 'New password', hint) +
                  secret('repeat', 'Repeat the password', '') +
                  f'<label><span>Access person</span><select name="person">{"".join(options)}</select></label>'
                  '<div class="block-label">Groups</div>' + checks +
                  f'<label class="check"><input type="checkbox" name="disabled" value="1"{" checked" if user.get("disabled") else ""}>'
                  '<span>Disabled (cannot sign in, their sessions are ended)</span></label>')
        body = self.saved(query)
        if name:
            body += facts([('Created', e(local_time(user['created'])) if user.get('created') else '—'),
                           ('Password changed', e(local_time(user['password_changed'])) if user.get('password_changed') else '—'),
                           ('Last login', e(local_time(user['last_login'])) if user.get('last_login') else 'never'),
                           ('Open sessions', str(sessions))])
        body += ('<div class="deck">'
                 f'<form class="action" method="post" action="/users/save"><h3>{"Settings" if name else "New user"}</h3>{fields}'
                 '<div class="form-foot"><p class="note">Access person – which "Access" key (SSH, tools) is this person; '
                 f'signing in to the UI does not depend on it.</p><button class="run">Save</button></div></form>')
        if name:
            body += (f'<form class="action danger" method="post" action="/users/delete"><h3>Delete {e(name)}</h3>{self.csrf_field()}'
                     f'<input type="hidden" name="name" value="{e(name)}"><div class="form-foot"><p class="note">The user will no longer '
                     'be able to sign in; their actions stay in the logs.</p><button class="stop">Delete</button></div></form>')
        body += '</div><p><a href="/users">← Users</a></p>'
        return self.layout(f'User {name}' if name else 'New user', body, section='users')

    def group_page(self, accounts, identifier, query):
        """A group's sections (identifier None: a new group)."""
        users, groups = accounts['users'], accounts['groups']
        group = groups.get(identifier, {}) if identifier else {}
        sections = group.get('sections') or {}
        locked = identifier == ADMINISTRATORS or not self.can('users', 'manage')
        members = [name for name, user in sorted(users.items()) if identifier and identifier in user.get('groups', [])]

        def choice(key, manage):
            levels = PERMISSION_LEVELS if manage else PERMISSION_LEVELS[:2]
            current = sections.get(key, '')
            if locked:
                return badge(PERMISSION_LABELS[current], {'manage': 'warn', 'view': 'ok'}.get(current, ''))
            return '<div class="seg">' + ''.join(
                f'<label class="pm-{level or "none"}"><input type="radio" name="level:{key}" value="{level}"'
                f'{" checked" if level == current else ""}><span>{PERMISSION_LABELS[level]}</span></label>' for level in levels) + '</div>'
        matrix = ('<table class="list matrix"><tr><th>Section</th><th>Permission</th></tr>' + ''.join(
            f'<tr><td>{e(title)}</td><td>{choice(key, manage)}</td></tr>' for key, title, manage in SECTIONS) + '</table>')
        body = self.saved(query)
        if identifier:
            body += facts([('Members', ', '.join(f'<a href="/users/{quote(name)}">{e(name)}</a>' for name in members) or '—')])
        if locked:
            note = ('"Administrators" always manage everything, so this group cannot be changed.' if identifier == ADMINISTRATORS else '')
            body += (f'<p class="note">{e(note)}</p>' if note else '') + matrix
        else:
            body += ('<div class="deck wide">'
                     f'<form class="action" method="post" action="/groups/save"><h3>{"Permissions" if identifier else "New group"}</h3>'
                     f'{self.csrf_field()}<input type="hidden" name="group" value="{e(identifier or "")}">'
                     f'<label><span>Name</span><input type="text" name="title" value="{e(group.get("title", ""))}" '
                     f'maxlength="{GROUP_TITLE}" required autocomplete="off"></label>{matrix}'
                     '<div class="form-foot"><p class="note">View – the section is shown; manage – its actions too (preview, run). '
                     'Users: manage – creates users and groups.</p><button class="run">Save</button></div></form>')
            if identifier:
                body += (f'<form class="action danger" method="post" action="/groups/delete"><h3>Delete the group</h3>{self.csrf_field()}'
                         f'<input type="hidden" name="group" value="{e(identifier)}"><div class="form-foot"><p class="note">The members '
                         'lose this group\'s permissions; the users themselves stay.</p><button class="stop">Delete</button></div></form>')
            body += '</div>'
        body += '<p><a href="/users">← Users</a></p>'
        title = f'Group {group["title"]}' if identifier else 'New group'
        return self.layout(title, body, section='users')

    def account_page(self, accounts, query, sessions=0):
        user = accounts['users'].get(self.user, {})
        rows = [('Name', e(self.user)), ('Full name', e(user.get('full_name') or '—')),
                ('Groups', e(self.group_titles(accounts['groups'], user.get('groups', [])))),
                ('Views and manages', e(self.permission_summary(self.permissions))),
                ('Access person', self.person_link(user.get('person')) if self.can('access') else e(user.get('person') or '—')),
                ('Password changed', e(local_time(user['password_changed'])) if user.get('password_changed') else '—'),
                ('Open sessions', str(sessions))]
        secret = lambda key, label, complete: (
            f'<label><span>{e(label)}</span><input type="password" name="{key}" autocomplete="{complete}" required></label>')
        body = ('<div class="callout"><p>Password changed; your other sessions have ended.</p></div>' if query.get('saved') == ['1'] else '')
        body += facts(rows) + ('<div class="deck"><form class="action" method="post" action="/account/password"><h3>Change the password</h3>'
                               f'{self.csrf_field()}' + secret('current', 'Current', 'current-password') +
                               secret('password', 'New', 'new-password') + secret('repeat', 'Repeat the new one', 'new-password') +
                               f'<div class="form-foot"><p class="note">{LOGIN_PASSWORD[0]}–{LOGIN_PASSWORD[1]} characters. Your sessions '
                               'open elsewhere are ended.</p><button class="run">Change</button></div></form></div>')
        return self.layout('My account', body)

    def refused(self, message, back='/users', label='Users'):
        return self.layout('Invalid input', f'<div class="callout bad"><p>{e(message)}</p></div>'
                                                 f'<p><a href="{e(back)}">← {e(label)}</a></p>', section='users')

    def invalid(self, message):
        return self.layout('Invalid input', f'<div class="callout bad"><p>{e(message)}</p></div>'
                                                 '<p><a href="/actions">← Back to the actions</a></p>', section='actions')

    def preview(self, plan, code, output, pending):
        back, section = plan.back
        body = ''
        if plan.changes:
            body += ('<div class="changes"><p class="block-label">What changes</p><ul>' +
                     ''.join(f'<li class="is-{kind}">{e(text)}</li>' for kind, text in plan.changes) + '</ul></div>')
        body += facts([('Command', f'<code>{e(shlex.join(plan.check))}</code>'),
                      ('Code', badge('—' if code is None else code, 'ok' if code == 0 else 'bad'))])
        if plan.stdin and plan.action == 'install-runner':
            body += '<p class="note">The pasted text was passed on stdin (not shown).</p>'
        if plan.stdin and plan.action == 'tool-password':
            body += '<p class="note">The password was passed on stdin (not shown, not stored; the server keeps only its hash).</p>'
        body += term(output)
        if plan.run is None:
            return self.layout(plan.title, body, section=section)
        if pending:
            if plan.danger:
                body += f'<div class="tape"><span>{e(plan.danger)}</span></div>'
            body += (f'<form class="action" method="post" action="/run"><input type="hidden" name="csrf" value="{e(self.token)}">'
                     f'<input type="hidden" name="pending" value="{e(pending)}">'
                     f'<p>Will run: <code>{e(shlex.join(plan.run))}</code></p>'
                     f'<div class="form-foot"><a class="btn" href="{e(back)}">Cancel</a><button class="run">Run</button></div></form>')
        else:
            body += '<div class="callout bad"><p>The preview ended with an error: it cannot run. Fix what it shows and try again.</p></div>'
        return self.layout(f'Preview: {plan.title}', body, section=section)

    def pipeline_preview(self, plan, pending, token_variable):
        body = ''
        if plan.pipeline == 'deploy-production':
            body += '<div class="tape"><span>Deploy to PROD</span></div>'
        body += (f'<p>Bitbucket repo: <code>{e(plan.workspace)}/{e(plan.slug)}</code>; token: '
                 f'{e(token_variable) if token_variable else badge("none (" + TOKEN_VARIABLE + ")", "bad")}</p>'
                 f'<p>Request: <code>POST {e(bitbucket_api() + plan.path)}</code></p><pre class="json">{e(json.dumps(plan.body, indent=2))}</pre>')
        if token_variable:
            body += (f'<form class="action" method="post" action="/run"><input type="hidden" name="csrf" value="{e(self.token)}">'
                     f'<input type="hidden" name="pending" value="{e(pending)}"><div class="form-foot">'
                     f'<a class="btn" href="/project/{e(plan.project)}">Cancel</a><button class="run">Run</button></div></form>')
        return self.layout(f'Preview: {plan.title}', body, section='projects')

    def pipeline_result(self, plan, code, data, error):
        if error or code != 201 or not isinstance(data, dict):
            body = f'<div class="callout bad"><p>Bitbucket answered: {e(error or f"HTTP {code}")}</p></div>'
        else:
            number = data.get('build_number')
            link = f'{BITBUCKET_WEB}/{quote(plan.workspace)}/{quote(plan.slug)}/pipelines/results/{int(number or 0)}'
            body = (f'<div class="callout"><p>Started: <a href="{e(link)}">#{e(number)}</a> ({e(plan.pipeline)}, '
                    f'branch {e(plan.branch)}).</p></div>')
        body += f'<p><a href="/project/{e(plan.project)}">← Back to the project</a></p>'
        return self.layout(plan.title, body, section='projects')

    def job(self, identifier, meta, result, running, output):
        if running:
            state, bar = badge('running', 'run'), 'run'
        elif result is None:
            state, bar = badge('cut off (no result)', 'bad'), 'bad'
        else:
            state, bar = badge(f'finished, code {result["exit"]}', 'ok' if result['exit'] == 0 else 'bad'), \
                'ok' if result['exit'] == 0 else 'bad'
        rows = [('State', state), ('Started', f'{e(local_time(meta["started"]))} · {e(meta["user"])}'),
                ('Command', f'<code>{e(shlex.join(meta["argv"]))}</code>')]
        if result is not None:
            rows.insert(2, ('Took', f'{result.get("seconds", 0)} s'))
        body = f'<div class="bar {bar}"><i></i></div>' + facts(rows) + term(output, '(no output yet)')
        back, section = meta.get('back') or ('/logs', 'logs')
        if running:
            body += '<p class="note">The page refreshes every 3 s.</p>'
        elif back != '/actions':
            body += f'<p><a class="btn go" href="{e(back)}">← Back</a></p>'
        return self.layout(meta.get('title', 'Action'), body, refresh=3 if running else None, section=section)

    def logs(self, actions, recent, data, error):
        body = '<h2>Recent actions</h2>'
        if recent:
            body += '<ul class="runs">' + ''.join(
                f'<li>{lamp(kind)}<a href="/job/{e(name)}">{e(local_time(meta["started"]))}</a><span>{e(meta.get("title", ""))}</span>'
                f'<span class="hide muted">{e(meta["user"])}</span><span>{state}</span></li>'
                for name, meta, state, kind in recent) + '</ul>'
        else:
            body += '<div class="empty">No actions yet.</div>'
        body += '<h2 id="activity">Developer activity</h2>' + self.activity_table(self.recent, keys=True, limit=150,
                                                                                      people=full_names(data))
        body += f'<h2>Logs</h2><details open><summary>ui-actions.log</summary><div class="inner">{term(actions)}</div></details>'
        if data is None:
            body += f'<div class="callout bad"><p>{e(error)}</p></div>'
        else:
            body += (f'<details><summary>backup-pulls.log</summary><div class="inner">'
                     f'{term(chr(10).join(data.get("backup_pulls", [])))}</div></details>')
            body += (f'<details><summary>access.log</summary><div class="inner">'
                     f'{term(chr(10).join(data.get("access", [])))}</div></details>')
            for unit, lines in data.get('journal', {}).items():
                body += (f'<details><summary>journalctl -u {e(unit)}</summary><div class="inner">'
                         f'{term(chr(10).join(lines))}</div></details>')
        return self.layout('Logs', body, section='logs')


# --- HTTP ----------------------------------------------------------------------------------------
class Pending:
    """Previewed actions waiting for "Run": in memory only (a restart forgets them), single use."""

    def __init__(self):
        self.lock = threading.Lock()
        self.items = {}

    def add(self, plan, user):
        key = secrets.token_urlsafe(18)
        with self.lock:
            now = time.monotonic()
            self.items = {name: item for name, item in self.items.items() if now - item[2] < PENDING_TTL}
            self.items[key] = (plan, user, now)
        return key

    def take(self, key, user):
        with self.lock:
            item = self.items.pop(key, None)
        if item and item[1] == user and time.monotonic() - item[2] < PENDING_TTL:
            return item[0]
        return None


def tail(path, limit=200):
    try:
        with open(path, 'rb') as handle:
            handle.seek(0, os.SEEK_END)
            handle.seek(max(0, handle.tell() - 256 * 1024))
            return '\n'.join(handle.read().decode('utf-8', 'replace').splitlines()[-limit:])
    except OSError as error:
        return f'({error.strerror})'


def path_section(path):
    """The section a GET path belongs to (its "view" is needed), or None (checked where it is served)."""
    for prefix, section in (('/projects', 'projects'), ('/project/', 'projects'), ('/runners', 'runners'), ('/access', 'access'), ('/files', 'files'),
                            ('/update', 'update'),
                            ('/actions', 'actions'), ('/instructions', 'instructions'), ('/logs', 'logs'),
                            ('/worker-metrics', 'metrics'), ('/users', 'users'), ('/groups', 'users'), ('/tokens', 'users')):
        if path == prefix.rstrip('/') or path.startswith(prefix.rstrip('/') + '/'):
            return section
    return None


# --- The API for agents (/api/v1) ----------------------------------------------------------------
# Read-only JSON for LLM agents and scripts on other computers (through nginx on ops.local): when each project
# environment was deployed and whether that worked, its backups against their policy, the pipelines and pull
# requests, what needs a look. An API token (Users → API tokens) or Basic auth of a user; the token's groups decide
# what it reads, as a user's do. Built from the same status and the same alarm logic as the pages; never a secret.
API_PREFIX = '/api/v1'
API_PROJECT = r'[a-z0-9][a-z0-9_-]{0,63}'
API_LOG_LIMIT, API_LOG_KEEP = 1_500_000, 5000  # past about 10 000 lines (1.5 MB) the access log keeps its newest 5000
# (path, section it needs (None: any signed-in caller), what it returns): the index, the OpenAPI document and the
# dispatcher all come from this one list.
API_ROUTES = (
    ('', None, 'This index: who you are, what your groups let you read, and every endpoint.'),
    ('/openapi.json', None, 'The OpenAPI 3.1 description of this API.'),
    ('/overview', 'overview', 'What needs a look (the Overview list: failed units, failed deploys, late or missing backups, '
                              'disk), the units and timers, the versions of Server OPS and setup, the free disk.'),
    ('/projects', 'projects', 'Every project and its environments: the last deploy (when, which ref and commit, from which branch, '
                              'whether it succeeded), the last successful one, the newest backup of each series against the '
                              'environment\'s backup policy, and the problems.'),
    ('/projects/{project}', 'projects', 'One project as in /projects, with each environment\'s target and containers.'),
    ('/projects/{project}/pipelines', 'projects', 'The newest Bitbucket pipeline runs of the project (deploys, backups, pull '
                                                  'request builds): state, result, trigger, ref, commit, pull request, times.'),
    ('/projects/{project}/pull-requests', 'projects', 'The most recently updated pull requests of the project\'s repositories '
                                                      '(environment and code repository on Bitbucket), and the latest one.'),
    ('/backups', 'projects', 'Every project environment\'s backups in one list (the Backups page): policy, the newest backup of '
                             'each series, the late or missing ones.'),
)


def api_route(path):
    """(route, project) of an /api/v1 path (a trailing / ignored), or None."""
    tail = path[len(API_PREFIX):].rstrip('/') if path == API_PREFIX or path.startswith(API_PREFIX + '/') else None
    if tail is None:
        return None
    for route, *_ in API_ROUTES:
        match = re.fullmatch(re.escape(route).replace(re.escape('{project}'), f'({API_PROJECT})'), tail)
        if match:
            return route, (match[1] if match.groups() else None)
    return None


def iso(moment):
    """A Unix time as ISO 8601 UTC ('2026-11-26T09:41:04Z'), None as None."""
    return datetime.fromtimestamp(int(moment), timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ') if moment is not None else None


def age_seconds(moment, now):
    return max(0, int(now - moment)) if moment is not None else None


def api_deploy(deploy, now):
    if not deploy:
        return None
    branch = deploy.get('branch') or {}
    return {'at': iso(deploy.get('at')), 'age_seconds': age_seconds(deploy.get('at'), now), 'ref': deploy.get('ref') or None,
            'commit': deploy.get('commit') or None, 'branch': branch.get('name'),
            'branch_behind': branch.get('behind') if isinstance(branch.get('behind'), int) else None,
            'succeeded': not deploy.get('failed'), 'failed': deploy.get('failed'), 'rollback': bool(deploy.get('rollback'))}


def api_series(backups, now):
    """The newest backup of one series and how many are kept; None when there is none."""
    newest = (backups or {}).get('newest')
    if not newest:
        return None
    return {'newest_at': iso(newest['time']), 'age_seconds': age_seconds(newest['time'], now), 'newest_name': newest.get('name'),
            'size_bytes': newest.get('size'), 'count': (backups or {}).get('count', 0)}


def api_environment(page, entry, environment, units, now, detail=False):
    """One project environment for the API: its state and problems (Page.project_environment and the files backup of
    Page.backup_problems: the same words the pages show), the deploys, the backups against the policy."""
    state = (entry.get('environments') or {}).get(environment) or {}
    kind, problems = page.project_environment(entry, environment)
    problems = problems + [f'{problem} files backup' for series, problem, _ in Page.backup_problems(entry, environment, units)
                           if series == 'files']
    deploys = state.get('deploys') or {}
    found = {'name': environment, 'state': 'bad' if problems else kind, 'problems': problems,
             'mode': 'files' if files_only(state) else 'docker', 'declared': bool(state.get('declared')),
             'registered': bool(Page.registered(entry, environment)), 'development': bool(state.get('development')),
             'last_deploy': api_deploy(deploys.get('last'), now), 'last_successful_deploy': api_deploy(deploys.get('last_success'), now),
             'deploy_count': deploys.get('count', 0),
             'backup_policy': None if state.get('development') else environment_policy(state),
             'backups': {series: api_series(state.get(key), now) for series, key in (
                 ('db-short', 'backups'), ('db-full', 'full_backups'), ('files', 'files_backups'), ('fresh', 'fresh_backups'))},
             'backup_file_paths': list(state.get('file_paths') or []),
             'ui': f'/project/{quote(entry["name"])}'}
    if detail:
        values = target_values(entry, environment)
        found['target'] = None if not values else {
            'mode': 'files' if values.get('DEPLOY_MODE') == 'files' else 'docker', 'remote': remote_target(values),
            'ssh': values.get('DEPLOY_SSH') or None, 'path': values.get('DEPLOY_PATH') or None,
            'docker_context': (values.get('DEPLOY_CONTEXT') or None) if values.get('DEPLOY_MODE') != 'files' else None}
        found['compose_project'] = None if files_only(state) else state.get('compose_project')
        found['containers'] = [{'name': item.get('name'), 'state': item.get('state'), 'status': item.get('status'),
                                'health': item.get('health')} for item in state.get('containers', [])]
        found['secret_store'] = None if files_only(state) else state.get('secrets')
    return found


def api_project(page, entry, units, now, detail=False):
    environments = sorted(entry.get('environments') or {}, key=environment_order)
    shown = [api_environment(page, entry, environment, units, now, detail) for environment in environments]
    return {'name': entry['name'], 'state': Page.project_kind([item['state'] for item in shown]) if shown else 'idle',
            'repository': entry.get('repository'), 'code_repository': entry.get('code_repository'),
            'branch': entry.get('branch'), 'monorepo': bool(entry.get('monorepo')),
            'last_deploy_at': max((item['last_deploy']['at'] for item in shown if item['last_deploy']), default=None),
            'environments': shown, 'ui': f'/project/{quote(entry["name"])}'}


def api_overview(data, now):
    items = Page.attention_items(data)
    units = []
    for name, unit in sorted((data.get('units') or {}).items()):
        units.append({'name': name, 'loaded': unit.get('LoadState') not in (None, 'not-found'), 'active': unit.get('ActiveState'),
                      'sub': unit.get('SubState'), 'result': unit.get('Result'), 'enabled': unit.get('UnitFileState'),
                      'last_trigger': unit.get('LastTriggerUSec'), 'next_run': unit.get('NextElapseUSecRealtime'),
                      'active_since': unit.get('ActiveEnterTimestamp')})
    versions = data.get('versions') or {}
    git = lambda state: None if not state else {'commit': state.get('commit'), 'tag': state.get('tag'), 'behind': state.get('behind'),
                                                'committed_at': iso(state.get('committed')), 'fetched_at': iso(state.get('fetched'))}
    disk = data.get('disk') or {}
    projects = data.get('projects', [])
    return {'generated_at': iso(data.get('generated', now)),
            'attention': [{'level': kind, 'kind': group or 'server', 'text': text, 'ui': href} for group, kind, text, href in items],
            'projects': {'count': len(projects), 'environments': sum(len(entry.get('environments') or {}) for entry in projects)},
            'units': units,
            'versions': {'server_ops': {'installed': versions.get('installed'), 'checkout': versions.get('checkout'),
                                        **(git(versions.get('checkout_git')) or {})},
                         'setup': {'describe': versions.get('setup'), **(git(versions.get('setup_git')) or {})}},
            'disk': {'path': disk.get('path'), 'size_bytes': disk.get('size'), 'available_bytes': disk.get('available'),
                     'available_percent': round(100 * disk['available'] / disk['size'], 1) if disk.get('size') else None}
            if disk else None,
            'errors': list(data.get('errors') or [])}


def api_backups(data, now):
    rows = []
    for row in Page.backup_rows(data):
        state = row['state']
        rows.append({'project': row['entry']['name'], 'environment': row['environment'],
                     'mode': 'docker' if row['database'] else 'files', 'state': row['kind'], 'registered': row['registered'],
                     'policy': row['policy'], 'policy_text': policy_text(row['policy'], row['files'], row['database']),
                     'problems': [('old ' if problem == 'old' else 'no ') + BACKUP_SERIES[series] for series, problem, _ in row['problems']],
                     'newest': {series: api_series(state.get(key), now) for series, key in (
                         ('db-short', 'backups'), ('db-full', 'full_backups'), ('files', 'files_backups'), ('fresh', 'fresh_backups'))},
                     'ui': f'/project/{quote(row["entry"]["name"])}#backup-{quote(row["environment"])}'})
    rows.sort(key=lambda row: (row['state'] != 'bad', row['project'], environment_order(row['environment'])))
    return {'generated_at': iso(data.get('generated', now)), 'environments': rows,
            'late_or_missing': sum(1 for row in rows if row['state'] == 'bad')}


def api_run(run, repository):
    """One Bitbucket pipeline run, as the API shows it."""
    state = run.get('state') or {}
    target = run.get('target') or {}
    pull = target.get('pullrequest') or {}
    number = run.get('build_number')
    return {'build_number': number, 'uuid': run.get('uuid'), 'state': state.get('name'),
            'result': (state.get('result') or {}).get('name') or (state.get('stage') or {}).get('name'),
            'trigger': (run.get('trigger') or {}).get('name'), 'pipeline': (target.get('selector') or {}).get('pattern'),
            'selector': (target.get('selector') or {}).get('type'), 'ref_type': target.get('ref_type'),
            'ref': target.get('ref_name') or target.get('source'), 'commit': (target.get('commit') or {}).get('hash'),
            'pull_request': {'id': pull.get('id'), 'title': pull.get('title'), 'source': target.get('source'),
                             'destination': target.get('destination')} if pull or target.get('type') == 'pipeline_pullrequest_target' else None,
            'creator': (run.get('creator') or {}).get('display_name'), 'created_on': run.get('created_on'),
            'completed_on': run.get('completed_on'), 'duration_seconds': run.get('duration_in_seconds'),
            'url': f'{BITBUCKET_WEB}/{quote(repository[0])}/{quote(repository[1])}/pipelines/results/{int(number)}'
            if isinstance(number, int) else None}


def api_pull_request(item):
    branch = lambda side: ((item.get(side) or {}).get('branch') or {}).get('name')
    return {'id': item.get('id'), 'title': item.get('title'), 'state': item.get('state'),
            'author': (item.get('author') or {}).get('display_name'), 'source_branch': branch('source'),
            'destination_branch': branch('destination'), 'source_commit': ((item.get('source') or {}).get('commit') or {}).get('hash'),
            'merge_commit': (item.get('merge_commit') or {}).get('hash'), 'comment_count': item.get('comment_count'),
            'created_on': item.get('created_on'), 'updated_on': item.get('updated_on'),
            'url': ((item.get('links') or {}).get('html') or {}).get('href')}


def project_repositories(entry):
    """[(role, url, (workspace, slug) or None)] of a project's repositories: the environment repo, then the code repo."""
    found = []
    for role, url in (('environment', entry.get('repository')), ('code', entry.get('code_repository'))):
        if url and all(url != item[1] for item in found):
            found.append((role, url, bitbucket_repository(url)))
    return found


def api_pipelines(entry, fresh):
    repository = bitbucket_repository(entry.get('repository') or '')
    if repository is None:
        link = github_actions_link(entry)
        return {'project': entry['name'], 'provider': 'github' if link else None, 'runs': None, 'link': link,
                'error': 'a GitHub project: its runs are in GitHub Actions (link)' if link else
                'no Bitbucket repository: no pipelines are read'}
    runs, error = pipeline_runs(entry['name'], repository, fresh)
    return {'project': entry['name'], 'provider': 'bitbucket', 'repository': '/'.join(repository),
            'runs': [api_run(run, repository) for run in runs if isinstance(run, dict)] if runs is not None else None,
            'error': error}


def api_pull_requests(entry, fresh):
    repositories, newest = [], None
    for role, url, repository in project_repositories(entry):
        if repository is None:
            repositories.append({'role': role, 'url': url, 'pull_requests': None,
                                 'error': 'not on Bitbucket: its pull requests are not read'})
            continue
        found, error = pull_requests(entry['name'], repository, fresh)
        shown = [{**api_pull_request(item), 'repository': '/'.join(repository)} for item in found or [] if isinstance(item, dict)]
        repositories.append({'role': role, 'repository': '/'.join(repository), 'pull_requests': shown if found is not None else None,
                             'error': error})
        for item in shown:
            if item.get('updated_on') and (newest is None or item['updated_on'] > newest['updated_on']):
                newest = item
    return {'project': entry['name'], 'latest': newest, 'repositories': repositories}


def api_openapi():
    """The OpenAPI 3.1 document of API_ROUTES."""
    project = {'name': 'project', 'in': 'path', 'required': True, 'description': 'the project (its build root\'s name)',
               'schema': {'type': 'string', 'pattern': f'^{API_PROJECT}$'}}
    fresh = {'name': 'fresh', 'in': 'query', 'required': False, 'description': '1: read again now instead of the cached answer',
             'schema': {'type': 'string', 'enum': ['1']}}
    error = {'description': 'error', 'content': {'application/json': {'schema': {'$ref': '#/components/schemas/Error'}}}}
    paths = {}
    for route, section, text in API_ROUTES:
        parameters = ([project] if '{project}' in route else []) + ([fresh] if route != '/openapi.json' and route != '' else [])
        responses = {'200': {'description': 'OK', 'content': {'application/json': {'schema': {'type': 'object'}}}},
                     '401': error}
        if section:
            responses['403'] = error
        if '{project}' in route:
            responses['404'] = error
        if section:
            responses['503'] = error
        paths[API_PREFIX + route] = {'get': {
            'summary': text, 'operationId': 'get' + (''.join(part.title() for part in re.split(r'[^a-z]+', route) if part) or 'Index'),
            'description': f'Needs the permission "view" of the section {SECTION_TITLES[section]}.' if section else 'Any valid token.',
            'parameters': parameters, 'responses': responses}}
    return {'openapi': '3.1.0',
            'info': {'title': 'Server OPS API', 'version': '1',
                     'description': 'Read-only status of the worker: deploys, backups, pipelines, pull requests and alarms. '
                                    'Timestamps are ISO 8601 UTC; ages are seconds. No secret is ever returned.'},
            'servers': [{'url': '/'}],
            'security': [{'bearer': []}, {'basic': []}],
            'components': {'securitySchemes': {'bearer': {'type': 'http', 'scheme': 'bearer', 'description': 'an API token ops_…'},
                                               'basic': {'type': 'http', 'scheme': 'basic', 'description': 'a UI user'}},
                           'schemas': {'Error': {'type': 'object', 'required': ['error', 'status'],
                                                 'properties': {'error': {'type': 'string'}, 'status': {'type': 'integer'}}}}},
            'paths': paths}


def api_answer(path, query, kind, name, permissions):
    """(HTTP status, JSON) of a GET of the API, for a caller (kind 'token' or 'user') with these permissions."""
    found = api_route(path)
    if found is None:
        return 404, {'error': f'no such endpoint; the index is {API_PREFIX}', 'status': 404}
    route, project = found
    section = next(item[1] for item in API_ROUTES if item[0] == route)
    can = lambda key: PERMISSION_LEVELS.index(permissions.get(key, '')) >= PERMISSION_LEVELS.index('view')
    if route == '':
        return 200, {'api': 'Server OPS', 'version': 1, 'caller': {'kind': kind, 'name': name},
                     'permissions': {key: level for key, level in permissions.items() if level},
                     'endpoints': [{'path': API_PREFIX + route, 'method': 'GET', 'needs': f'{key}: view' if key else None,
                                    'allowed': key is None or can(key), 'description': text} for route, key, text in API_ROUTES],
                     'notes': 'Read-only. Timestamps are ISO 8601 UTC, ages in seconds; "ui" fields are paths of the web UI. '
                              'state: ok, bad (problems lists why) or idle (not deployed from here). ?fresh=1 reads again now '
                              '(the status is cached for a few seconds, Bitbucket for a minute).'}
    if route == '/openapi.json':
        return 200, api_openapi()
    if section and not can(section):
        return 403, {'error': f'the section "{SECTION_TITLES[section]}" needs the permission "view"; groups give it (Users)',
                     'status': 403}
    fresh = query.get('fresh') == ['1']
    data, error = status(fresh=fresh and route in ('/overview', '/projects', '/projects/{project}', '/backups'))
    if data is None:
        return 503, {'error': f'could not get the status: {error}', 'status': 503}
    now = time.time()
    page = Page(name, '', permissions)
    if route == '/overview':
        return 200, api_overview(data, now)
    if route == '/backups':
        return 200, api_backups(data, now)
    units = data.get('units', {})
    if route == '/projects':
        return 200, {'generated_at': iso(data.get('generated', now)),
                     'projects': [api_project(page, entry, units, now) for entry in data.get('projects', [])],
                     'errors': list(data.get('errors') or [])}
    entry = next((item for item in data.get('projects', []) if item.get('name') == project), None)
    if entry is None:
        return 404, {'error': f'there is no project {project}', 'status': 404}
    if route == '/projects/{project}':
        return 200, {'generated_at': iso(data.get('generated', now)), **api_project(page, entry, units, now, detail=True)}
    if route == '/projects/{project}/pipelines':
        return 200, api_pipelines(entry, fresh)
    return 200, api_pull_requests(entry, fresh)


def safe_target(target):
    """Where a login leads: a path of this UI only (never //host or /login)."""
    return target if re.fullmatch(r'/(?![/\\])[^\s]{0,500}', target or '') and not target.startswith('/login') else '/'


def handler(accounts):
    csrf_key = secrets.token_bytes(32)
    verified = {}  # sha256 of an Authorization header -> (user, password hash): PBKDF2 runs once per login
    failures = {}  # client -> times of its wrong logins
    pending = Pending()
    lock = threading.Lock()
    api_log_lock = threading.Lock()

    class Handler(BaseHTTPRequestHandler):
        server_version = 'setup-server-ui'
        sys_version = ''
        timeout = 60

        def reply(self, status, body, content_type='text/html; charset=utf-8', headers=()):
            data = body if isinstance(body, bytes) else body.encode()
            self.send_response(status)
            self.send_header('Content-Type', content_type)
            self.send_header('Content-Length', str(len(data)))
            self.send_header('Cache-Control', 'no-store')
            self.send_header('X-Frame-Options', 'DENY')
            self.send_header('X-Content-Type-Options', 'nosniff')
            # same-origin: with no-referrer a browser posts the forms with Origin: null, which the POST check refuses.
            self.send_header('Referrer-Policy', 'same-origin')
            self.send_header('Content-Security-Policy', "default-src 'none'; style-src 'self'; form-action 'self'; "
                                                        "frame-ancestors 'none'; base-uri 'none'")
            for header in headers:
                self.send_header(*header)
            self.end_headers()
            if self.command != 'HEAD':
                self.wfile.write(data)

        def client(self):
            return self.client_address[0]

        def host_ok(self, api=False):
            host = self.headers.get('Host', '')
            if re.sub(r':[0-9]+$', '', host) not in LOOPBACK_HOSTS:
                log(f'refused {self.client()}: Host {host[:60]!r} (400)')
                if api:
                    self.json_reply(400, {'error': 'unexpected Host', 'status': 400})
                else:
                    self.reply(400, 'Unexpected Host\n', 'text/plain; charset=utf-8')
                return False
            return True

        def json_reply(self, status, data, headers=()):
            self.reply(status, json.dumps(data, indent=1, sort_keys=True, ensure_ascii=False) + '\n',
                       'application/json; charset=utf-8', headers)

        def cookie(self):
            for part in self.headers.get('Cookie', '').split(';'):
                key, _, text = part.strip().partition('=')
                if key == SESSION_COOKIE:
                    return text
            return ''

        def caller(self):
            """Who the wrong logins are counted for: behind a LAN proxy (nginx) every browser comes from 127.0.0.1,
            so the address the proxy passes (X-Real-IP) counts; one device's guesses then lock out only itself."""
            forwarded = self.headers.get('X-Real-IP', '').strip()
            try:
                return str(ipaddress.ip_address(forwarded)) if forwarded else self.client()
            except ValueError:
                return self.client()

        def limited(self, api=False):
            """True (and the reply sent) when this client has had too many wrong logins (or API tokens) lately."""
            now = time.time()
            with lock:
                recent = [moment for moment in failures.get(self.caller(), []) if now - moment < LOGIN_FAILURES[1]]
                failures[self.caller()] = recent
            if len(recent) < LOGIN_FAILURES[0]:
                return False
            log(f'refused {self.client()}: too many wrong logins (429)')
            headers = [('Retry-After', str(LOGIN_FAILURES[1]))]
            if api:
                self.json_reply(429, {'error': 'too many failed attempts: wait a few minutes', 'status': 429}, headers)
            else:
                self.reply(429, Page.login_page('Too many failed attempts: wait a few minutes.'), headers=headers)
            return True

        def failed(self):
            with lock:
                failures.setdefault(self.caller(), []).append(time.time())
                if len(failures) > 1000:
                    failures.clear()
            log(f'refused {self.caller()}: wrong login (401)')

        def login(self):
            """The logged-in user, or None (the reply is sent). A browser has a session cookie (the login page
            gives it); a script may send Basic auth of any enabled user instead. Without either a page leads to
            the login page; no WWW-Authenticate is sent, so no browser shows its own login dialog."""
            if not self.host_ok():
                return None
            header = self.headers.get('Authorization', '')
            if header:
                found = self.credentials(header)
                if found:
                    return found[1]
                if found is None:
                    self.reply(401, self.page_text('Wrong name or password.'))
                return None
            name = accounts.session_user(self.cookie())
            if name:
                return name
            if self.command in ('GET', 'HEAD'):
                self.redirect('/login' + (f'?next={quote(self.path)}' if self.path not in ('/', '') else ''))
            else:
                self.reply(401, self.page_text('You need to sign in.'))
            return None

        def credentials(self, header, api=False):
            """(kind, name) of an Authorization header: ('user', name) for Basic auth of an enabled user, ('token', name)
            for the Bearer API token of an enabled one (on /api/ only). None when it is wrong (counted as a wrong login;
            the caller replies), False when this client has had too many (the reply is sent)."""
            digest = hashlib.sha256(header.encode('utf-8', 'surrogateescape')).digest()
            with lock:
                known = verified.get(digest)
            if known and accounts.password_of(known[0]) == known[1]:  # same password, still enabled
                return 'user', known[0]
            if self.limited(api):
                return False
            if api and header.startswith('Bearer '):
                name = accounts.token_name(header[7:].strip())
                if name:
                    return 'token', name
                self.failed()
                return None
            given_user, given_password = '', ''
            if header.startswith('Basic '):
                try:
                    given_user, _, given_password = base64.b64decode(header[6:], validate=True).decode().partition(':')
                except (ValueError, UnicodeDecodeError):
                    pass
            if USER_NAME.fullmatch(given_user) and accounts.authenticate(given_user, given_password):
                with lock:
                    if len(verified) > 64:
                        verified.clear()
                    verified[digest] = (given_user, accounts.password_of(given_user))
                return 'user', given_user
            self.failed()
            return None

        # --- The API (/api/v1): JSON for agents, an API token or Basic auth; GET only ---
        def api_get(self, path, query):
            if not self.host_ok(api=True):
                return
            header = self.headers.get('Authorization', '')
            found = self.credentials(header, api=True) if header else None
            if found is False:
                return self.api_logged('-', '-', 429)
            if not found:
                self.api_logged('-', '-', 401)
                return self.json_reply(401, {'error': 'an API token is needed: Authorization: Bearer ops_… (Users → API tokens)',
                                             'status': 401}, [('WWW-Authenticate', 'Bearer realm="Server OPS"')])
            kind, name = found
            code, data = api_answer(path, query, kind, name, accounts.permissions(name, 'tokens' if kind == 'token' else 'users'))
            self.api_logged(kind, name, code)
            self.json_reply(code, data)

        def api_refused_method(self):
            """Anything but GET or HEAD on the API: 405 (it changes nothing yet)."""
            if not self.host_ok(api=True):
                return
            self.api_logged('-', '-', 405)
            self.json_reply(405, {'error': f'{self.command[:10]} is not allowed: the API is read-only (GET)', 'status': 405},
                            [('Allow', 'GET, HEAD')])

        def api_logged(self, kind, name, code):
            """One line in $STATE_DIRECTORY/api-access.log: time, caller, client, method, path, status (never a token).
            Past API_LOG_LIMIT bytes it keeps its newest API_LOG_KEEP lines."""
            stamp = datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
            who = f'{kind}={name}' if kind != '-' else 'caller=-'
            line = f'{stamp} {who} client={self.caller()} {self.command[:10]} {self.path[:300]} {code}'.replace('\n', ' ') + '\n'
            path = STATE / 'api-access.log'
            try:
                with api_log_lock:
                    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
                    descriptor = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
                    with os.fdopen(descriptor, 'a') as handle:
                        handle.write(line)
                        grown = handle.tell() > API_LOG_LIMIT
                    if grown:
                        kept = path.read_text(errors='replace').splitlines(keepends=True)[-API_LOG_KEEP:]
                        temporary = path.with_name(path.name + '.tmp')
                        descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
                        with os.fdopen(descriptor, 'w') as handle:
                            handle.writelines(kept)
                        os.replace(temporary, path)
            except OSError as error:
                log(f'{path}: {error}')

        def redirect(self, location, headers=()):
            self.send_response(303)
            self.send_header('Location', location)
            self.send_header('Content-Length', '0')
            self.send_header('Cache-Control', 'no-store')
            for header in headers:
                self.send_header(*header)
            self.end_headers()

        def session_cookie(self, token, age):
            secure = '; Secure' if self.headers.get('X-Forwarded-Proto') == 'https' else ''
            return ('Set-Cookie', f'{SESSION_COOKIE}={token}; Path=/; Max-Age={age}; HttpOnly; SameSite=Lax{secure}')

        def page_for(self, name):
            return Page(name, self.token(name), accounts.permissions(name))

        def allowed(self, page, section, level='view'):
            """True when the user's groups give this; else the 403 page is sent."""
            if page.can(section, level):
                return True
            self.reply(403, page.layout('No permission', f'<div class="callout bad"><p>The section "{e(SECTION_TITLES[section])}" '
                                                         f'needs the permission "{PERMISSION_LABELS[level]}". Groups give it (Users).</p></div>'))
            return False

        @staticmethod
        def page_text(text):
            return f'<!doctype html><html lang="en"><meta charset="utf-8"><p>{e(text)}</p></html>'

        def token(self, name):
            return hmac.new(csrf_key, b'csrf\0' + name.encode(), hashlib.sha256).hexdigest()

        def do_GET(self):
            url = urlsplit(self.path)
            path, query = url.path, parse_qs(url.query)
            if path == '/api' or path.startswith('/api/'):
                return self.api_get(path, query)
            if path == '/ui.css':  # the login page needs it too; nothing in it is secret
                return self.reply(200, STYLE, 'text/css; charset=utf-8')
            if path == '/login':
                if not self.host_ok():
                    return
                target = safe_target(query.get('next', ['/'])[0])
                if accounts.session_user(self.cookie()):
                    return self.redirect(target)
                return self.reply(200, Page.login_page(target=target))
            name = self.login()
            if name is None:
                return
            page = self.page_for(name)
            section = path_section(path)
            if section and not self.allowed(page, section):
                return
            if path == '/':
                if not page.can('overview'):
                    first = page.first_section()
                    return self.redirect(first) if first else self.reply(200, page.layout(
                        'Server OPS', '<div class="callout warn"><p>Your groups do not let you see any section yet. '
                        'Ask an administrator.</p></div><p><a href="/account">My account</a></p>'))
                data, error = status(fresh='fresh' in query)
                return self.reply(200, page.overview(data, error))
            if path == '/account':
                return self.reply(200, page.account_page(accounts.snapshot(), query, accounts.session_count(name)))
            if path == '/runners':
                data, error = status(fresh='fresh' in query)
                return self.reply(200, page.runners(data, error))
            if path == '/runners/new':
                if not self.allowed(page, 'runners', 'manage'):
                    return
                return self.reply(200, page.runner_new())
            if path in ('/runners/bitbucket', '/runners/github') or path.startswith('/runners/github/'):
                data, error = status(fresh='fresh' in query)
                if data is None:
                    return self.reply(200, page.runners(data, error))
                scope = path[len('/runners/github/'):] if path.startswith('/runners/github/') else None
                rendered = page.bitbucket_runner(data) if path == '/runners/bitbucket' else \
                    page.github_runner(data, scope) if scope and SCOPE.fullmatch(scope) else None
                return self.reply(200, rendered) if rendered else \
                    self.reply(404, page.layout('No such runner', '<p><a href="/runners">← Runners</a></p>', section='runners'))
            if path == '/users':
                return self.reply(200, page.users_page(accounts.snapshot(), query))
            match = re.fullmatch(r'/users/(' + USER_NAME.pattern + ')', unquote(path))
            if match:
                snapshot = accounts.snapshot()
                if match[1] == 'new':
                    if not self.allowed(page, 'users', 'manage'):
                        return
                    return self.reply(200, page.user_page(snapshot, None, self.people(), query))
                if match[1] not in snapshot['users']:
                    return self.reply(404, page.refused(f'There is no user {match[1]}.'))
                return self.reply(200, page.user_page(snapshot, match[1], self.people(), query, accounts.session_count(match[1])))
            match = re.fullmatch(r'/tokens/(' + USER_NAME.pattern + ')', unquote(path))
            if match:
                snapshot = accounts.snapshot()
                if match[1] == 'new':
                    if not self.allowed(page, 'users', 'manage'):
                        return
                    return self.reply(200, page.token_page(snapshot, None, query))
                if match[1] not in snapshot['tokens']:
                    return self.reply(404, page.refused(f'There is no API token {match[1]}.'))
                return self.reply(200, page.token_page(snapshot, match[1], query))
            match = re.fullmatch(r'/groups/(' + GROUP_ID.pattern + ')', path)
            if match:
                snapshot = accounts.snapshot()
                if match[1] == 'new':
                    if not self.allowed(page, 'users', 'manage'):
                        return
                    return self.reply(200, page.group_page(snapshot, None, query))
                if match[1] not in snapshot['groups']:
                    return self.reply(404, page.refused('There is no such group.'))
                return self.reply(200, page.group_page(snapshot, match[1], query))
            match = re.fullmatch(r'/project/([a-z0-9][a-z0-9_-]{0,63})/logs', path)
            if match:
                environment, container = query.get('env', [''])[0], query.get('container', [''])[0]
                lines = query.get('lines', [CONTAINER_LINES[0]])[0]
                if not (ENVIRONMENT.fullmatch(environment) or environment == 'local') or not CONTAINER.fullmatch(container) or lines not in CONTAINER_LINES:
                    return self.reply(400, page.invalid('Invalid environment, container or number of lines.'))
                data, error = helper('--container-logs', match[1], environment, container, lines)
                return self.reply(200, page.container_logs(match[1], environment, container, lines, data, error))
            if path == '/worker-metrics':
                data, error = helper('--metrics')
                return self.reply(200, page.worker_metrics(data, error))
            match = re.fullmatch(r'/project/([a-z0-9][a-z0-9_-]{0,63})', path)
            if match:
                data, error = status(fresh='fresh' in query)
                rendered = page.project(data, match[1]) if data else \
                    page.layout('Project', f'<div class="callout bad"><p>{e(error)}</p></div>', section='projects')
                return self.reply(200, rendered) if rendered else \
                    self.reply(404, page.layout('No such project', '<p><a href="/projects">← Projects</a></p>', section='projects'))
            if path == '/access':
                data, error = status(fresh='fresh' in query)
                page.recent = (helper('--activity')[0] or {}).get('events')
                return self.reply(200, page.access(data, error, query.get('q', [''])[0][:64]))
            if path == '/access/new':
                data, error = status()
                return self.reply(200, page.new_key(data, error))
            match = re.fullmatch(r'/access/(' + KEY_NAME.pattern + r')/session/(\d{8}T\d{6}Z-\d+\.log)', unquote(path))
            if match:
                data, error = helper('--session', match[1], match[2])
                events = (helper('--activity', match[1])[0] or {}).get('events', [])
                event = next((item for item in events if item.get('session') == match[2]), None)
                return self.reply(200, page.session_page(match[1], data, error, event))
            match = re.fullmatch(r'/access/(' + KEY_NAME.pattern + ')', unquote(path))
            if match:
                data, error = status(fresh='fresh' in query)
                events = (helper('--activity', match[1])[0] or {}).get('events')
                rendered = page.key_page(data, match[1], events, query.get('q', [''])[0][:64], query.get('granted') == ['1'],
                                         query.get('tab', ['access'])[0]) if data else None
                return self.reply(200, rendered) if rendered else \
                    self.reply(404, page.layout('No such key', '<p><a href="/access">← Access</a></p>', section='access'))
            match = re.fullmatch(r'/files/([a-z0-9][a-z0-9_-]{0,63})/(' + ENVIRONMENT.pattern + r')(?:/(' +
                                 FILES_ARCHIVE.pattern + r')(/view|/download)?)?', path)
            if match:
                name, environment, archive, part = match.groups()
                data, error = status(fresh='fresh' in query)
                state = next((item.get('environments', {}).get(environment) for item in (data or {}).get('projects', [])
                              if item.get('name') == name), None)
                if not archive:
                    rendered = page.files_environment(data, name, environment) if data else \
                        page.layout('Files', f'<div class="callout bad"><p>{e(error)}</p></div>', section='files')
                    return self.reply(200, rendered) if rendered else \
                        self.reply(404, page.layout('No such environment', '<p><a href="/files">← File backups</a></p>', section='files'))
                # The previous archive: the next older one of the same series (the status lists them newest first).
                names = [item['name'] for item in Page.files_archives(state or {})]
                older = names[names.index(archive) + 1] if archive in names[:-1] else None
                if not part:
                    listing, error = helper('--files', name, environment, archive)
                    previous = helper('--files', name, environment, older)[0] if older and listing else None
                    return self.reply(200, page.files_archive(name, environment, archive, listing, previous,
                                                              query.get('q', [''])[0][:200], query.get('changed') == ['1'], error))
                member = query.get('path', [''])[0]
                if not FILE_MEMBER.fullmatch(member):
                    return self.reply(400, page.invalid('Invalid file path.'))
                data, error = helper('--file', name, environment, archive, member)
                if part == '/download':
                    if error or not data or data.get('error') or data.get('truncated'):
                        return self.reply(404, page.layout('File', f'<div class="callout bad"><p>{e(error or (data or {}).get("error") or "too large")}</p></div>',
                                                           section='files'))
                    filename = member.rsplit('/', 1)[-1]
                    fallback = re.sub(r'[^A-Za-z0-9._-]', '_', filename) or 'file'
                    return self.reply(200, base64.b64decode(data['content']), 'application/octet-stream', headers=[
                        ('Content-Disposition', f"attachment; filename=\"{fallback}\"; filename*=UTF-8''{quote(filename)}")])
                previous = None
                if older and data and not data.get('error'):
                    previous, problem = helper('--file', name, environment, older, member)
                    previous = {**(previous or {'error': problem}), 'archive': older}
                return self.reply(200, page.files_view(name, environment, archive, member, data, previous, error))
            if path == '/files':
                data, error = status(fresh='fresh' in query)
                return self.reply(200, page.files(data, error))
            if path == '/update':
                data, error = status(fresh='fresh' in query)
                return self.reply(200, page.update_page(data, error, installation()))
            if path == '/actions':
                if 'target' in query:  # the instructions' old link: the add form moved to Projects
                    return self.redirect('/projects/new?' + urlencode({'target': query['target'][0][:200]}) + '#form-add-project')
                data, _ = status()
                return self.reply(200, page.actions((data or {}).get('github_runners', [])))
            if path == '/projects':
                data, error = status(fresh='fresh' in query)
                return self.reply(200, page.projects(data, error, query))
            if path == '/projects/backups':
                data, error = status(fresh='fresh' in query)
                return self.reply(200, page.backups_page(data, error, query))
            if path == '/projects/new':
                if not self.allowed(page, 'projects', 'manage'):
                    return
                target = query.get('target', [''])[0]
                return self.reply(200, page.project_new(target if len(target) <= 200 and TARGET.fullmatch(target) else ''))
            if path == '/instructions':
                data, _ = status()
                return self.reply(200, page.instructions(*guide_values(query, data)))
            if path == '/instructions/example':
                return self.reply(200, page.instructions_example())
            if path == '/logs':
                recent = []
                for directory in jobs(20):
                    try:
                        meta, result, running = job_state(directory)
                    except (OSError, ValueError, KeyError):
                        continue
                    kind = 'run' if running else 'bad' if result is None or result['exit'] else 'ok'
                    state = badge('running', 'run') if running else badge('cut off', 'bad') if result is None else \
                        badge(f'code {result["exit"]}', kind)
                    recent.append((directory.name, meta, state, kind))
                data, error = helper('--logs', '50')
                page.recent = (helper('--activity')[0] or {}).get('events')
                return self.reply(200, page.logs(tail(ACTIONS_LOG), recent, data, error))
            match = re.fullmatch(r'/job/(' + JOB_ID.pattern + ')', path)
            if match and (JOBS / match[1] / 'job.json').is_file():
                meta, result, running = job_state(JOBS / match[1])
                if not any(page.can(where) for where in ACTION_SECTIONS.get(meta.get('action'), ('actions',))):
                    return self.allowed(page, ACTION_SECTIONS.get(meta.get('action'), ('actions',))[0])
                output = JOBS / match[1] / 'output.log'
                return self.reply(200, page.job(match[1], meta, result, running, tail(output, 3000) if output.exists() else ''))
            self.reply(404, page.layout('Not found', '<p><a href="/">← To the overview</a></p>'))

        do_HEAD = do_GET

        def do_POST(self):
            path = urlsplit(self.path).path
            if path == '/api' or path.startswith('/api/'):
                return self.api_refused_method()
            if not self.host_ok():
                return
            origin = self.headers.get('Origin')
            if origin is not None and (urlsplit(origin).hostname or '') not in ('127.0.0.1', 'localhost', '::1'):
                log(f'refused {self.client()}: POST from Origin {origin[:60]!r} (403)')
                return self.reply(403, self.page_text('The request does not come from this UI.'))
            if path != '/login':
                name = self.login()
                if name is None:
                    return
            length = self.headers.get('Content-Length', '')
            if not length.isdigit() or int(length) > BODY_LIMIT:
                return self.reply(413, self.page_text('The request is too large.'))
            fields = parse_qs(self.rfile.read(int(length)).decode('utf-8', 'replace'), keep_blank_values=True)
            form = {key: values[0] for key, values in fields.items()}
            if path == '/login':  # no session yet: Origin above (SameSite and the CSP's form-action do the rest)
                return self.sign_in(form)
            if not hmac.compare_digest(form.get('csrf', '').encode(), self.token(name).encode()):
                log(f'refused {self.client()}: POST {path} without a valid CSRF token (403)')
                return self.reply(403, self.page_text('An outdated form: reload the page and try again.'))
            page = self.page_for(name)
            if path == '/preview':
                return self.preview(page, name, form)
            if path == '/run':
                return self.run(page, name, form)
            if path == '/logout':
                accounts.close_session(self.cookie())
                self.audit(name, 'logout')
                return self.redirect('/login', [self.session_cookie('', 0)])
            if path == '/account/password':
                return self.change_password(page, name, form)
            changes = {'/users/save': self.save_user, '/users/delete': self.delete_user,
                       '/groups/save': self.save_group, '/groups/delete': self.delete_group,
                       '/tokens/save': self.save_token, '/tokens/regenerate': self.regenerate_token,
                       '/tokens/delete': self.delete_token}
            if path in changes:
                if not self.allowed(page, 'users', 'manage'):
                    return
                try:
                    return changes[path](page, name, form)
                except Invalid as error:
                    return self.reply(400, page.refused(str(error)))
            self.reply(404, page.layout('Not found', ''))

        # --- Login and accounts ---
        def audit(self, name, text):
            """A line in ui-actions.log; False when it could not be written (a change then does not happen)."""
            try:
                record(name, self.client(), 'users', text)
                return True
            except OSError as error:
                log(f'ui-actions.log: {error}')
                return False

        def change(self, name, what, apply):
            """A change of users or groups: its line in ui-actions.log first (none written: nothing changes), then
            the change; a refused one gets its own line."""
            if not self.audit(name, what):
                raise Invalid('The action log cannot be written: nothing changed.')
            try:
                return apply()
            except Invalid as error:
                self.audit(name, f'{what.split(":")[0]}: refused ({error})')
                raise

        def people(self):
            """The Access keys a user may be linked to: key -> full name."""
            data = status()[0] or {}
            names = full_names(data)
            return {key['name']: names.get(key['name'], '') for key in data.get('keys', []) if key.get('name')}

        def sign_in(self, form):
            target = safe_target(form.get('next', '/'))
            if self.limited():
                return
            given, password = form.get('user', '').strip(), form.get('password', '')
            if not (USER_NAME.fullmatch(given) and accounts.authenticate(given, password)):
                self.failed()
                return self.reply(401, Page.login_page('Wrong name or password.', given[:32], target))
            token = accounts.open_session(given, self.client())
            self.audit(given, 'login')
            self.redirect(target, [self.session_cookie(token, SESSION_LIFETIME)])

        def change_password(self, page, name, form):
            try:
                if not accounts.authenticate(name, form.get('current', '')):
                    self.failed()
                    raise Invalid('The current password is wrong.')
                password = login_password(form, 'password', 'New password')
                if form.get('repeat', '') != password:
                    raise Invalid('The passwords do not match.')
                self.change(name, f'user {name}: password changed (own)', lambda: accounts.set_password(name, password_hash(password)))
            except Invalid as error:
                return self.reply(400, page.refused(str(error), '/account', 'My account'))
            accounts.drop_sessions(name, keep=self.cookie())
            self.redirect('/account?saved=1')

        def save_user(self, page, name, form):
            new = form.get('new') == '1'
            user = value(form, 'name', USER_NAME, 'Name', required=True)
            if new and user == 'new':
                raise Invalid('The name "new" is taken (the new user page).')
            full_name = form.get('full_name', '').strip()
            if len(full_name) > FULL_NAME_LENGTH or any(ord(character) < 32 for character in full_name):
                raise Invalid(f'Full name: up to {FULL_NAME_LENGTH} characters.')
            hashed = None
            if new or form.get('password'):
                password = login_password(form, 'password', 'Password')
                if form.get('repeat', '') != password:
                    raise Invalid('The passwords do not match.')
                hashed = password_hash(password)
            groups = [key[6:] for key, chosen in form.items() if key.startswith('group:') and chosen == '1']
            if any(not GROUP_ID.fullmatch(group) for group in groups):
                raise Invalid('Invalid group.')
            person = form.get('person', '')
            if person and (not KEY_NAME.fullmatch(person) or (status()[0] and person not in self.people() and
                                                                person != accounts.snapshot()['users'].get(user, {}).get('person'))):
                raise Invalid(f'There is no key {person} in Access.')
            disabled = form.get('disabled') == '1'
            what = (f'user {user}: {"created" if new else "saved"} groups={",".join(sorted(groups)) or "-"} person={person or "-"} '
                    f'disabled={"yes" if disabled else "no"} password={"set" if hashed else "kept"}')
            self.change(name, what, lambda: accounts.save_user(user, new, full_name, groups, person, disabled, hashed))
            if hashed or disabled:  # a new password or a disabled user ends their sessions (the admin's own stays)
                accounts.drop_sessions(user, keep=self.cookie() if user == name else None)
            self.redirect(f'/users/{quote(user)}?saved=1')

        def delete_user(self, page, name, form):
            user = value(form, 'name', USER_NAME, 'Name', required=True)
            self.change(name, f'user {user}: deleted', lambda: accounts.delete_user(user))
            if user == name:
                return self.redirect('/login', [self.session_cookie('', 0)])
            self.redirect('/users?saved=1')

        def save_group(self, page, name, form):
            identifier = form.get('group') or None
            if identifier is not None and not GROUP_ID.fullmatch(identifier):
                raise Invalid('There is no such group.')
            title = form.get('title', '').strip()
            if not 1 <= len(title) <= GROUP_TITLE or any(ord(character) < 32 for character in title):
                raise Invalid(f'Group name: 1–{GROUP_TITLE} characters.')
            if identifier is None and group_id(title) == 'new':
                raise Invalid('The name "new" is taken (the new group page).')
            sections = {}
            for key, _, manage in SECTIONS:
                level = form.get(f'level:{key}', '')
                if level not in (PERMISSION_LEVELS if manage else PERMISSION_LEVELS[:2]):
                    raise Invalid(f'{SECTION_TITLES[key]}: invalid permission.')
                sections[key] = level
            what = f'group {identifier or group_id(title)}: {"saved" if identifier else "created"} ' + \
                ' '.join(f'{key}={level}' for key, level in sections.items() if level)
            identifier = self.change(name, what, lambda: accounts.save_group(identifier, title, sections))
            self.redirect(f'/groups/{identifier}?saved=1')

        def delete_group(self, page, name, form):
            identifier = form.get('group', '')
            if not GROUP_ID.fullmatch(identifier):
                raise Invalid('There is no such group.')
            self.change(name, f'group {identifier}: deleted', lambda: accounts.delete_group(identifier))
            self.redirect('/users?saved=1')

        def save_token(self, page, name, form):
            new = form.get('new') == '1'
            token = value(form, 'name', USER_NAME, 'Name', required=True)
            if new and token == 'new':
                raise Invalid('The name "new" is taken (the new token page).')
            groups = [key[6:] for key, chosen in form.items() if key.startswith('group:') and chosen == '1']
            if any(not GROUP_ID.fullmatch(group) for group in groups):
                raise Invalid('Invalid group.')
            disabled = form.get('disabled') == '1'
            what = (f'token {token}: {"created" if new else "saved"} groups={",".join(sorted(groups)) or "-"} '
                    f'disabled={"yes" if disabled else "no"}')
            text = self.change(name, what, lambda: accounts.save_token(token, new, groups, disabled))
            if text:
                return self.reply(200, page.token_shown(token, text, accounts.snapshot()))
            self.redirect(f'/tokens/{quote(token)}?saved=1')

        def regenerate_token(self, page, name, form):
            token = value(form, 'name', USER_NAME, 'Name', required=True)
            text = self.change(name, f'token {token}: regenerated', lambda: accounts.regenerate_token(token))
            self.reply(200, page.token_shown(token, text, accounts.snapshot(), regenerated=True))

        def delete_token(self, page, name, form):
            token = value(form, 'name', USER_NAME, 'Name', required=True)
            self.change(name, f'token {token}: deleted', lambda: accounts.delete_token(token))
            self.redirect('/users?saved=1#tokens')

        def preview(self, page, name, form):
            builder = ACTIONS.get(form.get('action', ''))
            if builder is None:
                return self.reply(400, page.invalid('Unknown action.'))
            if not page.may(form['action'], form):
                return self.reply(403, page.invalid('Your groups do not give the permission "manage" for this action.'))
            try:
                plan = builder(form, status()[0] if form.get('action') in ('pipeline', 'project-target', 'backup-policy', 'add-backup-key', 'key-bulk', 'tool-access', 'remove-runner',
                                                                           'tool-bulk', 'tool-password', 'tool-person') else None)
            except Invalid as error:
                return self.reply(400, page.invalid(str(error)))
            if plan.kind == 'pipeline':
                variable, _ = token_for(plan.project)
                return self.reply(200, page.pipeline_preview(plan, pending.add(plan, name), variable))
            kind = 'read' if plan.run is None else 'check'
            code, output = check(plan)
            try:
                record(name, self.client(), kind, f'{plan.action}: {shlex.join(plan.check)} -> exit {code}')
            except OSError as error:
                # Nothing runs without its line in the log: no "Run" either.
                output += f'\n\n(ui-actions.log: {error.strerror}; cannot run)'
                code = None
            key = pending.add(plan, name) if plan.run is not None and code in plan.run_codes else None
            self.reply(200, page.preview(plan, code, output, key))

        def run(self, page, name, form):
            plan = pending.take(form.get('pending', ''), name)
            if plan is None:
                return self.reply(400, page.invalid('The preview is no longer valid (expired, already run or the UI restarted): start again.'))
            if not page.may(plan.action, getattr(plan, 'fields', None)):  # the groups may have changed since the preview
                return self.reply(403, page.invalid('Your groups do not give the permission "manage" for this action.'))
            if plan.kind == 'pipeline':
                return self.pipeline(page, name, plan)
            busy = running_job()
            if busy:
                return self.reply(409, page.layout('Busy', f'<div class="callout warn"><p>Another action is still running: '
                                                          f'<a href="/job/{e(busy)}">{e(busy)}</a>. Wait until it finishes.</p></div>'))
            identifier = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ') + '-' + secrets.token_hex(3)
            try:
                record(name, self.client(), 'run', f'job={identifier} {plan.action}: {shlex.join(plan.run)}')
            except OSError as error:
                return self.reply(500, page.invalid(f'The action log {ACTIONS_LOG} cannot be written ({error.strerror}): nothing was run.'))
            start_job(plan, identifier, name, self.client())  # status() reads again once it has finished
            self.send_response(303)
            self.send_header('Location', f'/job/{identifier}')
            self.send_header('Content-Length', '0')
            self.end_headers()

        def pipeline(self, page, name, plan):
            variable, token = token_for(plan.project)
            if not token:
                return self.reply(400, page.invalid(f'No Bitbucket token ({TOKEN_VARIABLE}).'))
            what = (f'POST {plan.path} {plan.pipeline} branch={plan.branch} ' +
                    ' '.join(f'{key}={text}' for key, text in plan.variables) + f' (token {variable})')
            try:
                record(name, self.client(), 'pipeline', f'{plan.project}: {what} (sending)')
            except OSError as error:
                return self.reply(500, page.invalid(f'The action log {ACTIONS_LOG} cannot be written ({error.strerror}): nothing was run.'))
            code, data, error = bitbucket('POST', plan.path, token, plan.body)
            number = data.get('build_number') if isinstance(data, dict) else None
            try:
                record(name, self.client(), 'pipeline', f'{plan.project}: {what} -> ' +
                       (f'HTTP {code} #{number}' if not error else error))
            except OSError as failure:
                log(f'ui-actions.log: {failure}')
            CACHE.forget(('pipelines', plan.project))
            self.reply(200 if not error else 502, page.pipeline_result(plan, code, data, error))

        def other_method(self):
            """PUT, PATCH, DELETE, OPTIONS: 405 on the API, else not implemented."""
            path = urlsplit(self.path).path
            if path == '/api' or path.startswith('/api/'):
                return self.api_refused_method()
            self.send_error(501, 'Unsupported method')

        do_PUT = do_PATCH = do_DELETE = do_OPTIONS = other_method

        def log_message(self, format, *arguments):  # refusals and errors only (log() above)
            pass

    return Handler


class Server(ThreadingHTTPServer):
    daemon_threads = True


def main(arguments):
    if arguments[:1] == ['--job'] and len(arguments) == 2:
        return job_main(arguments[1])
    if arguments == ['--hash']:
        password = sys.stdin.readline().rstrip('\n')
        if len(password) < 12:
            log('The password needs 12+ characters')
            return 65
        print(password_hash(password))
        return 0
    if arguments not in ([], ['--check']):
        log(__doc__.split('\n\n')[-1])
        return 64
    try:
        user, stored, port = settings()
    except Refused as error:
        log(str(error))
        return CONFIGURATION_ERROR
    tokens = sorted(key for key in os.environ if key.startswith(TOKEN_VARIABLE) and os.environ[key])
    if arguments == ['--check']:
        print(f'would listen on http://{ADDRESS}:{port}/ for {user} (Bitbucket tokens: {", ".join(tokens) or "none"})')
        return 0
    try:
        accounts = Accounts(STATE, user, stored)
    except Refused as error:
        log(str(error))
        return CONFIGURATION_ERROR
    except OSError as error:
        log(f'{STATE}: {error}')
        return 1
    if accounts.recovered:
        log(f'{user}: the ui.env login is an enabled administrator with the ui.env password')
    try:
        server = Server((ADDRESS, port), handler(accounts))
    except OSError as error:
        log(f'Cannot listen on {ADDRESS}:{port}: {error}')
        return 1
    log(f'listening on {ADDRESS}:{server.server_address[1]} (Bitbucket tokens: {", ".join(tokens) or "none"})')
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
