    Step('Which OS and architecture', 'target',
         'Choose the OS in the form by `ID` and `VERSION_ID`: `ubuntu` 22.04 or 24.04, `debian` 12; `centos`, `almalinux` or '
         '`rocky` – the third option. `uname -m` must match the worker\'s (`x86_64`): images are built on the worker and '
         'sent over SSH (`docker save | docker load`); a target of another architecture will not run them.',
         blocks=((None, ('. /etc/os-release && echo "$PRETTY_NAME (ID=$ID VERSION_ID=$VERSION_ID)"', 'uname -m')),),
         source='bin/prepare-host:11,50; setup doc/lt/09-aplinkos.md (model D)'),
    Step('Server OPS and setup versions', 'worker',
         'The project names the oldest setup it works with (`SETUP_MIN_VERSION` in `env/common.env`). Update both checkouts '
         'before registering; the page "Update" does the same.',
         blocks=((None, ('bin/update --check --server-ref origin/master --setup-ref vX.Y.Z',
                         'bin/update --server-ref origin/master --setup-ref vX.Y.Z')),),
         source='README "Updating"; setup doc/lt/09-aplinkos.md "Bitbucket Pipelines"'),
    Step('Disk space', 'target',
