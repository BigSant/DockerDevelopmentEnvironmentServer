.grants.projects td.id{width:auto;padding:10px 0 4px;border-bottom:none}.grants.projects td:last-child{padding:0 0 10px}
.matrix td:first-child{width:auto}
.envs{grid-template-columns:minmax(0,1fr)}.env{flex-wrap:wrap}
.tabs{overflow-x:auto;flex-wrap:nowrap}
.toolbar>a.btn{margin-left:0}
.runs li{grid-template-columns:18px minmax(0,1fr);gap:2px 10px}.runs li>:nth-child(n+3){grid-column:2}.runs li .hide{display:none}}
@media (max-width:600px){.ramp,.ramp.backups,.keyhead{grid-template-columns:1fr}.ramp li+li{border-left:none}
.plate-version{font-size:28px}.keytitle{font-size:22px}h1{font-size:20px}
input[type=text],input[type=password],textarea,select{font-size:16px}}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}
"""
NAVIGATION = (('overview', '/', 'Overview'), ('projects', '/projects', 'Projects'), ('runners', '/runners', 'Runners'), ('access', '/access', 'Access'),
              ('files', '/files', 'Files'),
              ('update', '/update', 'Update'),
              ('actions', '/actions', 'Actions'), ('instructions', '/instructions', 'Instructions'),
              ('logs', '/logs', 'Logs'), ('metrics', '/worker-metrics', 'Metrics'), ('users', '/users', 'Users'))


def ago(moment, now=None):
    seconds = max(0, int((now or time.time()) - moment))
    if seconds < 3600:
        return f'{seconds // 60} min ago'
    if seconds < 48 * 3600:
        return f'{seconds // 3600} h ago'
    return f'{seconds // 86400} d ago'


def size(count):
    for unit in ('B', 'KB', 'MB', 'GB', 'TB'):
        if count < 1024 or unit == 'TB':
            return (f'{count:.1f}' if unit != 'B' else str(count)) + f' {unit}'
        count /= 1024


def local_time(moment):
    return time.strftime('%Y-%m-%d %H:%M', time.localtime(moment))


def badge(text, kind):
    return f'<span class="chip {kind}">{e(text)}</span>'


def deployed_ref(deploy):
    """The ref of a deploy as shown: a tag or branch as it was given; a commit once, as its short commit."""
    ref, commit = str(deploy.get('ref') or ''), str(deploy.get('commit') or '')
    if commit and re.fullmatch(r'[0-9a-f]{7,64}', ref) and (ref.startswith(commit) or commit.startswith(ref)):
        return commit
    return ref or '?'


def branch_note(branch):
    """How a deployed commit stands on its branch (server-status' deployed_branch), in words; '' when unknown."""
    if not isinstance(branch, dict) or not branch.get('name'):
        return ''
    behind = branch.get('behind')
    if branch.get('exact') or behind == 0:
        return f'the tip of origin/{branch["name"]}'
    if isinstance(behind, int):
        return f'{behind} commit{"" if behind == 1 else "s"} behind origin/{branch["name"]}'
    return f'on origin/{branch["name"]}'


def deploy_branch(deploy):
    """The project page's branch of a deploy: 'branch master (3 commits behind origin/master) · ', or ''."""
    branch = deploy.get('branch')
    note = branch_note(branch)
    return f'branch {e(branch["name"])} <span class="muted">({e(note)})</span> · ' if note else ''


def deploy_shown(deploy):
    """A deploy on the project page: 'branch master (…) · v1.2.0 abc123def456 2 h ago' (a commit ref once)."""
    ref, commit = deployed_ref(deploy), str(deploy.get('commit') or '')
    plain = f' <span class="muted">{e(commit)}</span>' if commit and commit != ref else ''
    return f'{deploy_branch(deploy)}{e(ref)}{plain} {e(ago(deploy["at"]))}'


def lamp(kind):
    return f'<span class="lamp {kind}"></span>'


def file_text(content):
    """A backed-up file's content as text, or None when it is binary (a NUL byte or not UTF-8)."""
    if b'\0' in content:
        return None
    try:
        return content.decode('utf-8')
    except UnicodeDecodeError:
        return None


def diff_term(lines):
    """A unified diff on the dark terminal: added lines green, removed red."""
    def kind(line):
        if line.startswith(('+++', '---', '@@')):
            return ' class="hunk"'
        return ' class="add"' if line.startswith('+') else ' class="del"' if line.startswith('-') else ''
    return '<div class="term diff"><ol>' + ''.join(f'<li{kind(line)}>{e(line)}</li>' for line in lines) + '</ol></div>'


def term(text, empty='(empty)'):
    """Output as numbered lines on the dark terminal."""
    lines = str(text).splitlines() or [empty]
    return '<div class="term"><ol>' + ''.join(f'<li>{e(line)}</li>' for line in lines) + '</ol></div>'


def facts(rows):
    return '<table class="facts">' + ''.join(f'<tr><th>{e(name)}</th><td>{cell}</td></tr>' for name, cell in rows) + '</table>'


def unit_kind(units, name):
    unit = units.get(name)
    if not unit or unit.get('LoadState') == 'not-found':
        return 'muted'
    active = unit.get('ActiveState', '?')
    return 'ok' if active == 'active' else 'bad' if active == 'failed' else 'warn'


def installed(units, name):
    return unit_kind(units, name) != 'muted'


def unit_state(units, name):
    unit = units.get(name)
    if not unit or unit.get('LoadState') == 'not-found':
        return badge('not installed', 'muted')
    active = unit.get('ActiveState', '?')
    text = {'active': 'running', 'inactive': 'stopped', 'failed': 'failed', 'activating': 'starting'}.get(active, active)
    return badge(text, unit_kind(units, name)) + (f' <span class="muted">since {e(unit["ActiveEnterTimestamp"])}</span>'
                                                  if active == 'active' and unit.get('ActiveEnterTimestamp') else '')


GITHUB_URL = re.compile(r'https://github\.com/([A-Za-z0-9-]+)(?:/([A-Za-z0-9._-]+))?')


def runner_base(url):
    """The first runner's scope of an organization or repository (bin/install-runner names it so)."""
    match = GITHUB_URL.fullmatch(url or '')
    return (match[1] + (f'.{match[2]}' if match[2] else '')).lower() if match else None


def runner_instance(scope, base):
    """1 for the first runner of `base`, 2-9 for a further instance, None for another organization's."""
    if not base:
        return None
    if scope == base:
        return 1
    return int(scope[-1]) if re.fullmatch(re.escape(base) + r'\.[2-9]', scope) else None


def github_runners_page(url, tail=''):
    """GitHub's runner settings of the organization or repository (tail: /new, /<id>)."""
    match = GITHUB_URL.fullmatch(url or '')
    if not match:
        return None
    base = f'https://github.com/{match[1]}/{match[2]}' if match[2] else f'https://github.com/organizations/{match[1]}'
    return f'{base}/settings/actions/runners{tail}'


def environment_policy(state):
    """How often each backup series of an environment is made: server-status' backup_policy, the default for any series
    it does not give (an older server-status gives none)."""
    given = state.get('backup_policy') or {}
    return {series: given.get(series) if given.get(series) in BACKUP_POLICY[series] else default
            for series, default in BACKUP_DEFAULT.items()}


def policy_text(policy, files=True, database=True):
    """A policy in a few words: 'DB short daily · DB full weekly · files daily', 'DB full only, daily', 'DB off', 'off';
    files only when the environment has files to back up; no DB part without a database here (a files-only target)."""
    if not database:
        return f'files {policy["files"]}' if files else 'no backups (files only)'
    short, full, files_policy = policy['db-short'], policy['db-full'], policy['files'] if files else 'off'
    if short == full == files_policy == 'off':
        return 'off'
    parts = ([f'DB full only, {full}'] if short == 'off' and full != 'off' else ['DB off'] if short == 'off' else
             [f'DB short {short}', f'DB full {full}'])
    return ' · '.join(parts + ([f'files {policy["files"]}'] if files else []))


def policy_html(policy, files=True, database=True):
    """policy_text on a page: each part kept on one line, so a narrow cell wraps only between the parts."""
    return ' · '.join(f'<span class="nobreak">{e(part)}</span>' for part in policy_text(policy, files, database).split(' · '))


def files_only(state):
    """Whether an environment deploys to a files-only target (DEPLOY_MODE=files): no Docker there, so no containers,
    no secret store and no database here."""
    return (state or {}).get('mode') == 'files'


def has_files(state):
    """Whether an environment has files to back up (BACKUP_FILE_PATHS) or files backups kept."""
    return bool(state.get('file_paths') or (state.get('files_backups') or {}).get('count'))


def backup_watch(state):
    """(series, frequency, newest) of the DB backup an environment's alarm watches: the DB short (registry) series while
    it is on, else the DB full series while that is on; None when its database is not backed up at all (or there is no
    database here: a files-only target)."""
    if files_only(state):
        return None
    policy = environment_policy(state)
    if policy['db-short'] != 'off':
        return 'db-short', policy['db-short'], (state.get('backups') or {}).get('newest')
    if policy['db-full'] != 'off':
        return 'db-full', policy['db-full'], (state.get('full_backups') or {}).get('newest')
    return None


def backup_late(newest, frequency, now=None):
    """Whether the newest backup of a series made at that frequency is missing or older than it allows."""
    return not newest or (now or time.time()) - newest['time'] >= BACKUP_MAX_AGE[frequency]


def db_backup_problem(state):
    """'no DB short backup' / 'old DB short backup' (or 'no DB full backup' / 'old DB full backup' for a DB-full-only
    one) when the DB backup a deployed environment's policy asks for is missing or late; '' otherwise (development, off,
    fine)."""
    watch = None if not state.get('declared') or state.get('development') else backup_watch(state)
    if not watch or not backup_late(watch[2], watch[1]):
        return ''
    return ('old ' if watch[2] else 'no ') + BACKUP_SERIES[watch[0]]


def environment_kind(state):
    """The stripe of a project environment's row: bad when something needs a look, idle when not deployed from here."""
    deploys = state.get('deploys') or {}
    unhealthy = any(item.get('health') == 'unhealthy' for item in state.get('containers', []))
    if (deploys.get('last') or {}).get('failed') or state.get('secrets') == 'stopped' or unhealthy or db_backup_problem(state):
        return 'bad'
    return 'ok' if state.get('declared') else 'idle'


def level_chip(level):
    if level not in LEVEL_NOTES:
        return '<span class="lv lv-none">·</span>'
    return f'<span class="lv lv-{level}" title="{e(LEVEL_NOTES[level])}">{e(LEVEL_LABELS[level])}</span>'


def environment_order(name):
    """prod first, then stage, then any other environment by name."""
    return (('prod', 'stage').index(name) if name in ('prod', 'stage') else 2, name)


def env_class(name):
    """The class that keeps an environment in its own column: env-prod, env-stage or env-other."""
    return f'env-{name}' if name in ('prod', 'stage') else 'env-other'


def access_columns(data):
    """[(project, env)] a key may be granted: every environment the status shows, and any a key already has."""
    found = {(entry['name'], environment) for entry in (data or {}).get('projects', [])
             for environment, state in entry.get('environments', {}).items() if not state.get('development')}
    found |= {(grant['project'], grant['environment']) for key in (data or {}).get('keys', [])
              for grant in key.get('grants', []) + key.get('pulls', [])}
    return sorted(found, key=lambda item: (item[0], environment_order(item[1])))


def project_rows(columns):
    """[(project, [env, …])]: the columns grouped by project, in their order."""
    rows = []
    for project, environment in columns:
        if rows and rows[-1][0] == project:
            rows[-1][1].append(environment)
        else:
            rows.append((project, [environment]))
    return rows


ACTIVITY_WORDS = {'latest': 'backup name', 'info': 'backup size', 'get': 'downloaded a backup', 'fresh': 'ordered a fresh backup',
                  'access': 'access list', 'shell': 'shell', 'exec': 'command', 'host': 'server', 'docker': 'docker',
                  '': 'logged in'}


def key_grants(key, kind='access'):
    """{(project, env): level} of a key's access grants (make ssh) or its backups of single environments."""
    return {(grant['project'], grant['environment']): grant['level']
            for grant in (key or {}).get('grants' if kind == 'access' else 'pulls', [])}


def pull_level(key, project, environment):
    """The backups a key gets of one project environment: every project's level, or that environment's above it."""
    levels = ('none', *PULL_LEVELS)
    return max((key or {}).get('pull_all', 'none'), key_grants(key, 'backups').get((project, environment), 'none'),
               key=levels.index)


def git_line(state, tag_word=True):
    """A checkout's commit, its release tag and how far origin's master is ahead (as of its last fetch)."""
    if not state:
        return '<span class="muted">unknown</span>'
    text = f'<code>{e(state["commit"])}</code> '
    if tag_word:
        text += badge(state['tag'], 'ok') if state.get('tag') else badge('not a release tag', 'warn')
    behind = state.get('behind')
    if behind is None:
        text += ' ' + badge('origin/master unknown', 'muted')
    elif behind:
        text += ' ' + badge(f'master +{behind}', 'warn')
    else:
        text += ' ' + badge('up to date', 'ok')
    if state.get('fetched'):
        text += f' <span class="muted">checked {e(ago(state["fetched"]))}</span>'
    return text


def target_values(entry, environment):
    """The target an environment deploys to: its own target.<env>.env, else the shared target.env (as setup reads them)."""
    targets = entry.get('targets') or {}
    return targets.get(environment) or targets.get('all') or {}


def remote_target(values):
    """Whether a target is another server (over SSH): a Docker context of its own, or a files-only target's DEPLOY_SSH."""
    return bool(values.get('DEPLOY_SSH')) or values.get('DEPLOY_CONTEXT', 'default') != 'default'


FILES_CHIP = badge('files only', 'muted')


def target_place_text(values):
    """Where one target file deploys: this server and its directory, or user@host:path over SSH; a files-only one marked."""
    files = values.get('DEPLOY_MODE') == 'files'
    if not remote_target(values):
        text = f'this server <code>{e(values["DEPLOY_PATH"])}</code>' if values.get('DEPLOY_PATH') else 'this server'
        return text + (f' {FILES_CHIP}' if files else '')
    return e(f'{values.get("DEPLOY_SSH", "?")}:{values.get("DEPLOY_PATH", "?")}') + \
        (f' {FILES_CHIP}' if files else f' <span class="muted">(Docker context {e(values.get("DEPLOY_CONTEXT"))})</span>')


class Page:
    """Renders the pages; `token` is the CSRF token of the logged-in user, `permissions` what their groups give
    (section -> 'view' or 'manage'): the navigation shows what they see, the forms what they may run."""

    def __init__(self, user, token, permissions):
        self.user, self.token, self.permissions = user, token, permissions

    def can(self, section, level='view'):
        return PERMISSION_LEVELS.index(self.permissions.get(section, '')) >= PERMISSION_LEVELS.index(level)

    def may(self, action, fields=None):
        return any(self.can(section, 'manage') for section in action_sections(action, fields))

    def first_section(self):
        return next((href for key, href, _ in NAVIGATION if self.can(key)), None)

    def csrf_field(self):
        return f'<input type="hidden" name="csrf" value="{e(self.token)}">'

    def layout(self, title, body, refresh=None, section=None):
        head = f'<meta http-equiv="refresh" content="{int(refresh)}">' if refresh else ''
        marks = self.marks()
        navigation = ''.join(f'<a class="btn{" on" if key == section else ""}" href="{href}">{e(label)}{marks.get(key, "")}</a>'
                             for key, href, label in NAVIGATION if self.can(key))
        busy = running_job()
        busy = (f'<a class="busy" href="/job/{e(busy)}">{lamp("run")}action running</a>') if busy else ''
        if section in MANAGED_SECTIONS and self.can(section) and not self.can(section, 'manage'):
            body = ('<div class="callout"><p>View only: in this section your groups let you see but not change, '
                    'so there are no action buttons.</p></div>' + body)
        return (f'<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">'
                f'{head}<title>{e(title)} · Server OPS</title><link rel="stylesheet" href="/ui.css"></head><body>'
                f'<header class="top"><a class="mark" href="/">OPS<small>{e(socket.gethostname())}</small></a>'
                f'<nav class="nav">{navigation}</nav><span class="spacer"></span>{busy}'
                f'<div class="who"><b>{e(time.strftime("%H:%M"))}</b><a href="/account">{e(self.user)}</a>'
                f'<form class="logout" method="post" action="/logout">{self.csrf_field()}<button>Sign out</button></form>'
                f'</div></header><main><h1>{e(title)}</h1>{body}</main></body></html>')

    @staticmethod
    def marks():
        """Small marks on the navigation from the last status read (nothing is read for them): the number of
        developer keys, and whether an update waits or setup is off a release tag."""
        data = (CACHE.peek('status') or (None, None))[0]
        if not data:
            return {}
        versions = data.get('versions') or {}
        setup, server = versions.get('setup_git') or {}, versions.get('checkout_git') or {}
        marks = {'access': f'<i class="count">{len(data.get("keys", []))}</i>'}
        if setup and not setup.get('tag'):
            marks['update'] = '<i class="dot bad"></i>'
        elif setup.get('behind') or server.get('behind'):
            marks['update'] = '<i class="dot warn"></i>'
        return marks

    def hidden(self, action, fields=()):
        return (f'<input type="hidden" name="csrf" value="{e(self.token)}"><input type="hidden" name="action" value="{e(action)}">' +
                ''.join(f'<input type="hidden" name="{e(key)}" value="{e(text)}">' for key, text in fields))

    def form(self, action, title, fields, button='Preview', note='', command='', danger=False):
        if not self.may(action):
            return ''
        return (f'<form id="form-{e(action)}" class="action{" danger" if danger else ""}" method="post" action="/preview">'
                f'<h3>{e(title)}{f"<small>{e(command)}</small>" if command else ""}</h3>{self.hidden(action)}{fields}'
                f'<div class="form-foot"><p class="note">{note}</p><button>{e(button)}</button></div></form>')

    def button(self, action, fields, label, kind=''):
        """A one-button form (a unit's start/stop/restart): it leads to the same preview as any action."""
        if not self.may(action, fields):
            return ''
        return (f'<form method="post" action="/preview">{self.hidden(action, fields.items())}'
                f'<button class="{kind}">{e(label)}</button></form>')

    def unit_controls(self, unit, operations):
        return ''.join(self.button('unit', {'unit': unit, 'operation': operation}, OPERATION_TITLES[operation],
                                   'stop' if operation == 'stop' else '') for operation in operations)

    @staticmethod
    def tile(name, kind, state, detail='', controls=''):
        detail = f'<div class="detail">{detail}</div>' if detail else ''
        controls = f'<div class="controls">{controls}</div>' if controls else ''
        return f'<div class="unit is-{kind}"><div class="name">{lamp(kind)}{e(name)}</div><div class="state">{state}</div>{detail}{controls}</div>'

    # --- Overview ---
    def overview(self, data, error):
        if data is None:
            return self.layout('Overview', f'<div class="callout bad"><p>Could not get the status: {e(error)}</p></div>',
                               section='overview')
        units = data.get('units', {})
        versions = data.get('versions') or {}
        projects = data.get('projects', [])
        disk = data.get('disk') or {}
        share = disk['available'] / disk['size'] if disk.get('size') else None
        stats = [(len(projects), 'projects'), (sum(len(item.get('environments', {})) for item in projects), 'environments'),
                 (f'{share:.0%}' if share is not None else '?', 'disk free'),
                 (versions.get('installed') or '?', 'Server OPS'), (versions.get('setup') or '?', 'setup')]
        body = '<div class="stats">' + ''.join(f'<div class="stat"><b>{e(number)}</b><span>{e(label)}</span></div>'
                                               for number, label in stats) + '</div>'
        body += self.attention(data)
        tiles = []
        installed_version, checkout = versions.get('installed'), versions.get('checkout')
        differs = checkout and installed_version and checkout != installed_version
        server_git, setup_git = versions.get('checkout_git') or {}, versions.get('setup_git') or {}
        tiles.append(self.tile('Server OPS', 'warn' if differs or server_git.get('behind') else 'ok', e(installed_version or '?'),
                               (f'clone: {e(checkout)}; ' if differs else '') + git_line(server_git or None, False),
                               '<a class="btn" href="/update">Update</a>'))
        tiles.append(self.tile('setup (shared checkout)', 'bad' if setup_git and not setup_git.get('tag') else
                               'warn' if not versions.get('setup') or setup_git.get('behind') else 'ok',
                               e(versions.get('setup') or '?'), git_line(setup_git or None),
                               '<a class="btn" href="/update">Update</a>'))
        runner = 'setup-server-runner.service'
        scopes = data.get('github_runners', [])
        names = [runner] * installed(units, runner) + [f'setup-server-github-runner@{scope}.service' for scope in scopes]
        kinds = [unit_kind(units, name) for name in names]
        kind = 'bad' if 'bad' in kinds else 'warn' if 'warn' in kinds else 'ok' if names else 'muted'
        working = sum(1 for name in names if (units.get(name) or {}).get('ActiveState') == 'active')
        busy = sum(1 for item in (data.get('github_runner_details') or {}).values() if item.get('busy'))
        tiles.append(self.tile('Runners', kind, badge(f'{working} of {len(names)} running', kind) if names else badge('none', 'muted'),
                               f'GitHub: {len(scopes)}; Bitbucket: {"yes" if installed(units, runner) else "no"}; '
                               f'running a job: {busy}',
                               '<a class="btn" href="/runners">Manage</a>' if self.can('runners') else ''))
        for unit, label, operation in (('setup-server-backup', 'Nightly DB backups', 'backup'),
                                       ('setup-server-backup-full', 'Weekly full DB backups', 'backup-full'),
                                       ('setup-server-backup-files', 'Nightly files backups', 'backup-files')):
            timer, service = units.get(f'{unit}.timer', {}), units.get(f'{unit}.service', {})
            if timer and timer.get('LoadState') != 'not-found':
                result = service.get('Result')
                last = timer.get('LastTriggerUSec') or service.get('ExecMainExitTimestamp')
                kind = 'bad' if result and result != 'success' else unit_kind(units, f'{unit}.timer')
                if service.get('ActiveState') == 'activating':
                    kind = 'run'
                text = unit_state(units, f'{unit}.timer')
                if result:
                    text += ' ' + (badge('succeeded', 'ok') if result == 'success' else badge(f'failed ({result})', 'bad'))
                detail = (f'last {e(last)}' if last else 'not run yet') + \
                    (f'<br>next {e(timer["NextElapseUSecRealtime"])}' if timer.get('NextElapseUSecRealtime') else '')
                controls = self.button('unit', {'unit': operation, 'operation': 'start'}, 'Start now') \
                    if installed(units, f'{unit}.service') else ''
                tiles.append(self.tile(label, kind, text, detail, controls))
            else:
                tiles.append(self.tile(label, 'muted', badge('not installed', 'muted'),
                                       controls='<a class="btn" href="/actions#form-install-backups">Install</a>'))
        metrics = 'setup-server-metrics.service'
        tiles.append(self.tile('Metrics (/metrics)', unit_kind(units, metrics), unit_state(units, metrics),
                               controls=(self.unit_controls('metrics', UNIT_OPERATIONS['metrics']) +
                                         '<a class="btn" href="/worker-metrics">Show</a>') if installed(units, metrics)
                               else '<a class="btn" href="/actions#form-install-metrics">Install</a>'))
        ui = 'setup-server-ui.service'
        tiles.append(self.tile('Web UI', unit_kind(units, ui), unit_state(units, ui),
                               'a restart rereads the ui.env tokens; open previews are lost',
                               self.unit_controls('ui', UNIT_OPERATIONS['ui']) if installed(units, ui) else ''))
        if disk.get('size'):
            tiles.append(self.tile(f'Disk ({disk["path"]})', 'ok' if share > 0.15 else 'bad',
                                   badge(f'{size(disk["available"])} free of {size(disk["size"])} ({share:.0%})',
                                         'ok' if share > 0.15 else 'bad')))
        body += '<h2>Server</h2><div class="units">' + ''.join(tiles) + '</div>'
        body += '<h2>Projects</h2>' + self.projects_summary(data)
        if data.get('errors'):
            body += '<h2>What could not be read</h2><div class="callout warn">' + \
                ''.join(f'<p>{e(item)}</p>' for item in data['errors']) + '</div>'
        body += (f'<p class="foot">Status: {e(local_time(data.get("generated", time.time())))} · '
                 '<a href="/?fresh=1">Refresh</a></p>')
        return self.layout('Overview', body, section='overview')

    # What a folded group of per-environment alerts says after its count.
    ATTENTION_GROUPS = {'deploy-failed': 'environments: the last deploy failed', 'secrets-stopped': 'environments: secret store stopped',
                        'unhealthy': 'environments have unhealthy containers', 'no-backup': 'environments have no DB backup',
                        'old-backup': 'environments have an old DB backup', 'no-files-backup': 'environments have no files backup',
                        'old-files-backup': 'environments have an old files backup'}
    ATTENTION_FOLD = 3  # more of one kind than this – folded

    @staticmethod
    def attention_items(data):
        """(group, kind, text, href) of what needs a look, gathered from the whole status, each with where to act on it
        (plain text): the server's own (group None) first, then each project environment's (group: its kind of alarm).
        The Overview's list and the API's /api/v1/overview both show these."""
        items = []
        units = data.get('units', {})
        for name, unit in sorted(units.items()):
            if unit.get('ActiveState') == 'failed':
                items.append((None, 'bad', f'{name}: failed', '/logs'))
            elif name.endswith('.service') and unit.get('Result') not in (None, '', 'success') and unit.get('LoadState') != 'not-found':
                items.append((None, 'bad', f'{name}: the last run failed ({unit["Result"]})', '/logs'))
        versions = data.get('versions') or {}
        setup = versions.get('setup_git') or {}
        if setup and not setup.get('tag'):
            items.append((None, 'bad', 'setup is not on a release tag: prod deploys will not work', '/update'))
        updates = [label for label, state in (('setup', setup), ('Server OPS', versions.get('checkout_git') or {}))
                   if state.get('behind')]
        if updates:
            items.append((None, 'warn', 'A newer ' + ' and '.join(updates) + ' is available', '/update'))
        disk = data.get('disk') or {}
        if disk.get('size') and disk['available'] / disk['size'] <= 0.15:
            items.append((None, 'bad', f'Only {size(disk["available"])} free on the disk', '/'))
        for entry in data.get('projects', []):
            link = f'/project/{quote(entry["name"])}'
            for environment, state in entry.get('environments', {}).items():
                where = f'{entry["name"]} {environment}'
                last = ((state.get('deploys') or {}).get('last') or {})
                if last.get('failed'):
                    items.append(('deploy-failed', 'bad', f'{where}: the deploy failed ({last["failed"]})', link))
                if state.get('secrets') == 'stopped':
                    items.append(('secrets-stopped', 'bad', f'{where}: secret store stopped', link))
                unhealthy = [item['name'] for item in state.get('containers', []) if item.get('health') == 'unhealthy']
                if unhealthy:
                    items.append(('unhealthy', 'bad', f'{where}: unhealthy {", ".join(unhealthy)}', link))
                # An environment with no target deploys nowhere: nothing to back up, so no alarm (the Projects page shows it
                # quietly); nor is a series its backup policy turns off.
                for series, problem, newest in Page.backup_problems(entry, environment, units):
                    what = BACKUP_SERIES[series].replace('Files', 'files')
                    items.append((f'{problem}-{"files-" if series == "files" else ""}backup', 'bad',
                                  f'{where}: newest {what} ' + (ago(newest['time']) if newest else 'none'),
                                  f'/files/{quote(entry["name"])}/{quote(environment)}' if series == 'files' else
                                  f'{link}#backup-{quote(environment)}'))
        return items

    @staticmethod
    def attention(data):
        """What needs a look (attention_items), as the Overview's list."""
        ATTENTION_GROUPS, ATTENTION_FOLD = Page.ATTENTION_GROUPS, Page.ATTENTION_FOLD
        found = Page.attention_items(data)
        items = [(kind, e(text), href) for group, kind, text, href in found if group is None]
        # Per environment: the same kind may repeat for many projects; a kind repeated more than ATTENTION_FOLD
        # times folds into one counted <details> (its summary says how many), below the distinct alerts.
        grouped, ordered = {}, []
        for group, kind, text, href in found:
            if group is not None:
                grouped.setdefault(group, []).append((kind, e(text), href))
                ordered.append((group, (kind, e(text), href)))
        if not items and not grouped:
            return f'<div class="attention calm">{lamp("ok")}<span>All is well: nothing needs attention.</span></div>'
        items += [item for group, item in ordered if len(grouped[group]) <= ATTENTION_FOLD]
        folded = [(group, members) for group, members in grouped.items() if len(members) > ATTENTION_FOLD]
        line = lambda kind, text, href: f'<li><a href="{e(href)}">{lamp(kind)}<span>{text}</span></a></li>'
        total = len(items) + sum(len(members) for _, members in folded)
        body = '<div class="attention"><p class="attention-title">Needs attention · ' + str(total) + '</p>'
        if items:
            body += '<ul>' + ''.join(line(*item) for item in items) + '</ul>'
        for group, members in folded:
            body += (f'<details class="attention-group"><summary>{lamp("bad")}<span>{len(members)} {e(ATTENTION_GROUPS[group])}</span>'
                     '</summary><ul>' + ''.join(line(*item) for item in members) + '</ul></details>')
        return body + '</div>'

    @staticmethod
    def backup_problems(entry, environment, units):
        """[(series, 'no' | 'old', newest)] of a deployed environment: the DB backup its policy watches (backup_watch), and
        its files backup while the files timer is installed and the policy keeps files on, when missing or late."""
        state = (entry.get('environments') or {}).get(environment) or {}
        if not Page.registered(entry, environment) or not state.get('declared') or state.get('development'):
            return []
        found = []
        watch = backup_watch(state)
        if watch and backup_late(watch[2], watch[1]):
            found.append((watch[0], 'old' if watch[2] else 'no', watch[2]))
        frequency, newest = environment_policy(state)['files'], (state.get('files_backups') or {}).get('newest')
        if state.get('file_paths') and frequency != 'off' and installed(units, 'setup-server-backup-files.timer') and \
                backup_late(newest, frequency):
            found.append(('files', 'old' if newest else 'no', newest))
        return found

    # One compact row per project, its environments side by side: readable with 50 projects (Projects, Overview).
    PROJECT_COLUMNS = (('prod', 'Prod'), ('stage', 'Stage'), ('', 'Others'))

    def project_environment(self, entry, environment):
        """(kind, problems) of one project environment: kind as environment_kind, problems the words that made it bad."""
        state = dict((entry.get('environments') or {}).get(environment) or {})
        if not self.registered(entry, environment):
            state['declared'] = False  # no target: "no target" says it once; no backup or secrets is no alarm of its own
        last = (state.get('deploys') or {}).get('last') or {}
        backup = db_backup_problem(state)
        problems = [word for word, wrong in (
            ('deploy failed', last.get('failed')), ('secrets stopped', state.get('secrets') == 'stopped'),
            ('unhealthy', any(item.get('health') == 'unhealthy' for item in state.get('containers', []))),
            (backup, backup)) if wrong]
        return environment_kind(state), problems

    @staticmethod
    def project_kind(kinds):
        """A project's stripe from its environments': bad wins, then ok, else idle."""
        return 'bad' if 'bad' in kinds else 'ok' if 'ok' in kinds else 'idle'

    @staticmethod
    def target_short(entry, environment):
        """(a few words, the whole target) of where an environment deploys; None when it has no target."""
        state = (entry.get('environments') or {}).get(environment) or {}
        if state.get('development'):
            return 'this server · development', ''
        values = target_values(entry, environment)
        if not values:
            return None
        if not remote_target(values):
            path = values.get('DEPLOY_PATH') or ''
            return ('this server', path) if not path or path.endswith(f'/projects/{entry["name"]}') else (f'local:{path}', path)
        return f'ssh {values.get("DEPLOY_SSH") or "?"}', f'{values.get("DEPLOY_SSH", "?")}:{values.get("DEPLOY_PATH", "?")}'

    def environment_summary(self, entry, environment, kind, problems, named=False):
        """An environment in two short lines: a lamp, the last deploy and what is wrong; then the target and the newest backup."""
        state = (entry.get('environments') or {}).get(environment) or {}
        sign = f'<span class="sign {e(environment)}">{e(environment)}</span> ' if named else ''
        target = self.target_short(entry, environment)
        if target is None:
            return f'<span class="envline">{sign}{lamp("muted")}<span class="muted">— no target</span></span>'
        last = (state.get('deploys') or {}).get('last')
        deploy, note = '<span class="muted">not deployed yet</span>', ''
        if last and last.get('at'):
            # The branch first (once: not when the ref is that branch), then the ref, its age and how far behind.
            ref, branch = deployed_ref(last), last.get('branch') or {}
            name = branch.get('name') if branch_note(branch) else None
            behind = branch.get('behind') if name and isinstance(branch.get('behind'), int) else 0
            deploy = (f'{e(name) + " · " if name and name != ref else ""}<b>{e(ref)}</b> '
                      f'<span class="muted">{e(ago(last["at"]))}{f" · {behind} behind" if behind else ""}</span>')
            note = f' title="{e(f"branch {name}: {branch_note(branch)}")}"' if name else ''
        chips = ''.join(' ' + badge(word, 'bad') for word in problems) + (f' {FILES_CHIP}' if files_only(state) else '')
        backup = '' if state.get('development') else ' · ' + e(self.backup_short(state))
        title = f' title="{e(target[1])}"' if target[1] else ''
        return (f'<span class="envline"{note}>{sign}{lamp(kind if kind != "idle" else "muted")}{deploy}{chips}</span>'
                f'<small class="envline"{title}>{e(target[0])}{backup}</small>')

    @staticmethod
    def backup_short(state):
        """The newest DB backup the policy watches, in a few words: 'DB short 5 h ago', 'DB full 2 d ago' (DB full only),
        'no DB short backup', 'backups off' (nothing at all) or 'DB backups off' (files only). A files-only target has no
        database here: its files backup, 'files 3 h ago', 'no files backup', or 'no DB here'."""
        if files_only(state):
            newest = (state.get('files_backups') or {}).get('newest')
            if not has_files(state) or environment_policy(state)['files'] == 'off':
                return 'no DB here'
            return f'files {ago(newest["time"])}' if newest else 'no files backup'
        watch = backup_watch(state)
        if watch is None:
            return 'backups off' if environment_policy(state)['files'] == 'off' or not has_files(state) else 'DB backups off'
        series, _, newest = watch
        words = BACKUP_SERIES[series]
        return f'{words.removesuffix(" backup")} {ago(newest["time"])}' if newest else f'no {words}'

    def project_rows(self, projects):
        """(project, kind, problems, row) for each project: its compact row and whether it needs a look."""
        found = []
        for entry in projects:
            environments = entry.get('environments') or {}
            states = {environment: self.project_environment(entry, environment) for environment in environments}
            kind = self.project_kind([item[0] for item in states.values()])
            problems = [word for item in states.values() for word in item[1]]
            link = f'/project/{e(quote(entry["name"]))}'
            repos = ' · '.join(item for item in (entry.get('repository'), entry.get('code_repository')) if item)
            cells = (f'<td class="project" data-label="Project"><a href="{link}">{e(entry["name"])}</a>' +
                     (f'<small title="{e(repos)}">{e(repos)}</small>' if repos else '') + '</td>')
            if not environments:
                cells += ('<td class="envcell none" data-label="Prod"></td><td class="envcell none" data-label="Stage"></td>'
                          '<td class="envcell muted" data-label="Others">not deployed from here (no env/stage.env or env/prod.env)</td>')
            for key, label in self.PROJECT_COLUMNS if environments else ():
                members = [key] if key else sorted((name for name in environments if name not in ('prod', 'stage')), key=environment_order)
                members = [name for name in members if name in environments]
                summary = ''.join(f'<div class="env-item">{self.environment_summary(entry, name, *states[name], named=not key)}</div>'
                                  for name in members)
                summary = f'<div class="env-list">{summary}</div>' if summary else ''
                cells += f'<td class="envcell{"" if members else " none"}" data-label="{label}">{summary}</td>'
            found.append((entry, kind, problems, f'<tr class="is-{kind}">{cells}</tr>'))
        return found

    def projects_board(self, rows):
        return ('<div class="scroll"><table class="board projects"><thead><tr><th scope="col">Project</th>' +
                ''.join(f'<th scope="col">{label}</th>' for _, label in self.PROJECT_COLUMNS) +
                '</tr></thead><tbody>' + ''.join(row for *_, row in rows) + '</tbody></table></div>')

    def projects_summary(self, data):
        """The Overview's part: the counts, only the projects that need a look, and the way to all of them."""
        projects = data.get('projects', [])
        if not projects:
            return '<div class="empty">No projects yet. <a href="/projects/new">Add a project</a></div>'
        rows = sorted((row for row in self.project_rows(projects) if row[1] == 'bad'), key=lambda row: row[0]['name'])
        count = sum(len(entry.get('environments') or {}) for entry in projects)
        body = (f'<p class="note">{len(projects)} projects, {count} environments: ' +
                (f'{len(rows)} need{"s" if len(rows) == 1 else ""} a look.</p>' + self.projects_board(rows) if rows else
                 'nothing needs a look.</p>'))
        return body + '<p><a class="btn" href="/projects">All projects →</a></p>'

    @staticmethod
    def registered(entry, environment):
        """Whether an environment deploys anywhere: a development one here, else a registered target."""
        if (entry.get('environments', {}).get(environment) or {}).get('development'):
            return True
        return bool(target_values(entry, environment))

    @staticmethod
    def target(entry, environment):
        if entry.get('environments', {}).get(environment, {}).get('development'):
            return 'this server · development environment'
        values = target_values(entry, environment)
        if not values:
            return badge('not registered', 'warn')
        if not remote_target(values):
            return 'this server'
        return e(f'{values.get("DEPLOY_SSH", "?")}:{values.get("DEPLOY_PATH", "?")}')

    @staticmethod
    def deploy_cell(state):
        """The project page's last deploy: its branch, ref, commit (once), age and outcome."""
        deploys = state.get('deploys')
        if not deploys:
            return '<span class="muted">none yet</span>'
        last = deploys['last']
        text = deploy_shown(last)
        if last.get('failed'):
            text += ' ' + badge(f'failed ({last["failed"]})', 'bad')
        else:
            text += ' ' + badge('succeeded', 'ok')
        if last.get('rollback'):
            text += ' ' + badge('rollback', 'warn')
        return text

    @staticmethod
    def series_cell(state, key, frequency, missing):
        """The newest backup of one series: its age, green while its policy's frequency allows it (daily 26 h, weekly
        8 days, monthly 29 days), red after; 'off' when the policy turns the series off (what is kept still shown)."""
        backups = state.get(key) or {}
        newest = backups.get('newest')
        kept = f' {e(size(newest["size"]))}, {backups.get("count", 0)} kept' if newest else ''
        if frequency == 'off':
            return badge('off', 'muted') + (f' <span class="muted">newest {e(ago(newest["time"]))},{kept}</span>' if newest else '')
        if not newest:
            return badge('none', missing)
        return badge(ago(newest['time']), 'bad' if backup_late(newest, frequency) else 'ok') + kept

    @staticmethod
    def backup_cell(state):
        if state.get('development'):
            return '<span class="muted">the application\'s recovery backups</span>'
        return Page.series_cell(state, 'backups', environment_policy(state)['db-short'], 'bad' if state.get('declared') else 'muted')

    @staticmethod
    def full_backup_cell(state):
        """The DB full series (full-<env>): red when missing only while it is the series the alarm watches (DB full only)."""
        watched = (backup_watch(state) or ('',))[0] == 'db-full' and state.get('declared')
        return Page.series_cell(state, 'full_backups', environment_policy(state)['db-full'], 'bad' if watched else 'muted')

    @staticmethod
    def fresh_backup_cell(state):
        backups = state.get('fresh_backups') or {}
        newest = backups.get('newest')
        if not newest:
            return '<span class="muted">none yet</span>'
        return f'{e(ago(newest["time"]))}, {e(size(newest["size"]))}, {backups.get("count", 0)} kept'

    @staticmethod
    def secrets_cell(state):
        if state.get('development'):
            return '<span class="muted">local configuration</span>'
        return {'running': badge('running', 'ok'), 'stopped': badge('stopped', 'bad')}.get(
            state.get('secrets'), badge('none', 'warn' if state.get('declared') else 'muted'))

    @staticmethod
    def containers_cell(state):
        found = state.get('containers', [])
        if not found:
            return '<span class="muted">none</span>'
        running = sum(1 for item in found if item['state'] == 'running')
        unhealthy = [item['name'] for item in found if item.get('health') == 'unhealthy']
        text = badge(f'{running}/{len(found)} running', 'ok' if running == len(found) else 'warn')
        return text + (' ' + badge('unhealthy: ' + ', '.join(unhealthy), 'bad') if unhealthy else '')

    @staticmethod
    def run_cell(run, repository):
        state = run.get('state', {}) or {}
        result = (state.get('result') or {}).get('name') or state.get('name', '?')
        kind = 'ok' if result == 'SUCCESSFUL' else 'bad' if result in ('FAILED', 'ERROR') else 'warn'
        target = run.get('target', {}) or {}
        pattern = (target.get('selector') or {}).get('pattern') or target.get('ref_name') or ''
        link = f'{BITBUCKET_WEB}/{quote(repository[0])}/{quote(repository[1])}/pipelines/results/{int(run.get("build_number", 0))}'
        return (f'<a href="{e(link)}">#{e(run.get("build_number", "?"))}</a> {e(pattern)} {badge(result, kind)} '
                f'<span class="muted when">{e((run.get("created_on") or "")[:16].replace("T", " "))}</span>')

    # --- Projects ---
    def projects(self, data, error, query=None):
        """Every project, one row each, those that need a look first; filtered by name or repo, or to the problems only."""
        if data is None:
            return self.layout('Projects', f'<div class="callout bad"><p>Could not get the status: {e(error)}</p></div>',
                               section='projects')
        query = query or {}
        wanted = query.get('q', [''])[0].strip()[:64]
        only_problems = query.get('problems') == ['1']
        by_name = query.get('sort') == ['name']
        projects = data.get('projects', [])
        rows = self.project_rows(projects)
        environments = [(entry, environment) for entry in projects for environment in (entry.get('environments') or {})]
        problems = [set(self.project_environment(entry, environment)[1]) for entry, environment in environments]
        stats = [(len(projects), 'projects'), (len(environments), 'environments'),
                 (sum(1 for words in problems if words - BACKUP_WORDS), 'failing'),
                 (sum(1 for words in problems if words & BACKUP_WORDS), 'without a recent backup'),
                 (sum(1 for entry, environment in environments if not self.registered(entry, environment)), 'without a target')]
        body = '<div class="stats">' + ''.join(f'<div class="stat"><b>{e(number)}</b><span>{e(label)}</span></div>'
                                               for number, label in stats) + '</div>'
        text = wanted.lower()
        shown = [row for row in rows if (not text or any(text in (item or '').lower() for item in (
            row[0]['name'], row[0].get('repository'), row[0].get('code_repository')))) and (not only_problems or row[1] == 'bad')]
        shown.sort(key=lambda row: row[0]['name'] if by_name else (row[1] != 'bad', row[0]['name']))
        body += ('<div class="toolbar"><form class="search" method="get" action="/projects">'
                 f'<input type="text" name="q" value="{e(wanted)}" placeholder="project or repo" autocomplete="off">'
                 '<label class="check"><input type="checkbox" name="problems" value="1"' + (' checked' if only_problems else '') +
                 '> only with problems</label><select name="sort"><option value="state">problems first</option>'
                 '<option value="name"' + (' selected' if by_name else '') + '>by name</option></select>'
                 f'<button>Filter</button></form><span class="note shown">{len(shown)} of {len(projects)}</span>'
                 '<a class="btn" href="/projects/backups">Backups →</a>' +
                 ('<a class="btn go" href="/projects/new">+ Add a project</a>' if self.may('add-project') else '') + '</div>')
        if not projects:
            body += '<div class="empty">No projects yet.' + (' <a href="/projects/new">Add a project</a>' if self.may('add-project') else '') + '</div>'
        elif not shown:
            body += '<div class="empty">No project matches. <a href="/projects">All projects</a></div>'
        else:
            body += self.projects_board(shown)
            body += ('<p class="note">Each environment: a lamp, the last deploy and what is wrong; below it where it deploys and the '
                     'newest DB backup its backup policy watches (the DB full one when it backs up DB full only). A files only chip: a '
                     'deploy copies only the code there – no Docker, no database here (its files backup is shown). A project\'s page has its '
                     'settings: each environment\'s target and backup policy, a new environment, removing. '
                     '<a href="/projects/backups">Backups</a>: every environment\'s policy and newest backups.</p>')
        if data.get('errors'):
            body += '<h2>What could not be read</h2><div class="callout warn">' + \
                ''.join(f'<p>{e(item)}</p>' for item in data['errors']) + '</div>'
        body += (f'<p class="foot">Status: {e(local_time(data.get("generated", time.time())))} · '
                 '<a href="/projects?fresh=1">Refresh</a></p>')
        return self.layout('Projects', body, section='projects')

    # The Backups page's policy filter: (value, words, which policies it keeps).
    POLICY_FILTERS = (('', 'any policy', lambda policy: True),
                      ('custom', 'not the default', lambda policy: policy != BACKUP_DEFAULT),
                      ('db-full-only', 'DB full only', lambda policy: policy['db-short'] == 'off' and policy['db-full'] != 'off'),
                      ('db-off', 'DB off', lambda policy: policy['db-short'] == policy['db-full'] == 'off'))

    @staticmethod
    def newest_cell(state, key, frequency, problem):
        """A series on the Backups page: the newest one's age, 'late' or 'none' in red when it is the alarm's, off quiet."""
        newest = (state.get(key) or {}).get('newest')
        if frequency == 'off':
            return '<span class="muted">off' + (f' · newest {e(ago(newest["time"]))}' if newest else '') + '</span>'
        if not newest:
            return badge('none', 'bad') if problem else '<span class="muted">none</span>'
        return e(ago(newest['time'])) + (' ' + badge('late', 'bad') if problem else '')

    @staticmethod
    def backup_rows(data):
        """Every deployed (not development) project environment's backups: entry, environment, state, policy, files (it
        has files to back up), database (one here: not a files-only target), problems (backup_problems), registered
        and kind (bad: late or missing; idle: no target or nothing backed up; else ok). The Backups page and the API's
        /api/v1/backups."""
        units = data.get('units', {})
        rows = []
        for entry in data.get('projects', []):
            for environment in sorted(entry.get('environments') or {}, key=environment_order):
                state = entry['environments'][environment] or {}
                if state.get('development'):
                    continue
                policy, files, database = environment_policy(state), has_files(state), not files_only(state)
                problems = Page.backup_problems(entry, environment, units)
                registered = bool(Page.registered(entry, environment) and state.get('declared'))
                kind = 'bad' if problems else 'idle' if not registered or (
                    backup_watch(state) is None and (policy['files'] == 'off' or not files)) else 'ok'
                rows.append({'entry': entry, 'environment': environment, 'state': state, 'policy': policy, 'files': files,
                             'database': database, 'problems': problems, 'registered': registered, 'kind': kind})
        return rows

    def backups_page(self, data, error, query=None):
        """Every project environment's backup policy and its newest DB short, DB full and files backup: those late or missing
        first, filtered like Projects; each row leads to the environment's policy form on its project page."""
        if data is None:
            return self.layout('Backups', f'<div class="callout bad"><p>Could not get the status: {e(error)}</p></div>',
                               section='projects')
        query = query or {}
        wanted = query.get('q', [''])[0].strip()[:64]
        only_problems = query.get('problems') == ['1']
        by_name = query.get('sort') == ['name']
        chosen = query.get('policy', [''])[0]
        keep = next((test for key, _, test in self.POLICY_FILTERS if key == chosen), None)
        if keep is None:
            chosen, keep = '', self.POLICY_FILTERS[0][2]
        rows = []
        for row in self.backup_rows(data):
            entry, environment, state, policy = row['entry'], row['environment'], row['state'], row['policy']
            files, database, kind, registered = row['files'], row['database'], row['kind'], row['registered']
            late = {series for series, *_ in row['problems']}
            link = f'/project/{e(quote(entry["name"]))}#backup-{e(quote(environment))}'
            note = '' if registered else '<small>no target: no alarm</small>'
            no_database = '<span class="muted" title="a files-only target: no database here">n/a (files only)</span>'
            # Each value in one <span>: on a phone the cell is a row of its label and that.
            values = (('Environment', f'<span class="sign {e(environment)}">{e(environment)}</span>'),
                      ('Policy', policy_html(policy, files, database) +
                       (' <span class="muted">· default</span>' if policy == BACKUP_DEFAULT and database else '')),
                      ('DB short', self.newest_cell(state, 'backups', policy['db-short'], 'db-short' in late)
                       if database else no_database),
                      ('DB full', self.newest_cell(state, 'full_backups', policy['db-full'], 'db-full' in late)
                       if database else no_database),
                      ('Files', self.newest_cell(state, 'files_backups', policy['files'], 'files' in late) if files else
                       '<span class="muted" title="no BACKUP_FILE_PATHS">—</span>'))
            cells = (f'<td class="project" data-label="Project"><a href="{link}">{e(entry["name"])}</a>{note}</td>' +
                     ''.join(f'<td data-label="{label}"><span>{text}</span></td>' for label, text in values))
            rows.append((entry, environment, policy, kind, f'<tr class="is-{kind}">{cells}</tr>'))
        stats = [(len(rows), 'environments'), (sum(1 for row in rows if row[3] == 'bad'), 'late or missing'),
                 *((sum(1 for row in rows if test(row[2])), words) for key, words, test in self.POLICY_FILTERS[1:])]
        body = '<div class="stats">' + ''.join(f'<div class="stat"><b>{e(number)}</b><span>{e(label)}</span></div>'
                                               for number, label in stats) + '</div>'
        text = wanted.lower()
        shown = [row for row in rows if (not text or any(text in (item or '').lower() for item in (
            row[0]['name'], row[0].get('repository'), row[0].get('code_repository')))) and
            (not only_problems or row[3] == 'bad') and keep(row[2])]
        shown.sort(key=lambda row: (row[0]['name'], environment_order(row[1])) if by_name else
                   (row[3] != 'bad', row[0]['name'], environment_order(row[1])))
        body += ('<div class="toolbar"><form class="search" method="get" action="/projects/backups">'
                 f'<input type="text" name="q" value="{e(wanted)}" placeholder="project or repo" autocomplete="off">'
                 '<label class="check"><input type="checkbox" name="problems" value="1"' + (' checked' if only_problems else '') +
                 '> only late or missing</label><select name="policy">' +
                 ''.join(f'<option value="{key}"{" selected" if key == chosen else ""}>{e(words)}</option>'
                         for key, words, _ in self.POLICY_FILTERS) +
                 '</select><select name="sort"><option value="state">problems first</option>'
                 '<option value="name"' + (' selected' if by_name else '') + '>by name</option></select>'
                 f'<button>Filter</button></form><span class="note shown">{len(shown)} of {len(rows)}</span>'
                 '<a class="btn" href="/projects">← Projects</a></div>')
        if not rows:
            body += '<div class="empty">No project environment is backed up here yet. <a href="/projects">Projects</a></div>'
        elif not shown:
            body += '<div class="empty">No environment matches. <a href="/projects/backups">All environments</a></div>'
        else:
            body += ('<div class="scroll"><table class="board backups"><thead><tr><th scope="col">Project</th>'
                     '<th scope="col">Environment</th><th scope="col">Policy</th><th scope="col">DB short</th><th scope="col">DB full</th>'
                     '<th scope="col">Files</th></tr></thead><tbody>' + ''.join(row[-1] for row in shown) + '</tbody></table></div>')
            body += ('<p class="note">The newest backup of each series and how old it is. Red: the series the alarm watches is late '
                     'or missing – the DB short one, or the DB full one when the policy backs up DB full only (daily 26 h, weekly 8 days, '
                     'monthly 29 days); files while the files timer runs. A series the policy turns off is no alarm; — in Files: '
                     'the project lists no BACKUP_FILE_PATHS; n/a (files only): a files-only target has no database here. '
                     'A row leads to the environment\'s policy form on its project page.</p>')
        body += (f'<p class="foot">Status: {e(local_time(data.get("generated", time.time())))} · '
                 '<a href="/projects/backups?fresh=1">Refresh</a></p>')
        return self.layout('Backups', body, section='projects')

    @staticmethod
    def text_field(key, label, placeholder='', current=''):
        # autocomplete off: a browser must not fill in a value typed for another project (a build root name).
        return (f'<label><span>{e(label)}</span><input type="text" name="{key}" value="{e(current)}" '
                f'placeholder="{e(placeholder)}" autocomplete="off" spellcheck="false"></label>')

    @staticmethod
    def target_field(key, mode_key, label, placeholder='', current='', mode='docker'):
        """A target's field with its type in front: Docker stack (the project's containers run there) or Files only (a
        deploy copies only the code there; bin/add-project --target files:…)."""
        options = ''.join(f'<option value="{value}"{" selected" if value == mode else ""}>{e(words)}</option>'
                          for value, words in TARGET_MODES)
        return (f'<label><span>{e(label)}</span><span class="typed"><select name="{mode_key}" aria-label="{e(label)}: type">'
                f'{options}</select><input type="text" name="{key}" value="{e(current)}" placeholder="{e(placeholder)}" '
                'autocomplete="off" spellcheck="false"></span></label>')

    def project_new(self, target=''):
        """The add form; target ([ENV=]TARGET, from the instructions) fills the field it belongs to."""
        given = {'all': '', 'prod': '', 'stage': '', 'more': ''}
        modes = {'all': 'docker', 'prod': 'docker', 'stage': 'docker'}
        if target:
            scope = target_scope(target)
            if scope in ('prod', 'stage') or not scope:
                place = target.split('=', 1)[1] if scope else target
                key = scope or 'all'
                if place.startswith('files:'):
                    place, modes[key] = place[len('files:'):], 'files'
                given[key] = place
            else:
                given['more'] = target
        text, typed = self.text_field, self.target_field
        steps = ('<ol class="steps-list"><li>The <b>env repo</b> (app/: Makefile, env/) is cloned into the build root; a separate '
                 '<b>code repo</b> into app/public/. A <b>monorepo</b> holds both (app/ and app/public/).</li>'
                 '<li>Bitbucket: the account\'s key reads the repos (add it to each, read-only). GitHub: each repo gets a deploy key of '
                 'its own; the preview shows it when GitHub does not accept it yet.</li>'
                 f'<li>Name where it deploys: <b>a target</b> for every environment, or one per environment ({e(TARGET_HINT)}). '
                 'A remote server must be prepared first: <a href="/instructions">Instructions</a>.</li>'
                 '<li>Its type: <b>Docker stack</b> – the project\'s containers run there; <b>Files only</b> – a server without '
                 'Docker: a deploy copies only the code there (rsync over SSH), and no database is managed or backed up here.</li></ol>')
        fields = (text('env_repo', 'Env repo URL', 'git@ssh.bitbucket.org:workspace/shop_docker.git') +
                  text('code_repo', 'Code repo URL (optional)', 'git@ssh.bitbucket.org:workspace/shop.git') +
                  text('name', 'Name (optional)', 'default – the repo name') +
                  '<label class="check"><input type="checkbox" name="monorepo" value="yes"> monorepo – the env repo holds '
                  'app/ and app/public/ (--monorepo; no code repo, a target per environment, not local)</label>'
                  '<label class="check"><input type="checkbox" name="shared_key" value="yes"> GitHub: the account key instead of a '
                  'deploy key per repo (--shared-key)</label>'
                  '<p class="block-label">Targets</p>' +
                  typed('target_all', 'mode_all', 'Every environment', 'local, local:/PATH or ssh://USER@HOST/PATH', given['all'],
                        modes['all']) +
                  typed('target_prod', 'mode_prod', 'prod (its own)', 'e.g. ssh://deploy@shop.example/home/deploy/prod', given['prod'],
                        modes['prod']) +
                  typed('target_stage', 'mode_stage', 'stage (its own)', 'e.g. local:/home/shop/stage', given['stage'], modes['stage']) +
                  '<label><span>Other environments (ENV=target, one per line)</span><textarea name="targets" autocomplete="off" '
                  f'spellcheck="false" placeholder="demo=local:/home/shop/demo">{e(given["more"])}</textarea></label>')
        body = steps + '<div class="deck">' + self.form(
            'add-project', 'Add a project', fields,
            note='A new project needs a target: local – this server, the build root; local:/PATH – this server, another '
                 'directory; ssh://USER@HOST/PATH – another server. Files only: no Docker there, PATH must exist or be creatable '
                 'and writable for USER, and rsync installed (files:ssh://… or files:local:/PATH in the other lines). An '
                 'environment\'s own target wins over the shared one. For an existing project the fields left empty keep its targets.',
            command='bin/add-project') + '</div>'
        body += '<p><a href="/projects">← Projects</a></p>'
        return self.layout('Add a project', body, section='projects')

    def project_settings(self, entry):
        """Where each environment of a project deploys, and the forms that change it (bin/add-project)."""
        name, targets = entry['name'], entry.get('targets') or {}
        states = entry.get('environments') or {}
        if any((state or {}).get('development') for state in states.values()):
            return ('<p class="note">A development checkout: its environment is local, on this server, and has no deploy '
                    'target to set.</p>')
        # An environment's own target file may go when the shared target.env remains to deploy to (bin/add-project --remove-target).
        removable = entry.get('target_files', []) if 'all' in targets else []
        known = sorted({*states, *(key for key in targets if key != 'all'), *entry.get('target_files', [])}, key=environment_order)
        rows = []
        if 'all' in targets:
            rows.append('<tr class="is-idle"><td data-label="Environment"><span class="muted">every environment</span></td>'
                        f'<td class="target" data-label="Target">{target_place_text(targets["all"])}</td>'
                        '<td data-label="Target file"><code>target.env</code></td></tr>')
        for environment in known:
            values = targets.get(environment) or {}
            file = (f'<code>target.{e(environment)}.env</code>' if environment in entry.get('target_files', [])
                    else '<span class="muted">shares target.env</span>' if 'all' in targets else '<span class="muted">none</span>')
            if environment not in states:
                file += ' ' + badge('not in STAGE_ENVIRONMENTS', 'muted')
            shown = target_place_text(values) if values else self.target(entry, environment)
            kind = 'ok' if values or 'all' in targets else 'idle'
            rows.append(f'<tr class="is-{kind}"><td data-label="Environment"><span class="sign {e(environment)}">{e(environment)}</span></td>'
                        f'<td class="target" data-label="Target">{shown}</td><td data-label="Target file">{file}</td></tr>')
        body = facts([('Layout', ('monorepo: the env repo is the build root (app/, app/public/)' if entry.get('monorepo') else
                                  'separate repos: app/' + (' and app/public/' if entry.get('code_repository') else '')) +
                       ' <span class="muted">· a change reruns bin/add-project with the repos above</span>')])
        if rows:
            body += ('<div class="scroll"><table class="board"><thead><tr><th scope="col">Environment</th><th scope="col">Target</th>'
                     '<th scope="col">Target file</th></tr></thead><tbody>' + ''.join(rows) + '</tbody></table></div>')
        else:
            body += '<div class="empty">No environment and no target yet. Add one below.</div>'
        hidden = f'<input type="hidden" name="project" value="{e(name)}"><input type="hidden" name="operation" value="set">'
        target_field = self.target_field('target', 'mode', 'Target', 'local:/PATH or ssh://USER@HOST/PATH')
        rerun = f'bin/add-project {"--monorepo " if entry.get("monorepo") else ""}--target ENV=TARGET {name} ENV_REPO_URL' + \
            (' CODE_REPO_URL' if entry.get('code_repository') and not entry.get('monorepo') else '')
        monorepo = ' A monorepo\'s target lies outside its checkout: not local.' if entry.get('monorepo') else ''
        forms = ''
        if known:
            forms += self.form('project-target', 'Change the target',
                               hidden + '<label><span>Environment</span><select name="environment">' +
                               ''.join(f'<option value="{e(environment)}">{e(environment)}</option>' for environment in known) +
                               '</select></label>' + target_field,
                               note='Writes the environment\'s own target.ENV.env; the clones stay as they are. The next deploy goes '
                                    'there, and what runs on the old target stays until it is stopped. Files only: a deploy copies '
                                    'only the code there (no Docker, no database here); a Docker context of the old target goes.' + monorepo,
                               command=rerun)
        forms += self.form('project-target', 'Add an environment',
                           hidden + self.text_field('environment', 'Environment', 'demo – lowercase letters and digits, 2–16') +
                           target_field,
                           note='Not local or test. Besides stage and prod an environment deploys once the project lists it in '
                                'STAGE_ENVIRONMENTS (env/common.env) and has env/ENV.env. Files only: a server without Docker.' + monorepo,
                           command=rerun)
        if removable:
            forms += self.form('project-target', 'Remove an environment\'s own target',
                               f'<input type="hidden" name="project" value="{e(name)}"><input type="hidden" name="operation" value="remove">'
                               '<label><span>Environment</span><select name="environment">' +
                               ''.join(f'<option value="{e(environment)}">{e(environment)} – target.{e(environment)}.env</option>'
                                       for environment in removable) + '</select></label>',
                               note='Deletes target.ENV.env (and the Docker context of a remote one); the environment then '
                                    'deploys to the shared target.env. What runs on the old target stays there.',
                               command=f'bin/add-project --remove-target ENV --name {name}', danger=True)
        if forms:
            body += '<div class="deck">' + forms + '</div>'
        return body

    # --- One project ---
    def project(self, data, name):
        entry = next((item for item in (data or {}).get('projects', []) if item.get('name') == name), None)
        if entry is None:
            return None
        body = facts([('Env repo', e(entry.get('repository') or '?')),
                      ('Code repo', e(entry.get('code_repository') or '—')),
                      ('Build directory', f'{e(data.get("root", ""))}/projects/{e(name)}/{e(entry.get("layout") or "")}'),
                      ('PROJECT_NAME', e(entry.get('project_name')))])
        for environment, state in entry.get('environments', {}).items():
            body += f'<h2 id="env-{e(environment)}"><span class="sign {e(environment)}">{e(environment)}</span> environment</h2>'
            # A files-only target: no Docker there (no containers, secret store or context) and no database here.
            files = files_only(state)
            not_used = '<span class="muted">not used (files only)</span>'
            rows = [('Target', f'{self.target(entry, environment)} ' +
                     (FILES_CHIP + ' <span class="muted">· a deploy copies only the code there (rsync); no database here</span>'
                      if files else f'<span class="muted">(Docker context {e(state["context"])})</span>')),
                    ('Last deploy', self.deploy_cell(state)), ('Containers', not_used if files else self.containers_cell(state))]
            success = (state.get('deploys') or {}).get('last_success')
            if success and success != state['deploys']['last']:
                rows.append(('Last successful', deploy_shown(success)))
            newest = lambda key: (f' <span class="muted">{e(state[key]["newest"]["name"])}</span>'
                                  if (state.get(key) or {}).get('newest') else '')
            if not state.get('development'):
                policy = environment_policy(state)
                text = policy_html(policy, has_files(state), not files)
                linked = self.may('backup-policy') and (has_files(state) or not files)
                rows.append(('Backup policy', (f'<a href="#backup-{e(environment)}">{text}</a>' if linked else text) +
                             (' <span class="muted">(default)</span>' if policy == BACKUP_DEFAULT and not files else '')))
            if not files:
                rows += [('DB short backup', self.backup_cell(state) + newest('backups')),
                         ('DB full backup', self.full_backup_cell(state) + newest('full_backups')),
                         ('DB short, fresh', self.fresh_backup_cell(state) + ' <span class="muted">· make db-pull fresh=1</span>')]
            rows += [*([('Files backup (BACKUP_FILE_PATHS)', self.files_cell(state) +
                         f' <a class="btn" href="/files/{e(quote(name))}/{e(environment)}">View</a>')]
                       if state.get('file_paths') or (state.get('files_backups') or {}).get('count') else []),
                     ('Secret store', not_used if files else
                      f'{self.secrets_cell(state)} <span class="muted">{e(state["compose_project"])}-secrets</span>')]
            body += facts(rows)
            if state.get('containers'):
                body += ('<table class="board"><thead><tr><th scope="col">Container</th><th scope="col">State</th>'
                         '<th scope="col">Health</th><th scope="col">Status</th><th scope="col">Logs</th></tr></thead><tbody>' + ''.join(
                             f'<tr class="is-{"ok" if item["state"] == "running" and item.get("health") != "unhealthy" else "bad"}">'
                             f'<td data-label="Container">{e(item["name"])}</td>'
                             f'<td data-label="State">{badge(item["state"], "ok" if item["state"] == "running" else "warn")}</td>'
                             f'<td data-label="Health">{badge(item.get("health") or "—", {"healthy": "ok", "unhealthy": "bad"}.get(item.get("health"), "muted"))}</td>'
                             f'<td class="muted" data-label="Status">{e(item["status"])}</td>'
                             f'<td data-label="Logs"><a class="btn" href="/project/{e(name)}/logs?env={e(quote(environment))}&amp;container={e(quote(item["name"]))}">'
                             'Show</a></td></tr>' for item in state['containers']) + '</tbody></table>')
            if state.get('development'):
                body += '<p class="note">The application manages a development environment\'s backups; the server\'s DB backup roles do not apply here.</p>'
                continue
            body += self.backup_list(state)
            if files:  # no database here: only the files series has a policy, and only when there are files to back up
                forms = self.policy_form(name, environment, state) if has_files(state) else ''
                body += f'<div class="deck" id="backup-{e(environment)}">{forms}</div>' if forms else ''
                continue
            body += f'<div class="deck" id="backup-{e(environment)}">' + self.policy_form(name, environment, state) + self.form(
                'backup-local', 'Backup now on the server',
                f'<input type="hidden" name="project" value="{e(name)}"><input type="hidden" name="environment" value="{e(environment)}">'
                '<label class="check"><input type="checkbox" name="full" value="yes"> DB full – the data of every table (--full)</label>',
                note='Without Bitbucket: works for GitHub projects too. The preview shows the secret store and what the rotation would '
                     'delete. A backup asked for here is made whatever the backup policy says.',
                command=f'setup-server-backup [--full] {name} {environment}') + '</div>'
        body += '<h2 id="settings">Settings</h2>' + self.project_settings(entry)
        body += '<h2 id="access">Access</h2>' + self.project_access(data, name)
        body += '<h2 id="pipelines">Pipelines</h2>' + self.pipelines(entry)
        body += '<h2 id="remove">Remove</h2><div class="deck">' + self.form(
            'remove-project', f'Remove the build directory {name}',
            f'<input type="hidden" name="name" value="{e(name)}">'
            '<label class="check"><input type="checkbox" name="with_backups" value="yes"> together with the DB backups and '
            'the deploy history (no rollback afterwards)</label>',
            note='The preview (--check) shows the size, the backups and whether a container uses the directory.',
            command=f'bin/remove-project {name}', danger=True) + '</div>'
        body += '<p><a href="/projects">← Projects</a></p>'
        return self.layout(f'Project {name}', body, section='projects')

    # The words of each frequency in the policy selects.
    FREQUENCY_WORDS = {'daily': 'daily', 'weekly': 'weekly', 'monthly': 'monthly – every 4 weeks', 'off': 'off – none'}

    def policy_form(self, name, environment, state):
        """How often each backup series of one environment is made (bin/backup-projects --set): a select per series with the
        current value chosen; the files one only when the environment has files to back up (else its value goes as it is).
        A files-only target has no database here: the files one only, the DB values go as they are."""
        policy = environment_policy(state)
        hidden = lambda series: f'<input type="hidden" name="{series}" value="{e(policy[series])}">'
        if files_only(state):
            return self.form('backup-policy', 'Backup policy',
                             f'<input type="hidden" name="project" value="{e(name)}"><input type="hidden" name="environment" '
                             f'value="{e(environment)}">' + hidden('db-short') + hidden('db-full') +
                             self.policy_select(policy, 'files', 'Files backup (BACKUP_FILE_PATHS)'),
                             note='How often the files timer backs this environment\'s files up. A files-only target has no database '
                                  'here: no DB backups, and no alarm for them.',
                             command=f'bin/backup-projects --set {name} {environment} files=…')

        def select(series, label):
            return self.policy_select(policy, series, label)
        fields = (f'<input type="hidden" name="project" value="{e(name)}"><input type="hidden" name="environment" value="{e(environment)}">' +
                  select('db-short', 'DB short backup') +
                  select('db-full', 'DB full backup') +
                  (select('files', 'Files backup (BACKUP_FILE_PATHS)') if has_files(state) else
                   f'<input type="hidden" name="files" value="{e(policy["files"])}">'))
        return self.form('backup-policy', 'Backup policy', fields,
                         note='How often the timers back this environment up. DB short – every table\'s structure and the data of the import '
                              'tables (the registry); DB full – every table\'s data. DB short off and DB full on: DB full backups only '
                              '(daily DB full ones come with the nightly run). All off: no backups, and no alarm for them.',
                         command=f'bin/backup-projects --set {name} {environment} db-short=… db-full=… files=…')

    def policy_select(self, policy, series, label):
        """The select of one backup series' frequency, its current value chosen."""
        options = ''.join(f'<option value="{frequency}"{" selected" if frequency == policy[series] else ""}>'
                          f'{e(self.FREQUENCY_WORDS[frequency])}{" (default)" if frequency == BACKUP_DEFAULT[series] else ""}</option>'
                          for frequency in BACKUP_POLICY[series])
        return f'<label><span>{e(label)}</span><select name="{series}">{options}</select></label>'

    @staticmethod
    def backup_list(state):
        files = state.get('backup_files') or []
        if not files:
            return ''
        return (f'<details><summary>All backups ({len(files)})</summary><div class="inner"><table class="list">'
                '<tr><th>Kind</th><th>File</th><th>Time</th><th>Size</th></tr>' +
                ''.join(f'<tr><td>{badge(BACKUP_KINDS.get(item["kind"], item["kind"]), "muted")}</td><td>{e(item["name"])}</td>'
                        f'<td>{e(local_time(item["time"]))} <span class="muted">{e(ago(item["time"]))}</span></td>'
                        f'<td>{e(size(item["size"]))}</td></tr>' for item in files) +
                '</table><p class="note">To download: make db-pull (the key – bin/add-backup-key).</p></div></details>')

    def pipelines(self, entry):
        link = github_actions_link(entry)
        if link:
            return f'<p><a class="btn" href="{e(link)}">GitHub Actions: runs and logs</a></p>'
        repository = bitbucket_repository(entry.get('repository') or '')
        if repository is None:
            return ('<div class="callout warn"><p>Starting pipelines – Bitbucket projects only; GitHub is not supported yet. '
                    'Start a deploy in GitHub Actions; a backup now – in the form "Backup now on the server".</p></div>')
        found, error = pipeline_runs(entry['name'], repository)
        body = ''
        if error:
            body += f'<div class="callout warn"><p>Bitbucket: {e(error)}</p></div>'
        elif found:
            body += ('<table class="board"><thead><tr><th scope="col">No. · pipeline · result</th><th scope="col">Who</th></tr></thead>'
                     '<tbody>') + ''.join(
                f'<tr class="is-idle"><td data-label="No. · pipeline · result">{self.run_cell(run, repository)}</td>'
                f'<td data-label="Who">{e(((run.get("creator") or {}).get("display_name")) or "")}</td></tr>' for run in found) + '</tbody></table>'
        name, branch = e(entry['name']), e(entry.get('branch') or 'master')
        hidden = f'<input type="hidden" name="project" value="{name}">'
        branch_field = f'<label><span>Branch (the pipeline definition)</span><input type="text" name="branch" value="{branch}"></label>'
        forms = []
        extra = [f'deploy-{environment}' for environment in sorted(entry.get('environments', {}), key=environment_order)
                 if EXTRA_DEPLOY.fullmatch(f'deploy-{environment}')]
        for pipeline in (*DEPLOY_PIPELINES, *extra):
            forms.append(self.form('pipeline', pipeline_title(pipeline),
                                   hidden + f'<input type="hidden" name="pipeline" value="{pipeline}">' + branch_field +
                                   '<label><span>REF (tag or commit)</span><input type="text" name="ref" autocomplete="off"></label>'
                                   '<label class="check"><input type="checkbox" name="images" value="yes"> IMAGES – rebuild the images</label>'
                                   '<label class="check"><input type="checkbox" name="backup" value="yes" checked> BACKUP – a backup before the deploy</label>'
                                   '<label class="check"><input type="checkbox" name="rollback" value="yes"> ROLLBACK – go back to the previous one</label>'
                                   '<label class="check"><input type="checkbox" name="cache" value="yes"> CACHE – clear the cache '
                                   '(unticked – only when the deploy changes it)</label>',
                                   note='The history stays in Bitbucket Deployments.', command=f'custom pipeline {pipeline}'))
        forms.append(self.form('pipeline', PIPELINES['backup-now'],
                               hidden + '<input type="hidden" name="pipeline" value="backup-now">' + branch_field +
                               '<label class="check"><input type="checkbox" name="full" value="yes"> FULL – a full backup (the data of every table)</label>',
                               note='Without FULL – a backup by the table registry (like the nightly one).', command='custom pipeline backup-now'))
        forms.append(self.form('pipeline', PIPELINES['runner-test'],
                               hidden + '<input type="hidden" name="pipeline" value="runner-test">' + branch_field,
                               command='custom pipeline runner-test'))
        return body + '<div class="deck">' + ''.join(forms) + '</div>'

    def container_logs(self, name, environment, container, lines, data, error):
        choices = ''.join(f'<option value="{count}"{" selected" if count == lines else ""}>{count} lines</option>'
                          for count in CONTAINER_LINES)
        body = (f'<p><a href="/project/{e(name)}">← {e(name)}</a> · <span class="sign {e(environment)}">{e(environment)}</span> · '
                f'<code>docker logs --timestamps --tail {e(lines)} {e(container)}</code></p>'
                f'<form class="subnav" method="get" action="/project/{e(name)}/logs">'
                f'<input type="hidden" name="env" value="{e(environment)}"><input type="hidden" name="container" value="{e(container)}">'
                f'<select name="lines">{choices}</select><button>Show</button></form>')
        problem = error or (data or {}).get('error')
        if problem:
            body += f'<div class="callout bad"><p>{e(problem)}</p></div>'
        else:
            body += term('\n'.join(data.get('lines', [])))
        return self.layout(f'Logs: {container}', body, section='projects')

    def worker_metrics(self, data, error):
        problem = error or (data or {}).get('error')
        if problem:
            return self.layout('Metrics', f'<div class="callout bad"><p>{e(problem)}</p></div>', section='metrics')
        text = data.get('text', '')
        groups = re.findall(r'(?m)^setup_metrics_group_up\{group="([^"]+)"\} (\S+)$', text)
        samples = sum(1 for line in text.splitlines() if line and not line.startswith('#'))
        body = ('<div class="stats">' + ''.join(f'<div class="stat"><b>{lamp("ok" if up == "1" else "bad")} {e(group)}</b>'
                                                f'<span>{"collected" if up == "1" else "missing"}</span></div>' for group, up in groups) +
                f'<div class="stat"><b>{samples}</b><span>values</span></div></div>'
                '<p class="note">setup-server-metrics --once as the setup account: what Prometheus sees (without the token).</p>' + term(text))
        return self.layout('Metrics', body, section='metrics')

    # --- Files backups (BACKUP_FILE_PATHS) ---
    @staticmethod
    def files_environments(data):
        """(project, environment, state) of every environment with BACKUP_FILE_PATHS or files backups kept."""
        return [(entry['name'], environment, state) for entry in (data or {}).get('projects', [])
                for environment, state in sorted(entry.get('environments', {}).items(), key=lambda item: environment_order(item[0]))
                if state.get('file_paths') or (state.get('files_backups') or {}).get('count')]

    @staticmethod
    def files_cell(state):
        """The newest files backup: fine as long as its policy's frequency allows (daily: 26 hours)."""
        return Page.series_cell(state, 'files_backups', environment_policy(state)['files'],
                                'bad' if state.get('file_paths') and state.get('declared') else 'muted')

    @staticmethod
    def file_paths(state):
        return ' '.join(f'<code>{e(item)}</code>' for item in state.get('file_paths') or []) or '<span class="muted">not set</span>'

    def files(self, data, error):
        if data is None:
            return self.layout('File backups', f'<div class="callout bad"><p>Could not get the status: {e(error)}</p></div>',
                               section='files')
        found = self.files_environments(data)
        body = ('<p class="note">Files of the code tree that are not in git (e.g. translations), which the project lists in '
                '<code>BACKUP_FILE_PATHS</code>: every night the worker reads them from the target (setup <code>make files-backup</code>) '
                'and keeps <code>files-&lt;env&gt;-…Z.tar.gz</code> (7 days + 4 weeks). Here they are only viewed: the target is not changed.</p>')
        if not found:
            body += ('<div class="empty">No project sets BACKUP_FILE_PATHS. Add it to the project\'s env/common.env '
                     '(e.g. <code>BACKUP_FILE_PATHS="modules/*/translations/"</code>).</div>')
            return self.layout('File backups', body, section='files')
        rows = ''.join(
            f'<tr class="is-{"ok" if (state.get("files_backups") or {}).get("newest") else "idle"}">'
            f'<td class="project" data-label="Project"><a href="/project/{e(quote(name))}">{e(name)}</a></td>'
            f'<td data-label="Environment"><span class="sign {e(environment)}">{e(environment)}</span></td>'
            f'<td data-label="Paths">{self.file_paths(state)}</td>'
            f'<td data-label="Newest backup">{self.files_cell(state)}</td>'
            f'<td><a class="btn" href="/files/{e(quote(name))}/{e(environment)}">Backups</a></td></tr>'
            for name, environment, state in found)
        body += ('<div class="scroll"><table class="board"><thead><tr><th scope="col">Project</th><th scope="col">Environment</th>'
                 '<th scope="col">Paths</th><th scope="col">Newest backup</th><th scope="col"></th></tr></thead><tbody>' +
                 rows + '</tbody></table></div>')
        return self.layout('File backups', body, section='files')

    @staticmethod
    def files_archives(state):
        """The files backups of an environment, newest first."""
        return [item for item in state.get('backup_files') or [] if item.get('kind') == 'files']

    def files_environment(self, data, name, environment):
        entry = next((item for item in (data or {}).get('projects', []) if item.get('name') == name), None)
        state = (entry or {}).get('environments', {}).get(environment)
        if state is None:
            return None
        archives = self.files_archives(state)
        body = f'<p><a href="/files">← File backups</a> · <a href="/project/{e(quote(name))}">{e(name)}</a></p>'
        body += facts([('Paths (BACKUP_FILE_PATHS)', self.file_paths(state)),
                       ('Newest backup', self.files_cell(state)),
                       ('From', self.target(entry, environment))])
        if not state.get('file_paths'):
            body += ('<div class="callout warn"><p>The project no longer sets BACKUP_FILE_PATHS for this environment: no new files '
                     'backups are made, the existing ones are kept until the rotation or a person deletes them.</p></div>')
        if archives:
            body += ('<table class="list"><tr><th>Backup</th><th>Time</th><th>Size</th></tr>' + ''.join(
                f'<tr><td><a href="/files/{e(quote(name))}/{e(environment)}/{e(item["name"])}">{e(item["name"])}</a></td>'
                f'<td>{e(local_time(item["time"]))} <span class="muted">{e(ago(item["time"]))}</span></td>'
                f'<td>{e(size(item["size"]))}</td></tr>' for item in archives) + '</table>')
        else:
            body += '<div class="empty">No files backups yet.</div>'
        if state.get('file_paths'):
            body += '<div class="deck">' + self.form(
                'backup-local', 'Files backup now',
                f'<input type="hidden" name="project" value="{e(name)}"><input type="hidden" name="environment" value="{e(environment)}">'
                '<input type="hidden" name="files" value="yes">',
                note='The same as the nightly files timer does. The target is only read.',
                command=f'setup-server-backup --files {name} {environment}') + '</div>'
        return self.layout(f'Files: {name} {environment}', body, section='files')

    @staticmethod
    def file_changes(entries, previous):
        """({path: 'new'|'changed'}, [paths gone]) of an archive's files against the previous archive, or ({}, [])."""
        if previous is None:
            return {}, []
        before = {item['path']: item for item in previous if item['type'] != 'dir'}
        marks = {}
        for item in entries:
            if item['type'] == 'dir':
                continue
            old = before.pop(item['path'], None)
            if old is None:
                marks[item['path']] = 'new'
            elif (old['size'], old['time'], old.get('link')) != (item['size'], item['time'], item.get('link')):
                marks[item['path']] = 'changed'
        return marks, sorted(before)

    def files_archive(self, name, environment, archive, listing, previous, query, changed_only, error):
        base = f'/files/{quote(name)}/{environment}'
        body = (f'<p><a href="{e(base)}">← {e(name)} <span class="sign {e(environment)}">{e(environment)}</span></a> · '
                f'<code>{e(archive)}</code></p>')
        problem = error or (listing or {}).get('error')
        if problem:
            body += f'<div class="callout bad"><p>{e(problem)}</p></div>'
            return self.layout('Files backup', body, section='files')
        entries = listing.get('entries', [])
        old = previous.get('entries') if previous and not previous.get('error') else None
        marks, gone = self.file_changes(entries, old)
        files = [item for item in entries if item['type'] != 'dir']
        stats = [(len(files), 'files'), (size(sum(item['size'] for item in files)), 'uncompressed'),
                 (size(listing.get('size', 0)), 'backup')]
        if old is not None:
            stats += [(sum(1 for mark in marks.values() if mark == 'new'), 'new'),
                      (sum(1 for mark in marks.values() if mark == 'changed'), 'changed'), (len(gone), 'gone')]
        body += '<div class="stats">' + ''.join(f'<div class="stat"><b>{e(number)}</b><span>{e(label)}</span></div>'
                                               for number, label in stats) + '</div>'
        body += (f'<p class="note">Compared with the previous backup <code>{e(previous["archive"])}</code> (size and time).</p>'
                 if old is not None else '<p class="note">There is no previous backup: nothing to compare with.</p>')
        if listing.get('truncated'):
            body += f'<div class="callout warn"><p>The backup has more than {len(entries)} entries: the first ones are shown.</p></div>'
        wanted = query.lower()
        shown = [item for item in files if wanted in item['path'].lower() and (not changed_only or item['path'] in marks)]
        body += (f'<div class="toolbar"><form class="search" method="get" action="{e(base)}/{e(archive)}">'
                 f'<input type="text" name="q" value="{e(query)}" placeholder="part of the path" autocomplete="off">'
                 f'<label class="check"><input type="checkbox" name="changed" value="1"{" checked" if changed_only else ""}> '
                 'only new and changed</label><button>Show</button></form></div>')
        view = f'{base}/{archive}/view?path='
        rows = ''.join(
            f'<tr><td>' + (f'<a href="{e(view + quote(item["path"]))}">{e(item["path"])}</a>' if item['type'] == 'file' else
                           f'{e(item["path"])} <span class="muted">→ {e(item.get("link") or "")}</span>') + '</td>'
            f'<td class="num">{e(size(item["size"]))}</td><td>{e(local_time(item["time"]))}</td>'
            f'<td>{badge(marks[item["path"]], "warn" if marks[item["path"]] == "changed" else "ok") if item["path"] in marks else ""}</td></tr>'
            for item in shown[:FILE_ROWS])
        if shown:
            body += ('<div class="scroll"><table class="list"><tr><th>File</th><th>Size</th><th>Time</th><th></th></tr>' +
                     rows + '</table></div>')
            if len(shown) > FILE_ROWS:
                body += f'<p class="note">Showing {FILE_ROWS} of {len(shown)}: narrow the search.</p>'
        else:
            body += '<div class="empty">No file matches.</div>'
        if gone:
            older = f'/files/{quote(name)}/{environment}/{previous["archive"]}/view?path='
            body += (f'<details><summary>Gone since the previous backup ({len(gone)})</summary><div class="inner"><table class="list">' +
                     ''.join(f'<tr><td><a href="{e(older + quote(path))}">{e(path)}</a></td></tr>' for path in gone) +
                     '</table></div></details>')
        return self.layout(f'Files backup {archive}', body, section='files')

    def files_view(self, name, environment, archive, path, data, previous, error):
        base = f'/files/{quote(name)}/{environment}/{archive}'
        body = f'<p><a href="{e(base)}">← <code>{e(archive)}</code></a></p>'
        problem = error or (data or {}).get('error')
        if problem:
            body += f'<div class="callout bad"><p>{e(problem)}</p></div>'
            return self.layout('File', body, section='files')
        content = base64.b64decode(data.get('content', ''))
        text = file_text(content)
        download = '' if data.get('truncated') else f' <a class="btn" href="{e(base)}/download?path={e(quote(path))}">Download</a>'
        body += facts([('File', f'<code>{e(path)}</code>{download}'), ('Size', e(size(data.get('size', 0)))),
                       ('Time', f'{e(local_time(data.get("time", 0)))} <span class="muted">(of the file on the target)</span>'),
                       ('Backup', f'<code>{e(archive)}</code> <span class="muted">{e(name)} {e(environment)}</span>')])
        if data.get('truncated'):
            body += (f'<div class="callout warn"><p>The file is larger than {e(size(len(content)))}: only the beginning is shown, '
                     'download is not allowed (on the server: tar -xzf backup file).</p></div>')
        if previous is not None:
            if previous.get('error'):
                body += (f'<p class="note">The previous backup <code>{e(previous["archive"])}</code> does not have this file '
                         f'<span class="muted">({e(previous["error"])})</span>.</p>')
            else:
                old = file_text(base64.b64decode(previous.get('content', '')))
                if old == text and previous.get('size') == data.get('size'):
                    body += f'<p class="note">Unchanged since the previous backup <code>{e(previous["archive"])}</code>.</p>'
                elif old is not None and text is not None:
                    lines = list(difflib.unified_diff(old.splitlines(), text.splitlines(), previous['archive'], archive,
                                                      lineterm='', n=2))
                    body += f'<h2>Differences from {e(previous["archive"])}</h2>' + diff_term(lines)
                else:
                    body += f'<p class="note">Differs from the previous backup <code>{e(previous["archive"])}</code> (binary).</p>'
        body += '<h2>Content</h2>' + (term(text) if text is not None else
                                      '<div class="empty">A binary file: download it to view it.</div>')
        return self.layout(path.rsplit('/', 1)[-1], body, section='files')

    # --- Instructions ---
    def instructions(self, choice, values, errors, given, key_known, complete):
        selects =''.join(
            f'<label><span>{e(label)}</span><select name="{key}">' +
            ''.join(f'<option value="{value}"{" selected" if choice[key] == value else ""}>{e(title)}</option>'
                    for value, title in options) + '</select></label>' for key, label, options in GUIDE_OPTIONS)
        def field(item):
            return (f'<label class="field-{item.key}"><span>{e(item.label)}</span><input type="text" name="{item.key}" '
                    f'value="{e(given[item.key])}" autocomplete="off"><small>{e(item.hint)}</small></label>')
        required = ''.join(field(item) for item in GUIDE_FIELDS if not item.more)
        optional = ''.join(field(item) for item in GUIDE_FIELDS if item.more)
        opened = ' open' if any(given[item.key] for item in GUIDE_FIELDS if item.more) else ''
        body = ('<p class="note">What to do on a server so that it becomes a project\'s target (bin/add-project --target '
                'ENV=ssh://USER@SERVER/PATH). Only the fields this choice needs are shown; filled ones go into the '
                'commands, empty ones stay in CAPITALS. Adding a whole project with real names – '
                '<a href="/instructions/example">the example</a>.</p>'
                f'<form class="action guide-form" method="get" action="/instructions"><div class="guide">{selects}{required}</div>'
                f'<details class="more"{opened}><summary>Optional: change the defaults</summary>'
                f'<div class="inner guide">{optional}</div></details>'
                '<div class="form-foot"><p class="note">Runs nothing: only shows the steps.</p><button>Show the steps</button></div></form>')
        if errors:
            body += '<div class="callout bad">' + ''.join(f'<p>{e(item)}</p>' for item in errors) + '</div>'
        if not key_known:
            body += ('<div class="callout warn"><p>Could not read the worker\'s key: SETUP_KEY – '
                     f'<code>sudo cat {e(ROOT)}/.ssh/id_ed25519.pub</code>.</p></div>')
        steps = [step for step in GUIDE if step.applies(choice)]
        labels = {key: dict(options)[choice[key]] for key, _, options in GUIDE_OPTIONS}
        body += ('<div class="chosen">' + ''.join(badge(label, 'warn' if key == 'os' and choice['os'] == 'centos' else 'muted')
                                                  for key, label in labels.items()) +
                 f'<span class="note">{len(steps)} {steps_word(len(steps))}</span></div><ol class="steps">')
        for step in steps:
            link = ''
            if step.link and complete:
                target = f'{choice["env"]}=ssh://{values["user"]}@{values["host"]}{values["path"]}'
                if TARGET.fullmatch(target):
                    link = (f'<p><a class="btn" href="/projects/new?target={e(quote(target, safe=""))}#form-add-project">'
                            'Open the form with this target</a></p>')
            body += guide_step(step, values, link)
        return self.layout('Instructions: preparing a server', body + '</ol>', section='instructions')

    def instructions_example(self):
        values = {'root': str(ROOT)}
        intro = re.sub(r'`([^`]+)`', r'<code>\1</code>', e(EXAMPLE_INTRO))
        body = (f'<p class="note">{intro}</p><p><a class="btn" href="/instructions">← Preparing a server</a></p>'
                f'<div class="chosen"><span class="note">{len(EXAMPLE)} {steps_word(len(EXAMPLE))}</span></div>'
                '<ol class="steps">' + ''.join(guide_step(step, values) for step in EXAMPLE) + '</ol>')
        return self.layout('Instructions: an example of adding a project', body, section='instructions')

    # --- Access: developer keys and what each may reach ---
    @staticmethod
    def seg(name, current, levels=LEVELS, none='—'):
        """A segmented choice of a level (radios: no script needed); '' is none (lv-off: quiet when chosen, unless it
        stands for a level every project inherits)."""
        empty = 'lv-none lv-off' if none == '—' else 'lv-none'
        return '<div class="seg">' + ''.join(
            f'<label class="{f"lv-{level}" if level else empty}"><input type="radio" name="{e(name)}" value="{e(level)}"'
            f'{" checked" if level == current else ""}><span>{e(LEVEL_LABELS.get(level, none))}</span></label>'
            for level in ('', *levels)) + '</div>'

    @staticmethod
    def last_use(key):
        last = key.get('last')
        if not last:
            return '<span class="muted">never</span>'
        what = 'access' if last['log'] == 'access' else 'backups'
        return f'{e(ago(last["at"]))} <span class="muted">{e(what)} · {e(last["from"])}</span>'

    @staticmethod
    def summary(granted, wanted=lambda environment: True, levels=LEVELS):
        """How many environments (of one kind: prod, stage, the others) a key has at each level."""
        counts = {}
        for (_, environment), level in granted.items():
            if wanted(environment):
                counts[level] = counts.get(level, 0) + 1
        if not counts:
            return '<span class="muted">—</span>'
        return ' '.join(f'<span class="tallied"><span class="tally">{count}</span>{level_chip(level)}</span>'
                        for level, count in sorted(counts.items(), key=lambda item: -levels.index(item[0])))

    def backups_summary(self, key, granted=None):
        """Every project's backup level and the environments raised above it."""
        everything = key.get('pull_all', 'none')
        text = (f'<span class="tallied"><span class="tally">all</span>{level_chip(everything)}</span>'
                if everything != 'none' else '')
        pulls = key_grants(key, 'backups') if granted is None else granted
        raised = {item: level for item, level in pulls.items()
                  if PULL_LEVELS.index(level) > (PULL_LEVELS.index(everything) if everything in PULL_LEVELS else -1)}
        if raised:
            text += ' ' + self.summary(raised, levels=PULL_LEVELS)
        if key.get('legacy'):
            text += ' <span class="chip muted" title="an entry from before the backup permissions: a change makes it explicit">old</span>'
        return text.strip() or '<span class="muted">—</span>'

    def access(self, data, error, query=''):
        if data is None:
            return self.layout('Access', f'<div class="callout bad"><p>Could not get the status: {e(error)}</p></div>',
                               section='access')
        keys, columns = data.get('keys', []), access_columns(data)
        wanted = query.strip().lower()
        reaches = lambda key: {project for project, _ in [*key_grants(key), *key_grants(key, 'backups')]}
        people = full_names(data)
        # The key, its person and their tools login: who it is, by any name.
        named = lambda key: wanted in ' '.join([key['name'], people.get(key['name'], ''),
                                                tool_user(data, key['name']).get('login') or '']).lower()
        shown = [key for key in keys if not wanted or named(key) or
                 any(wanted in project for project in reaches(key)) or key.get('pull_all', 'none') != 'none']
        with_access = sum(1 for key in keys if key.get('grants'))
        everything = sum(1 for key in keys if key.get('pull_all', 'none') != 'none')
        stats = [(len(keys), 'keys'), (with_access, 'with access'), (everything, 'all backups'),
                 (len(project_rows(columns)), 'projects'), (len(columns), 'environments')]
        body = '<div class="stats">' + ''.join(f'<div class="stat"><b>{e(number)}</b><span>{e(label)}</span></div>'
                                               for number, label in stats) + '</div>'
        body += ('<div class="toolbar"><form class="search" method="get" action="/access">'
                 f'<input type="text" name="q" value="{e(query)}" placeholder="person, key or project" autocomplete="off">'
                 '<button>Search</button></form><a class="btn go" href="/access/new">+ Add a key</a></div>')
        if not keys:
            body += '<div class="empty">No keys yet. <a href="/access/new">Add a key</a></div>'
        elif not shown:
            body += f'<div class="empty">No key matches "{e(query)}". <a href="/access">All</a></div>'
        else:
            rows = []
            for key in shown:
                granted, pulls = key_grants(key), key_grants(key, 'backups')
                if wanted and not named(key):
                    granted = {item: level for item, level in granted.items() if wanted in item[0]}
                    pulls = {item: level for item, level in pulls.items() if wanted in item[0]}
                rows.append(f'<tr class="is-{"ok" if key.get("grants") or key.get("pulls") or key.get("pull_all", "none") != "none" else "idle"}">'
                            f'<td class="keyname" data-label="Key"><a href="/access/{e(quote(key["name"]))}">'
                            f'{e(people.get(key["name"]) or key["name"])}</a>'
                            f'<small>{e(key["name"] + " · " if key["name"] in people else "")}{e(key.get("fingerprint", ""))}</small></td>'
                            f'<td data-label="access prod">{self.summary(granted, lambda name: name == "prod")}</td>'
                            f'<td data-label="stage">{self.summary(granted, lambda name: name == "stage")}</td>'
                            f'<td data-label="other">{self.summary(granted, lambda name: name not in ("prod", "stage"))}</td>'
                            f'<td data-label="Backups (db-pull)">{self.backups_summary(key, pulls)}</td>'
                            f'<td data-label="Tools">{self.tools_summary(data, key["name"])}</td>'
                            f'<td data-label="From">{" ".join(badge(source, "muted") for source in key.get("sources", []))}</td>'
                            f'<td data-label="Last used">{self.last_use(key)}</td></tr>')
            body += ('<div class="scroll"><table class="board keys"><thead><tr><th scope="col">Key</th><th scope="col">access prod</th>'
                     '<th scope="col">stage</th><th scope="col">other</th><th scope="col">Backups (db-pull)</th><th scope="col">Tools</th>'
                     '<th scope="col">From</th><th scope="col">Last used</th></tr></thead>'
                     '<tbody>' + ''.join(rows) + '</tbody></table></div>')
            if wanted:
                body += (f'<p class="note">Showing where the keys reach "{e(query)}" (and the keys with every project\'s backups). '
                         '<a href="/access">All keys</a></p>')
        # What the levels mean, after the keys: the search and the first key come first on a phone.
        body += ('<h3>Access levels</h3><ol class="ramp">' + ''.join(f'<li class="lv-{level}"><b>{e(LEVEL_LABELS[level])}</b>'
                                                                   f'<span>{e(LEVEL_NOTES[level])}</span></li>' for level in LEVELS) +
                 '</ol><ol class="ramp backups">' + ''.join(f'<li class="lv-{level}"><b>{e(LEVEL_LABELS[level])}</b>'
                                                            f'<span>{e(LEVEL_NOTES[level])}</span></li>' for level in PULL_LEVELS) +
                 '</ol>')
        body += self.tools_section(data)
        body += '<h2>Recent activity</h2>' + self.activity_table(self.recent, keys=True, limit=25, people=people)
        body += '<p class="note"><a href="/logs#activity">All activity – Logs</a></p>'
        return self.layout('Access', body, section='access')

    recent = None  # the activity of every key, set by the handler before access() and logs()

    @staticmethod
    def tools_summary(data, name):
        """How many project environments' tools a key's user opens, and whether it has a password."""
        user = (((data or {}).get('tool_access') or {}).get('users') or {}).get(name) or {}
        count = len(user.get('projects', []))
        if not count:
            return '<span class="muted">—</span>'
        text = f'<span class="tallied"><span class="tally">{count}</span>{level_chip("tools")}</span>'
        return text + ('' if user.get('password') else ' ' + badge('no password', 'warn'))

    def tools_section(self, data):
        """This server's addresses the targets let reach their tools, and how the last sending went (bin/tool-access)."""
        tools = (data or {}).get('tool_access') or {}
        addresses, managed = tools.get('allowed_ips') or [], tools.get('managed') or []
        applied = tools.get('applied') or {}
        failed = sorted(item for item, result in applied.items() if result.get('ok') is False)
        waiting = sorted(item for item, result in applied.items() if result.get('ok') is None)
        rows = [('Addresses', ' '.join(badge(address, 'muted') for address in addresses) or
                 '<span class="muted">not set: only the project\'s ALLOWED_IPS get in</span>'),
                ('Environments with passwords', e(len(managed)))]
        if failed:
            rows.append(('Not applied', ' '.join(f'<span class="chip bad" title="{e(applied[item].get("note", ""))}">'
                                                  f'{e(item.replace(":", " "))}</span>' for item in failed)))
        if waiting:
            rows.append(('Waiting for a deploy', ' '.join(f'<span class="chip warn" title="{e(applied[item].get("note", ""))}">'
                                                         f'{e(item.replace(":", " "))}</span>' for item in waiting)))
        field = (f'<label><span>Server OPS addresses (IP or CIDR, comma-separated)</span><input type="text" name="allowed_ips" '
                 f'value="{e(",".join(addresses))}" placeholder="198.51.100.7" autocomplete="off"></label>')
        return ('<h2 id="tools">Tool access</h2>' + facts(rows) +
                '<p class="note">Who opens which environment\'s tools – on the key page\'s tab "Tools". The addresses are added to '
                'each tool\'s IP list (not the site\'s) in the environments the passwords protect; a change applies at once.</p>'
                '<div class="deck">' + self.form('tool-ips', 'Addresses', field, note='E.g. the VPN server\'s public IP: the '
                                                 'developers\' traffic to the targets goes through it.', command='bin/tool-access --allowed-ips') +
                self.form('tool-apply', 'Send again', '', note='Every environment\'s user files and addresses – to the targets '
                          'once more (e.g. after a failed sending or a setup update).', command='bin/tool-access --apply') +
                '</div>')

    def new_key(self, data, error):
        if data is None:
            return self.layout('New key', f'<div class="callout bad"><p>Could not get the status: {e(error)}</p></div>',
                               section='access')
        keys = data.get('keys', [])
        common = max((source for key in keys for source in key.get('sources', [])),
                     key=lambda source: sum(source in key.get('sources', []) for key in keys), default='')
        text = lambda name, label, placeholder='', value='': (
            f'<label><span>{e(label)}</span><input type="text" name="{name}" value="{e(value)}" placeholder="{e(placeholder)}" '
            'autocomplete="off"></label>')
        start = lambda field, levels: ''.join(
            f'<tr><td><span class="sign {environment}">{environment}</span></td>'
            f'<td>{self.seg(f"start:{field}:{environment}", "", levels)}</td></tr>' for environment in ('prod', 'stage'))
        fields = ('<input type="hidden" name="new" value="yes">'
                  '<label><span>Public key (.pub)</span><textarea name="public_key" spellcheck="false" '
                  'placeholder="ssh-ed25519 AAAA… name@computer"></textarea></label>' +
                  text('key_name', 'Name (in the logs)', 'tomas') + text('sources', 'From (VPN network)', '10.8.0.0/24', common) +
                  '<p class="block-label">Backup downloads (make db-pull, make files-pull)</p><table class="grants">'
                  f'<tr><td><span class="chip muted">every project</span></td><td>{self.seg("pull_all", "", PULL_LEVELS)}</td></tr>' +
                  start('pull', PULL_LEVELS) + '</table>'
                  '<p class="block-label">Access (make ssh)</p><table class="grants">' + start('grant', LEVELS) + '</table>'
                  '<p class="note">"Every project" applies to new ones too; prod/stage – to every current one. Single projects '
                  'you change on the key\'s page.</p>'
                  '<details class="more"><summary>Specific projects only</summary><div class="inner">' +
                  text('pulls', 'Backups', 'shop:prod=db shop:stage=fresh') +
                  text('grants', 'Access', 'shop:prod=phpfpm-readonly shop:stage=docker') + '</div></details>')
        body = '<p><a href="/access">← Access</a></p><div class="deck wide">' + self.form(
            'add-backup-key', 'New key', fields, note='Without any choice the key reaches nothing. The preview shows what the key '
            'gets; "Run" writes it to authorized_keys.', command='bin/add-backup-key') + '</div>'
        return self.layout('New key', body, section='access')

    def key_page(self, data, name, events, query='', only_granted=False, tab='access'):
        key = next((item for item in (data or {}).get('keys', []) if item.get('name') == name), None)
        if key is None:
            return None
        tab = tab if tab in KINDS or tab == 'tools' else 'access'
        access = key_grants(key)
        person = full_names(data).get(name)
        body = ('<p><a href="/access">← Access</a></p><div class="keyhead">'
                f'<div><p class="plate-name">{"person · key " + e(name) if person else "key"}</p>'
                f'<p class="keytitle">{e(person or name)}</p>'
                f'<p class="plate-line">{e(key.get("type", ""))} <code>{e(key.get("fingerprint", ""))}</code></p></div>'
                f'<div><p class="plate-name">from</p><p>{" ".join(badge(source, "muted") for source in key.get("sources", []))}</p></div>'
                f'<div><p class="plate-name">backups</p><p>{self.backups_summary(key)}</p></div>'
                f'<div><p class="plate-name">access prod</p><p>{self.summary(access, lambda one: one == "prod")}</p></div>'
                f'<div><p class="plate-name">access stage</p><p>{self.summary(access, lambda one: one == "stage")}</p></div>'
                f'<div><p class="plate-name">last used</p><p>{self.last_use(key)}</p></div></div>')
        link = lambda kind: f'/access/{quote(name)}?tab={kind}' + (f'&amp;q={quote(query)}' if query else '') + \
            ('&amp;granted=1' if only_granted else '') + '#projects'
        tabs = [(kind, label, command_) for kind, (_, _, _, label, command_) in KINDS.items()] + \
            [('tools', 'Tools', 'pma, cron…')]
        body += ('<nav class="tabs" id="projects">' + ''.join(
            f'<a class="{"on" if kind == tab else ""}" href="{link(kind)}">{e(label)} <small>{e(command_)}</small></a>'
            for kind, label, command_ in tabs) + '</nav>')
        if tab == 'tools':
            body += self.tools_tab(data, name, query, only_granted)
        else:
            body += self.grants_tab(data, key, name, tab, query, only_granted)
        body += self.key_settings(key, name, events, tool_user(data, name))
        return self.layout(f'Key {name}' + (f' – {person}' if person else ''), body, section='access')

    def grants_tab(self, data, key, name, tab, query, only_granted):
        """A key's access (make ssh) or backups (make db-pull): every prod/stage at once, then one row per project."""
        field, levels = KINDS[tab][:2]
        granted, columns = key_grants(key, tab), access_columns(data)
        body = ''
        if tab == 'backups':
            everything = key.get('pull_all', 'none')
            body += (f'<form class="bulk everything" method="post" action="/preview">'
                     f'{self.hidden("add-backup-key", [("key_name", name), ("merge", "yes")])}'
                     f'<span class="bulk-scope"><span class="chip muted">every project</span></span>'
                     f'{self.seg("pull_all", "" if everything == "none" else everything, PULL_LEVELS)}'
                     '<span class="note">new ones too; a project environment\'s permission can only be higher</span>'
                     '<button>Preview</button></form>')
            if key.get('legacy'):
                body += ('<div class="callout warn"><p>This entry was made before the backup permissions: it may pull every project\'s '
                         f'backups ({e(LEVEL_LABELS.get(everything, everything))}). The first change writes that explicitly ("every project").</p></div>')
        # Every prod, every stage or every environment at once.
        bulk = []
        others = sorted({environment for _, environment in columns if environment not in ('prod', 'stage')})
        scopes = [('prod', '<span class="sign prod">prod</span>'), ('stage', '<span class="sign stage">stage</span>')]
        if others:
            scopes.append(('other', f'<span class="sign" title="{e(", ".join(others))}">other</span>'))
        for scope, label in scopes + [('all', '<span class="chip muted">all</span>')]:
            bulk.append(f'<form class="bulk" method="post" action="/preview">'
                        f'{self.hidden("key-bulk", [("key_name", name), ("scope", scope), ("kind", tab)])}'
                        f'<span class="bulk-scope">{label}</span>{self.seg("level", "", levels)}'
                        '<span class="bulk-only"><label class="check"><input type="radio" name="only" value="all" checked> every project'
                        '</label><label class="check"><input type="radio" name="only" value="existing"> only where it already has some</label></span>'
                        '<button>Preview</button></form>')
        body += ('<div class="bulkbox"><p class="block-label">All at once</p>' + ''.join(bulk) +
                 '<p class="note">"—" removes. The preview shows every environment that will change; nothing changes until you press '
                 '"Run".</p></div>')
        # One row per project, its environments side by side; a filter narrows a long list. Without a level of its
        # own a project environment has every project's backups: the empty choice says which.
        everything = key.get('pull_all', 'none') if tab == 'backups' else 'none'
        inherited = f'all: {LEVEL_LABELS[everything]}' if everything != 'none' else '—'
        wanted = query.strip().lower()
        rows = [(project, environments) for project, environments in project_rows(columns)
                if (not wanted or wanted in project) and
                (not only_granted or any((project, one) in granted for one in environments))]
        body += (f'<form class="toolbar search" method="get" action="/access/{e(quote(name))}#projects">'
                 f'<input type="hidden" name="tab" value="{e(tab)}">'
                 f'<input type="text" name="q" value="{e(query)}" placeholder="project" autocomplete="off">'
                 f'<label class="check"><input type="checkbox" name="granted" value="1"{" checked" if only_granted else ""}> '
                 f'only with a permission</label><button>Show</button><span class="note">{len(rows)} of {len(project_rows(columns))}</span></form>')
        if rows:
            def slot(project, environment, environments):
                # prod and stage keep their place in every row, so the levels line up down the list.
                if environment not in environments:
                    return f'<div class="env {env_class(environment)}"></div>'
                return (f'<div class="env {env_class(environment)}"><span class="sign {e(environment)}">{e(environment)}</span>'
                        f'{self.seg(f"{field}:{project}:{environment}", granted.get((project, environment), ""), levels, inherited)}</div>')
            lines = ''.join(
                f'<tr><td class="id">{e(project)}</td><td><div class="envs {e(tab)}">' +
                ''.join(slot(project, environment, environments)
                        for environment in ('prod', 'stage', *[one for one in environments if one not in ('prod', 'stage')])) +
                '</div></td></tr>' for project, environments in rows)
            note = ('Only the environments shown change; the ones the filter hides stay as they are.' +
                    (' "—" for backups – the "every project" level stays.' if tab == 'backups' else ''))
            body += (f'<form class="action" method="post" action="/preview">{self.hidden("add-backup-key", [("key_name", name), ("merge", "yes")])}'
                     f'<table class="grants projects">{lines}</table><div class="form-foot"><p class="note">{note}</p>'
                     '<button>Preview the changes</button></div></form>')
        else:
            body += '<div class="empty">No project matches the filter.</div>'
        return body

    def key_settings(self, key, name, events, user=None):
        """The key itself (networks, a new public key, a project not on this server yet), its person and its activity."""
        hidden = lambda fields: ''.join(f'<input type="hidden" name="{e(name_)}" value="{e(text)}">' for name_, text in fields)
        body = ''
        text = lambda field_, label, placeholder='', current='': (
            f'<label><span>{e(label)}</span><input type="text" name="{field_}" value="{e(current)}" placeholder="{e(placeholder)}" '
            'autocomplete="off"></label>')
        settings = (hidden([('key_name', name), ('merge', 'yes')]) +
                    text('sources', 'From (VPN networks)', '10.8.0.0/24', ','.join(key.get('sources', []))) +
                    text('pulls', 'Backups of a project not here yet', 'shop:prod=db') +
                    text('grants', 'Access to a project not here yet', 'shop:prod=phpfpm-readonly') +
                    '<label><span>New public key</span><textarea name="public_key" spellcheck="false" '
                    'placeholder="empty – the current one stays"></textarea></label>')
        user = user or {}
        person = (hidden([('key_name', name)]) +
                  text('full_name', 'Full name (shown on the pages)', 'Jane Doe', user.get('full_name') or '') +
                  text('login', 'Login for the tools', f'{name} or name@company.com',
                       user.get('login') if user.get('login') not in (None, name) else ''))
        body += ('<h2 id="person">Key settings</h2><div class="deck">' +
                 self.form('tool-person', 'Person', person, note='The login – a name or an e-mail address that pma, cron and the '
                           f'other tools ask for (case-sensitive); empty – the key\'s name {name}. '
                           'In the logs the key stays the key.', command=f'bin/tool-access --name {name} --full-name … --login …') +
                 self.form('add-backup-key', 'Networks, key', settings,
                           note='A new key applies to all of this key\'s environments at once.', command=f'bin/add-backup-key --name {name}') +
                 self.form('remove-backup-key', f'Revoke the key {name}', f'<input type="hidden" name="key_name" value="{e(name)}">',
                           note='The key will no longer download backups, log in to the targets or open the tools.',
                           command=f'bin/add-backup-key --remove {name}', danger=True) + '</div>')
        body += '<h2 id="activity">Activity</h2>' + self.activity_table(events, keys=False, limit=200)
        return body

    def tools_tab(self, data, name, query, only_granted):
        """The key's tools password and the project environments whose tools it opens (bin/tool-access): a change holds
        at once, Server OPS sends the user file to the target and reloads its nginx-proxy."""
        tools = (data or {}).get('tool_access') or {}
        user = (tools.get('users') or {}).get(name) or {}
        granted = set(user.get('projects', []))
        applied = tools.get('applied') or {}
        addresses = tools.get('allowed_ips') or []
        state = (f'{badge("set", "ok")} <span class="muted">{e(user.get("password_set") or "")}</span>'
                 if user.get('password') else badge('not set', 'warn'))
        body = ('<div class="callout"><p>pma, cron, mailpit, backup, metrics and the project\'s PROXY_TOOLS of the ticked environments ask for '
                f'the login <code>{e(user.get("login") or name)}</code> (<a href="#person">change</a>) and this password. Only the Server OPS addresses get in '
                f'({e(", ".join(addresses)) if addresses else "not set – only the project ALLOWED_IPS"}; '
                '<a href="/access#tools">change</a>). A change applies at once, without a deploy.</p></div>')
        fields = (f'<input type="hidden" name="key_name" value="{e(name)}"><p>Password: {state}</p>'
                  f'<label><span>New password ({TOOL_PASSWORD[0]}+ characters)</span><input type="password" name="tool_password" '
                  f'autocomplete="new-password" minlength="{TOOL_PASSWORD[0]}" maxlength="{TOOL_PASSWORD[1]}"></label>' +
                  ('<label class="check"><input type="checkbox" name="remove" value="yes"> remove the password '
                   '(the tools let in nowhere)</label>' if user.get('password') else ''))
        body += '<div class="deck">' + self.form(
            'tool-password', 'Tools password', fields, note='The administrator makes up the password and hands it over; the server '
            'keeps only its hash.', command=f'bin/tool-access --name {name} --password -') + '</div>'
        # Every prod, every stage or every environment at once.
        columns = access_columns(data)
        others = sorted({environment for _, environment in columns if environment not in ('prod', 'stage', 'local', 'test')})
        scopes = [('prod', '<span class="sign prod">prod</span>'), ('stage', '<span class="sign stage">stage</span>')]
        if others:
            scopes.append(('other', f'<span class="sign" title="{e(", ".join(others))}">other</span>'))
        bulk = ''.join(f'<form class="bulk tools" method="post" action="/preview">'
                       f'{self.hidden("tool-bulk", [("key_name", name), ("scope", scope)])}'
                       f'<span class="bulk-scope">{label}</span>{self.seg("level", "", ("tools",))}<button>Preview</button></form>'
                       for scope, label in scopes + [('all', '<span class="chip muted">all</span>')])
        body += ('<div class="bulkbox"><p class="block-label">All at once</p>' + bulk +
                 '<p class="note">"—" removes. The preview shows every environment that will change; nothing changes until you press '
                 '"Run".</p></div>')
        wanted = query.strip().lower()
        rows = [(project, environments) for project, environments in project_rows(columns)
                if (not wanted or wanted in project) and
                (not only_granted or any(f'{project}:{one}' in granted for one in environments))]
        body += (f'<form class="toolbar search" method="get" action="/access/{e(quote(name))}#projects">'
                 '<input type="hidden" name="tab" value="tools">'
                 f'<input type="text" name="q" value="{e(query)}" placeholder="project" autocomplete="off">'
                 f'<label class="check"><input type="checkbox" name="granted" value="1"{" checked" if only_granted else ""}> '
                 f'only with a permission</label><button>Show</button><span class="note">{len(rows)} of {len(project_rows(columns))}</span></form>')
        if not rows:
            return body + '<div class="empty">No project matches the filter.</div>'

        def slot(project, environment, environments):
            if environment not in environments:
                return f'<div class="env {env_class(environment)}"></div>'
            item = f'{project}:{environment}'
            result = applied.get(item) or {}
            mark = ''
            if item in granted and result.get('ok') is False:
                mark = f' <span class="chip bad" title="{e(result.get("note", ""))}">not applied</span>'
            elif item in granted and result.get('ok') is None and result:
                mark = f' <span class="chip warn" title="{e(result.get("note", ""))}">waiting for a deploy</span>'
            return (f'<div class="env {env_class(environment)}"><span class="sign {e(environment)}">{e(environment)}</span>'
                    f'{self.seg(f"tool:{project}:{environment}", "tools" if item in granted else "", ("tools",))}{mark}</div>')
        lines = ''.join(
            f'<tr><td class="id">{e(project)}</td><td><div class="envs tools">' +
            ''.join(slot(project, environment, environments)
                    for environment in ('prod', 'stage', *[one for one in environments if one not in ('prod', 'stage')])) +
            '</div></td></tr>' for project, environments in rows)
        body += (f'<form class="action" method="post" action="/preview">{self.hidden("tool-access", [("key_name", name)])}'
                 f'<table class="grants projects">{lines}</table><div class="form-foot"><p class="note">Only the environments shown '
                 'change. An environment where anyone ever had a tools permission stays password-protected: once the '
                 'last one is removed, nobody gets in.</p><button>Preview the changes</button></div></form>')
        return body

    @staticmethod
    def activity_table(events, keys=True, limit=100, people=None):
        """Logins, downloads, shells and commands: newest first, a shell with how long it ran and its session."""
        if events is None:
            return '<div class="callout warn"><p>Could not read the activity.</p></div>'
        if not events:
            return '<div class="empty">No activity yet.</div>'
        rows = []
        for event in events[:limit]:
            words = event['request'].split()
            what = ACTIVITY_WORDS.get(event['verb'], event['verb'])
            target = ' '.join(words[1:3]) if event['verb'] not in ('', 'access') else ''
            detail = ' '.join(words[3:]).removeprefix('-- ')
            state = {'ok': badge('succeeded', 'ok'), 'failed': badge(f'code {event.get("exit", "?")}', 'bad'),
                     'refused': badge('refused', 'bad'), 'running': badge('running', 'run')}.get(event['state'], '')
            reason = (f'<small class="muted">{e(event["answer"].split(":", 1)[-1].strip())}</small>'
                      if event['state'] in ('refused', 'failed') and 'exit' not in event else '')
            took = ''
            if event.get('ended') is not None:
                seconds = event['ended'] - event['at']
                took = f'{seconds // 60} min' if seconds >= 60 else f'{seconds} s'
            session = (f'<a class="btn" href="/access/{e(quote(event["key"]))}/session/{e(event["session"])}">Session</a>'
                       if event.get('session') else '')
            person = (people or {}).get(event['key'])
            title = f' title="{e(event["key"])}"' if person else ''
            who = (f'<td data-label="Key"><a href="/access/{e(quote(event["key"]))}#activity"{title}>{e(person or event["key"])}</a></td>'
                   if keys else '')
            rows.append(f'<tr class="is-{"bad" if event["state"] in ("failed", "refused") else "idle"}">'
                        f'<td class="when" data-label="Time">{e(local_time(event["at"]))}<small>{e(ago(event["at"]))}</small></td>{who}'
                        f'<td class="what" data-label="What">{e(what)}{" " + level_chip(event["level"]) if event.get("level") else ""}</td>'
                        f'<td class="text" data-label="Where · command">{e(target)}{f" <code>{e(detail)}</code>" if detail else ""}{reason}</td>'
                        f'<td data-label="Result">{state}</td><td class="num" data-label="Took">{e(took)}</td><td>{session}</td>'
                        f'<td class="muted" data-label="From">{e(event["from"])}</td></tr>')
        return ('<div class="scroll"><table class="board activity"><thead><tr><th scope="col">Time</th>' +
                ('<th scope="col">Key</th>' if keys else '') +
                '<th scope="col">What</th><th scope="col">Where · command</th><th scope="col">Result</th><th scope="col">Took</th>'
                '<th scope="col"></th><th scope="col">From</th></tr></thead><tbody>' +
                ''.join(rows) + '</tbody></table></div>')

    def session_page(self, name, data, error, event):
        problem = error or (data or {}).get('error')
        body = f'<p><a href="/access/{e(quote(name))}#activity">← {e(name)}</a></p>'
        if event:
            body += facts([('Request', f'<code>{e(event["request"])}</code>'),
                           ('Started', f'{e(local_time(event["at"]))} from {e(event["from"])}'),
                           ('Took', e(f'{(event["ended"] - event["at"]) // 60} min' if event.get('ended') is not None else 'running or cut off')),
                           ('Level', level_chip(event.get('level')))])
        if problem:
            body += f'<div class="callout bad"><p>{e(problem)}</p></div>'
        else:
            body += ('<p class="note">What the person typed (not what the screen showed): Enter – a new line, corrections applied, '
                     'arrows and history left out.</p>' +
                     '<div class="term typed"><ol>' + ''.join(f'<li>{e(line)}</li>' for line in data.get('lines', [])) + '</ol></div>')
        return self.layout(f'Session {name}', body, section='access')

    # --- Update: Server OPS and setup to their newest ---
    def update_page(self, data, error, where):
        if data is None:
            return self.layout('Update', f'<div class="callout bad"><p>Could not get the status: {e(error)}</p></div>',
                               section='update')
        versions = data.get('versions') or {}
        setup, server = versions.get('setup_git'), versions.get('checkout_git')
        body = ''
        if setup and not setup.get('tag'):
            body += ('<div class="tape"><span>setup is not on a release tag: make release ENV=prod refuses, so prod '
                     'deploys will not work until setup is back on a tag ("Update to the newest" below).</span></div>')
        plate_server = (f'<div class="plate"><p class="plate-name">Server OPS</p><p class="plate-version">'
                        f'{e(versions.get("installed") or "?")}</p><p class="plate-line">installed copies</p>'
                        f'<p class="plate-line">clone {e(versions.get("checkout") or "?")} · {git_line(server, False)}</p>')
        if where['checkout']:
            plate_server += ('<div class="plate-actions">' + self.button('update', {'latest': 'yes'}, 'Update to the newest', 'go') +
                             f'</div><p class="note">origin/master through {e(where["checkout"])}, run by {e(where["admin"])} '
                             '(their sudo must work without a password). The installed copies are rewritten too and the health '
                             'is checked; on failure it is rolled back. The UI restarts, the work goes on.</p>')
        else:
            plate_server += '<div class="callout warn"><p>Unknown admin clone: run sudo bin/install-ui from it.</p></div>'
        plate_server += '</div>'
        plate_setup = (f'<div class="plate"><p class="plate-name">setup (shared checkout)</p><p class="plate-version">'
                       f'{e(versions.get("setup") or "?")}</p><p class="plate-line">{e(ROOT)}/setup</p>'
                       f'<p class="plate-line">{git_line(setup)}</p><div class="plate-actions">' +
                       self.button('update-setup', {}, 'Update to the newest', 'go') + '</div>'
                       '<p class="note">The newest release of the same MAJOR. setup releases every merge to master '
                       'itself (a release tag after a successful CI), so that is master. Without a password, as the setup '
                       'account; not while a pipeline step runs. A new MAJOR – only by giving the tag below.</p></div>')
        body += '<div class="plates">' + plate_server + plate_setup + '</div>'
        body += ('<p class="note">"master +N" – how many new commits origin/master had at the last fetch (setup – how much '
                 'newer the newest release is). Every button first runs --check: it fetches the newest '
                 'and shows the list of commits, only then "Run".</p>')
        text = lambda name, label, placeholder: (f'<label><span>{e(label)}</span><input type="text" name="{name}" '
                                                 f'placeholder="{e(placeholder)}" autocomplete="off"></label>')
        body += '<details class="more"><summary>A specific version or ref</summary><div class="inner deck">' + self.form(
            'update-setup', 'setup to a release tag', text('setup_tag', 'setup tag', 'v2.15.0'),
            note='Release tags only (vX.Y.Z); a new MAJOR or going back too.', command='bin/update-setup vX.Y.Z')
        if where['checkout']:
            body += self.form('update', 'Server OPS and setup together',
                              text('server_ref', 'Server OPS ref', 'origin/master') + text('setup_ref', 'setup ref', 'v2.14.1'),
                              note='A tag, an origin branch or a commit; with a health check and rollback.', command='bin/update')
        body += '</div></details>'
        return self.layout('Update', body, section='update')

    def project_access(self, data, name):
        """Who reaches this project's environments through the worker."""
        environments = sorted({environment for project, environment in access_columns(data) if project == name},
                              key=environment_order)
        rows, people = [], full_names(data)
        for key in (data or {}).get('keys', []):
            granted = {environment: level for (project, environment), level in key_grants(key).items() if project == name}
            pulls = {environment: pull_level(key, name, environment) for environment in environments}
            if granted or any(level != 'none' for level in pulls.values()):
                rows.append(f'<tr><td class="id"><a href="/access/{e(quote(key["name"]))}?q={e(quote(name))}#projects">{e(people.get(key["name"]) or key["name"])}</a></td>' +
                            ''.join(f'<td>{level_chip(granted.get(environment))} {level_chip(pulls[environment])}</td>'
                                    for environment in environments) + '</tr>')
        if not rows:
            return '<div class="empty">Nobody reaches this project, neither by make ssh nor by make db-pull. <a href="/access">Access</a></div>'
        return ('<table class="list"><tr><th>Key</th>' +
                ''.join(f'<th><span class="sign {e(environment)}">{e(environment)}</span> <small class="muted">access · backups</small></th>'
                        for environment in environments) +
                '</tr>' + ''.join(rows) + '</table><p class="note"><a href="/access">Change – Access</a></p>')

    # --- Actions ---
    def actions(self, scopes=()):
        def text(name, label, placeholder='', value=''):
            # autocomplete off: a browser must not fill in a value typed for another project (a build root name).
            return (f'<label><span>{e(label)}</span><input type="text" name="{name}" value="{e(value)}" '
                    f'placeholder="{e(placeholder)}" autocomplete="off"></label>')
        sections = (('add-project', 'Projects'), ('runners', 'Runners'), ('backups', 'Backups'),
                    ('access', 'SSH and metrics'), ('units', 'Services'), ('server', 'Server'))
        index = ('<nav class="index"><p class="block-label">Sections</p>' +
                 ''.join(f'<a href="#{key}">{e(label)}</a>' for key, label in sections) +
                 '<p class="block-label">On other pages</p><a href="/projects">Projects →</a><a href="/projects/backups">Backups →</a><a href="/runners">Runners →</a>'
                 '<a href="/access">Keys and access →</a>'
                 '<a href="/update">Update →</a><p class="note">Every action first runs with --check: '
                 'you see what it would do, and only then press "Run".</p></nav>')
        body = ('<h2 id="add-project">Projects</h2><div class="pointer"><h3>Projects – on their own page</h3>'
                '<p class="note">The list of projects and their environments, adding a project, each environment\'s target, '
                'and removing.</p><a class="btn" href="/projects">Projects →</a></div>')
        body += ('<h2 id="runners">Runners</h2><div class="pointer"><h3>Runners – on their own page</h3>'
                 '<p class="note">The list of GitHub and Bitbucket runners, adding, extra instances, starting, '
                 'stopping and removing.</p><a class="btn go" href="/runners">Runners →</a></div>')
        body += '<h2 id="backups">Backups</h2><div class="deck">' + self.form(
            'backup-local', 'Backup now on the server',
            text('project', 'Project (optional)', 'empty – all projects') +
            '<label><span>Environment</span><select name="environment"><option value="">all of the project</option>'
            '<option value="stage">stage</option><option value="prod">prod</option></select></label>'
            '<label class="check"><input type="checkbox" name="full" value="yes"> DB full – the data of every table (--full)</label>'
            '<label class="check"><input type="checkbox" name="files" value="yes"> files – BACKUP_FILE_PATHS, not the DB (--files)</label>',
            note='The same as the nightly (without --full), weekly (with --full) or files (--files) timer does; without Bitbucket, '
                 'works for GitHub projects too.',
            command='setup-server-backup [--full|--files] [PROJECT [ENV]]')
        body += self.form(
            'install-backups', 'Backup timers',
            text('at', 'Nightly backup time', '03:30') +
            text('full_at', 'Weekly DB full backup day and time', 'Sun 04:30') +
            text('files_at', 'Files backup time', 'as the nightly one'),
            note='Nightly – the DB short backup, by the table registry (7 days + 4 weeks), weekly – the DB full backup, the data '
                 'of every table (2 kept), '
                 'files – the BACKUP_FILE_PATHS paths from the target (7 days + 4 weeks). Without values the installed ones stay '
                 '(default 03:30, Sun 04:30, files – as the nightly one). How often each environment is backed up '
                 '(daily, weekly, monthly, off) is its backup policy: on its project page or on '
                 '<a href="/projects/backups">Projects → Backups</a>.', command='bin/install-backups')
        body += ('<div class="pointer"><h3>Backup policy – per environment</h3><p class="note">Every project environment\'s '
                 'policy and its newest DB short, DB full and files backup, late or missing ones first.</p>'
                 '<a class="btn" href="/projects/backups">Backups →</a></div>')
        body += ('<div class="pointer"><h3>Backup and access keys</h3><p class="note">The developers\' keys (make db-pull, '
                 'make ssh) and who has which access – on their own page.</p><a class="btn" href="/access">Access →</a></div>')
        body += '</div>'
        body += '<h2 id="access">SSH and metrics</h2><div class="deck">' + self.form(
            'install-ssh', 'SSH from the VPN',
            text('sources', 'Networks (comma-separated)', '10.8.0.0/24'),
            note='Installs openssh-server; from other networks – keys only; a ufw rule (if ufw is on). Empty – the installed networks.',
            command='bin/install-ssh', danger=True)
        body += self.form(
            'install-metrics', 'Worker metrics',
            text('address', 'Address (optional)', '10.8.0.14') + text('allow', 'Allowed addresses', '10.8.0.20') +
            text('port', 'Port (optional)', '9101') +
            '<label><span>Token</span><select name="token"><option value="keep">keep as it is</option>'
            '<option value="new">new (--new-token)</option><option value="none">no token (--no-token)</option></select></label>',
            note='Settings not given stay as in /etc/setup-server/metrics.env. <a href="/worker-metrics">What Prometheus sees</a>.',
            command='bin/install-metrics') + '</div>'
        units = [*UNIT_OPERATIONS, *(f'github-runner@{scope}' for scope in scopes)]
        titles = {**UNIT_TITLES, **{f'github-runner@{scope}': f'GitHub runner {scope}' for scope in scopes}}
        body += '<h2 id="units">Services</h2><div class="deck">' + self.form(
            'unit', 'Start, stop, restart',
            '<label><span>Service</span><select name="unit">' +
            ''.join(f'<option value="{e(unit)}">{e(titles[unit])} – {e(", ".join(UNIT_OPERATIONS.get(unit, ("start", "stop", "restart"))))}</option>'
                    for unit in units) + '</select></label>'
            '<label><span>Operation</span><select name="operation">' +
            ''.join(f'<option value="{key}">{e(label)} ({key})</option>' for key, label in OPERATION_TITLES.items()) + '</select></label>',
