         'container. PrestaShop keys – the same as the shop\'s whose DB you will move (otherwise the encrypted values and the '
         'old password hashes will not work): setup takes them from `parameters.php` – `%%` becomes `%`, the API keys base64.',
         blocks=(('names and check (on your computer, in the env repo)', ('make deploy-variables ENV={env} names=1',
                                                                         'make deploy-variables ENV={env} token=…')),
                 ('DB password', ("openssl rand -base64 24 | tr -d '/+='",)),
                 ('PS keys from the existing shop (PS 1.7+; the file is 0600, nothing printed to the terminal)', (
                     'umask 077; php -r \'$p = (require "PATH/app/config/parameters.php")["parameters"];',
                     'foreach (["PS_COOKIE_KEY"=>"cookie_key", "PS_COOKIE_IV"=>"cookie_iv", "PS_NEW_COOKIE_KEY"=>"new_cookie_key",',
                     '          "PS_SECRET"=>"secret", "PS_API_PRIVATE_KEY"=>"api_private_key", "PS_API_PUBLIC_KEY"=>"api_public_key"] as $e => $k) {',
                     '    $v = str_replace("%%", "%", $p[$k] ?? ""); if ($v === "") continue;',
                     '    if (strpos($e, "PS_API_") === 0) { $v = base64_encode($v); }',
                     '    echo $e, "=\\x27", $v, "\\x27\\n"; }\' > /root/keys.env   # once entered: shred -u /root/keys.env'))),
         source='setup doc/lt/09-aplinkos.md "Deployment variables"; docker/project_prestashop.py existing_keys'),
