                 'su versijomis ir commit\'ų sąrašu.</p><a class="btn" href="/update">Atnaujinimas →</a></div></div>')
        body = f'<div class="split">{index}<div class="sections">{body}</div></div>'
        return self.layout('Veiksmai', body, section='actions')

    def invalid(self, message):
        return self.layout('Netinkami duomenys', f'<div class="callout bad"><p>{e(message)}</p></div>'
                                                 '<p><a href="/actions">← Atgal į veiksmus</a></p>', section='actions')

    def preview(self, plan, code, output, pending):
        back, section = plan.back
        body = ''
        if plan.changes:
            body += ('<div class="changes"><p class="block-label">Kas pasikeis</p><ul>' +
                     ''.join(f'<li class="is-{kind}">{e(text)}</li>' for kind, text in plan.changes) + '</ul></div>')
        body += facts([('Komanda', f'<code>{e(shlex.join(plan.check))}</code>'),
                      ('Kodas', badge('—' if code is None else code, 'ok' if code == 0 else 'bad'))])
        if plan.stdin and plan.action == 'install-runner':
            body += '<p class="note">Įklijuotas tekstas perduotas per stdin (nerodomas).</p>'
        if plan.stdin and plan.action == 'tool-password':
            body += '<p class="note">Slaptažodis perduotas per stdin (nerodomas, nesaugomas; serveryje lieka tik jo hash\'as).</p>'
        body += term(output)
        if plan.run is None:
            return self.layout(plan.title, body, section=section)
        if pending:
            if plan.danger:
                body += f'<div class="tape"><span>{e(plan.danger)}</span></div>'
            body += (f'<form class="action" method="post" action="/run"><input type="hidden" name="csrf" value="{e(self.token)}">'
                     f'<input type="hidden" name="pending" value="{e(pending)}">'
                     f'<p>Vykdys: <code>{e(shlex.join(plan.run))}</code></p>'
                     f'<div class="form-foot"><a class="btn" href="{e(back)}">Atšaukti</a><button class="run">Vykdyti</button></div></form>')
        else:
            body += '<div class="callout bad"><p>Peržiūra baigėsi klaida: vykdyti negalima. Pataisyk, ką ji rodo, ir bandyk dar kartą.</p></div>'
        return self.layout(f'Peržiūra: {plan.title}', body, section=section)

    def pipeline_preview(self, plan, pending, token_variable):
        body = ''
        if plan.pipeline == 'deploy-production':
            body += '<div class="tape"><span>Deploy\'us į PROD</span></div>'
        body += (f'<p>Bitbucket repo: <code>{e(plan.workspace)}/{e(plan.slug)}</code>; token\'as: '
                 f'{e(token_variable) if token_variable else badge("nėra (" + TOKEN_VARIABLE + ")", "bad")}</p>'
                 f'<p>Užklausa: <code>POST {e(bitbucket_api() + plan.path)}</code></p><pre class="json">{e(json.dumps(plan.body, indent=2))}</pre>')
        if token_variable:
            body += (f'<form class="action" method="post" action="/run"><input type="hidden" name="csrf" value="{e(self.token)}">'
                     f'<input type="hidden" name="pending" value="{e(pending)}"><div class="form-foot">'
                     f'<a class="btn" href="/project/{e(plan.project)}">Atšaukti</a><button class="run">Vykdyti</button></div></form>')
        return self.layout(f'Peržiūra: {plan.title}', body, section='overview')

    def pipeline_result(self, plan, code, data, error):
        if error or code != 201 or not isinstance(data, dict):
            body = f'<div class="callout bad"><p>Bitbucket atsakė: {e(error or f"HTTP {code}")}</p></div>'
        else:
            number = data.get('build_number')
            link = f'{BITBUCKET_WEB}/{quote(plan.workspace)}/{quote(plan.slug)}/pipelines/results/{int(number or 0)}'
            body = (f'<div class="callout"><p>Paleista: <a href="{e(link)}">#{e(number)}</a> ({e(plan.pipeline)}, '
                    f'šaka {e(plan.branch)}).</p></div>')
        body += f'<p><a href="/project/{e(plan.project)}">← Atgal į projektą</a></p>'
        return self.layout(plan.title, body, section='overview')

    def job(self, identifier, meta, result, running, output):
        if running:
            state, bar = badge('vykdoma', 'run'), 'run'
        elif result is None:
            state, bar = badge('nutrūko (be rezultato)', 'bad'), 'bad'
        else:
            state, bar = badge(f'baigta, kodas {result["exit"]}', 'ok' if result['exit'] == 0 else 'bad'), \
                'ok' if result['exit'] == 0 else 'bad'
        rows = [('Būsena', state), ('Pradėta', f'{e(local_time(meta["started"]))} · {e(meta["user"])}'),
                ('Komanda', f'<code>{e(shlex.join(meta["argv"]))}</code>')]
        if result is not None:
            rows.insert(2, ('Truko', f'{result.get("seconds", 0)} s'))
        body = f'<div class="bar {bar}"><i></i></div>' + facts(rows) + term(output, '(išvesties dar nėra)')
        back, section = meta.get('back') or ('/logs', 'logs')
        if running:
            body += '<p class="note">Puslapis atsinaujina kas 3 s.</p>'
        elif back != '/actions':
            body += f'<p><a class="btn go" href="{e(back)}">← Atgal</a></p>'
        return self.layout(meta.get('title', 'Veiksmas'), body, refresh=3 if running else None, section=section)

    def logs(self, actions, recent, data, error):
        body = '<h2>Paskutiniai veiksmai</h2>'
        if recent:
            body += '<ul class="runs">' + ''.join(
                f'<li>{lamp(kind)}<a href="/job/{e(name)}">{e(local_time(meta["started"]))}</a><span>{e(meta.get("title", ""))}</span>'
                f'<span class="hide muted">{e(meta["user"])}</span><span>{state}</span></li>'
                for name, meta, state, kind in recent) + '</ul>'
        else:
            body += '<div class="empty">Veiksmų dar nebuvo.</div>'
        body += '<h2 id="activity">Programuotojų veikla</h2>' + self.activity_table(self.recent, keys=True, limit=150,
                                                                                      people=full_names(data))
        body += f'<h2>Žurnalai</h2><details open><summary>ui-actions.log</summary><div class="inner">{term(actions)}</div></details>'
        if data is None:
            body += f'<div class="callout bad"><p>{e(error)}</p></div>'
        else:
            body += (f'<details><summary>backup-pulls.log</summary><div class="inner">'
                     f'{term(chr(10).join(data.get("backup_pulls", [])))}</div></details>')
            body += (f'<details><summary>access.log</summary><div class="inner">'
                     f'{term(chr(10).join(data.get("access", [])))}</div></details>')
            for unit, lines in data.get('journal', {}).items():
                body += (f'<details><summary>journalctl -u {e(unit)}</summary><div class="inner">'
                         f'{term(chr(10).join(lines))}</div></details>')
        return self.layout('Žurnalai', body, section='logs')


# --- HTTP ----------------------------------------------------------------------------------------
class Pending:
    """Previewed actions waiting for "Vykdyti": in memory only (a restart forgets them), single use."""

    def __init__(self):
        self.lock = threading.Lock()
        self.items = {}

    def add(self, plan, user):
        key = secrets.token_urlsafe(18)
        with self.lock:
            now = time.monotonic()
            self.items = {name: item for name, item in self.items.items() if now - item[2] < PENDING_TTL}
            self.items[key] = (plan, user, now)
        return key

    def take(self, key, user):
        with self.lock:
            item = self.items.pop(key, None)
        if item and item[1] == user and time.monotonic() - item[2] < PENDING_TTL:
            return item[0]
        return None


def tail(path, limit=200):
    try:
        with open(path, 'rb') as handle:
            handle.seek(0, os.SEEK_END)
            handle.seek(max(0, handle.tell() - 256 * 1024))
            return '\n'.join(handle.read().decode('utf-8', 'replace').splitlines()[-limit:])
    except OSError as error:
        return f'({error.strerror})'


def handler(user, stored):
    csrf_key = secrets.token_bytes(32)
    verified = set()  # sha256 of Authorization headers already checked: PBKDF2 runs once per login
    pending = Pending()
    lock = threading.Lock()

    class Handler(BaseHTTPRequestHandler):
        server_version = 'setup-server-ui'
        sys_version = ''
        timeout = 60

        def reply(self, status, body, content_type='text/html; charset=utf-8', headers=()):
            data = body if isinstance(body, bytes) else body.encode()
            self.send_response(status)
            self.send_header('Content-Type', content_type)
            self.send_header('Content-Length', str(len(data)))
            self.send_header('Cache-Control', 'no-store')
            self.send_header('X-Frame-Options', 'DENY')
            self.send_header('X-Content-Type-Options', 'nosniff')
            # same-origin: with no-referrer a browser posts the forms with Origin: null, which the POST check refuses.
            self.send_header('Referrer-Policy', 'same-origin')
            self.send_header('Content-Security-Policy', "default-src 'none'; style-src 'self'; form-action 'self'; "
                                                        "frame-ancestors 'none'; base-uri 'none'")
            for header in headers:
                self.send_header(*header)
            self.end_headers()
            if self.command != 'HEAD':
                self.wfile.write(data)

        def client(self):
            return self.client_address[0]

        def login(self):
            """The user of a valid Basic-auth header, or None (the reply is sent)."""
            host = self.headers.get('Host', '')
            if re.sub(r':[0-9]+$', '', host) not in LOOPBACK_HOSTS:
                log(f'refused {self.client()}: Host {host[:60]!r} (400)')
                self.reply(400, 'Unexpected Host\n', 'text/plain; charset=utf-8')
                return None
            header = self.headers.get('Authorization', '')
            digest = hashlib.sha256(header.encode('utf-8', 'surrogateescape')).digest()
            with lock:
                known = digest in verified
            if not known:
                given_user, given_password = '', ''
                if header.startswith('Basic '):
                    try:
                        given_user, _, given_password = base64.b64decode(header[6:], validate=True).decode().partition(':')
                    except (ValueError, UnicodeDecodeError):
                        pass
                # Both are compared, whatever the first gives: the time tells nothing about the user name.
                user_ok = hmac.compare_digest(given_user.encode(), user.encode())
                password_ok = password_matches(given_password, stored)
                if not (user_ok and password_ok):
                    if header:
                        log(f'refused {self.client()}: wrong login (401)')
                    self.reply(401, self.page_text('Reikia prisijungti.'),
                               headers=[('WWW-Authenticate', 'Basic realm="setup-server", charset="UTF-8"')])
                    return None
                with lock:
                    if len(verified) > 64:
                        verified.clear()
                    verified.add(digest)
            return user

        @staticmethod
        def page_text(text):
            return f'<!doctype html><html lang="lt"><meta charset="utf-8"><p>{e(text)}</p></html>'

        def token(self, name):
            return hmac.new(csrf_key, b'csrf\0' + name.encode(), hashlib.sha256).hexdigest()

        def do_GET(self):
            name = self.login()
            if name is None:
                return
            page = Page(name, self.token(name))
            url = urlsplit(self.path)
            path, query = url.path, parse_qs(url.query)
            if path == '/ui.css':
                return self.reply(200, STYLE, 'text/css; charset=utf-8')
            if path == '/':
                data, error = status(fresh='fresh' in query)
                return self.reply(200, page.overview(data, error))
            match = re.fullmatch(r'/project/([a-z0-9][a-z0-9_-]{0,63})/logs', path)
            if match:
                environment, container = query.get('env', [''])[0], query.get('container', [''])[0]
                lines = query.get('lines', [CONTAINER_LINES[0]])[0]
                if not ENVIRONMENT.fullmatch(environment) or not CONTAINER.fullmatch(container) or lines not in CONTAINER_LINES:
                    return self.reply(400, page.invalid('Netinkama aplinka, konteineris ar eilučių skaičius.'))
                data, error = helper('--container-logs', match[1], environment, container, lines)
                return self.reply(200, page.container_logs(match[1], environment, container, lines, data, error))
            if path == '/worker-metrics':
                data, error = helper('--metrics')
                return self.reply(200, page.worker_metrics(data, error))
            match = re.fullmatch(r'/project/([a-z0-9][a-z0-9_-]{0,63})', path)
            if match:
                data, error = status(fresh='fresh' in query)
                rendered = page.project(data, match[1]) if data else \
                    page.layout('Projektas', f'<div class="callout bad"><p>{e(error)}</p></div>')
                return self.reply(200, rendered) if rendered else \
                    self.reply(404, page.layout('Nėra projekto', '<p><a href="/">← Į apžvalgą</a></p>'))
            if path == '/access':
                data, error = status(fresh='fresh' in query)
                page.recent = (helper('--activity')[0] or {}).get('events')
                return self.reply(200, page.access(data, error, query.get('q', [''])[0][:64]))
            if path == '/access/new':
                data, error = status()
                return self.reply(200, page.new_key(data, error))
            match = re.fullmatch(r'/access/(' + KEY_NAME.pattern + r')/session/(\d{8}T\d{6}Z-\d+\.log)', unquote(path))
            if match:
                data, error = helper('--session', match[1], match[2])
                events = (helper('--activity', match[1])[0] or {}).get('events', [])
                event = next((item for item in events if item.get('session') == match[2]), None)
                return self.reply(200, page.session_page(match[1], data, error, event))
            match = re.fullmatch(r'/access/(' + KEY_NAME.pattern + ')', unquote(path))
            if match:
                data, error = status(fresh='fresh' in query)
                events = (helper('--activity', match[1])[0] or {}).get('events')
                rendered = page.key_page(data, match[1], events, query.get('q', [''])[0][:64], query.get('granted') == ['1'],
                                         query.get('tab', ['access'])[0]) if data else None
                return self.reply(200, rendered) if rendered else \
                    self.reply(404, page.layout('Nėra rakto', '<p><a href="/access">← Prieiga</a></p>', section='access'))
            match = re.fullmatch(r'/files/([a-z0-9][a-z0-9_-]{0,63})/(' + ENVIRONMENT.pattern + r')(?:/(' +
                                 FILES_ARCHIVE.pattern + r')(/view|/download)?)?', path)
            if match:
                name, environment, archive, part = match.groups()
                data, error = status(fresh='fresh' in query)
                state = next((item.get('environments', {}).get(environment) for item in (data or {}).get('projects', [])
                              if item.get('name') == name), None)
                if not archive:
                    rendered = page.files_environment(data, name, environment) if data else \
                        page.layout('Failai', f'<div class="callout bad"><p>{e(error)}</p></div>', section='files')
                    return self.reply(200, rendered) if rendered else \
                        self.reply(404, page.layout('Nėra aplinkos', '<p><a href="/files">← Failų kopijos</a></p>', section='files'))
                # The previous archive: the next older one of the same series (the status lists them newest first).
                names = [item['name'] for item in Page.files_archives(state or {})]
                older = names[names.index(archive) + 1] if archive in names[:-1] else None
                if not part:
                    listing, error = helper('--files', name, environment, archive)
                    previous = helper('--files', name, environment, older)[0] if older and listing else None
                    return self.reply(200, page.files_archive(name, environment, archive, listing, previous,
                                                              query.get('q', [''])[0][:200], query.get('changed') == ['1'], error))
                member = query.get('path', [''])[0]
                if not FILE_MEMBER.fullmatch(member):
                    return self.reply(400, page.invalid('Netinkamas failo kelias.'))
                data, error = helper('--file', name, environment, archive, member)
                if part == '/download':
                    if error or not data or data.get('error') or data.get('truncated'):
                        return self.reply(404, page.layout('Failas', f'<div class="callout bad"><p>{e(error or (data or {}).get("error") or "per didelis")}</p></div>',
                                                           section='files'))
                    filename = member.rsplit('/', 1)[-1]
                    fallback = re.sub(r'[^A-Za-z0-9._-]', '_', filename) or 'file'
                    return self.reply(200, base64.b64decode(data['content']), 'application/octet-stream', headers=[
                        ('Content-Disposition', f"attachment; filename=\"{fallback}\"; filename*=UTF-8''{quote(filename)}")])
                previous = None
                if older and data and not data.get('error'):
                    previous, problem = helper('--file', name, environment, older, member)
                    previous = {**(previous or {'error': problem}), 'archive': older}
                return self.reply(200, page.files_view(name, environment, archive, member, data, previous, error))
            if path == '/files':
                data, error = status(fresh='fresh' in query)
                return self.reply(200, page.files(data, error))
            if path == '/update':
                data, error = status(fresh='fresh' in query)
                return self.reply(200, page.update_page(data, error, installation()))
            if path == '/actions':
                data, _ = status()
                target = query.get('target', [''])[0]
                target = target if len(target) <= 200 and TARGET.fullmatch(target) else ''
                return self.reply(200, page.actions((data or {}).get('github_runners', []), target))
            if path == '/instructions':
                data, _ = status()
                return self.reply(200, page.instructions(*guide_values(query, data)))
            if path == '/instructions/example':
                return self.reply(200, page.instructions_example())
            if path == '/logs':
                recent = []
                for directory in jobs(20):
                    try:
                        meta, result, running = job_state(directory)
                    except (OSError, ValueError, KeyError):
                        continue
                    kind = 'run' if running else 'bad' if result is None or result['exit'] else 'ok'
                    state = badge('vykdoma', 'run') if running else badge('nutrūko', 'bad') if result is None else \
                        badge(f'kodas {result["exit"]}', kind)
                    recent.append((directory.name, meta, state, kind))
                data, error = helper('--logs', '50')
                page.recent = (helper('--activity')[0] or {}).get('events')
                return self.reply(200, page.logs(tail(ACTIONS_LOG), recent, data, error))
            match = re.fullmatch(r'/job/(' + JOB_ID.pattern + ')', path)
            if match and (JOBS / match[1] / 'job.json').is_file():
                meta, result, running = job_state(JOBS / match[1])
                output = JOBS / match[1] / 'output.log'
                return self.reply(200, page.job(match[1], meta, result, running, tail(output, 3000) if output.exists() else ''))
            self.reply(404, page.layout('Nerasta', '<p><a href="/">← Į apžvalgą</a></p>'))

        do_HEAD = do_GET

        def do_POST(self):
            name = self.login()
            if name is None:
                return
            origin = self.headers.get('Origin')
            if origin is not None and (urlsplit(origin).hostname or '') not in ('127.0.0.1', 'localhost', '::1'):
                log(f'refused {self.client()}: POST from Origin {origin[:60]!r} (403)')
                return self.reply(403, self.page_text('Užklausa ne iš šios sąsajos.'))
            length = self.headers.get('Content-Length', '')
            if not length.isdigit() or int(length) > BODY_LIMIT:
                return self.reply(413, self.page_text('Per didelė užklausa.'))
            fields = parse_qs(self.rfile.read(int(length)).decode('utf-8', 'replace'), keep_blank_values=True)
            form = {key: values[0] for key, values in fields.items()}
            if not hmac.compare_digest(form.get('csrf', '').encode(), self.token(name).encode()):
                log(f'refused {self.client()}: POST {urlsplit(self.path).path} without a valid CSRF token (403)')
                return self.reply(403, self.page_text('Pasenusi forma: atnaujink puslapį ir bandyk dar kartą.'))
            page = Page(name, self.token(name))
            path = urlsplit(self.path).path
            if path == '/preview':
                return self.preview(page, name, form)
            if path == '/run':
                return self.run(page, name, form)
            self.reply(404, page.layout('Nerasta', ''))

        def preview(self, page, name, form):
            builder = ACTIONS.get(form.get('action', ''))
            if builder is None:
                return self.reply(400, page.invalid('Nežinomas veiksmas.'))
            try:
                plan = builder(form, status()[0] if form.get('action') in ('pipeline', 'add-backup-key', 'key-bulk', 'tool-access',
                                                                           'tool-bulk', 'tool-password', 'tool-person') else None)
            except Invalid as error:
                return self.reply(400, page.invalid(str(error)))
            if plan.kind == 'pipeline':
                variable, _ = token_for(plan.project)
                return self.reply(200, page.pipeline_preview(plan, pending.add(plan, name), variable))
            kind = 'read' if plan.run is None else 'check'
            code, output = check(plan)
            try:
                record(name, self.client(), kind, f'{plan.action}: {shlex.join(plan.check)} -> exit {code}')
            except OSError as error:
                # Nothing runs without its line in the log: no "Vykdyti" either.
                output += f'\n\n(ui-actions.log: {error.strerror}; vykdyti negalima)'
                code = None
            key = pending.add(plan, name) if plan.run is not None and code in plan.run_codes else None
            self.reply(200, page.preview(plan, code, output, key))

        def run(self, page, name, form):
            plan = pending.take(form.get('pending', ''), name)
            if plan is None:
                return self.reply(400, page.invalid('Peržiūra nebegalioja (pasibaigė, jau vykdyta ar sąsaja persikrovė): pradėk iš naujo.'))
            if plan.kind == 'pipeline':
                return self.pipeline(page, name, plan)
            busy = running_job()
            if busy:
                return self.reply(409, page.layout('Užimta', f'<div class="callout warn"><p>Dar vykdomas kitas veiksmas: '
                                                            f'<a href="/job/{e(busy)}">{e(busy)}</a>. Palauk, kol baigsis.</p></div>'))
            identifier = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ') + '-' + secrets.token_hex(3)
            try:
                record(name, self.client(), 'run', f'job={identifier} {plan.action}: {shlex.join(plan.run)}')
            except OSError as error:
                return self.reply(500, page.invalid(f'Veiksmų žurnalas {ACTIONS_LOG} neįrašomas ({error.strerror}): nieko nevykdyta.'))
            start_job(plan, identifier, name, self.client())  # status() reads again once it has finished
            self.send_response(303)
            self.send_header('Location', f'/job/{identifier}')
            self.send_header('Content-Length', '0')
            self.end_headers()

        def pipeline(self, page, name, plan):
            variable, token = token_for(plan.project)
            if not token:
                return self.reply(400, page.invalid(f'Nėra Bitbucket token\'o ({TOKEN_VARIABLE}).'))
            what = (f'POST {plan.path} {plan.pipeline} branch={plan.branch} ' +
                    ' '.join(f'{key}={text}' for key, text in plan.variables) + f' (token {variable})')
            try:
                record(name, self.client(), 'pipeline', f'{plan.project}: {what} (sending)')
            except OSError as error:
                return self.reply(500, page.invalid(f'Veiksmų žurnalas {ACTIONS_LOG} neįrašomas ({error.strerror}): nieko nevykdyta.'))
            code, data, error = bitbucket('POST', plan.path, token, plan.body)
            number = data.get('build_number') if isinstance(data, dict) else None
            try:
                record(name, self.client(), 'pipeline', f'{plan.project}: {what} -> ' +
                       (f'HTTP {code} #{number}' if not error else error))
            except OSError as failure:
                log(f'ui-actions.log: {failure}')
            CACHE.forget(('pipelines', plan.project))
            self.reply(200 if not error else 502, page.pipeline_result(plan, code, data, error))

        def log_message(self, format, *arguments):  # refusals and errors only (log() above)
            pass

    return Handler


class Server(ThreadingHTTPServer):
    daemon_threads = True


def main(arguments):
    if arguments[:1] == ['--job'] and len(arguments) == 2:
        return job_main(arguments[1])
    if arguments == ['--hash']:
        password = sys.stdin.readline().rstrip('\n')
        if len(password) < 12:
            log('The password needs 12+ characters')
            return 65
        print(password_hash(password))
        return 0
    if arguments not in ([], ['--check']):
        log(__doc__.split('\n\n')[-1])
        return 64
    try:
        user, stored, port = settings()
    except Refused as error:
        log(str(error))
        return CONFIGURATION_ERROR
    tokens = sorted(key for key in os.environ if key.startswith(TOKEN_VARIABLE) and os.environ[key])
    if arguments == ['--check']:
        print(f'would listen on http://{ADDRESS}:{port}/ for {user} (Bitbucket tokens: {", ".join(tokens) or "none"})')
        return 0
    try:
        server = Server((ADDRESS, port), handler(user, stored))
    except OSError as error:
        log(f'Cannot listen on {ADDRESS}:{port}: {error}')
        return 1
    log(f'listening on {ADDRESS}:{server.server_address[1]} (Bitbucket tokens: {", ".join(tokens) or "none"})')
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
