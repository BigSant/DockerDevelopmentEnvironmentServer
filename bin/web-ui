def pipeline_title(pipeline):
    extra = EXTRA_DEPLOY.fullmatch(pipeline)
    return f'Deploy į {extra[1]}' if extra and pipeline not in PIPELINES else PIPELINES[pipeline]


def log(text):
    print(text, file=sys.stderr, flush=True)


class Refused(Exception):
    """Settings the service will not start with (exit 78)."""


class Invalid(ValueError):
    """A form value that is not accepted; the message is shown to the user."""


# --- Settings ------------------------------------------------------------------------------------
def password_hash(password, salt=None, iterations=HASH_ITERATIONS):
    salt = salt or secrets.token_bytes(16)
    digest = hashlib.pbkdf2_hmac('sha256', password.encode(), salt, iterations)
    encode = lambda data: base64.urlsafe_b64encode(data).decode().rstrip('=')
    return f'pbkdf2_sha256:{iterations}:{encode(salt)}:{encode(digest)}'


def password_matches(password, stored):
    try:
        scheme, iterations, salt, _ = stored.split(':')
        if scheme != 'pbkdf2_sha256':
            return False
        salt = base64.urlsafe_b64decode(salt + '=' * (-len(salt) % 4))
        return hmac.compare_digest(password_hash(password, salt, int(iterations)), stored)
    except (ValueError, TypeError):
        return False


def settings():
    user = os.environ.get('UI_USER', '')
    if not re.fullmatch(r'[A-Za-z0-9._-]{1,32}', user):
        raise Refused('UI_USER must be 1-32 letters, digits, . _ or - (bin/install-ui sets it)')
    stored = os.environ.get('UI_PASSWORD_HASH', '')
    if not re.fullmatch(r'pbkdf2_sha256:[0-9]{5,7}:[A-Za-z0-9_-]{16,}:[A-Za-z0-9_-]{40,}', stored):
        raise Refused('UI_PASSWORD_HASH is missing or not a pbkdf2_sha256 hash (sudo bin/install-ui --new-password)')
    address = os.environ.get('UI_ADDRESS') or ADDRESS
    if address != ADDRESS:
        raise Refused(f'UI_ADDRESS must be {ADDRESS}: the UI is reached through an SSH tunnel, never directly; got {address!r}')
    port = os.environ.get('UI_PORT') or str(DEFAULT_PORT)
    if not port.isdigit() or not (int(port) == 0 or 1024 <= int(port) <= 65535):
        raise Refused(f'UI_PORT must be a TCP port number from 1024 to 65535; got {port!r}')
    api = bitbucket_api()
    if not (api.startswith('https://') or re.match(r'http://127\.0\.0\.1:[0-9]+/', api + '/')):
        raise Refused('BITBUCKET_API must be an https:// address')
    return user, stored, int(port)


def bitbucket_api():
    return (os.environ.get('BITBUCKET_API') or 'https://api.bitbucket.org/2.0').rstrip('/')


def child_environment():
    """The environment of every command: this one's, without the login hash and the tokens."""
    return {key: value for key, value in os.environ.items()
            if not key.startswith(TOKEN_VARIABLE) and key != 'UI_PASSWORD_HASH'}


def installation():
    """The admin clone bin/install-ui was run from and its owner ($LIBRARY/install.env)."""
    values = {}
    try:
        for line in (LIBRARY / 'install.env').read_text().splitlines():
            key, separator, value = line.partition('=')
            if separator and re.fullmatch(r'[A-Z]+', key):
                values[key] = value.strip()
    except OSError:
        pass
    checkout, admin = values.get('CHECKOUT', ''), values.get('ADMIN', '')
    if not re.fullmatch(r'/[A-Za-z0-9._/-]+', checkout) or not re.fullmatch(r'[a-z_][a-z0-9_.-]*', admin):
        checkout = admin = None
    return {'version': values.get('VERSION'), 'checkout': checkout, 'admin': admin}


# --- The action log ------------------------------------------------------------------------------
def record(user, client, kind, text):
    """One line in ui-actions.log (append only, never through a symlink); raises OSError when it cannot."""
    stamp = datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
    line = f'{stamp} user={user} client={client} {kind} {text}'.replace('\n', ' ')[:4000] + '\n'
    descriptor = os.open(ACTIONS_LOG, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o640)
    with os.fdopen(descriptor, 'a') as handle:
        handle.write(line)


# --- Form values ---------------------------------------------------------------------------------
def value(form, key, pattern=None, label=None, required=False, limit=200):
    text = form.get(key, '').strip()
    if not text:
        if required:
            raise Invalid(f'Užpildyk lauką „{label or key}“.')
        return ''
    if len(text) > limit or (pattern is not None and not pattern.fullmatch(text)):
        raise Invalid(f'Netinkama reikšmė lauke „{label or key}“: {text[:80]}')
    return text


def git_ref(form, key, label, required=False):
    text = value(form, key, REF, label, required)
    if text and ('..' in text or '//' in text or text.endswith(('/', '.lock', '.'))):
        raise Invalid(f'Netinkama reikšmė lauke „{label}“: {text[:80]}')
    return text


def git_url(form, key, label, required=False):
    text = value(form, key, GIT_URL, label, required, limit=300)
    if text.endswith('.git.git'):
        raise Invalid(f'Netinkama reikšmė lauke „{label}“: {text[:80]}')
    return text


def networks(text, label):
    found = []
    for part in [part for part in re.split(r'[\s,]+', text) if part]:
        try:
            network = ipaddress.ip_network(part, strict=False)
        except ValueError:
            raise Invalid(f'„{label}“: {part[:60]} nėra IP adresas ar tinklas.') from None
        if network.prefixlen == 0:
            raise Invalid(f'„{label}“: nurodyk konkretų tinklą, ne visus adresus.')
        found.append(part)
    return found


def flag(form, key):
    return form.get(key) == 'yes'


# --- Actions: what each form runs ----------------------------------------------------------------
class Plan:
    """One action: the --check command, the command "Vykdyti" runs, and its stdin (kept in memory only)."""

    def __init__(self, action, title, check, run, stdin=None, timeout=600, run_codes=(0,), danger=None):
        self.action, self.title, self.check, self.run = action, title, check, run
        self.stdin, self.timeout, self.run_codes = stdin, timeout, run_codes
        self.danger = danger  # what can go wrong, shown above "Vykdyti"
        self.kind = 'command'
        self.changes = []  # (kind, text) the preview lists above the command: what the run changes
        self.back = ('/actions', 'actions')  # where "Atšaukti" leads, and the page's navigation section


class PipelinePlan:
    """A Bitbucket custom pipeline: the request is shown first, sent on "Vykdyti"."""

    def __init__(self, project, workspace, slug, pipeline, branch, variables):
        self.action, self.kind = 'pipeline', 'pipeline'
        self.project, self.workspace, self.slug = project, workspace, slug
        self.pipeline, self.branch, self.variables = pipeline, branch, variables
        self.title = f'{pipeline_title(pipeline)}: {project}'
        self.path = f'/repositories/{quote(workspace)}/{quote(slug)}/pipelines/'
        self.body = {'target': {'type': 'pipeline_ref_target', 'ref_type': 'branch', 'ref_name': branch,
                                'selector': {'type': 'custom', 'pattern': pipeline}},
                     'variables': [{'key': key, 'value': text} for key, text in variables]}


def command(script, arguments):
    """sudo of a root-owned copy in $LIBRARY/bin: (with --check, without)."""
    base = ['sudo', '-n', str(LIBRARY / 'bin' / script)]
    return base + ['--check'] + arguments, base + arguments


def plan_add_project(form, status):
    name = value(form, 'name', NAME, 'Vardas')
    env_repo = git_url(form, 'env_repo', 'Aplinkos repo', required=True)
    code_repo = git_url(form, 'code_repo', 'Kodo repo')
    targets = [line.strip() for line in form.get('targets', '').splitlines() if line.strip()]
    if len(targets) > 3:
        raise Invalid('Taikinių – ne daugiau kaip trys (bendras, stage=, prod=).')
    for target in targets:
        if len(target) > 200 or not TARGET.fullmatch(target):
            raise Invalid(f'Netinkamas taikinys: {target[:80]} (local, local:/KELIAS arba ssh://VARTOTOJAS@SERVERIS/KELIAS, '
                          'prieš jį gali būti stage= ar prod=).')
    arguments = (['--shared-key'] if flag(form, 'shared_key') else []) + [part for target in targets for part in ('--target', target)]
    arguments += ([name] if name else []) + [env_repo] + ([code_repo] if code_repo else [])
    return Plan('add-project', 'Pridėti projektą', *command('add-project', arguments), timeout=1800)


def plan_remove_project(form, status):
    name = value(form, 'name', NAME, 'Projektas', required=True)
    with_backups = flag(form, 'with_backups')
    arguments = (['--with-backups'] if with_backups else []) + [name]
    return Plan('remove-project', f'Pašalinti projektą {name}', *command('remove-project', arguments),
                danger='Build katalogas ištrinamas' + (' kartu su DB kopijomis ir deploy\'ų istorija.' if with_backups else '.'))


def plan_install_runner(form, status):
    provider = form.get('provider', 'bitbucket')
    if provider not in ('bitbucket', 'github'):
        raise Invalid('Runner\'is: bitbucket arba github.')
    name = value(form, 'runner_name', RUNNER_NAME, 'Vardas GitHub\'e') if provider == 'github' else ''
    tarball = value(form, 'tarball', TARBALL, 'Archyvas', limit=420)
    if tarball and ('..' in tarball.split('/') or tarball.startswith('//')):
        raise Invalid(f'Netinkama reikšmė lauke „Archyvas“: {tarball[:80]}')
    sha256 = value(form, 'sha256', SHA256, 'SHA-256')
    if sha256 and provider != 'github':
        raise Invalid('SHA-256 nurodomas tik GitHub runner\'iui (Bitbucket archyvą tikrina pati Atlassian nuoroda).')
    if sha256 and not tarball:
        raise Invalid('SHA-256 – tik kartu su archyvu (be jo imamas pin\'intas release\'as, jo hash\'as žinomas).')
    text = form.get('dialog', '')
    if not text.strip():
        raise Invalid('Įklijuok Bitbucket dialogo (GitHub puslapio) tekstą.')
    if len(text) > 64 * 1024:
        raise Invalid('Tekstas per ilgas.')
    arguments = ['--provider', provider] + (['--name', name] if name else []) + \
        (['--tarball', tarball] if tarball else []) + (['--sha256', sha256] if sha256 else [])
    title = 'Įdiegti GitHub runner\'į' if provider == 'github' else 'Įdiegti Bitbucket runner\'į'
    return Plan('install-runner', title, *command('install-runner', arguments), stdin=text, timeout=1800)


def plan_install_backups(form, status):
    at = value(form, 'at', re.compile(r'([01][0-9]|2[0-3]):[0-5][0-9]'), 'Laikas')
    full_at = value(form, 'full_at', re.compile(r'(Mon|Tue|Wed|Thu|Fri|Sat|Sun) ([01][0-9]|2[0-3]):[0-5][0-9]'),
                    'Pilnos kopijos diena ir laikas')
    files_at = value(form, 'files_at', re.compile(r'([01][0-9]|2[0-3]):[0-5][0-9]'), 'Failų kopijos laikas')
    arguments = (['--at', at] if at else []) + (['--full-at', full_at] if full_at else []) + \
        (['--files-at', files_at] if files_at else [])
    return Plan('install-backups', 'Kopijos (naktinės, savaitinės pilnos ir failų)', *command('install-backups', arguments))


def plan_install_metrics(form, status):
    arguments = []
    address = value(form, 'address', re.compile(r'[0-9a-fA-F:.]{2,45}'), 'Adresas')
    if address:
        try:
            ipaddress.ip_address(address)
        except ValueError:
            raise Invalid(f'„Adresas“: {address} nėra IP adresas.') from None
        arguments += ['--address', address]
    allow = networks(form.get('allow', ''), 'Leidžiami adresai')
    if allow:
        arguments += ['--allow', ' '.join(allow)]
    port = value(form, 'port', re.compile(r'[0-9]{1,5}'), 'Port\'as')
    if port:
        arguments += ['--port', port]
    token = form.get('token', 'keep')
    if token not in ('keep', 'new', 'none'):
        raise Invalid('Token\'as: palikti, naujas arba be jo.')
    arguments += {'keep': [], 'new': ['--new-token'], 'none': ['--no-token']}[token]
    return Plan('install-metrics', 'Worker\'io metrikos', *command('install-metrics', arguments))


def plan_backup_local(form, status):
    name = value(form, 'project', NAME, 'Projektas')
    environment = form.get('environment', '')
    if environment and not ENVIRONMENT.fullmatch(environment):
        raise Invalid('Aplinka: stage, prod ar projekto STAGE_ENVIRONMENTS (pvz. mdv).')
    if environment and not name:
        raise Invalid('Aplinka nurodoma tik kartu su projektu.')
    full, files = flag(form, 'full'), flag(form, 'files')
    if full and files:
        raise Invalid('Failų kopija nėra DB kopija: „pilna“ su ja nežymima.')
    arguments = (['--full'] if full else ['--files'] if files else []) + ([name] if name else []) + \
        ([environment] if environment else [])
    what = ' '.join(part for part in (name or 'visi projektai', environment) if part)
    title = f'{"Pilna DB kopija" if full else "Failų kopija" if files else "DB kopija"} dabar: {what}'
    return Plan('backup-local', title, *command('backup-projects', arguments), timeout=12 * 3600)


def plan_unit(form, status):
    unit, operation = form.get('unit', ''), form.get('operation', '')
    scope = unit[len('github-runner@'):] if unit.startswith('github-runner@') else None
    allowed = ('start', 'stop', 'restart') if scope and SCOPE.fullmatch(scope) else UNIT_OPERATIONS.get(unit)
    if not allowed:
        raise Invalid('Nežinoma paslauga.')
    if operation not in allowed:
        raise Invalid(f'Paslaugai „{unit}“ galima tik: {", ".join(allowed)}.')
    title = f'{OPERATION_TITLES[operation]}: ' + (f"GitHub runner'is {scope}" if scope else UNIT_TITLES[unit])
    danger = None
    if operation in ('stop', 'restart') and unit != 'ui' and unit != 'metrics':
        danger = 'Vykdomas pipeline\'o žingsnis nutrūktų (peržiūra parodo, ar toks yra).'
    if operation == 'stop' and unit == 'metrics':
        danger = 'Prometheus nebegaus worker\'io metrikų, kol paslauga nebus paleista.'
    return Plan('unit', title, *command('server-unit', [operation, unit]),
                timeout=12 * 3600 if unit.startswith('backup') else 600, danger=danger)


def plan_install_ssh(form, status):
    sources = networks(form.get('sources', ''), 'Tinklai')
    arguments = ['--from', ','.join(sources)] if sources else []
    return Plan('install-ssh', 'SSH iš VPN (bin/install-ssh)', *command('install-ssh', arguments), timeout=1800,
                danger='Iš kitų tinklų sshd priims tik raktus. Šią sąsają pasieki per SSH tunelį: patikrink, kad tavo '
                       'tinklas yra sąraše arba kad jungiesi raktu.')


def stored_key(status, name):
    return next((item for item in (status or {}).get('keys', []) if item.get('name') == name), None)


def text_grants(form, kind='access'):
    """{(project, env): level} of a free text field: PROJECT[:ENV]=LEVEL, without ENV both stage and prod."""
    field, levels, _, title, _ = KINDS[kind]
    found = {}
    for grant in form.get(f'{field}s', '').replace(',', ' ').split():
        if not (GRANT if kind == 'access' else PULL).fullmatch(grant):
            raise Invalid(f'„{title}“: {grant} – rašyk PROJEKTAS[:APLINKA]=LYGIS (aplinka stage, prod, mdv…; be jos – '
                          f'stage ir prod), lygis {", ".join(levels)}.')
        target, level = grant.split('=')
        project, _, environment = target.partition(':')
        for one in [environment] if environment else ['stage', 'prod']:
            found[(project, one)] = level
    return found


def grant_changes(before, after, kind='access'):
    """What a key's grants become: (kind, text) lines for the preview, a project environment per line."""
    changes, prefix = [], '' if kind == 'access' else 'kopijos: '
    for item in sorted(set(before) | set(after), key=lambda pair: (pair[0], environment_order(pair[1]))):
        old, new = before.get(item), after.get(item)
        if old == new:
            continue
        where = f'{prefix}{item[0]} {item[1]}'
        if new is None:
            changes.append(('bad', f'− {where}: atimama {LEVEL_LABELS[old]}'))
        elif old is None:
            changes.append(('ok', f'+ {where}: {LEVEL_LABELS[new]}'))
        else:
            changes.append(('warn', f'~ {where}: {LEVEL_LABELS[old]} → {LEVEL_LABELS[new]}'))
    return changes


def key_plan(name, stored, granted, pulls, pull_all, public_key, sources, title):
    """bin/add-backup-key with the key's whole lists (written explicitly, so nothing depends on what it kept);
    the preview lists what changes."""
    arguments = (['-'] if public_key else []) + ['--name', name] + (['--from', ','.join(sources)] if sources else [])
    arguments += ['--pull-all', pull_all]
    arguments += [word for (project, environment), level in sorted(pulls.items())
                  for word in ('--pull', f'{project}:{environment}={level}')] or ['--no-pulls']
    arguments += [word for (project, environment), level in sorted(granted.items())
                  for word in ('--grant', f'{project}:{environment}={level}')] or ['--no-grants']
    plan = Plan('add-backup-key', title, *command('add-backup-key', arguments), stdin=public_key + '\n' if public_key else None)
    plan.changes = grant_changes(key_grants(stored), granted) + grant_changes(key_grants(stored, 'backups'), pulls, 'backups')
    before = (stored or {}).get('pull_all', 'none')
    if before != pull_all:
        plan.changes.append(('warn' if stored else 'ok', f'kopijos, visi projektai (ir nauji): {before} → {pull_all}'))
    if stored is not None:
        if sources and sources != stored.get('sources'):
            plan.changes.append(('warn', f'iš kur: {", ".join(stored.get("sources", []))} → {", ".join(sources)}'))
        if public_key:
            plan.changes.append(('warn', 'raktas pakeičiamas nauju'))
    plan.back = (f'/access/{quote(name)}' if stored else '/access/new', 'access')
    return plan


def plan_add_backup_key(form, status):
    """A new developer key, or a change of an existing one. A key page sends merge=yes: the cells it shows change
    those project environments only (a filtered list keeps the rest). Without a pasted key the stored key stays,
    with the networks left empty its networks; pull_all, when sent, sets every project's backups."""
    lines = [line.strip() for line in form.get('public_key', '').splitlines() if line.strip()]
    name = value(form, 'key_name', KEY_NAME, 'Vardas', required=True)
    stored = stored_key(status, name)
    if lines and (len(lines) != 1 or not PUBLIC_KEY.fullmatch(lines[0])):
        raise Invalid('Įklijuok vieną viešąjį raktą (.pub eilutę, pvz. „ssh-ed25519 AAAA… vardas“), ne privatų.')
    if not lines and stored is None:
        raise Invalid('Įklijuok viešąjį raktą (.pub eilutę): rakto vardu ' + name + ' serveryje dar nėra.')
    if stored is not None and form.get('new') == 'yes':
        raise Invalid(f'Raktas vardu {name} jau yra: keisk jį jo puslapyje.')
    sources = networks(form.get('sources', ''), 'Iš kur')
    if not sources and stored is None:
        raise Invalid('„Iš kur“: nurodyk VPN tinklą, pvz. 10.8.0.0/24.')
    merge = flag(form, 'merge')
    found = {'access': dict(key_grants(stored)) if merge else {},
             'backups': dict(key_grants(stored, 'backups')) if merge else {}}
    pull_all = form.get('pull_all', (stored or {}).get('pull_all', 'none') if merge else 'none') or 'none'
    if pull_all not in ('none', *PULL_LEVELS):
        raise Invalid(f'„Kopijos“: nežinomas lygis {pull_all}.')
    columns = access_columns(status)
    for kind, (field, levels, _, title, _) in KINDS.items():
        for environment in ('prod', 'stage'):  # a new key's starting level for every project environment of that name
            level = form.get(f'start:{field}:{environment}', '')
            if level and level not in levels:
                raise Invalid(f'„{title}“: nežinomas lygis {level}.')
            if level:
                found[kind].update({(project, environment): level for project, one in columns if one == environment})
    for key, chosen in form.items():
        match = GRANT_FIELD.fullmatch(key)
        if key.startswith(('grant:', 'pull:')) and not match:
            raise Invalid('„Prieiga“: netinkamas projektas ar aplinka.')
        if match:
            kind = 'access' if match[1] == 'grant' else 'backups'
            if chosen and chosen not in KINDS[kind][1]:
                raise Invalid(f'„{KINDS[kind][3]}“: nežinomas lygis {chosen}.')
            if chosen:
                found[kind][(match[2], match[3])] = chosen
            else:
                found[kind].pop((match[2], match[3]), None)
    found['access'].update(text_grants(form))
    found['backups'].update(text_grants(form, 'backups'))
    title = f'Naujas raktas {name}' if stored is None else f'Rakto {name} pakeitimas'
    return key_plan(name, stored, found['access'], found['backups'], pull_all, lines[0] if lines else '', sources, title)


def plan_key_bulk(form, status):
    """One level of access or backups for every prod, every stage or every environment of an existing key, or only
    where it already has some."""
    name = value(form, 'key_name', KEY_NAME, 'Vardas', required=True)
    stored = stored_key(status, name)
    if stored is None:
        raise Invalid(f'Rakto vardu {name} nėra.')
    kind = form.get('kind', 'access')
    scope, level, only = form.get('scope', ''), form.get('level', ''), form.get('only') == 'existing'
    if kind not in KINDS or scope not in ('prod', 'stage', 'other', 'all') or (level and level not in KINDS[kind][1]):
        raise Invalid('Pasirink aplinką (prod, stage, kitos, visos) ir lygį.')
    granted, pulls = dict(key_grants(stored)), dict(key_grants(stored, 'backups'))
    changed = granted if kind == 'access' else pulls
    before = dict(changed)
    for item in access_columns(status):
        wanted = scope == 'all' or item[1] == scope or (scope == 'other' and item[1] not in ('prod', 'stage'))
        if wanted and (not only or item in before):
            if level:
                changed[item] = level
            else:
                changed.pop(item, None)
    what = {'prod': 'visos prod', 'stage': 'visos stage', 'other': 'kitos aplinkos', 'all': 'visos aplinkos'}[scope]
    title = (f'{name}: {KINDS[kind][3].lower()}, {what} → {LEVEL_LABELS.get(level, "be leidimo")}' +
             (' (tik kur jau turi)' if only else ''))
    plan = key_plan(name, stored, granted, pulls, stored.get('pull_all', 'none'), '', [], title)
    if not plan.changes:
        plan.changes = [('muted', 'nieko nesikeičia')]
    return plan


def tool_state(status):
    return (status or {}).get('tool_access') or {}


def tool_user(status, name):
    return (tool_state(status).get('users') or {}).get(name) or {}


def full_names(status):
    """A key's name -> the person's full name, for the keys that have one (bin/tool-access --full-name)."""
    return {name: user['full_name'] for name, user in (tool_state(status).get('users') or {}).items() if user.get('full_name')}


def plan_tool_access(form, status):
    """The project environments whose tools a key's user opens: the cells the page shows change, the rest stays."""
    name = value(form, 'key_name', KEY_NAME, 'Vardas', required=True)
    if stored_key(status, name) is None:
        raise Invalid(f'Rakto vardu {name} nėra.')
    user = tool_user(status, name)
    before = set(user.get('projects', []))
    after = set(before)
    for key, chosen in form.items():
        if not key.startswith('tool:'):
            continue
        match = TOOL_FIELD.fullmatch(key)
        if not match or chosen not in ('', 'tools'):
            raise Invalid('„Įrankiai“: netinkamas projektas ar aplinka.')
        (after.add if chosen else after.discard)(f'{match[1]}:{match[2]}')
    return tool_plan(name, user, before, after, f'{name}: įrankiai')


def plan_tool_bulk(form, status):
    """Tools for every prod, every stage, the other or all environments of a key's user at once."""
    name = value(form, 'key_name', KEY_NAME, 'Vardas', required=True)
    if stored_key(status, name) is None:
        raise Invalid(f'Rakto vardu {name} nėra.')
    scope, level = form.get('scope', ''), form.get('level', '')
    if scope not in ('prod', 'stage', 'other', 'all') or level not in ('', 'tools'):
        raise Invalid('Pasirink aplinką (prod, stage, kitos, visos) ir lygį.')
    user = tool_user(status, name)
    before = set(user.get('projects', []))
    after = set(before)
    for project, environment in access_columns(status):
        # local and test never run on a target: no tools there to open.
        if environment in ('local', 'test'):
            continue
        if scope == 'all' or environment == scope or (scope == 'other' and environment not in ('prod', 'stage')):
            (after.add if level else after.discard)(f'{project}:{environment}')
    what = {'prod': 'visos prod', 'stage': 'visos stage', 'other': 'kitos aplinkos', 'all': 'visos aplinkos'}[scope]
    return tool_plan(name, user, before, after, f'{name}: įrankiai, {what} → {LEVEL_LABELS["tools"] if level else "be leidimo"}')


def tool_plan(name, user, before, after, title):
    arguments = ['--name', name] + ([word for item in sorted(after) for word in ('--tools', item)] or ['--no-tools'])
    plan = Plan('tool-access', title, *command('tool-access', arguments), timeout=3600)
    plan.changes = ([('bad', f'− {item.replace(":", " ")}: įrankiai nebeįleis') for item in sorted(before - after)] +
                    [('ok', f'+ {item.replace(":", " ")}: įrankiai įleis') for item in sorted(after - before)])
    if not plan.changes:
        plan.changes = [('muted', 'nieko nesikeičia')]
    if after and not user.get('password'):
        plan.changes.append(('warn', 'slaptažodis nenustatytas: kol jo nėra, įrankiai šio vartotojo neįleidžia'))
    plan.back = (f'/access/{quote(name)}?tab=tools', 'access')
    return plan


def plan_tool_password(form, status):
    """The tools password of a key's user, set by the administrator; it reaches bin/tool-access on stdin only."""
    name = value(form, 'key_name', KEY_NAME, 'Vardas', required=True)
    if stored_key(status, name) is None:
        raise Invalid(f'Rakto vardu {name} nėra.')
    if flag(form, 'remove'):
        plan = Plan('tool-password', f'{name}: pašalinti įrankių slaptažodį', *command('tool-access', ['--name', name, '--no-password']),
                    timeout=3600, danger=f'{name} nebepateks į jokio projekto įrankius.')
    else:
        password = form.get('tool_password', '')
        if not TOOL_PASSWORD[0] <= len(password) <= TOOL_PASSWORD[1] or any(ord(character) < 32 for character in password):
            raise Invalid(f'Slaptažodis: {TOOL_PASSWORD[0]}–{TOOL_PASSWORD[1]} simbolių, be valdymo simbolių.')
        plan = Plan('tool-password', f'{name}: įrankių slaptažodis', *command('tool-access', ['--name', name, '--password', '-']),
                    stdin=password + '\n', timeout=3600)
        plan.changes = [('warn' if tool_user(status, name).get('password') else 'ok',
                         'slaptažodis pakeičiamas nauju' if tool_user(status, name).get('password') else 'naujas slaptažodis')]
    plan.back = (f'/access/{quote(name)}?tab=tools', 'access')
    return plan


def plan_tool_person(form, status):
    """A key's person: the full name the pages show and the login the tools ask for (empty: the key's name)."""
    name = value(form, 'key_name', KEY_NAME, 'Vardas', required=True)
    if stored_key(status, name) is None:
        raise Invalid(f'Rakto vardu {name} nėra.')
    full = ' '.join(form.get('full_name', '').split())
    if len(full) > FULL_NAME_LENGTH or any(ord(character) < 32 or ord(character) == 127 for character in full):
        raise Invalid(f'Vardas ir pavardė: iki {FULL_NAME_LENGTH} simbolių.')
    login = value(form, 'login', TOOL_LOGIN, 'Prisijungimo vardas', limit=128)
    others = {other['name'] for other in (status or {}).get('keys', []) if other.get('name') != name}
    taken = {other.lower(): other for other in others}
    taken.update({(user.get('login') or other).lower(): other
                  for other, user in (tool_state(status).get('users') or {}).items() if other != name})
    if login and login.lower() in taken:
        raise Invalid(f'Prisijungimo vardas {login} jau užimtas (raktas {taken[login.lower()]}).')
    user = tool_user(status, name)
    plan = Plan('tool-person', f'{name}: vardas ir prisijungimas',
                *command('tool-access', ['--name', name, '--full-name', full, '--login', login]), timeout=3600)
    before = user.get('login') or name
    plan.changes = [('ok', f'vardas: {full}' if full else 'vardas nerodomas')] if full != (user.get('full_name') or '') else []
    if (login or name) != before:
        plan.changes.append(('warn', f'įrankiai klaus {login or name} vietoj {before}' +
                             (': pakeitimas nusiunčiamas į taikinius iš karto' if user.get('projects') else '')))
    plan.back = (f'/access/{quote(name)}', 'access')
    return plan


def plan_tool_ips(form, status):
    """This server's addresses every managed target lets reach its tools."""
    addresses = networks(form.get('allowed_ips', ''), 'Adresai')
    arguments = ['--allowed-ips', ','.join(addresses)] if addresses else ['--no-allowed-ips']
    plan = Plan('tool-ips', 'Įrankių adresai', *command('tool-access', arguments), timeout=3600)
    plan.back = ('/access#tools', 'access')
    return plan


def plan_tool_apply(form, status):
    plan = Plan('tool-apply', 'Įrankių prieiga – siųsti iš naujo', *command('tool-access', ['--apply']), timeout=3600)
    plan.back = ('/access#tools', 'access')
    return plan


def plan_remove_backup_key(form, status):
    name = value(form, 'key_name', KEY_NAME, 'Vardas', required=True)
    plan = Plan('remove-backup-key', f'Atimti raktą {name}', *command('add-backup-key', ['--remove', name]),
                danger=f'Raktas {name} nebegalės parsisiųsti kopijų nei prisijungti prie taikinių.')
    plan.back = (f'/access/{quote(name)}', 'access')
    return plan


def plan_list_backup_keys(form, status):
    # Read-only: the listing is the preview, nothing runs after it.
    return Plan('list-backup-keys', 'Kopijų raktai', ['sudo', '-n', str(LIBRARY / 'bin/add-backup-key'), '--list'], None)


def plan_prepare_host(form, status):
    ref = git_ref(form, 'setup_ref', 'setup tag\'as')
    # Exit 1 of --check is "Needs attention" (e.g. less RAM): the run still prepares the rest.
    return Plan('prepare-host', 'Paruošti serverį', *command('prepare-host', ['--setup-ref', ref] if ref else []),
                timeout=3600, run_codes=(0, 1))


def plan_move_bitbucket_ssh(form, status):
    return Plan('move-bitbucket-ssh', 'Bitbucket remote\'ai į ssh.bitbucket.org', *command('move-bitbucket-ssh', []), timeout=1800)


def plan_update(form, status):
    where = installation()
    if not where['checkout']:
        raise Invalid('Nežinomas administratoriaus klonas: paleisk sudo bin/install-ui iš jo.')
    server_ref = git_ref(form, 'server_ref', 'setup-server ref\'as')
    setup_ref = git_ref(form, 'setup_ref', 'setup ref\'as')
    if flag(form, 'latest'):
        server_ref = server_ref or 'origin/master'  # the newest setup-server: the repository has no release tags
    if not server_ref and not setup_ref:
        raise Invalid('Nurodyk bent vieną ref\'ą (setup-server arba setup).')
    arguments = (['--server-ref', server_ref] if server_ref else []) + (['--setup-ref', setup_ref] if setup_ref else [])
    base = ['sudo', '-n', '-H', '-u', where['admin'], f"{where['checkout']}/bin/update"]
    return Plan('update', 'Atnaujinti', base + ['--check'] + arguments, base + arguments, timeout=3600)


def plan_update_setup(form, status):
    """setup to the newest release of its MAJOR version (setup releases every merge to master: it is master), or to
    the release tag given."""
    tag = value(form, 'setup_tag', re.compile(r'v[0-9]+\.[0-9]+\.[0-9]+'), 'setup tag\'as')
    return Plan('update-setup', f'Atnaujinti setup {"į " + tag if tag else "į naujausią"}',
                *command('update-setup', [tag] if tag else []), timeout=600)


def plan_pipeline(form, status):
    name = value(form, 'project', NAME, 'Projektas', required=True)
    entry = next((item for item in (status or {}).get('projects', []) if item.get('name') == name), None)
    if entry is None:
        raise Invalid(f'Nėra projekto {name}.')
    repository = bitbucket_repository(entry.get('repository') or '')
    if repository is None:
        raise Invalid('Pipeline\'ai paleidžiami tik Bitbucket projektams (GitHub dar nepalaikomas).')
    pipeline = form.get('pipeline', '')
    extra = EXTRA_DEPLOY.fullmatch(pipeline)
    if pipeline not in PIPELINES and not (extra and extra[1] in entry.get('environments', {})):
        raise Invalid('Nežinomas pipeline\'as.')
    branch = git_ref(form, 'branch', 'Šaka') or entry.get('branch') or 'master'
    variables = []
    if pipeline in DEPLOY_PIPELINES or extra:
        ref = git_ref(form, 'ref', 'REF')
        if ref:
            variables.append(('REF', ref))
        for key in ('IMAGES', 'ROLLBACK', 'BACKUP'):
            variables.append((key, 'yes' if flag(form, key.lower()) else 'no'))
        # Sent only when asked for: without it the pipeline's CACHE=auto clears the cache when the deploy needs it
        # (setup 5.2.0+).
        if flag(form, 'cache'):
            variables.append(('CACHE', 'yes'))
    elif pipeline == 'backup-now' and flag(form, 'full'):
        # Sent only when asked for: a project whose backup-now predates FULL keeps working as it did.
        variables.append(('FULL', 'yes'))
    return PipelinePlan(name, *repository, pipeline, branch, variables)


ACTIONS = {'add-project': plan_add_project, 'remove-project': plan_remove_project,
           'install-runner': plan_install_runner, 'install-backups': plan_install_backups,
           'install-metrics': plan_install_metrics, 'add-backup-key': plan_add_backup_key, 'key-bulk': plan_key_bulk,
           'remove-backup-key': plan_remove_backup_key, 'list-backup-keys': plan_list_backup_keys,
           'prepare-host': plan_prepare_host, 'update': plan_update, 'update-setup': plan_update_setup,
           'pipeline': plan_pipeline, 'backup-local': plan_backup_local, 'unit': plan_unit, 'install-ssh': plan_install_ssh,
           'move-bitbucket-ssh': plan_move_bitbucket_ssh, 'tool-access': plan_tool_access,
           'tool-bulk': plan_tool_bulk, 'tool-password': plan_tool_password,
           'tool-person': plan_tool_person, 'tool-ips': plan_tool_ips, 'tool-apply': plan_tool_apply}


# --- Running commands ----------------------------------------------------------------------------
def hidden_values(stdin, action=''):
    """The secrets of a pasted runner dialog or page (--OAuthClientSecret, --token), or a typed tools password: never
    shown back."""
    if action == 'tool-password':
        return [line for line in (stdin or '').splitlines() if line]
    return [found for found in re.findall(r'(?:--OAuthClientSecret|--token)[\s=]+([^\s\\]+)', stdin or '') if len(found) >= 4]


def redact(text, hidden):
    for secret in hidden:
        text = text.replace(secret, '<hidden>')
    return text


def check(plan):
    """The --check run: (exit code, output); a secret of its stdin never appears in the output."""
    try:
        process = subprocess.Popen(plan.check, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                   text=True, errors='replace', env=child_environment(), start_new_session=True)
    except OSError as error:
        return 126, f'{plan.check[0]}: {error.strerror}'
    try:
        output, _ = process.communicate(plan.stdin or '', timeout=CHECK_TIMEOUT)
        code = process.returncode
    except subprocess.TimeoutExpired:
        stop(process)
        output, code = f'(no answer within {CHECK_TIMEOUT} s; stopped)', 124
    return code, redact(output, hidden_values(plan.stdin, plan.action))


def stop(process, grace=30):
    """SIGTERM to the command's process group (sudo relays it to the command), then SIGKILL."""
    for sent, wait in ((signal.SIGTERM, grace), (signal.SIGKILL, 10)):
        try:
            os.killpg(process.pid, sent)
        except (ProcessLookupError, PermissionError):
            pass
        try:
            process.wait(timeout=wait)
            return
        except subprocess.TimeoutExpired:
            continue


def job_main(directory):
    """--job DIR: run job.json's argv with this process's stdin, write output.log and result.json, log the end."""
    directory = Path(directory)
    meta = json.loads((directory / 'job.json').read_text())
    given = sys.stdin.buffer.read()  # e.g. a runner dialog: kept in memory, never written anywhere
    (directory / 'pid').write_text(f'{os.getpid()}\n')
    started = time.time()
    hidden = [found.encode() for found in hidden_values(given.decode('utf-8', 'replace'), meta.get('action', ''))]
    with open(directory / 'output.log', 'ab', buffering=0) as output:
        try:
            process = subprocess.Popen(meta['argv'], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                       stderr=subprocess.STDOUT, start_new_session=True, env=child_environment())
        except OSError as error:
            output.write(f'{meta["argv"][0]}: {error.strerror}\n'.encode())
            code = 126
        else:
            def feed():
                try:
                    process.stdin.write(given)
                    process.stdin.close()
                except OSError:
                    pass
            expired = threading.Event()
            timer = threading.Timer(meta['timeout'], lambda: (expired.set(), stop(process)))
            threading.Thread(target=feed, daemon=True).start()
            timer.start()
            # Line by line, so that a secret of the stdin is masked before it reaches the file.
            for line in process.stdout:
                for secret in hidden:
                    line = line.replace(secret, b'<hidden>')
                output.write(line)
            code = process.wait()
            timer.cancel()
            if expired.is_set():
                output.write(f'\n(sustabdyta po {meta["timeout"] // 60} min.)\n'.encode())
                code = 124
    (directory / 'result.json').write_text(json.dumps({'exit': code, 'finished': int(time.time()),
                                                       'seconds': int(time.time() - started)}))
    try:
        record(meta['user'], meta['client'], 'finished', f'job={directory.name} {meta["action"]} -> exit {code}')
    except OSError as error:
        log(f'ui-actions.log: {error}')
    return 0


def job_state(directory):
    """(meta, result or None, running?) of a job directory."""
    meta = json.loads((directory / 'job.json').read_text())
    try:
        return meta, json.loads((directory / 'result.json').read_text()), False
    except (OSError, ValueError):
        pass
    try:
        os.kill(int((directory / 'pid').read_text()), 0)
        return meta, None, True
    except (OSError, ValueError):
        # Started a moment ago (no pid yet) or gone without a result (killed).
        return meta, None, time.time() - meta['started'] < 30


def jobs(limit=None):
    if not JOBS.is_dir():
        return []
    found = sorted((path for path in JOBS.iterdir() if JOB_ID.fullmatch(path.name)), reverse=True)
    return found[:limit] if limit else found


def running_job():
    for directory in jobs(20):
        try:
            if job_state(directory)[2]:
                return directory.name
        except (OSError, ValueError, KeyError):
            continue
    return None


def start_job(plan, identifier, user, client):
    JOBS.mkdir(parents=True, exist_ok=True, mode=0o700)
    for old in jobs()[KEEP_JOBS:]:
        if (old / 'result.json').exists():
            shutil.rmtree(old, ignore_errors=True)
    directory = JOBS / identifier
    directory.mkdir(mode=0o700)
    (directory / 'job.json').write_text(json.dumps({'argv': plan.run, 'action': plan.action, 'title': plan.title,
                                                    'user': user, 'client': client, 'timeout': plan.timeout,
                                                    'started': int(time.time()), 'back': plan.back}))
    process = subprocess.Popen([sys.executable, PROGRAM, '--job', str(directory)], stdin=subprocess.PIPE,
                               stdout=subprocess.DEVNULL, start_new_session=True, env=child_environment())
    try:
        process.stdin.write((plan.stdin or '').encode())
        process.stdin.close()
    except OSError:
        pass
    threading.Thread(target=process.wait, daemon=True).start()  # reaped here; it outlives a restart of the UI


# --- Status --------------------------------------------------------------------------------------
class Cache:
    def __init__(self):
        self.lock = threading.Lock()
        self.values = {}

    def get(self, key, ttl, compute, fresh=False, since=None):
        """The stored value while younger than ttl, and (since given) computed after that wall-clock time."""
        with self.lock:
            stored = self.values.get(key)
            if stored and not fresh and time.monotonic() - stored[0] < ttl and (since is None or stored[2] > since):
                return stored[1]
        computed = time.time()
        result = compute()
        with self.lock:
            self.values[key] = (time.monotonic(), result, computed)
        return result

    def forget(self, key):
        with self.lock:
            self.values.pop(key, None)

    def peek(self, key):
        """What is stored, however old; None when nothing is (nothing is computed)."""
        with self.lock:
            stored = self.values.get(key)
        return stored[1] if stored else None


CACHE = Cache()


def helper(*arguments, timeout=150):
    """The read-only status helper through its sudo rule: (JSON, None) or (None, error)."""
    argv = ['sudo', '-n', str(LIBRARY / 'bin/server-status'), *arguments]
    try:
        result = subprocess.run(argv, capture_output=True, text=True, timeout=timeout, env=child_environment())
    except (OSError, subprocess.TimeoutExpired) as error:
        return None, f'server-status: {error}'
    if result.returncode:
        return None, f'server-status: exit {result.returncode}: {result.stderr.strip()[:300]}'
    try:
        return json.loads(result.stdout), None
    except ValueError:
        return None, 'server-status: no JSON'


def status(fresh=False):
    # A status read while an action ran may miss what it changed: read again once one has finished since.
    return CACHE.get('status', STATUS_TTL, helper, fresh, since=last_job_end())


def last_job_end():
    """When the newest finished action finished (its result.json), or None."""
    for directory in jobs(3):
        try:
            return (directory / 'result.json').stat().st_mtime
        except OSError:
            continue
    return None


# --- Bitbucket -----------------------------------------------------------------------------------
class NoRedirect(urllib.request.HTTPRedirectHandler):
    """A redirect is an error: the token is never sent anywhere but the configured API."""

    def redirect_request(self, request, fp, code, message, headers, url):
        return None


OPENER = urllib.request.build_opener(NoRedirect)


def bitbucket_repository(url):
    match = BITBUCKET_URL.fullmatch(url.strip())
    return (match[1], match[2]) if match else None


def token_for(project):
    """(variable, token) for a build root: BITBUCKET_ACCESS_TOKEN_<NAME>, else BITBUCKET_ACCESS_TOKEN."""
    for variable in (f'{TOKEN_VARIABLE}_{re.sub(r"[^A-Z0-9]", "_", project.upper())}', TOKEN_VARIABLE):
        token = os.environ.get(variable, '')
        if token and re.fullmatch(r'[A-Za-z0-9._~+/=-]{8,512}', token):
            return variable, token
    return None, None


def bitbucket(method, path, token, body=None, timeout=20):
    """(HTTP status, JSON or None, error text or None); the token is only in the Authorization header."""
    data = json.dumps(body).encode() if body is not None else None
    request = urllib.request.Request(bitbucket_api() + path, data=data, method=method)
    request.add_header('Authorization', f'Bearer {token}')
    request.add_header('Accept', 'application/json')
    request.add_header('User-Agent', 'setup-server-ui')
    if data is not None:
        request.add_header('Content-Type', 'application/json')
    try:
        with OPENER.open(request, timeout=timeout) as response:
            return response.status, json.loads(response.read(2 * 1024 * 1024) or b'null'), None
    except urllib.error.HTTPError as error:
        try:
            message = json.loads(error.read(65536)).get('error', {}).get('message', '')
        except (ValueError, AttributeError, OSError):
            message = ''
        text = f'HTTP {error.code}' + (f': {message}' if message else '') + \
            (' (nukreipimas nesekamas)' if 300 <= error.code < 400 else '')
        return error.code, None, text.replace(token, '<token>')[:300]
    except (urllib.error.URLError, OSError, ValueError) as error:
        return None, None, str(getattr(error, 'reason', error)).replace(token, '<token>')[:300]


def pipeline_runs(project, repository, fresh=False):
    """The 10 newest pipeline runs of a repository: (runs, error)."""
    variable, token = token_for(project)
    if not token:
        return None, f'nėra token\'o ({TOKEN_VARIABLE}_{re.sub(r"[^A-Z0-9]", "_", project.upper())} ar {TOKEN_VARIABLE})'

    def compute():
        code, data, error = bitbucket('GET', f'/repositories/{quote(repository[0])}/{quote(repository[1])}'
                                             '/pipelines/?sort=-created_on&pagelen=10', token, timeout=8)
        if error or not isinstance(data, dict):
            return None, error or f'HTTP {code}'
        return data.get('values', []), None
    return CACHE.get(('pipelines', project), PIPELINES_TTL, compute, fresh)


# --- Instructions: preparing a server as a deploy target ------------------------------------------
# What a server needs before bin/add-project --target ENV=ssh://USER@HOST/PATH and a first deploy, step by
# step for the chosen OS, panel, environment and certificate. Facts come from setup's docs and code and
# from bin/add-project; where setup documents nothing (CentOS, the DirectAdmin proxy, a certificate without a
# panel) the step says so instead of pretending.
GUIDE_OPTIONS = (
    ('os', 'OS', (('ubuntu', 'Ubuntu 22.04 / 24.04'), ('debian', 'Debian 12'),
                  ('centos', 'CentOS Stream / AlmaLinux / Rocky (netestuota)'))),
    ('panel', 'Valdymo skydelis', (('directadmin', 'DirectAdmin'), ('none', 'Be skydelio'))),
    ('env', 'Aplinka', (('prod', 'prod'), ('stage', 'stage'))),
    ('ssl', 'SSL', (('letsencrypt', "Let's Encrypt"), ('own', 'Savas sertifikatas'), ('none', 'Be SSL (tik VPN, HTTP)'))),
)
class Field:
    """A value the guide asks for. `when`: alternatives of {option: values} under which it is asked (none: always);
    `more`: an optional override, kept under "Nebūtina"; `address`: an IP address."""

    def __init__(self, key, label, pattern, hint, when=(), more=False, address=False):
        self.key, self.label, self.pattern, self.hint = key, label, pattern, hint
        self.when, self.more, self.address = when, more, address

    def applies(self, choice):
        return not self.when or any(all(choice[key] in values for key, values in case.items()) for case in self.when)


NAME_PATTERN = re.compile(r'[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?')
ACCOUNT_PATTERN = re.compile(r'[a-z_][a-z0-9_.-]{0,31}')
ADDRESS_PATTERN = re.compile(r'[0-9a-fA-F:.]{2,45}')
PUBLIC = {'panel': ('none',), 'ssl': ('letsencrypt', 'own')}
VPN = {'panel': ('none',), 'ssl': ('none',)}
DIRECTADMIN = {'panel': ('directadmin',)}
GUIDE_FIELDS = (
    Field('host', 'Serveris', NAME_PATTERN, 'adresas, kuriuo worker\'is jungsis per SSH'),
    Field('domain', 'Domenas', NAME_PATTERN, 'svetainės domenas (DOMAIN)'),
    Field('da_user', 'DirectAdmin vartotojas', ACCOUNT_PATTERN, 'domeno savininkas DirectAdmin\'e', when=(DIRECTADMIN,)),
    Field('vpn_address', 'Taikinio VPN IP', ADDRESS_PATTERN, 'taikinyje: ip -4 addr show tun0', when=(VPN,), address=True),
    Field('public_address', 'Taikinio viešas IP', ADDRESS_PATTERN, 'taikinyje: hostname -I', when=(PUBLIC,), address=True),
    Field('worker', 'Worker\'io IP', ADDRESS_PATTERN, 'ugniasienei: per VPN – worker\'io VPN adresas; internetu – '
          'curl -4 -s https://ifconfig.me worker\'yje', address=True),
    Field('user', 'SSH vartotojas', ACCOUNT_PATTERN, 'numatyta deploy', when=({'panel': ('none',)},), more=True),
    Field('path', 'Projekto katalogas', re.compile(r'/[A-Za-z0-9._/-]{1,200}'),
          'numatyta /home/VARTOTOJAS/DOMENAS', more=True),
    Field('port', 'Projekto port\'as', re.compile(r'[0-9]{2,5}'), 'numatyta 8081; stage ir prod viename serveryje – skirtingi',
          when=(DIRECTADMIN, VPN), more=True),
)


def guide_css():
    """Hide a field while the chosen options do not ask for it: CSS :has() on the selected options, so the form
    follows a choice at once without any script. A browser without :has() shows every field; the server ignores
    the ones that do not apply either way."""
    rules = []
    for field in GUIDE_FIELDS:
        keys = sorted({key for case in field.when for key in case})
        options = {key: [value for value, _ in next(item for item in GUIDE_OPTIONS if item[0] == key)[2]] for key in keys}
        combinations = [{}]
        for key in keys:
            combinations = [{**combination, key: value} for combination in combinations for value in options[key]]
        for combination in combinations:
            if not field.applies({**{key: None for key, _, _ in GUIDE_OPTIONS}, **combination}):
                selector = ''.join(f':has(select[name="{key}"] option[value="{value}"]:checked)'
                                   for key, value in combination.items())
                rules.append(f'.guide-form{selector} .field-{field.key}')
    return (','.join(rules) + '{display:none}') if rules else ''


