#!/usr/bin/env bash
# Update this setup-server checkout and the shared setup checkout ($ROOT/setup) to the given refs, check
# that the server still works and, when it does not, return both to the commits they were on before.
# The runner services (Bitbucket's and every GitHub one) are never restarted or reloaded: pipeline steps
# read the setup checkout when they run.
# Run it as the owner of this checkout (the admin who cloned it), without sudo; the setup account's part
# runs through sudo -u. The installed command copies ($SBIN/setup-server-backup and setup-server-metrics,
# when installed) are rewritten from the new checkout through sudo and returned with the checkouts.
# --check fetches and shows what would change; it changes no checkout.
set -euo pipefail

ROOT=${SETUP_SERVER_ROOT:-/srv/setup-server}
ACCOUNT=${SETUP_SERVER_USER:-setup}
RUNNER=${SETUP_SERVER_RUNNER:-setup-server-runner}
# The GitHub Actions runners: one instance per organization or repository (bin/install-runner --provider github).
GITHUB_RUNNERS='setup-server-github-runner@*.service'
CHECKOUT=${SETUP_SERVER_CHECKOUT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}
SETUP="$ROOT/setup"
SBIN=${SETUP_SERVER_SBIN:-/usr/local/sbin}
# Installed copy of a command : the installer whose --refresh rewrites it.
COPIES=(setup-server-backup:install-backups setup-server-metrics:install-metrics)
RELEASE_TAG='^v[0-9]+\.[0-9]+\.[0-9]+$'

usage() {
    cat <<EOF
Usage: $0 [--check] [--server-ref REF] [--setup-ref REF]
  --server-ref REF  move this setup-server checkout ($CHECKOUT) to REF
  --setup-ref REF   move the shared setup checkout ($SETUP) to REF
  --check           fetch and show what would change; change no checkout
REF is a tag (preferred), a branch of origin or a commit id. setup off a vX.Y.Z tag is for stage only:
prod releases need setup on a release tag. Exit: 0 updated, 1 health check failed and both checkouts
returned, 2 the return failed too (see the printed commands), 64 usage, 65 refused, 75 a pipeline runs.
Environment: SETUP_SERVER_ROOT ($ROOT), SETUP_SERVER_USER ($ACCOUNT), SETUP_SERVER_RUNNER ($RUNNER),
SETUP_SERVER_CHECKOUT (this checkout), SETUP_SERVER_SBIN ($SBIN); SETUP_SERVER_CONFIG,
SETUP_SERVER_SYSTEMD and SETUP_SERVER_SUDOERS are passed to the installers
EOF
}

say() { printf '==> %s\n' "$*"; }
fail() { echo "$1" >&2; exit "${2:-65}"; }
# The setup account owns the shared checkout; others reach it through sudo. Run from / so that git
# does not start in a directory the account cannot read (a caller's 0750 home breaks git).
as_account() { if [ "$(id -un)" = "$ACCOUNT" ]; then "$@"; else (cd / && sudo -u "$ACCOUNT" -H "$@"); fi; }
git_in() {  # git_in server|setup ARGS — git in that checkout, as its owner
    local side=$1; shift
    if [ "$side" = setup ]; then as_account git -C "$SETUP" "$@"; else git -C "$CHECKOUT" "$@"; fi
}
name_of() { if [ "$1" = setup ]; then echo "setup $SETUP"; else echo "setup-server $CHECKOUT"; fi; }
label() {  # label SIDE COMMIT — its tag, or its short id
    git_in "$1" describe --tags --exact-match "$2" 2>/dev/null || git_in "$1" rev-parse --short "$2"
}
commits() { if [ "$1" = 1 ]; then echo "1 commit"; else echo "$1 commits"; fi; }
resolve() {  # resolve SIDE REF — the commit of a tag, else of origin's branch, else a commit id
    local candidate
    for candidate in "refs/tags/$2" "refs/remotes/origin/$2"; do
        git_in "$1" rev-parse -q --verify "$candidate^{commit}" 2>/dev/null && return
    done
    [[ "$2" =~ ^[0-9a-f]{7,40}$ ]] && git_in "$1" rev-parse -q --verify "$2^{commit}" 2>/dev/null
}
as_root() { if [ "$(id -u)" = 0 ]; then "$@"; else sudo "$@"; fi; }
installed_copies() {  # the installed command copies, as NAME:INSTALLER
    local copy
    for copy in "${COPIES[@]}"; do
        [ ! -e "$SBIN/${copy%%:*}" ] || echo "$copy"
    done
}
refresh_copies() {  # rewrite the installed copies from this (new) checkout; fails when one fails
    local copy installer
    for copy in "${copies[@]}"; do
        installer="$CHECKOUT/bin/${copy#*:}"
        say "Refreshing $SBIN/${copy%%:*} (sudo bin/${copy#*:} --refresh)"
        if ! grep -q -- '--refresh' "$installer" 2>/dev/null; then
            echo "    note: this version has no bin/${copy#*:} --refresh; the installed copy is left as it is"
            continue
        fi
        as_root env SETUP_SERVER_ROOT="$ROOT" SETUP_SERVER_USER="$ACCOUNT" SETUP_SERVER_SBIN="$SBIN" \
            SETUP_SERVER_CONFIG="${SETUP_SERVER_CONFIG:-/etc/setup-server}" \
            SETUP_SERVER_SYSTEMD="${SETUP_SERVER_SYSTEMD:-/etc/systemd/system}" \
            SETUP_SERVER_SUDOERS="${SETUP_SERVER_SUDOERS:-/etc/sudoers.d}" "$installer" --refresh 2>&1 \
            | sed 's/^/    /'
        [ "${PIPESTATUS[0]}" = 0 ] || return 1
    done
}
restore_copies() {  # put the saved copies back where they changed; the failed ones go to manual
    local copy name restored=1
    for copy in "${copies[@]}"; do
        name=${copy%%:*}
        cmp -s "$saved/$name" "$SBIN/$name" && continue
        if as_root install -o root -g root -m 0755 "$saved/$name" "$SBIN/$name"; then
            [ "$name" != setup-server-metrics ] || as_root systemctl try-restart setup-server-metrics.service || true
            echo "    restored $SBIN/$name"
        else
            manual+=("sudo install -o root -g root -m 0755 $saved/$name $SBIN/$name")
            restored=0
        fi
    done
    [ "$restored" = 0 ] || say "Restored the previous installed copies"
}
fetch() {  # fetch SIDE — new commits and tags; a tag that origin moved is refused, never taken over
    local output moved
    if output=$(git_in "$1" fetch -q --tags --prune origin 2>&1); then
        [ -z "$output" ] || printf '%s\n' "$output" >&2
        return
    fi
    # Without --force git keeps a local tag that origin now points elsewhere and fails; name those tags.
    moved=$( { git_in "$1" show-ref --tags | sed 's/^/L /'; git_in "$1" ls-remote --tags origin | sed 's/^/R /'; } 2>/dev/null \
        | awk '$1 == "L" {local[$3] = $2} $1 == "R" && $3 !~ /\^\{\}$/ {remote[$3] = $2}
               END {for (tag in remote) if ((tag in local) && local[tag] != remote[tag]) {sub("^refs/tags/", "", tag); print tag}}' \
        | sort | paste -sd ' ')
    if [ -n "$moved" ]; then
        fail "$(name_of "$1"): tag ${moved// /, tag } was moved on origin (rewritten upstream); refused, no checkout changed.
A release tag must not move: find out who moved it and why. Here it stays where it was:
$(for tag in $moved; do echo "    $tag: here $(git_in "$1" rev-parse --short "$tag^{commit}"), origin $(git_in "$1" ls-remote --tags origin "refs/tags/$tag^{}" "refs/tags/$tag" | head -n1 | cut -c1-7)"; done)"
    fi
    fail "Cannot fetch $(name_of "$1") from origin:
$output"
}
runner_pid() { systemctl show -p MainPID --value "${1:-$RUNNER}" 2>/dev/null || true; }
github_runners() {  # the active GitHub runner services
    systemctl list-units --type=service --state=active --plain --no-legend "$GITHUB_RUNNERS" 2>/dev/null | awk '{print $1}' || true
}
runner_check() {  # runner_check UNIT PID — still active with the PID it had before the update?
    local unit=$1 before=$2
    if [ -z "$before" ]; then
        echo "    runner $unit: was not active before; not checked"
    elif ! systemctl is-active --quiet "$unit"; then
        echo "    runner $unit: FAILED — not active any more (it was PID $before)"
        return 1
    elif [ "$(runner_pid "$unit")" != "$before" ]; then
        echo "    runner $unit: FAILED — PID changed from $before to $(runner_pid "$unit") (restarted)"
        return 1
    else
        echo "    runner $unit: still active, same PID $before"
    fi
}

plan() {  # plan SIDE REF CURRENT TARGET — what moving that checkout changes
    local side=$1 ref=$2 current=$3 target=$4 back forward shown
    shown=$(label "$side" "$target")
    [ "$shown" = "$ref" ] || shown="$shown ($ref)"
    if [ "$current" = "$target" ]; then
        say "$(name_of "$side"): already at $shown"
        return
    fi
    read -r back forward < <(git_in "$side" rev-list --left-right --count "$current...$target")
    local direction
    if [ "$back" = 0 ]; then direction="$(commits "$forward") forward"
    elif [ "$forward" = 0 ]; then direction="$(commits "$back") back"
    else direction="$(commits "$forward") forward and $(commits "$back") back (another line of history)"
    fi
    say "$(name_of "$side"): $(label "$side" "$current") -> $shown: $direction;$(git_in "$side" diff --shortstat "$current" "$target")"
    git_in "$side" log --format='    + %h %s' -n 10 "$current..$target"
    [ "$forward" -le 10 ] || echo "    + ... and $((forward - 10)) more"
    git_in "$side" log --format='    - %h %s' -n 10 "$target..$current"
    [ "$back" -le 10 ] || echo "    - ... and $((back - 10)) more"
    if [ "$side" = setup ] && ! { [[ "$ref" =~ $RELEASE_TAG ]] && git_in setup rev-parse -q --verify "refs/tags/$ref" >/dev/null; }; then
        echo "    note: $ref is not a release tag (vX.Y.Z); prod releases need setup on a tag, so this is stage only"
    elif [ "$side" = server ] && ! git_in server rev-parse -q --verify "refs/tags/$ref" >/dev/null; then
        echo "    note: $ref is not a tag; allowed for setup-server"
    fi
}

health() {  # every check runs; the result fails when one of them fails
    local failed=0 log head
    say "Health check"
    log=$(mktemp)
    if (cd "$CHECKOUT" && env -u SETUP_SERVER_ROOT -u SETUP_SERVER_USER -u SETUP_SERVER_RUNNER \
            -u SETUP_SERVER_CHECKOUT -u SETUP_SERVER_UBUNTU_IMAGE -u SETUP_SERVER_SBIN -u SETUP_SERVER_CONFIG \
            -u SETUP_SERVER_SYSTEMD -u SETUP_SERVER_SUDOERS python3 -m unittest discover -s tests) >"$log" 2>&1; then
        echo "    setup-server tests: ok ($(grep -m1 '^Ran ' "$log"))"
    else
        echo "    setup-server tests: FAILED"
        tail -n 20 "$log" | sed 's/^/      /'
        failed=1
    fi
    rm -f "$log"
    if head=$(git_in setup rev-parse HEAD 2>&1) && [ "$head" = "$setup_expected" ] \
            && [ -z "$(git_in setup status --porcelain --untracked-files=no 2>&1)" ]; then
        echo "    setup at $(label setup "$head"), readable by $ACCOUNT: ok"
    else
        echo "    setup: FAILED — $ACCOUNT sees ${head:-nothing} with $(git_in setup status --porcelain --untracked-files=no 2>&1 | wc -l) changed files, expected $setup_expected"
        failed=1
    fi
    runner_check "$RUNNER" "$runner_before" || failed=1
    local entry
    for entry in "${github_before[@]}"; do
        runner_check "${entry%:*}" "${entry##*:}" || failed=1
    done
    return "$failed"
}

restore() {  # restore SIDE COMMIT BRANCH — back to the branch it was on, or to the bare commit
    local side=$1 commit=$2 branch=$3
    if [ -n "$branch" ]; then
        git_in "$side" checkout -q --force "$branch" || return 1
    else
        git_in "$side" checkout -q --force --detach "$commit" || return 1
    fi
    [ "$(git_in "$side" rev-parse HEAD)" = "$commit" ]
}

give_back() {  # return every moved checkout; print the manual commands for those that did not return
    local manual=()
    trap - INT TERM
    say "Returning to the previous commits"
    if [ -n "$server_target" ] && ! restore server "$server_previous" "$server_branch"; then
        manual+=("git -C $CHECKOUT checkout --force $server_previous")
    fi
    if [ -n "$setup_target" ] && ! restore setup "$setup_previous" "$setup_branch"; then
        manual+=("(cd / && sudo -u $ACCOUNT -H git -C $SETUP checkout --force $setup_previous)")
    fi
    [ ${#copies[@]} -eq 0 ] || restore_copies
    if [ ${#manual[@]} -eq 0 ]; then
        rm -rf "$saved"
        say "Returned both checkouts to the previous commits: setup-server $(label server "$server_previous"), setup $(label setup "$setup_previous"). The runners were not restarted."
        exit 1
    fi
    say "The automatic return failed. Return by hand (README: \"Rankinis atstatymas\"):"
    printf '    %s\n' "${manual[@]}"
    exit 2
}

main() {
    local check=0 server_ref= setup_ref=
    while [ $# -gt 0 ]; do
        case "$1" in
            --check) check=1 ;;
            --server-ref) server_ref=${2:?--server-ref needs a ref}; shift ;;
            --setup-ref) setup_ref=${2:?--setup-ref needs a ref}; shift ;;
            -h|--help) usage; exit 0 ;;
            *) usage >&2; exit 64 ;;
        esac
        shift
    done
    [ -n "$server_ref$setup_ref" ] || { usage >&2; exit 64; }

    # --- Preconditions ----------------------------------------------------------------------------
    git -C "$CHECKOUT" rev-parse --git-dir >/dev/null 2>&1 || fail "$CHECKOUT is not a git checkout"
    local owner; owner=$(stat -c %U "$CHECKOUT")
    [ "$(id -un)" = "$owner" ] || fail "Run this as $owner, the owner of $CHECKOUT, without sudo (the setup account's part uses sudo itself)" 77
    as_account test -d "$SETUP/.git" || fail "No setup checkout at $SETUP (run bin/prepare-host first)"
    local side changes
    for side in server setup; do
        changes=$(git_in "$side" status --porcelain --untracked-files=no)
        [ -z "$changes" ] || fail "$(name_of "$side") has local changes; commit, stash or discard them first:
$changes"
    done
    local busy; busy=$(pgrep -u "$ACCOUNT" -x make 2>/dev/null | tr '\n' ' ' || true)
    if [ -n "$busy" ]; then
        [ "$check" = 1 ] || fail "A pipeline step of $ACCOUNT is running (make, PID ${busy% }); update when it has finished" 75
        say "Note: a pipeline step of $ACCOUNT is running (make, PID ${busy% }); an update now would be refused"
    fi

    # --- What would change ------------------------------------------------------------------------
    server_previous=$(git_in server rev-parse HEAD)
    server_branch=$(git_in server symbolic-ref -q --short HEAD || true)
    setup_previous=$(git_in setup rev-parse HEAD)
    setup_branch=$(git_in setup symbolic-ref -q --short HEAD || true)
    server_target= setup_target=
    for side in server setup; do
        local ref; [ "$side" = server ] && ref=$server_ref || ref=$setup_ref
        [ -n "$ref" ] || continue
        fetch "$side"
        local target
        target=$(resolve "$side" "$ref") \
            || fail "Unknown ${side/server/setup-server} ref $ref (newest tags: $(git_in "$side" tag --sort=-v:refname | head -n 5 | paste -sd ' '))"
        local previous; [ "$side" = server ] && previous=$server_previous || previous=$setup_previous
        plan "$side" "$ref" "$previous" "$target"
        [ "$target" = "$previous" ] && continue
        if [ "$side" = server ]; then server_target=$target; else setup_target=$target; fi
    done
    setup_expected=${setup_target:-$setup_previous}
    if systemctl is-active --quiet "$RUNNER"; then
        runner_before=$(runner_pid)
        say "runner $RUNNER active (PID $runner_before); an update never restarts it"
    else
        runner_before=
        say "runner $RUNNER is not active; not checked"
    fi
    github_before=()
    local unit
    for unit in $(github_runners); do
        github_before+=("$unit:$(runner_pid "$unit")")
        say "runner $unit active (PID ${github_before[-1]##*:}); an update never restarts it"
    done
    if [ -z "$server_target$setup_target" ]; then
        say "Nothing to do."
        exit 0
    fi
    copies=()
    [ -z "$server_target" ] || mapfile -t copies < <(installed_copies)
    if [ ${#copies[@]} -gt 0 ]; then
        say "Then refresh the installed copies:$(printf " $SBIN/%s" "${copies[@]%%:*}") (sudo; back with the checkouts on a failure)"
    fi
    if [ "$check" = 1 ]; then
        say "After updating: setup-server tests, setup at the new commit and readable by $ACCOUNT, every active runner still active with the same PID; on a failure both checkouts return."
        say "Check finished; nothing was changed (only fetched)."
        exit 0
    fi

    # --- Update -----------------------------------------------------------------------------------
    say "Previous commits (for a manual return): setup-server $server_previous, setup $setup_previous"
    saved=$(mktemp -d)
    local copy
    for copy in "${copies[@]}"; do
        cp -p "$SBIN/${copy%%:*}" "$saved/" || fail "Cannot read $SBIN/${copy%%:*}"
    done
    trap 'echo "Interrupted" >&2; give_back' INT TERM
    local switched=1
    if [ -n "$server_target" ] && ! git_in server checkout -q --detach "$server_target"; then switched=0; fi
    if [ "$switched" = 1 ] && [ -n "$setup_target" ] && ! git_in setup checkout -q --detach "$setup_target"; then switched=0; fi
    if [ "$switched" = 0 ]; then
        say "Switching a checkout failed"
        give_back
    fi
    if [ ${#copies[@]} -gt 0 ] && ! refresh_copies; then
        say "Refreshing an installed copy failed"
        give_back
    fi
    if ! health; then
        give_back
    fi
    trap - INT TERM
    rm -rf "$saved"
    say "Updated: setup-server $(label server HEAD), setup $(label setup HEAD). The runners were not restarted."
}

# Bash reads a script while running it and the update replaces this file, so the whole run is one call
# that bash has parsed before anything changes.
main "$@"; exit $?
