#!/usr/bin/env bash
# Install the worker's nightly database backups: setup-server-backup.timer starts
# setup-server-backup.service every night, which runs /usr/local/sbin/setup-server-backup (a root-owned
# copy of bin/backup-projects) as root; it backs up every deployed project as the setup account. A
# sudoers rule lets that account start the same command for one project ("backup now" pipeline).
# Idempotent (a rerun keeps the installed time); --check shows the units and what tonight's run would do,
# and changes nothing. --refresh only rewrites an installed command copy: bin/update runs it.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
ROOT=${SETUP_SERVER_ROOT:-/srv/setup-server}
ACCOUNT=${SETUP_SERVER_USER:-setup}
CONFIG=${SETUP_SERVER_CONFIG:-/etc/setup-server}
SBIN=${SETUP_SERVER_SBIN:-/usr/local/sbin}
SYSTEMD=${SETUP_SERVER_SYSTEMD:-/etc/systemd/system}
SUDOERS=${SETUP_SERVER_SUDOERS:-/etc/sudoers.d}
NAME=setup-server-backup

check=0
refresh=0
at=
usage() {
    cat <<EOF
Usage: sudo $0 [--check] [--at HH:MM] | --refresh
  --at       local time of the nightly run (default: the installed one, else 03:30; a missed run starts
             after the next boot)
  --check    show the units and what tonight's run would back up and delete; change nothing
  --refresh  only rewrite $SBIN/$NAME from this checkout, when it is installed (bin/update runs it)
EOF
}
while [ $# -gt 0 ]; do
    case "$1" in
        --check) check=1 ;;
        --refresh) refresh=1 ;;
        --at) at=${2:-}; shift ;;
        -h|--help) usage; exit 0 ;;
        *) usage >&2; exit 64 ;;
    esac
    shift
done
at=${at:-$(sed -n 's/^OnCalendar=\*-\*-\* \([0-9][0-9]:[0-9][0-9]\):00$/\1/p' "$SYSTEMD/$NAME.timer" 2>/dev/null || true)}
at=${at:-03:30}
[[ "$at" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || { echo "--at needs a time such as 03:30" >&2; exit 64; }
for value in "$ROOT" "$CONFIG" "$SBIN" "$ACCOUNT"; do
    [[ "$value" =~ ^[A-Za-z0-9._/-]+$ ]] || { echo "Unexpected characters in $value" >&2; exit 65; }
done
if [ "$check" = 0 ] && [ "$(id -u)" != 0 ]; then
    echo "Run with sudo (or use --check)" >&2
    exit 77
fi

command="$SBIN/$NAME"
staging=$(mktemp -d)
trap 'rm -rf "$staging"' EXIT

# The installed copy carries this host's paths: sudo resets the environment of the pipeline's call.
sed -e "s|os.environ.get('SETUP_SERVER_ROOT', '/srv/setup-server')|os.environ.get('SETUP_SERVER_ROOT', '$ROOT')|" \
    -e "s|os.environ.get('SETUP_SERVER_USER', 'setup')|os.environ.get('SETUP_SERVER_USER', '$ACCOUNT')|" \
    -e "s|os.environ.get('SETUP_SERVER_CONFIG', '/etc/setup-server')|os.environ.get('SETUP_SERVER_CONFIG', '$CONFIG')|" \
    "$here/backup-projects" > "$staging/command"
for setting in "SETUP_SERVER_ROOT', '$ROOT'" "SETUP_SERVER_USER', '$ACCOUNT'" "SETUP_SERVER_CONFIG', '$CONFIG'"; do
    grep -qF "$setting" "$staging/command" || { echo "bin/backup-projects no longer has the default of ${setting%%\'*}" >&2; exit 70; }
done

cat > "$staging/service" <<EOF
[Unit]
Description=Database backups of the setup-server projects (stage/prod, 7 daily + 4 weekly)
Documentation=https://github.com/BigSant/DockerDevelopmentEnvironmentServer
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Root plans; the backups run as $ACCOUNT and setup takes the secrets from each stack's secret store.
ExecStart=$command
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
EOF

cat > "$staging/timer" <<EOF
[Unit]
Description=Nightly database backups of the setup-server projects

[Timer]
OnCalendar=*-*-* $at:00
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
EOF

# Only the "backup now" form: sudo -n $command "$BUILD_ROOT" [stage|prod]. sudo 1.9.10+ matches the
# arguments with a regular expression; older ones (Ubuntu 22.04: 1.9.9) only with wildcards, where `*` also
# matches spaces: the first argument is still a build root, and the command refuses anything else.
projects="$ROOT/projects"
sudo_version=$(sudo -V 2>/dev/null | sed -n '1s/^Sudo version \([0-9.]*\).*/\1/p' || true)
if [ "$(printf '%s\n%s\n' 1.9.10 "${sudo_version:-0}" | sort -V | head -n1)" = 1.9.10 ]; then
    arguments="^${projects//./\\.}/[a-z0-9][a-z0-9_-]*( (stage|prod))?\$"
else
    arguments="$projects/[a-z0-9]*"
fi
printf '# "Backup now" pipelines of the runner account back up one project (README: Kopijos).\n%s ALL=(root) NOPASSWD: %s %s\n' \
    "$ACCOUNT" "$command" "$arguments" > "$staging/sudoers"
if command -v visudo >/dev/null; then
    visudo -cqf "$staging/sudoers" || { echo "The sudoers rule does not validate" >&2; exit 70; }
fi

place() {  # place SOURCE TARGET MODE [quiet] — write only what differs
    if cmp -s "$1" "$2"; then
        echo "==> $2: unchanged"
    elif [ "$check" = 1 ]; then
        echo "==> would write $2"
        [ -n "${4:-}" ] || sed 's/^/    /' "$1"
    else
        install -D -o root -g root -m "$3" "$1" "$2"
        echo "==> wrote $2"
    fi
}
if [ "$refresh" = 1 ]; then
    [ -e "$command" ] || { echo "==> $command is not installed; nothing to refresh"; exit 0; }
    place "$staging/command" "$command" 0755 quiet
    for file in "service:$SYSTEMD/$NAME.service" "timer:$SYSTEMD/$NAME.timer" "sudoers:$SUDOERS/$NAME"; do
        cmp -s "$staging/${file%%:*}" "${file#*:}" 2>/dev/null \
            || echo "==> note: ${file#*:} differs from this version; apply it with: sudo bin/install-backups"
    done
    exit 0
fi
place "$staging/command" "$command" 0755 quiet  # a copy of bin/backup-projects
place "$staging/service" "$SYSTEMD/$NAME.service" 0644
place "$staging/timer" "$SYSTEMD/$NAME.timer" 0644
place "$staging/sudoers" "$SUDOERS/$NAME" 0440

if [ "$check" = 1 ]; then
    echo "==> would enable $NAME.timer"
    echo "==> Tonight's run:"
    "$here/backup-projects" --check || true
    exit 0
fi

systemctl daemon-reload
systemctl enable --now "$NAME.timer"
echo "==> $NAME.timer: $(systemctl is-active "$NAME.timer"); next: $(systemctl show -P NextElapseUSecRealtime "$NAME.timer")"
echo "==> Tonight's run:"
"$command" --check || echo "Needs attention: deploy the projects named above with setup 2.5.0+ (secret store; README, Kopijos)" >&2
