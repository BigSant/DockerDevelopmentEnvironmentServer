#!/usr/bin/python3
"""Backups of the projects on this worker: their databases nightly (7 daily + 4 weekly), weekly full and fresh
ones, and nightly the files BACKUP_FILE_PATHS names (7 daily + 4 weekly).

Every night setup-server-backup.timer runs this as root (installed by bin/install-backups as
/usr/local/sbin/setup-server-backup). A project's environment is backed up when its environment
repository in the build root ($ROOT/projects/<name>/app, or app/docker) has env/stage.env, env/prod.env or
the env file of an environment its env/common.env lists in STAGE_ENVIRONMENTS (setup's stage-class ones, e.g. a
temporary demo): the file its deploy pipeline writes, so "deployed from here" is the declaration. Each
backup is `make db-backup ENV=<env>` (setup: every schema of DATABASE_EXTRA_SCHEMAS in one dump), run as
the setup account and written to .generated/backups/worker-<env>-<UTC time>Z.sql.gz. No secret is kept
here: setup takes the Deployment variables from the stack's secret store (<PROJECT_NAME>-<env>-secrets,
setup 2.5.0+), the values the last deploy brought from Bitbucket. After a successful backup that
series is rotated; a failed one deletes nothing. A failing project does not stop the others: they all
run, and the command then exits 1 naming them (the unit shows failed, the journal has the details).

"Backup now" for one project (Bitbucket custom pipeline on the runner):
    sudo -n /usr/local/sbin/setup-server-backup [--full] "$BUILD_ROOT" [ENV]
Variables in the caller's environment (e.g. a deployment step's) win over the store.

Kinds (one series each, rotated on its own; anything else in .generated/backups is never touched):
  daily       worker-<env>-…Z.sql.gz      setup's registry backup: structure of every table, data of the import
                                          ones (nightly timer and "backup now"); 7 daily + 4 weekly kept
  full        full-<env>-…Z.sql.gz        every table's data (make db-backup full=1; the weekly timer, --full); 2 kept
  fresh       fresh-<env>-…Z.sql.gz       a registry backup a developer asked for (bin/backup-pull fresh); 2 kept
  fresh-full  fresh-full-<env>-…Z.sql.gz  the same, every table's data; 2 kept
  files       files-<env>-…Z.tar.gz       the code-tree files BACKUP_FILE_PATHS lists (env/common.env or env/<env>.env,
                                          e.g. modules/*/translations/), which git does not carry: setup's
                                          `make files-backup` reads them from the deploy target (--files, the files
                                          timer); 7 daily + 4 weekly kept. A developer's fresh one (--files --fresh,
                                          bin/backup-pull fresh … files) joins the same series
One database backup per project and ENV runs at a time (a lock in .generated/backups); the others wait for it, and
so does a second files backup. A fresh backup is not made again when one with the same content (registry or full)
is younger than 30 minutes. A files backup needs no secret store, only the target the deploy reaches.
A files deploy target (DEPLOY_MODE=files in target.env / target.<env>.env, bin/add-project --target files:…) has no
database here: its DB series (db-short, db-full, fresh) are skipped ("skipped: files deploy target (no database
here)"), with no secret-store check; its files backups are made as for any other environment.

Backup policy: how often the timers back up each series of a project environment, in the root-owned
$SETUP_SERVER_CONFIG/backup-policy.conf (not in a build root: a pipeline cannot switch its backups off), written by
    backup-projects --set PROJECT ENV db-short=daily|weekly|off db-full=daily|weekly|monthly|off files=daily|weekly|off
                    [--check]
db-short is the DB short backup (the registry series, worker-<env>), db-full the DB full backup (full-<env>), files the
files backup (files-<env>); SERIES=default drops back to the default, series not given keep their value. The default
is db-short=daily db-full=weekly files=daily. Only the timers' runs (no PROJECT) follow it: daily backs up every run;
weekly when the newest backup of that series is older than 6.5 days (or there is none), monthly older than 27.5 days;
off never. The nightly run makes the DB full backup of an environment with db-full=daily (its full series then keeps
7 daily + 4 weekly, not 2); the weekly run backs up db-full=weekly and db-full=monthly when due. "Backup now"
(PROJECT [ENV]) and --fresh ignore the policy.
"""

from datetime import datetime, timezone
import os
from pathlib import Path
import fcntl
import pwd
import re
import signal
import subprocess
import sys
import tempfile
import threading
import time

ROOT = Path(os.environ.get('SETUP_SERVER_ROOT', '/srv/setup-server'))
ACCOUNT = os.environ.get('SETUP_SERVER_USER', 'setup')
CONFIG = Path(os.environ.get('SETUP_SERVER_CONFIG', '/etc/setup-server'))
PROJECTS = ROOT / 'projects'
KEEP_DAILY, KEEP_WEEKLY = 7, 4
KEEP_FULL, KEEP_FRESH = 2, 2
FRESH_REUSE = 30 * 60
JOB_TIMEOUT, FULL_TIMEOUT = 4 * 3600, 8 * 3600
# kind: (file name prefix, make target and arguments, how many rotation keeps; None = daily + weekly)
KINDS = {'daily': ('worker', ['db-backup'], None), 'full': ('full', ['db-backup', 'full=1'], KEEP_FULL),
         'fresh': ('fresh', ['db-backup'], KEEP_FRESH), 'fresh-full': ('fresh-full', ['db-backup', 'full=1'], KEEP_FRESH),
         'files': ('files', ['files-backup'], None), 'fresh-files': ('files', ['files-backup'], None)}
# NAME, SERIES and environment_directory are identical in bin/worker-metrics (tests/test_metrics.py).
NAME = re.compile(r'[a-z0-9][a-z0-9_-]*')
# The database series are .sql.gz, the files series .tar.gz (the lookahead pairs them); groups: kind, ENV, time.
SERIES = re.compile(r'(?=files-.*\.tar\.gz$|(?!files-).*\.sql\.gz$)(worker|full|fresh|fresh-full|files)-'
                    r'([a-z][a-z0-9]{1,15})-(\d{8}T\d{6})Z\.(?:sql|tar)\.gz')
STAMP = '%Y%m%dT%H%M%S'
USAGE = f"""Usage: {Path(sys.argv[0]).name} [--check] [--full | --files] [--fresh] [--progress] [PROJECT [ENV]]
       {Path(sys.argv[0]).name} --set PROJECT ENV SERIES=FREQUENCY ... [--check]
  (none)      every project under {PROJECTS} with env/stage.env, env/prod.env or the env file of an environment its
              env/common.env lists in STAGE_ENVIRONMENTS (the timers), as its backup policy says (--set)
  PROJECT     one project: its name or build root, e.g. "$BUILD_ROOT" in a pipeline ("backup now"); the policy
              does not apply: a person asked for it
  ENV         stage, prod or a STAGE_ENVIRONMENTS one (e.g. demo); by default every one the project has
  --full      every table's data, the full-<env> series (the weekly timer); keeps {KEEP_FULL}
  --fresh     the fresh-<env> series a developer asked for (bin/backup-pull); with --full fresh-full-<env>.
              Not made again while a backup with the same content is younger than {FRESH_REUSE // 60} minutes
  --files     not the database: the files BACKUP_FILE_PATHS lists (setup's make files-backup), the files-<env> series
              (the files timer), of every environment that has the setting; 7 daily + 4 weekly kept. With --fresh
              (bin/backup-pull) not made again while one is younger than {FRESH_REUSE // 60} minutes
  --progress  machine-readable progress on stderr ("progress backup BYTES EXPECTED"); a terminal gets a bar
  --check     show what would be backed up (and what the policy skips) and which old backups rotation would
              delete; change nothing
  --set       how often the timers back up one project environment, in {CONFIG}/backup-policy.conf (as root):
              db-short=daily|weekly|off (DB short backup: the registry series), db-full=daily|weekly|monthly|off
              (DB full backup), files=daily|weekly|off (files backup); SERIES=default drops back to the default
              (db-short=daily db-full=weekly files=daily), series not given keep their value. With --check it shows
              the change and writes nothing
The timers follow the policy: daily backs up every run, weekly when the newest backup of the series is older than
6.5 days, monthly older than 27.5 days, off never; the nightly run makes the DB full backups of db-full=daily.
The nightly series keeps the newest backup of each of the last {KEEP_DAILY} days that have one and of
{KEEP_WEEKLY} more weeks (so does the full series of db-full=daily); pre-deploy backups and other files in
.generated/backups are not touched."""


class Refused(Exception):
    """A request this command will not run (exit 65)."""


def rotation(names, daily=KEEP_DAILY, weekly=KEEP_WEEKLY):
    """Split one series' file names into (keep, remove), newest first.

    Keeps the newest backup of each of the `daily` latest days that have one, then of each of the
    `weekly` latest ISO weeks whose newest backup is not already kept (borg/restic style: a gap in
    the backups never costs the last good ones).
    """
    stamped = sorted(((datetime.strptime(SERIES.fullmatch(name)[3], STAMP), name) for name in names), reverse=True)
    keep = []
    for count, period in ((daily, lambda time: time.date()), (weekly, lambda time: time.isocalendar()[:2])):
        current, kept = None, 0
        for time, name in stamped:
            if kept >= count:
                break
            if period(time) == current:
                continue
            current = period(time)
            if name not in keep:
                keep.append(name)
                kept += 1
    return keep, [name for _, name in stamped if name not in keep]


# ENVIRONMENTS, ENVIRONMENT and server_environments are identical in bin/backup-projects, bin/backup-pull,
# bin/server-access, bin/server-status and bin/worker-metrics (tests/test_metrics.py).
ENVIRONMENTS = ('stage', 'prod')
ENVIRONMENT = re.compile(r'[a-z][a-z0-9]{1,15}')


def server_environments(directory):
    """stage, prod and the stage-class environments env/common.env lists (setup's STAGE_ENVIRONMENTS, e.g. a
    temporary demo): every environment a deploy from here may have. None (no environment repository): stage, prod."""
    extra = []
    try:
        text = (directory / 'env/common.env').read_text(errors='replace') if directory else ''
    except OSError:
        text = ''
    for line in text.splitlines():
        match = re.fullmatch(r'\s*(?:export\s+)?STAGE_ENVIRONMENTS\s*=\s*(["\']?)([^"\'#]*)\1\s*(?:#.*)?', line)
        if match:
            extra = [name for name in re.split(r'[\s,]+', match[2])
                     if ENVIRONMENT.fullmatch(name) and name not in ('local', 'test', *ENVIRONMENTS)]
    return ENVIRONMENTS + tuple(dict.fromkeys(extra))


# BACKUP_POLICY, BACKUP_DEFAULT and backup_policy are identical in bin/backup-projects, bin/server-status and
# bin/worker-metrics (tests/test_metrics.py).
# How often each backup series of a project environment is made (bin/backup-projects --set writes it; README: DB backups).
BACKUP_POLICY = {'db-short': ('daily', 'weekly', 'off'), 'db-full': ('daily', 'weekly', 'monthly', 'off'),
                 'files': ('daily', 'weekly', 'off')}
BACKUP_DEFAULT = {'db-short': 'daily', 'db-full': 'weekly', 'files': 'daily'}


def backup_policy(config, project, environment):
    """{'db-short': …, 'db-full': …, 'files': …} of one project environment: backup-policy.conf in the config directory,
    the defaults for whatever it does not set (or when it cannot be read)."""
    policy = dict(BACKUP_DEFAULT)
    try:
        text = (config / 'backup-policy.conf').read_text(errors='replace')
    except OSError:
        return policy
    for line in text.splitlines():
        words = line.split('#', 1)[0].split()
        if words[:2] == [project, environment]:
            for item in words[2:]:
                series, _, frequency = item.partition('=')
                if frequency in BACKUP_POLICY.get(series, ()):
                    policy[series] = frequency
    return policy


def environment_directory(build_root):
    """The environment repository of a build root: app/, or app/docker/ in older layouts."""
    for directory in (build_root / 'app', build_root / 'app/docker'):
        if (directory / 'Makefile').is_file() and (directory / 'env').is_dir():
            return directory
    return None


def declared(build_root, kind='daily'):
    """(environment repository, [ENV deployed from here]); for files backups only the ENVs with files to back up."""
    directory = environment_directory(build_root)
    environments = [env for env in server_environments(directory) if directory and (directory / f'env/{env}.env').is_file()]
    if is_files(kind):
        environments = [env for env in environments if file_paths(directory, env)]
    return directory, environments


def is_files(kind):
    """The files kinds (files, fresh-files): one series, files-<env>-…Z.tar.gz."""
    return KINDS[kind][0] == 'files'


# The paths setup's PrestaShop profile always backs up (setup 4.0.0+), before a project's BACKUP_FILE_PATHS.
PRESTASHOP_FILE_PATHS = ('modules/*/translations/', 'themes/*/modules/*/translations/', 'mails/*/lang.php',
                         'themes/*/mails/*/lang.php', 'translations/*-*/')


def file_paths(directory, environment):
    """The code-tree paths a files backup takes: a PrestaShop project's translations, then BACKUP_FILE_PATHS (setup's
    setting; env/<env>.env wins over env/common.env)."""
    values = {**read_env(directory / 'env/common.env'), **read_env(directory / f'env/{environment}.env')}
    profile = PRESTASHOP_FILE_PATHS if values.get('PROFILE') == 'prestashop' else ()
    return list(dict.fromkeys([*profile, *(values.get('BACKUP_FILE_PATHS') or '').split()]))


def setup_knows_files():
    """Whether the setup checkout make uses has `make files-backup` (older setup releases do not)."""
    makefile = Path(os.environ.get('SETUP_DIRECTORY') or ROOT / 'setup') / 'docker/project.mk'
    try:
        return re.search(r'(?m)^files-backup:', makefile.read_text(errors='replace')) is not None
    except OSError:
        return False


def series(backups, environment, kind='daily'):
    """This command's backups of one ENV and kind; anything else in the directory is never touched."""
    if backups.is_symlink():
        raise Refused(f'{backups} is a symlink; not rotated')
    prefix = KINDS[kind][0]
    names = []
    for path in sorted(backups.iterdir()) if backups.is_dir() else []:
        match = SERIES.fullmatch(path.name)
        if not match or match[1] != prefix or match[2] != environment or path.is_symlink() or not path.is_file():
            continue
        try:
            datetime.strptime(match[3], STAMP)
        except ValueError:
            continue
        names.append(path.name)
    return names


def rotate(names, kind, keep_daily=False):
    """(keep, remove) of one series: daily + weekly for the nightly one (and, keep_daily, for the full series of
    an environment whose policy makes a full backup every night), the newest N for the others."""
    count = KINDS[kind][2]
    if count is None or keep_daily:
        return rotation(names)
    stamped = sorted(names, key=lambda name: SERIES.fullmatch(name)[3], reverse=True)
    return stamped[:count], stamped[count:]


def same_content(kind):
    """The kinds whose backups hold the same data: the registry ones, the full ones, or the files."""
    if is_files(kind):
        return ('files',)
    return ('full', 'fresh-full') if 'full=1' in KINDS[kind][1] else ('daily', 'fresh')


def file_name(kind, environment, moment):
    return f'{KINDS[kind][0]}-{environment}-{moment}Z.' + ('tar.gz' if is_files(kind) else 'sql.gz')


def newest_backup(backups, environment, kind):
    """(path, modified) of the newest backup with the content of `kind`, or (None, 0)."""
    found = []
    for other in same_content(kind):
        for name in series(backups, environment, other):
            path = backups / name
            found.append((path.stat().st_mtime, path))
    return (max(found)[1], max(found)[0]) if found else (None, 0)


def size_text(value):
    for unit in ('B', 'KB', 'MB', 'GB'):
        if value < 1024 or unit == 'GB':
            return f'{value:.0f} {unit}' if unit == 'B' else f'{value:.1f} {unit}'
        value /= 1024
    return ''


class Progress:
    """Watches setup's temporary backup file grow while make runs: bytes written against the size of the
    previous backup with the same content (an estimate; none for the first one). --progress writes
    machine-readable lines for bin/backup-pull, a terminal gets a bar, the journal gets nothing."""

    def __init__(self, backups, expected, machine):
        self.backups, self.expected, self.machine = backups, expected, machine
        self.terminal = not machine and sys.stderr.isatty()
        self.started = time.time()
        self.stop = threading.Event()
        self.thread = threading.Thread(target=self.watch, daemon=True)

    def __enter__(self):
        if self.machine or self.terminal:
            self.thread.start()
        return self

    def __exit__(self, *exception):
        self.stop.set()
        if self.thread.is_alive():
            self.thread.join()
        if self.terminal:
            print(file=sys.stderr, flush=True)

    def written(self):
        # setup writes into tempfile.NamedTemporaryFile(dir=<backups>) and renames it when it is complete.
        sizes = [0]
        for path in self.backups.glob('tmp*'):
            try:
                info = path.stat()
            except OSError:
                continue
            if info.st_mtime >= self.started - 5:
                sizes.append(info.st_size)
        return max(sizes)

    def watch(self):
        while not self.stop.wait(2):
            done = self.written()
            if self.machine:
                print(f'progress backup {done} {self.expected}', file=sys.stderr, flush=True)
            else:
                share = min(done / self.expected, 0.99) if self.expected else 0
                bar = ('#' * int(share * 30)).ljust(30, '.') if self.expected else '.' * 30
                total = f' of ~{size_text(self.expected)}' if self.expected else ''
                print(f'\r    [{bar}] {size_text(done)}{total}  {int(time.time() - self.started)} s ',
                      end='', file=sys.stderr, flush=True)


def locked(backups, environment, kind='daily'):
    """An exclusive lock per project and ENV: one database backup at a time, a second one waits for it. Files
    backups have a lock of their own: they do not wait for a database backup."""
    handle = open(backups / f'.lock-{"files-" if is_files(kind) else ""}{environment}', 'a')
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        say(f'    waiting for the {"files " if is_files(kind) else ""}backup of {environment} that is running')
        fcntl.flock(handle, fcntl.LOCK_EX)
    return handle


ENV_ENTRY = re.compile(r'(?:export[ \t]+)?([A-Za-z_][A-Za-z0-9_]*)[ \t]*=[ \t]*')
ENV_ESCAPES = {'n': '\n', 't': '\t', 'r': '\r'}


def env_closing(text, quote):
    """Index of the quote that closes a value (after the opening one) in text, or -1."""
    if quote == "'":
        return text.find("'")
    index = 0
    while index < len(text):
        if text[index] == '\\':
            index += 2
            continue
        if text[index] == quote:
            return index
        index += 1
    return -1


def env_entries(text):
    """(line number, NAME, value) of an env file, read as setup reads it (project_env_files.parse_dotenv):
    a quoted value may run over several lines (alpha.local's APP_ENVIRONMENT), double quotes take \n \t \r
    escapes, an unquoted value ends at ' #'. NAME is None for a line that is no entry or a quote never closed."""
    lines = (text or '').splitlines()
    index = 0
    while index < len(lines):
        number, line = index + 1, lines[index].strip()
        index += 1
        if not line or line.startswith('#'):
            continue
        match = ENV_ENTRY.match(line)
        if not match:
            yield number, None, None
            continue
        raw = line[match.end():]
        quote = raw[:1] if raw[:1] in ('"', "'") else ''
        if not quote:
            yield number, match[1], '' if raw.startswith('#') else re.split(r'\s#', raw, maxsplit=1)[0].strip()
            continue
        body = raw[1:]
        end = env_closing(body, quote)
        while end < 0 and index < len(lines):
            body += '\n' + lines[index]
            index += 1
            end = env_closing(body, quote)
        if end < 0:
            yield number, None, None
            continue
        value = body[:end]
        if quote == '"':
            value = re.sub(r'\\(.)', lambda escape: ENV_ESCAPES.get(escape[1], escape[1]), value, flags=re.S)
        yield number, match[1], value


def parse_env(text, path):
    values = {}
    for number, key, value in env_entries(text):
        if key is None:
            raise Refused(f'{path} line {number} is not NAME=value')
        values[key] = value
    return values


def read_env(path):
    """NAME=value lines of an env file the project commits (no secrets); {} when there is none."""
    try:
        return parse_env(path.read_text(), path)
    except (FileNotFoundError, PermissionError):
        return {}


def target_values(name, environment):
    """The deploy target bin/add-project registered for the project ENV: its own target.<env>.env, else the shared
    target.env (as setup reads them; never the two mixed)."""
    return read_env(PROJECTS / name / f'target.{environment}.env') or read_env(PROJECTS / name / 'target.env')


def files_target(name, environment):
    """Whether the project ENV deploys only its files (DEPLOY_MODE=files): no Docker there, so no database here."""
    try:
        return target_values(name, environment).get('DEPLOY_MODE') == 'files'
    except Refused:
        return False  # a target file that cannot be read: the backup itself reports it


FILES_SKIP = 'skipped: files deploy target (no database here)'


def with_database(candidates, kind):
    """The candidates whose DB a DB backup can reach: a files deploy target's environment is said and skipped."""
    if is_files(kind):
        return candidates
    kept = []
    for name, environment in candidates:
        if files_target(name, environment):
            say(f'==> {name} {environment}: {FILES_SKIP}')
        else:
            kept.append((name, environment))
    return kept


def secret_store(name, environment):
    """(container, state): setup's secret store of the project ENV; state running, stopped or missing."""
    directory = environment_directory(PROJECTS / name)
    values = {**read_env(directory / 'env/common.env'), **read_env(directory / f'env/{environment}.env')} if directory else {}
    # The deploy target bin/add-project registered (target.env, target.<env>.env) names the context.
    values.update(target_values(name, environment))
    container = f"{values.get('PROJECT_NAME', name)}-{environment}-secrets"
    context = values.get('DEPLOY_CONTEXT')
    command = ['docker', *(['--context', context] if context else []), 'inspect', '--type', 'container',
               '--format', '{{.State.Running}}', container]
    try:
        # As the setup account: its Docker contexts are the ones setup uses (DEPLOY_CONTEXT).
        result = subprocess.run(command, capture_output=True, text=True, timeout=30, **as_account())
    except (OSError, subprocess.TimeoutExpired, KeyError):
        return container, 'missing'
    if result.returncode:
        return container, 'missing'
    return container, 'running' if result.stdout.strip() == 'true' else 'stopped'


def as_account():
    """subprocess options that run a command as the setup account when this one runs as root."""
    if os.geteuid() != 0:
        return {}
    account = pwd.getpwnam(ACCOUNT)
    return dict(user=account.pw_uid, group=account.pw_gid, extra_groups=os.getgrouplist(ACCOUNT, account.pw_gid),
                env={'PATH': '/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin', 'HOME': account.pw_dir},
                cwd='/')


def store_refusal(name, environment, kind='daily'):
    """Why a backup cannot get its secrets, or None. A files backup needs none, nor does a files deploy target."""
    if is_files(kind) or files_target(name, environment) or (os.environ.get('DATABASE_ROOT_PASSWORD') and os.geteuid() != 0):
        return None  # the caller's environment (a deployment step) has them
    container, state = secret_store(name, environment)
    if state == 'missing':
        return (f'no secret store {container}: deploy {name} {environment} once with setup 2.5.0 or newer, '
                'which keeps the Deployment variables in the stack')
    return None


def stamp():
    value = os.environ.get('SETUP_SERVER_BACKUP_TIME') or datetime.now(timezone.utc).strftime(STAMP)
    datetime.strptime(value, STAMP)
    return value


def say(text, error=False):
    print(text, file=sys.stderr if error else sys.stdout, flush=True)


# --- One backup, run as the setup account --------------------------------------------------------
def job(name, environment, kind='daily', progress=False, keep_daily=False):
    """keep_daily: rotate the full series daily + weekly (its policy is db-full=daily). The caller decides: it reads
    backup-policy.conf as root, where this account may not."""
    if os.geteuid() == 0:
        raise Refused('--job runs as the setup account, not as root')
    if kind not in KINDS:
        raise Refused(f'Unknown backup kind {kind}')
    os.umask(0o077)
    directory = environment_directory(PROJECTS / name)
    if directory is None:
        raise Refused(f'No environment repository in {PROJECTS / name}')
    backups = directory / '.generated/backups'
    backups.mkdir(mode=0o700, parents=True, exist_ok=True)
    if is_files(kind) and not setup_knows_files():
        say(f'{name} {environment}: setup has no make files-backup; update it (bin/update-setup)', error=True)
        return 1
    requested = time.time()
    with locked(backups, environment, kind):
        previous, modified = newest_backup(backups, environment, kind)
        if kind.startswith('fresh') and previous and modified >= requested - FRESH_REUSE:
            say(f'==> {name} {environment}: {previous.name} is {int((time.time() - modified) // 60)} min old; '
                f'used instead of a new {kind} backup')
            return 0
        target = backups / file_name(kind, environment, stamp())
        say(f'==> {name} {environment}: backing up into {target}')
        expected = previous.stat().st_size if previous else 0
        with Progress(backups, expected, progress):
            # make's own lines go to stderr: with --progress stdout is not shown to anybody.
            make, *arguments = KINDS[kind][1]
            result = subprocess.run(['make', '--no-print-directory', '-C', str(directory), make,
                                     f'ENV={environment}', f'file={target}', *arguments],
                                    stdout=sys.stderr if progress else None)
        if result.returncode or not target.is_file() or target.is_symlink():
            say(f'{name} {environment}: backup failed (make exit {result.returncode}); old backups kept', error=True)
            return 1
        if progress:
            size = target.stat().st_size
            print(f'progress backup {size} {size}', file=sys.stderr, flush=True)
        keep, remove = rotate(series(backups, environment, kind), kind, keep_daily)
        for old in remove:
            (backups / old).unlink()
        say(f'    {name} {environment}: kept {len(keep)}, removed {len(remove)}' + (f': {" ".join(remove)}' if remove else ''))
    return 0


# --- Planning and running every project ----------------------------------------------------------
def plan(arguments, kind='daily'):
    """[(name, environment)] to back up; projects without stage/prod env files (for files backups: without
    BACKUP_FILE_PATHS) are reported and skipped."""
    if arguments:
        project, *rest = arguments
        if '/' in project:
            path = Path(project)
            if path.resolve().parent != PROJECTS.resolve():
                raise Refused(f'{project} is not a build root under {PROJECTS}')
            project = path.resolve().name
        if not NAME.fullmatch(project):
            raise Refused('NAME must be lowercase letters, digits, _ or -')
        build_root = PROJECTS / project
        if build_root.is_symlink() or not build_root.is_dir():
            names = ' '.join(sorted(path.name for path in PROJECTS.iterdir())) if PROJECTS.is_dir() else ''
            raise Refused(f'No build root {build_root} (projects: {names})')
        directory, environments = declared(build_root)
        if rest:
            if rest[0] not in server_environments(directory):
                raise Refused('ENV must be stage, prod or one of the project\'s STAGE_ENVIRONMENTS')
            if rest[0] not in environments:
                raise Refused(f'{project} has no env/{rest[0]}.env: it is not deployed to {rest[0]} from here')
            environments = rest[:1]
        if not environments:
            raise Refused(f'{project} has no env/<stage|prod|…>.env: nothing deployed from here yet')
        if is_files(kind):
            environments = [env for env in environments if file_paths(directory, env)]
            if not environments:
                raise Refused(f'{project} sets no BACKUP_FILE_PATHS (env/common.env or env/<env>.env) and is no PrestaShop '
                              'project: no files to back up')
        return [(project, env) for env in environments]
    jobs = []
    for build_root in sorted(PROJECTS.iterdir()) if PROJECTS.is_dir() else []:
        if build_root.is_symlink() or not build_root.is_dir() or not NAME.fullmatch(build_root.name):
            continue
        _, environments = declared(build_root, kind)
        if not environments:
            say(f'==> {build_root.name}: ' + ('no BACKUP_FILE_PATHS of a deployed environment; skipped' if is_files(kind)
                                             else 'no env/<env>.env (not deployed from here); skipped'))
        jobs += [(build_root.name, env) for env in environments]
    return jobs


# How old the newest backup of a series may be before a weekly or monthly one is due again (a timer run a little
# earlier or later than last time must not skip a whole period).
DUE_AFTER = {'weekly': 6.5 * 86400, 'monthly': 27.5 * 86400}


def age_text(seconds):
    return f'{int(seconds // 86400)} d' if seconds >= 86400 else f'{int(seconds // 3600)} h'


def due(name, environment, kind, frequency):
    """(whether a timer run backs the series up now, why not) under its policy frequency."""
    if frequency == 'off':
        return False, 'off'
    if frequency == 'daily':
        return True, ''
    try:
        names = series(environment_directory(PROJECTS / name) / '.generated/backups', environment, kind)
    except Refused:
        return True, ''  # the backup itself reports it
    if not names:
        return True, ''
    newest = datetime.strptime(max(SERIES.fullmatch(item)[3] for item in names), STAMP)
    age = (datetime.strptime(stamp(), STAMP) - newest).total_seconds()
    if age > DUE_AFTER[frequency]:
        return True, ''
    return False, f'{frequency}, newest {age_text(max(age, 0))} ago'


def scheduled(candidates, kind):
    """[(name, environment, kind)] a timer run makes, by each environment's backup policy: the nightly run its
    DB short backup (db-short, the registry one) and, for db-full=daily, its DB full one; the weekly run the DB full
    backups of db-full=weekly and, when due, db-full=monthly; the files run the files backups. What the policy skips
    is said."""
    jobs = []
    for name, environment in candidates:
        policy = backup_policy(CONFIG, name, environment)
        skipped = []
        if kind == 'daily':
            go, why = due(name, environment, 'daily', policy['db-short'])
            if go:
                jobs.append((name, environment, 'daily'))
            else:
                skipped.append(f'{"skipped" if why == "off" else "not due"}: db-short {why}')
            if policy['db-full'] == 'daily':
                jobs.append((name, environment, 'full'))
        elif kind == 'full':
            if policy['db-full'] in ('daily', 'off'):
                skipped.append(f'skipped: db-full {policy["db-full"]}' +
                               (' (the nightly run makes it)' if policy['db-full'] == 'daily' else ''))
            else:  # weekly: every run of the weekly timer; monthly: when due
                go, why = due(name, environment, 'full', 'daily' if policy['db-full'] == 'weekly' else 'monthly')
                if go:
                    jobs.append((name, environment, 'full'))
                else:
                    skipped.append(f'not due: db-full {why}')
        else:
            go, why = due(name, environment, 'files', policy['files'])
            if go:
                jobs.append((name, environment, kind))
            else:
                skipped.append(f'{"skipped" if why == "off" else "not due"}: files {why}')
        for text in skipped:
            say(f'==> {name} {environment}: {text}')
    return jobs


def keeps_daily(name, environment, kind):
    """Whether the series is rotated daily + weekly instead of the newest N: the full series of db-full=daily."""
    return kind == 'full' and backup_policy(CONFIG, name, environment)['db-full'] == 'daily'


def check(jobs):
    """--check: what tonight's run would do; nothing is written or deleted."""
    problems = 0
    for name, environment, kind in jobs:
        directory = environment_directory(PROJECTS / name)
        backups = directory / '.generated/backups'
        new = file_name(kind, environment, stamp())
        say(f'==> would back up {name} {environment} into {backups / new}')
        try:
            if is_files(kind):
                say(f'    paths: {" ".join(file_paths(directory, environment))} (from the deploy target)')
                if not setup_knows_files():
                    say('    setup has no make files-backup; update it (bin/update-setup)', error=True)
                    problems += 1
                _, remove = rotate(series(backups, environment, kind) + [new], kind)
                say(f'    would delete {len(remove)}' + (f': {" ".join(remove)}' if remove else ''))
                continue
            container, state = secret_store(name, environment)
            if state == 'missing':
                say(f'    secrets: {store_refusal(name, environment) or "no secret store " + container}', error=True)
                problems += 1
            else:
                say(f'    secrets: from {container} ({state})')
            legacy = CONFIG / 'projects' / name / f'{environment}.env'
            if os.geteuid() == 0 and legacy.exists():
                say(f'    note: {legacy} is not used any more; remove it: sudo rm {legacy}')
            _, remove = rotate(series(backups, environment, kind) + [new], kind, keeps_daily(name, environment, kind))
        except Refused as error:
            say(f'    {error}', error=True)
            problems += 1
            continue
        say(f'    would delete {len(remove)}' + (f': {" ".join(remove)}' if remove else ''))
    return 1 if problems else 0


def child_environment(name, environment, kind='daily'):
    refusal = store_refusal(name, environment, kind)
    if refusal:
        raise Refused(refusal)
    if os.geteuid() == 0:
        account = pwd.getpwnam(ACCOUNT)
        env = {'PATH': '/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin', 'LANG': 'C.UTF-8',
               'HOME': account.pw_dir, 'USER': ACCOUNT, 'LOGNAME': ACCOUNT, 'SHELL': '/bin/bash'}
        for key in ('SETUP_SERVER_BACKUP_TIME',):
            if key in os.environ:
                env[key] = os.environ[key]
    else:
        env = dict(os.environ)
        env.pop('CI', None)  # a pipeline step's call: setup may read the store for what the step lacks
    env.update(SETUP_SERVER_ROOT=str(ROOT), SETUP_SERVER_USER=ACCOUNT, SETUP_SERVER_CONFIG=str(CONFIG))
    env.setdefault('SETUP_DIRECTORY', str(ROOT / 'setup'))
    return env


def run(jobs, progress=False):
    failed = []
    for name, environment, kind in jobs:
        try:
            env = child_environment(name, environment, kind)
        except Refused as error:
            say(f'{name} {environment}: {error}', error=True)
            failed.append(f'{name}/{environment}' + (f'/{kind}' if len({job[2] for job in jobs}) > 1 else ''))
            continue
        options = {}
        if os.geteuid() == 0:
            options = {key: value for key, value in as_account().items() if key in ('user', 'group', 'extra_groups')}
        command = [sys.executable, os.path.realpath(__file__), '--job', name, environment, kind,
                   *(['--progress'] if progress else []), *(['--keep-daily'] if keeps_daily(name, environment, kind) else [])]
        process = subprocess.Popen(command, env=env, cwd=str(PROJECTS / name),
                                   start_new_session=True, stdout=sys.stderr if progress else None, **options)
        timeout = FULL_TIMEOUT if 'full=1' in KINDS[kind][1] else JOB_TIMEOUT
        try:
            code = process.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            os.killpg(process.pid, signal.SIGTERM)
            try:
                process.wait(timeout=60)
            except subprocess.TimeoutExpired:
                os.killpg(process.pid, signal.SIGKILL)
                process.wait()
            say(f'{name} {environment}: stopped after {timeout // 3600} h', error=True)
            code = 1
        if code:
            # A nightly run with db-full=daily mixes the kinds: name the full one.
            failed.append(f'{name}/{environment}' + (f'/{kind}' if len({job[2] for job in jobs}) > 1 else ''))
    say(f'==> Backups: {len(jobs) - len(failed)} ok, {len(failed)} failed' + (f': {" ".join(failed)}' if failed else ''))
    return 1 if failed else 0


# --- The backup policy (--set) ---------------------------------------------------------------------
POLICY_FILE = 'backup-policy.conf'
POLICY_HEADER = ('# bin/backup-projects --set: how often each series of a project environment is backed up '
                 '(README: DB backups).\n')


def project_environments(name):
    """The environments a project has: the stage-class ones of its env repository and those with a target file."""
    if not NAME.fullmatch(name):
        raise Refused('NAME must be lowercase letters, digits, _ or -')
    build_root = PROJECTS / name
    if build_root.is_symlink() or not build_root.is_dir():
        names = ' '.join(sorted(path.name for path in PROJECTS.iterdir())) if PROJECTS.is_dir() else ''
        raise Refused(f'No build root {build_root} (projects: {names})')
    targets = [path.name[len('target.'):-len('.env')] for path in sorted(build_root.glob('target.*.env'))]
    return tuple(dict.fromkeys([*server_environments(environment_directory(build_root)),
                                *(env for env in targets if ENVIRONMENT.fullmatch(env) and env not in ('local', 'test'))]))


def policy_line(name, environment, policy):
    """The line of backup-policy.conf for a policy, or None when it is the default (no line needed)."""
    items = [f'{series}={policy[series]}' for series in BACKUP_POLICY if policy[series] != BACKUP_DEFAULT[series]]
    return f'{name} {environment} {" ".join(items)}' if items else None


def set_policy(arguments, checking):
    """--set PROJECT ENV SERIES=FREQUENCY …: change how often the timers back up one project environment."""
    if len(arguments) < 3:
        say(USAGE, error=True)
        return 64
    name, environment, *items = arguments
    given = {}
    for item in items:
        series_name, _, frequency = item.partition('=')
        if series_name not in BACKUP_POLICY or frequency not in (*BACKUP_POLICY[series_name], 'default'):
            say(f'{item}: SERIES=FREQUENCY with ' + '; '.join(f'{key}={"|".join(choices)}|default'
                                                               for key, choices in BACKUP_POLICY.items()), error=True)
            return 64
        given[series_name] = frequency
    environments = project_environments(name)
    if environment not in environments:
        raise Refused(f'{name} has no environment {environment} (it has: {" ".join(environments)})')
    if os.geteuid() != 0 and not checking and 'SETUP_SERVER_CONFIG' not in os.environ:
        say(f'Run as root (sudo): {CONFIG / POLICY_FILE} is root-owned', error=True)
        return 77
    if checking:
        return change_policy(name, environment, given, write=False)
    CONFIG.mkdir(mode=0o711, parents=True, exist_ok=True)
    # The directory only lets others through (its secrets are 0600 files): bin/worker-metrics and bin/server-status run
    # as the setup account and read this world-readable file. Older installers made it 0700.
    if os.geteuid() == 0 and not CONFIG.is_symlink() and not CONFIG.stat().st_mode & 0o001:
        os.chmod(CONFIG, (CONFIG.stat().st_mode & 0o7777) | 0o011)
    with open(CONFIG / f'.{POLICY_FILE}.lock', 'w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)  # two changes at once (two UI jobs) would lose one
        return change_policy(name, environment, given, write=True)


def change_policy(name, environment, given, write):
    """Say what changes in backup-policy.conf and, write, write the whole file anew (atomically, 0644): this
    environment's line replaced (or dropped when the policy is the default), other lines and comments kept."""
    path = CONFIG / POLICY_FILE
    try:
        text = path.read_text()
    except FileNotFoundError:
        text = ''
    except OSError as error:
        raise Refused(f'Cannot read {path}: {error.strerror}; run as root (sudo)') from None
    before = backup_policy(CONFIG, name, environment)
    after = {key: BACKUP_DEFAULT[key] if given.get(key) == 'default' else given.get(key, before[key])
             for key in BACKUP_POLICY}
    changes = [f'{key} {before[key]} → {after[key]}' for key in BACKUP_POLICY if before[key] != after[key]]
    say(f'{name} {environment}: ' + (', '.join(changes) or 'no change'))
    if not write or not changes:
        return 0
    lines, placed = [], False
    new = policy_line(name, environment, after)
    for line in text.splitlines():
        if line.split('#', 1)[0].split()[:2] != [name, environment]:
            lines.append(line)
        elif not placed:  # the first line of the environment becomes the new one (its comment kept), others go
            placed = True
            comment = line.partition('#')[2]
            if new:
                lines.append(new + (f'  #{comment}' if comment else ''))
    if new and not placed:
        lines.append(new)
    if not text:
        lines.insert(0, POLICY_HEADER.rstrip('\n'))
    handle, temporary = tempfile.mkstemp(dir=CONFIG, prefix=f'.{POLICY_FILE}.')
    try:
        with os.fdopen(handle, 'w') as output:
            output.write('\n'.join(lines) + '\n')
        os.chmod(temporary, 0o644)
        os.replace(temporary, path)
    except BaseException:
        os.unlink(temporary)
        raise
    say(f'    written to {path}')
    return 0


def main(arguments):
    checking = full = fresh = files = progress = False
    positional = []
    if arguments[:1] == ['--job'] and len(arguments) >= 4 and len(set(arguments[4:])) == len(arguments[4:]) \
            and set(arguments[4:]) <= {'--progress', '--keep-daily'}:
        return job(*arguments[1:4], progress='--progress' in arguments[4:], keep_daily='--keep-daily' in arguments[4:])
    if '--set' in arguments:
        rest = [argument for argument in arguments if argument not in ('--set', '--check')]
        if arguments.count('--set') > 1 or any(argument.startswith('-') for argument in rest):
            say(USAGE, error=True)
            return 64
        return set_policy(rest, '--check' in arguments)
    for argument in arguments:
        if argument == '--check':
            checking = True
        elif argument == '--full':
            full = True
        elif argument == '--fresh':
            fresh = True
        elif argument == '--files':
            files = True
        elif argument == '--progress':
            progress = True
        elif argument in ('-h', '--help'):
            say(USAGE)
            return 0
        elif argument.startswith('-') or len(positional) == 2:
            say(USAGE, error=True)
            return 64
        else:
            positional.append(argument)
    if not checking and os.geteuid() == 0:
        try:
            pwd.getpwnam(ACCOUNT)
        except KeyError:
            raise Refused(f'No account {ACCOUNT}; run bin/prepare-host first') from None
    if files and full:
        say('--files backs up files, not the database: no --full with it', error=True)
        return 64
    if files:
        kind = 'fresh-files' if fresh else 'files'
    else:
        kind = ('fresh-full' if full else 'fresh') if fresh else ('full' if full else 'daily')
    if progress:
        sys.stdout = sys.stderr  # bin/backup-pull keeps stdout for its answer
    candidates = plan(positional, kind)
    if not candidates:
        say(f'==> No project under {PROJECTS} has an env/<env>.env of stage, prod or STAGE_ENVIRONMENTS' +
            (' with BACKUP_FILE_PATHS' if files else '') + '; nothing to back up')
        return 0
    candidates = with_database(candidates, kind)
    if not candidates:
        say('==> Nothing to back up: no database here (files deploy targets)')
        return 0
    # The timers follow each environment's backup policy; "backup now" (PROJECT) and --fresh: a person asked for it.
    if positional or fresh:
        jobs = [(name, environment, kind) for name, environment in candidates]
    else:
        jobs = scheduled(candidates, kind)
    if not jobs:
        say('==> Nothing to back up in this run: the backup policy skips every environment or none is due')
        return 0
    return check(jobs) if checking else run(jobs, progress)


if __name__ == '__main__':
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as error:
        say(str(error), error=True)
        sys.exit(65)
