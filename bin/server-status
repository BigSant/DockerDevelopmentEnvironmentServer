#!/usr/bin/python3
"""Read-only status of this worker as JSON: for the web UI (bin/web-ui) and by hand.

The web UI's account (setup-ui) runs the root-owned copy as root through its sudo rule (bin/install-ui):
    sudo -n /usr/local/lib/setup-server/bin/server-status [--logs [LINES]]
It changes nothing. As root it asks systemd for the setup-server units and timers (systemctl show) and the
journal, reads the versions of the checkouts and the disk. Everything under the build roots — repository
URLs, env and target files, deploy histories, backups and, through Docker, the project containers and
secret stores — it reads as the setup account (their owner, in the docker group, with its Docker contexts),
so a file a pipeline step planted there is read with that account's rights, never root's; only listed
values leave (never a whole env file). Run by another account it reports what that account can read.

Usage: server-status                 versions, units, backup timer, disk and every project
       server-status --logs [LINES]  the journal of the setup-server units and the tails of backup-pulls.log and access.log
                                     (default 50 lines each, at most 500)
       server-status --container-logs PROJECT ENV CONTAINER [LINES]
                                     the last LINES (default 200, at most 2000) of docker logs of one container
                                     of that project environment (as the setup account, with its context)
       server-status --metrics       the worker's /metrics exposition (setup-server-metrics --once, as the
                                     setup account; no server, no token)
       server-status --projects      only the projects (the part that runs as the setup account)
       server-status --activity [KEY]
                                     what the developer keys did, newest first (backup-pulls.log and access.log:
                                     logins, downloads, shells and commands; a shell with its start, end and
                                     recorded session), of one key or of all
       server-status --session KEY FILE
                                     what was typed in one recorded terminal session (access-sessions/KEY/FILE),
                                     as lines: editing keys applied, terminal escapes left out
       server-status --files PROJECT ENV ARCHIVE
                                     what one files backup (files-<env>-…Z.tar.gz, BACKUP_FILE_PATHS) holds: every
                                     entry's path, type, size and time; nothing is extracted
       server-status --file PROJECT ENV ARCHIVE PATH
                                     one regular file of that backup, base64 (at most 2 MiB of it)
"""

import ast
import base64
from datetime import datetime, timezone
import errno
import hashlib
import json
import os
from pathlib import Path
import pwd
import re
import stat
import subprocess
import sys
import tarfile
import time

ROOT = Path(os.environ.get('SETUP_SERVER_ROOT', '/srv/setup-server'))
ACCOUNT = os.environ.get('SETUP_SERVER_USER', 'setup')
LIBRARY = Path(os.environ.get('SETUP_SERVER_LIBRARY', '/usr/local/lib/setup-server'))
SBIN = Path(os.environ.get('SETUP_SERVER_SBIN', '/usr/local/sbin'))
PROJECTS = ROOT / 'projects'
CONFIG = Path(os.environ.get('SETUP_SERVER_CONFIG', '/etc/setup-server'))
PROC = Path(os.environ.get('SETUP_SERVER_PROC') or '/proc')
CGROUP = Path(os.environ.get('SETUP_SERVER_CGROUP') or '/sys/fs/cgroup')
GITHUB_RUNNERS = ROOT / 'github-runner'
# NAME, SERIES and environment_directory are identical in bin/backup-projects (tests/test_metrics.py).
NAME = re.compile(r'[a-z0-9][a-z0-9_-]*')
# The database series are .sql.gz, the files series .tar.gz (the lookahead pairs them); groups: kind, ENV, time.
SERIES = re.compile(r'(?=files-.*\.tar\.gz$|(?!files-).*\.sql\.gz$)(worker|full|fresh|fresh-full|files)-'
                    r'([a-z][a-z0-9]{1,15})-(\d{8}T\d{6})Z\.(?:sql|tar)\.gz')
SCOPE = re.compile(r'[a-z0-9][a-z0-9._-]*')
# What leaves the env and target files: the deploy target and the names, nothing secret.
TARGET_KEYS = ('DEPLOY_CONTEXT', 'DEPLOY_SSH', 'DEPLOY_PATH', 'APP_UID', 'APP_GID')
UNITS = ('setup-server-runner.service', 'setup-server-backup.service', 'setup-server-backup.timer',
         'setup-server-backup-full.service', 'setup-server-backup-full.timer',
         'setup-server-backup-files.service', 'setup-server-backup-files.timer',
         'setup-server-metrics.service', 'setup-server-ui.service')
GITHUB_UNIT = 'setup-server-github-runner@{}.service'
# The journal of these only (a glob for the GitHub runners).
JOURNAL_UNITS = ('setup-server-runner.service', 'setup-server-github-runner@*.service', 'setup-server-backup.service',
                 'setup-server-backup-full.service', 'setup-server-backup-files.service', 'setup-server-metrics.service',
                 'setup-server-ui.service')
PROPERTIES = ('Id', 'LoadState', 'ActiveState', 'SubState', 'Result', 'NRestarts', 'ActiveEnterTimestamp',
              'ExecMainExitTimestamp', 'ExecMainStatus', 'LastTriggerUSec', 'NextElapseUSecRealtime', 'UnitFileState',
              'ControlGroup')
CONTAINERS = '{{.Label "com.docker.compose.project"}}\t{{.Names}}\t{{.State}}\t{{.Status}}'
READ_LIMIT = 4 * 1024 * 1024
DEFAULT_LINES, MAXIMUM_LINES = 50, 500
CONTAINER_LINES, MAXIMUM_CONTAINER_LINES = 200, 2000
# Every backup file of an environment the project page lists: the series above and setup's pre-deploy
# backups (<PROJECT_NAME>-<env>-<time>.sql.gz, as bin/backup-pull knows them).
PREDEPLOY = re.compile(r'[a-z0-9][a-z0-9_-]*-([a-z][a-z0-9]{1,15})-\d{8}T\d{6}\d*\.sql\.gz')
LISTED_BACKUPS = 100
# A files backup: how many entries are listed and how much of one file is read (bin/backup-projects --files).
ARCHIVE_ENTRIES, ARCHIVE_FILE_LIMIT = 20000, 2 * 1024 * 1024
MEMBER = re.compile(r'[^\x00-\x1f\x7f]{1,1024}')
# A BACKUP_FILE_PATHS entry as setup accepts it (a code-tree path, `*` allowed); only such entries are shown.
FILE_PATH = re.compile(r'/?[A-Za-z0-9._*-]+(/[A-Za-z0-9._*-]+)*/?')
# The paths setup's PrestaShop profile always backs up (setup 4.0.0+), before a project's BACKUP_FILE_PATHS.
PRESTASHOP_FILE_PATHS = ('modules/*/translations/', 'themes/*/modules/*/translations/', 'mails/*/lang.php',
                         'themes/*/mails/*/lang.php', 'translations/*-*/')
PATH = '/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'


# ENVIRONMENTS, ENVIRONMENT and server_environments are identical in bin/backup-projects, bin/backup-pull,
# bin/server-access, bin/server-status and bin/worker-metrics (tests/test_metrics.py).
ENVIRONMENTS = ('stage', 'prod')
ENVIRONMENT = re.compile(r'[a-z][a-z0-9]{1,15}')


def server_environments(directory):
    """stage, prod and the stage-class environments env/common.env lists (setup's STAGE_ENVIRONMENTS, e.g. a
    temporary mdv): every environment a deploy from here may have. None (no environment repository): stage, prod."""
    extra = []
    try:
        text = (directory / 'env/common.env').read_text(errors='replace') if directory else ''
    except OSError:
        text = ''
    for line in text.splitlines():
        match = re.fullmatch(r'\s*(?:export\s+)?STAGE_ENVIRONMENTS\s*=\s*(["\']?)([^"\'#]*)\1\s*(?:#.*)?', line)
        if match:
            extra = [name for name in re.split(r'[\s,]+', match[2])
                     if ENVIRONMENT.fullmatch(name) and name not in ('local', 'test', *ENVIRONMENTS)]
    return ENVIRONMENTS + tuple(dict.fromkeys(extra))


def development_checkout(build_root):
    """An explicitly registered monorepo; never infer local access from an arbitrary symlink."""
    try:
        registration = json.loads((build_root / 'development.json').read_text())
        checkout = Path(registration['checkout'])
        if registration.get('version') != 1 or not checkout.is_absolute() or not (checkout / '.git').is_dir():
            return None
        if (build_root / 'app').resolve() != (checkout / 'app').resolve():
            return None
        return checkout
    except (OSError, ValueError, KeyError, TypeError):
        return None


def registered_environments(build_root, directory):
    return ('local',) if development_checkout(build_root) else server_environments(directory)


def environment_directory(build_root):
    """The environment repository of a build root: app/, or app/docker/ in older layouts."""
    for directory in (build_root / 'app', build_root / 'app/docker'):
        if (directory / 'Makefile').is_file() and (directory / 'env').is_dir():
            return directory
    return None


def run(command, timeout=20, **options):
    """(exit code, stdout, stderr) of a read-only command; 127 when it cannot start, 124 on a timeout."""
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=timeout, **options)
    except FileNotFoundError:
        return 127, '', f'{command[0]}: not found'
    except subprocess.TimeoutExpired:
        return 124, '', f'{command[0]}: no answer within {timeout} s'
    except OSError as error:
        return 126, '', f'{command[0]}: {error.strerror}'
    return result.returncode, result.stdout, result.stderr


def as_user(name):
    """subprocess options that run a command as that account when this one runs as root ({} otherwise)."""
    if os.geteuid() != 0:
        return {}
    account = pwd.getpwnam(name)
    return dict(user=account.pw_uid, group=account.pw_gid, extra_groups=os.getgrouplist(name, account.pw_gid),
                env={'PATH': PATH, 'HOME': account.pw_dir, 'LANG': 'C.UTF-8'}, cwd='/')


ERRORS = []  # what could not be read, for the "errors" of the output


def read_text(path):
    """A regular file's text (never through a symlink, at most READ_LIMIT); None when it is missing or cannot
    be read (then named in ERRORS: nothing of its content)."""
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except FileNotFoundError:
        return None
    except OSError as error:
        ERRORS.append(f'{path}: ' + ('a symlink; not read' if error.errno == errno.ELOOP else error.strerror))
        return None
    with os.fdopen(descriptor, 'rb') as handle:
        if not stat.S_ISREG(os.fstat(handle.fileno()).st_mode):
            ERRORS.append(f'{path}: not a regular file; not read')
            return None
        return handle.read(READ_LIMIT).decode('utf-8', 'replace')


ENV_ENTRY = re.compile(r'(?:export[ \t]+)?([A-Za-z_][A-Za-z0-9_]*)[ \t]*=[ \t]*')
ENV_ESCAPES = {'n': '\n', 't': '\t', 'r': '\r'}


def env_closing(text, quote):
    """Index of the quote that closes a value (after the opening one) in text, or -1."""
    if quote == "'":
        return text.find("'")
    index = 0
    while index < len(text):
        if text[index] == '\\':
            index += 2
            continue
        if text[index] == quote:
            return index
        index += 1
    return -1


def env_entries(text):
    """(line number, NAME, value) of an env file, read as setup reads it (project_env_files.parse_dotenv):
    a quoted value may run over several lines (asana.local's APP_ENVIRONMENT), double quotes take \n \t \r
    escapes, an unquoted value ends at ' #'. NAME is None for a line that is no entry or a quote never closed."""
    lines = (text or '').splitlines()
    index = 0
    while index < len(lines):
        number, line = index + 1, lines[index].strip()
        index += 1
        if not line or line.startswith('#'):
            continue
        match = ENV_ENTRY.match(line)
        if not match:
            yield number, None, None
            continue
        raw = line[match.end():]
        quote = raw[:1] if raw[:1] in ('"', "'") else ''
        if not quote:
            yield number, match[1], '' if raw.startswith('#') else re.split(r'\s#', raw, maxsplit=1)[0].strip()
            continue
        body = raw[1:]
        end = env_closing(body, quote)
        while end < 0 and index < len(lines):
            body += '\n' + lines[index]
            index += 1
            end = env_closing(body, quote)
        if end < 0:
            yield number, None, None
            continue
        value = body[:end]
        if quote == '"':
            value = re.sub(r'\\(.)', lambda escape: ENV_ESCAPES.get(escape[1], escape[1]), value, flags=re.S)
        yield number, match[1], value


def parse_env(text):
    """NAME=value entries (as bin/backup-projects reads them); other lines are skipped."""
    return {key: value for _, key, value in env_entries(text) if key is not None}


def origin(checkout):
    """The origin URL of a git checkout, from its .git/config (no git: it would run the checkout's config)."""
    text = read_text(checkout / '.git/config')
    if text is None:
        return None
    section = None
    for line in text.splitlines():
        line = line.strip()
        if line.startswith('['):
            section = re.sub(r'\s+', ' ', line.strip('[]').strip())
        elif section == 'remote "origin"' and re.match(r'url\s*=', line):
            return line.split('=', 1)[1].strip()[:300]
    return None


def default_branch(checkout):
    text = read_text(checkout / '.git/refs/remotes/origin/HEAD') or ''
    match = re.fullmatch(r'ref: refs/remotes/origin/([A-Za-z0-9._/-]{1,100})\s*', text)
    return match[1] if match else None


def timestamp(text):
    """Unix time of a deployments.json "at" (ISO 8601 with an offset), as bin/worker-metrics reads it."""
    moment = datetime.fromisoformat(text[:-1] + '+00:00' if text.endswith('Z') else text)
    if moment.tzinfo is None:
        moment = moment.replace(tzinfo=timezone.utc)
    return int(moment.timestamp())


def deploys(directory, environment):
    """The last deploy, the last completed one and how many there were (setup's deployments.json)."""
    text = read_text(directory / f'.generated/release/{environment}/deployments.json')
    if text is None:
        return None
    entries = json.loads(text)
    if not isinstance(entries, list) or not all(isinstance(entry, dict) for entry in entries):
        raise ValueError('not a list of deploys')
    if not entries:
        return None

    def shown(entry):
        return {'ref': str(entry.get('ref') or '')[:64], 'commit': str(entry.get('commit') or '')[:12],
                'at': timestamp(str(entry['at'])), 'rollback': bool(entry.get('rollback')),
                'failed': str(entry['failed'])[:40] if entry.get('failed') else None}
    completed = [entry for entry in entries if not entry.get('failed')]
    return {'last': shown(entries[-1]), 'last_success': shown(completed[-1]) if completed else None,
            'count': len(entries)}


def backups(directory, environment, prefix='worker'):
    """One series: worker (nightly and "backup now"), full (weekly) or fresh (developers' db-pull fresh=1):
    how many, the newest one's time and size."""
    folder = directory / '.generated/backups'
    found = []
    if folder.is_dir() and not folder.is_symlink():
        with os.scandir(folder) as entries:
            for item in entries:
                match = SERIES.fullmatch(item.name)
                if match and match[1] == prefix and match[2] == environment and item.is_file(follow_symlinks=False):
                    info = item.stat(follow_symlinks=False)
                    found.append((info.st_mtime, info.st_size, item.name))
    if not found:
        return {'count': 0, 'newest': None}
    modified, size, name = max(found)
    return {'count': len(found), 'newest': {'name': name, 'time': int(modified), 'size': size}}


def backup_files(directory, environment):
    """Every backup of one environment, newest first (at most LISTED_BACKUPS): name, kind, time and size."""
    folder = directory / '.generated/backups'
    found = []
    if folder.is_dir() and not folder.is_symlink():
        with os.scandir(folder) as entries:
            for item in entries:
                match = SERIES.fullmatch(item.name)
                if match and match[2] == environment:
                    kind = match[1]
                else:
                    predeploy = PREDEPLOY.fullmatch(item.name)
                    if not predeploy or predeploy[1] != environment:
                        continue
                    kind = 'predeploy'
                if item.is_file(follow_symlinks=False):
                    info = item.stat(follow_symlinks=False)
                    found.append({'name': item.name, 'kind': kind, 'time': int(info.st_mtime), 'size': info.st_size})
    found.sort(key=lambda item: (item['time'], item['name']), reverse=True)
    return found[:LISTED_BACKUPS]


def containers(contexts, errors):
    """{(context, compose project): [container]} of every context: the project containers (compose label)."""
    found = {}
    for context in sorted(contexts):
        command = ['docker', *([] if context == 'default' else ['--context', context]),
                   'ps', '--all', '--filter', 'label=com.docker.compose.project', '--format', CONTAINERS]
        code, output, error = run(command, timeout=30)
        if code:
            errors.append(f'docker ({context}): {error.strip()[:300] or f"exit {code}"}')
            continue
        for line in output.splitlines():
            parts = line.split('\t')
            if len(parts) != 4:
                continue
            project, name, state, status = parts
            health = re.search(r'\((healthy|unhealthy|health: starting)\)', status)
            found.setdefault((context, project), []).append({
                'name': name[:120], 'state': state[:20], 'status': status[:80],
                'health': health[1].replace('health: ', '') if health else None})
    return found


def project(build_root, errors):
    name = build_root.name
    directory = environment_directory(build_root)
    entry = {'name': name, 'layout': None, 'repository': None, 'code_repository': None, 'branch': None,
             'monorepo': False, 'project_name': name, 'targets': {}, 'target_files': [], 'environments': {}}
    if directory is None:
        errors.append(f'{name}: no environment repository (app/ with a Makefile and env/)')
        return entry
    entry['layout'] = str(directory.relative_to(build_root))
    # The environment repository's clone: app/, or the build root itself for bin/add-project --monorepo.
    monorepo = (build_root / '.git').is_dir() and not (build_root / 'app/.git').exists()
    entry['monorepo'] = monorepo  # a rerun of bin/add-project (the UI's target change) needs --monorepo then
    checkout = development_checkout(build_root) or (build_root if monorepo else build_root / 'app')
    entry['repository'] = origin(checkout)
    entry['branch'] = default_branch(checkout)
    entry['code_repository'] = origin(checkout / 'public') if (checkout / 'public/.git').exists() else None
    common = {**parse_env(read_text(directory / 'env/common.env'))}
    entry['project_name'] = common.get('PROJECT_NAME') if NAME.fullmatch(common.get('PROJECT_NAME', '')) else name
    # The deploy target bin/add-project registered: target.env for both, target.<env>.env for one.
    environments = registered_environments(build_root, directory)
    targets = {'': parse_env(read_text(build_root / 'target.env'))}
    # The environments with a target file of their own (target.<env>.env), listed in STAGE_ENVIRONMENTS or not yet:
    # what bin/add-project --remove-target can remove.
    try:
        own = sorted(path.name[len('target.'):-len('.env')] for path in build_root.glob('target.*.env')
                     if path.is_file() and not path.is_symlink())
    except OSError:
        own = []
    entry['target_files'] = [environment for environment in own
                             if ENVIRONMENT.fullmatch(environment) and environment not in ('local', 'test')]
    for environment in dict.fromkeys([*environments, *entry['target_files']]):
        targets[environment] = parse_env(read_text(build_root / f'target.{environment}.env'))
    entry['targets'] = {scope or 'all': {key: values[key] for key in TARGET_KEYS if key in values}
                        for scope, values in targets.items() if values}
    for environment in environments:
        declared = (directory / f'env/{environment}.env').is_file()
        values = {**common, **parse_env(read_text(directory / f'env/{environment}.env')), **targets[''],
                  **targets[environment]}
        state = {'declared': declared, 'compose_project': f"{entry['project_name']}-{environment}",
                 'context': values.get('DEPLOY_CONTEXT') or 'default', 'deploys': None, 'backups': None,
                 'full_backups': None, 'fresh_backups': None, 'files_backups': None, 'backup_files': [],
                 'development': development_checkout(build_root) is not None,
                 'file_paths': list(dict.fromkeys([*(PRESTASHOP_FILE_PATHS if values.get('PROFILE') == 'prestashop' else ()),
                                                   *(item for item in (values.get('BACKUP_FILE_PATHS') or '').split()
                                                     if FILE_PATH.fullmatch(item))]))[:50],
                 'containers': [], 'secrets': None}
        try:
            state['deploys'] = deploys(directory, environment)
        except (OSError, ValueError, KeyError, TypeError) as error:
            errors.append(f'{name} {environment}: deployments.json: {type(error).__name__}')
        try:
            state['backups'] = backups(directory, environment)
            state['full_backups'] = backups(directory, environment, 'full')
            state['fresh_backups'] = backups(directory, environment, 'fresh')
            state['files_backups'] = backups(directory, environment, 'files')
            state['backup_files'] = backup_files(directory, environment)
        except OSError as error:
            errors.append(f'{name} {environment}: backups: {error.strerror}')
        entry['environments'][environment] = state
    return entry


def projects():
    """Every build root under projects/ (as bin/backup-projects and bin/worker-metrics find them)."""
    errors, found = ERRORS, []
    try:
        roots = sorted(PROJECTS.iterdir()) if PROJECTS.is_dir() else []
    except OSError as error:
        return {'projects': [], 'errors': [*errors, f'{PROJECTS}: {error.strerror}']}
    for build_root in roots:
        if build_root.is_symlink() or not build_root.is_dir() or not NAME.fullmatch(build_root.name):
            continue
        try:
            found.append(project(build_root, errors))
        except OSError as error:
            errors.append(f'{build_root.name}: {error.strerror}')
    contexts = {state['context'] for entry in found for state in entry['environments'].values()
                if re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]*', state['context'])}
    running = containers(contexts, errors) if found else {}
    for entry in found:
        for environment, state in list(entry['environments'].items()):
            state['containers'] = running.get((state['context'], state['compose_project']), [])
            store = [item for item in state['containers'] if item['name'] == state['compose_project'] + '-secrets']
            state['secrets'] = (('running' if store[0]['state'] == 'running' else 'stopped') if store else 'missing')
            # An environment that is neither deployed from here nor has anything of its own is left out; one the
            # project lists in STAGE_ENVIRONMENTS stays (it is declared there, e.g. before its first deploy).
            if environment in ENVIRONMENTS and not (state['declared'] or state['deploys'] or
                                                    (state['backups'] or {}).get('count') or
                                                    (state['files_backups'] or {}).get('count') or state['containers']):
                del entry['environments'][environment]
    return {'projects': found, 'keys': developer_keys(errors), 'errors': errors}


# The developer keys bin/add-backup-key writes into the account's authorized_keys: what each may do. Public keys
# and their options only; other entries (an administrator's own key) are not listed.
KEY_ENTRY = re.compile(r'from="([^"]*)",command="\S*/setup-server-(backup-pull|access) --key ([A-Za-z0-9][A-Za-z0-9._@-]{0,63})'
                       r'((?: [^" ]+)*)",restrict(?:,pty)? (\S+) ([A-Za-z0-9+/]+={0,3})')
GRANT = re.compile(r'([a-z0-9][a-z0-9_-]*):([a-z][a-z0-9]{1,15})=(phpfpm-readonly|phpfpm|docker|full)')
PULL = re.compile(r'([a-z0-9][a-z0-9_-]*):([a-z][a-z0-9]{1,15})=(db|fresh)')
# A request line of backup-pulls.log or access.log: its time, the key and the address.
USE = re.compile(r'(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ) key=([A-Za-z0-9][A-Za-z0-9._@-]{0,63}) from=(\S+)')


def last_uses():
    """{key name: {'at': epoch, 'from': address, 'log': 'access'|'backups'}} of the newest request in the tails of
    the two logs (the last 512 KiB of each)."""
    found = {}
    for kind, name in (('backups', 'backup-pulls.log'), ('access', 'access.log')):
        try:
            with open(ROOT / name, 'rb') as handle:
                handle.seek(0, os.SEEK_END)
                handle.seek(max(0, handle.tell() - 512 * 1024))
                text = handle.read().decode('utf-8', 'replace')
        except OSError:
            continue
        for line in text.splitlines():
            match = USE.match(line)
            if not match:
                continue
            moment = int(datetime.strptime(match[1], '%Y-%m-%dT%H:%M:%SZ').replace(tzinfo=timezone.utc).timestamp())
            if moment >= found.get(match[2], {}).get('at', 0):
                found[match[2]] = {'at': moment, 'from': match[3][:45], 'log': kind}
    return found


# A line of either log: time, key, address, then the request and the answer. access.log writes the request as a
# Python string literal (it may hold " -> "), backup-pulls.log as plain words.
ACTIVITY = re.compile(r'(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ) key=([A-Za-z0-9][A-Za-z0-9._@-]{0,63}|-) from=(\S+) (.*)')
LITERAL = re.compile(r"""('(?:[^'\\]|\\.)*'|"(?:[^"\\]|\\.)*") -> (.*)""")
SESSION_FILE = re.compile(r'\d{8}T\d{6}Z-\d+\.log')
ACTIVITY_LIMIT, ACTIVITY_READ = 500, 4 * 1024 * 1024


def log_tail(name, limit=ACTIVITY_READ):
    try:
        with open(ROOT / name, 'rb') as handle:
            handle.seek(0, os.SEEK_END)
            handle.seek(max(0, handle.tell() - limit))
            return handle.read().decode('utf-8', 'replace').splitlines()
    except OSError:
        return []


def activity(key=None):
    """The requests of the developer keys, newest first: a download or listing as one event, a shell or command
    as one event from its start to its exit (with the recorded session's file)."""
    events, open_runs = [], {}
    for kind, name in (('backups', 'backup-pulls.log'), ('access', 'access.log')):
        for line in log_tail(name):
            match = ACTIVITY.fullmatch(line)
            if not match or (key and match[2] != key):
                continue
            parts = LITERAL.fullmatch(match[4]) if kind == 'access' else None
            if parts:
                try:
                    request, answer = str(ast.literal_eval(parts[1])), parts[2]
                except (ValueError, SyntaxError):
                    continue
            else:
                request, _, answer = match[4].partition(' -> ')
            moment = int(datetime.strptime(match[1], '%Y-%m-%dT%H:%M:%SZ').replace(tzinfo=timezone.utc).timestamp())
            run = (match[2], match[3], request)
            if kind == 'access' and re.fullmatch(r'exit -?\d+', answer) and run in open_runs:
                event = open_runs.pop(run)
                event.update(exit=int(answer.split()[1]), ended=moment)
                continue
            words = request.split()
            event = {'at': moment, 'key': match[2], 'from': match[3][:45], 'log': kind, 'request': request[:300],
                     'verb': words[0] if words else '', 'answer': answer[:300], 'state': 'ok'}
            if answer.startswith('refused'):
                event['state'] = 'refused'
            elif answer.startswith('failed'):
                event['state'] = 'failed'
            elif kind == 'access' and answer.startswith('started'):
                event['state'] = 'running'
                found = re.search(r' session=(\S+)$', answer)
                event['session'] = found[1] if found and SESSION_FILE.fullmatch(found[1]) else None
                level = re.match(r'started \(([a-z-]+)\)', answer)
                event['level'] = level[1] if level else None
                open_runs[run] = event
            events.append(event)
    for event in open_runs.values():  # no exit line (yet): still running, or cut off
        event['state'] = 'running'
    for event in events:
        if event['state'] == 'running' and 'exit' in event:
            event['state'] = 'ok' if event['exit'] == 0 else 'failed'
    events.sort(key=lambda item: item['at'], reverse=True)
    return {'events': events[:ACTIVITY_LIMIT]}


def typed_lines(raw):
    """What a person typed, as lines: Enter ends a line, Backspace takes back a character, Ctrl-U the line, escape
    sequences (arrows, history) are left out, other control characters shown as ^X."""
    text = re.sub(r'\x1b(?:\[[0-9;?]*[A-Za-z~]|O.|.)', '', raw.decode('utf-8', 'replace'))
    lines, current = [], []
    for character in text:
        if character in '\r\n':
            if current:
                lines.append(''.join(current))
            current = []
        elif character in '\x7f\x08':
            if current:
                current.pop()
        elif character == '\x15':
            current = []
        elif character == '\t':
            current.append('\t')
        elif ord(character) < 32:
            lines.append(''.join(current) + '^' + chr(ord(character) + 64))
            current = []
        else:
            current.append(character)
    if current:
        lines.append(''.join(current))
    return lines


def session(key, name):
    path = ROOT / 'access-sessions' / key / name
    text = None
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
        with os.fdopen(descriptor, 'rb') as handle:
            if stat.S_ISREG(os.fstat(handle.fileno()).st_mode):
                text = handle.read(READ_LIMIT)
    except OSError as error:
        return {'error': f'{name}: {error.strerror}'}
    if text is None:
        return {'error': f'{name}: not a regular file'}
    return {'key': key, 'file': name, 'lines': typed_lines(text)}


def developer_keys(errors):
    text = read_text(ROOT / '.ssh/authorized_keys')
    if text is None:
        return []
    uses, keys = last_uses(), []
    for line in text.splitlines():
        match = KEY_ENTRY.search(line)
        if not match:
            continue
        try:
            blob = base64.b64decode(match[6], validate=True)
        except ValueError:
            errors.append(f'authorized_keys: the key of {match[3]} does not decode')
            continue
        fingerprint = 'SHA256:' + base64.b64encode(hashlib.sha256(blob).digest()).decode().rstrip('=')
        tokens = match[4].split()
        values = lambda option, pattern: [found for index, token in enumerate(tokens[:-1]) if token == option
                                          for found in [pattern.fullmatch(tokens[index + 1])] if found]
        pull_all = next((tokens[index + 1] for index, token in enumerate(tokens[:-1])
                         if token == '--pull-all' and tokens[index + 1] in ('none', 'db', 'fresh')), None)
        pulls = values('--pull', PULL)
        # Written before the backup grants (bin/add-backup-key): every project, fresh with --allow-fresh.
        legacy = pull_all is None and not pulls
        if legacy:
            pull_all = 'fresh' if '--allow-fresh' in tokens else 'db'
        keys.append({'name': match[3], 'sources': match[1].split(','), 'type': match[5],
                     'fingerprint': fingerprint, 'command': match[2], 'legacy': legacy, 'pull_all': pull_all or 'none',
                     'pulls': [{'project': pull[1], 'environment': pull[2], 'level': pull[3]} for pull in pulls],
                     'grants': [{'project': grant[1], 'environment': grant[2], 'level': grant[3]}
                                for grant in values('--grant', GRANT)],
                     'last': uses.get(match[3])})
    return keys


# --- What root reads ------------------------------------------------------------------------------
def units(errors):
    """systemctl show of the setup-server units and every registered GitHub runner; read, never changed."""
    scopes = []
    try:
        scopes = sorted(item.name for item in GITHUB_RUNNERS.iterdir()
                        if SCOPE.fullmatch(item.name) and item.is_dir() and not item.is_symlink()
                        and (item / '.runner').is_file()) if GITHUB_RUNNERS.is_dir() else []
    except OSError as error:
        errors.append(f'{GITHUB_RUNNERS}: {error.strerror}')
    names = [*UNITS, *(GITHUB_UNIT.format(scope) for scope in scopes)]
    code, output, error = run(['systemctl', 'show', '--timestamp=utc', '--property=' + ','.join(PROPERTIES), *names])
    found = {}
    if code:
        errors.append(f'systemctl show: {error.strip()[:300] or f"exit {code}"}')
    for block in output.split('\n\n'):
        properties = dict(line.partition('=')[::2] for line in block.splitlines() if '=' in line)
        unit = properties.pop('Id', None)
        if unit in names:
            found[unit] = {key: value for key, value in properties.items() if value not in ('', 'n/a')}
    groups = {unit: properties.pop('ControlGroup', '') for unit, properties in found.items()}
    return found, scopes, groups


def running_job(group):
    """Whether a GitHub runner runs a job now: its Runner.Worker process is in the unit's cgroup."""
    if not group or '..' in group.split('/'):
        return False
    try:
        pids = (CGROUP / group.lstrip('/') / 'cgroup.procs').read_text().split()
    except OSError:
        return False
    for pid in pids:
        try:
            if pid.isdigit() and (PROC / pid / 'comm').read_text().strip() == 'Runner.Worker':
                return True
        except OSError:
            continue
    return False


def runner_details(scopes, groups):
    """Each registered GitHub runner: its name and organization or repository in GitHub (its .runner, never
    through a symlink), the version it runs (bin/ links to bin.<version>) and whether it runs a job now."""
    details = {}
    for scope in scopes:
        directory = GITHUB_RUNNERS / scope
        text = read_text(directory / '.runner') or ''
        try:
            registration = json.loads(text.lstrip('\ufeff')) if text else {}
        except ValueError:
            registration = {}
        registration = registration if isinstance(registration, dict) else {}
        url, name, agent = str(registration.get('gitHubUrl') or ''), str(registration.get('agentName') or ''), registration.get('agentId')
        try:
            version = re.fullmatch(r'.*/bin\.([0-9][0-9.]{0,30})', os.readlink(directory / 'bin'))
        except OSError:
            version = None
        details[scope] = {'name': name[:100] if re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]{0,99}', name) else None,
                          'url': url if re.fullmatch(r'https://github\.com/[A-Za-z0-9-]+(/[A-Za-z0-9._-]+)?', url) else None,
                          'agent_id': agent if isinstance(agent, int) and not isinstance(agent, bool) else None,
                          'version': version[1] if version else None,
                          'busy': running_job(groups.get(GITHUB_UNIT.format(scope), ''))}
    return details


def describe(checkout, owner=None):
    """git describe of a checkout, as its owner (root never runs git in a checkout another account writes)."""
    if not (checkout / '.git').exists():
        return None
    try:
        owner = owner or pwd.getpwuid(checkout.stat().st_uid).pw_name
        options = as_user(owner)
    except (KeyError, OSError):
        return None
    code, output, _ = run(['git', '-C', str(checkout), 'describe', '--tags', '--always'], timeout=15, **options)
    return output.strip()[:80] if code == 0 else None


def git_state(checkout, owner=None):
    """Where a checkout stands, from what it already fetched (nothing is fetched here): its commit, whether that is
    exactly a release tag, how many commits origin's master has beyond it and when origin was last fetched."""
    if not (checkout / '.git').exists():
        return None
    try:
        owner = owner or pwd.getpwuid(checkout.stat().st_uid).pw_name
        options = as_user(owner)
    except (KeyError, OSError):
        return None
    git = lambda *arguments: run(['git', '-C', str(checkout), *arguments], timeout=15, **options)
    code, commit, _ = git('rev-parse', '--short=12', 'HEAD')
    if code:
        return None
    tag_code, tag, _ = git('describe', '--tags', '--exact-match', 'HEAD')
    behind_code, behind, _ = git('rev-list', '--count', 'HEAD..refs/remotes/origin/master')
    time_code, committed, _ = git('log', '-1', '--format=%ct', 'HEAD')
    try:
        fetched = int((checkout / '.git/FETCH_HEAD').stat().st_mtime)
    except OSError:
        fetched = None
    tag = tag.strip()
    return {'commit': commit.strip(), 'tag': tag if tag_code == 0 and re.fullmatch(r'v\d+\.\d+\.\d+', tag) else None,
            'behind': int(behind) if behind_code == 0 and behind.strip().isdigit() else None,
            'committed': int(committed) if time_code == 0 and committed.strip().isdigit() else None, 'fetched': fetched}


def versions():
    installed = parse_env(read_text(LIBRARY / 'install.env'))
    checkout = installed.get('CHECKOUT')
    known = bool(checkout and checkout.startswith('/'))
    return {'installed': installed.get('VERSION'), 'checkout_path': checkout,
            'checkout': describe(Path(checkout)) if known else None,
            'checkout_git': git_state(Path(checkout)) if known else None,
            'setup': describe(ROOT / 'setup', ACCOUNT), 'setup_git': git_state(ROOT / 'setup', ACCOUNT)}


def disk():
    try:
        stats = os.statvfs(ROOT)
    except OSError:
        return None
    return {'path': str(ROOT), 'size': stats.f_blocks * stats.f_frsize, 'available': stats.f_bavail * stats.f_frsize}


def as_account(arguments, failed, timeout=120):
    """This command with these arguments as the setup account (root re-runs itself): its JSON, or
    failed(error text) when it gives none."""
    try:
        options = as_user(ACCOUNT)
    except KeyError:
        return failed(f'no account {ACCOUNT}')
    options['env'].update(SETUP_SERVER_ROOT=str(ROOT), SETUP_SERVER_USER=ACCOUNT, SETUP_SERVER_SBIN=str(SBIN))
    code, output, error = run([sys.executable, os.path.realpath(__file__), *arguments], timeout=timeout, **options)
    try:
        return json.loads(output) if code == 0 else failed(error.strip()[:300] or f'exit {code}')
    except ValueError:
        return failed('no JSON')


def projects_as_account():
    """The projects part, as the setup account when this runs as root."""
    if os.geteuid() != 0:
        return projects()
    return as_account(['--projects'], lambda error: {'projects': [], 'errors': [f'projects: {error}']})


def container_logs(name, environment, container, lines):
    """docker logs of one container of a project environment; only a container the project's compose
    project has (the same list the overview shows), in the environment's Docker context."""
    build_root = PROJECTS / name
    if build_root.is_symlink() or not build_root.is_dir():
        return {'error': f'no build root {name}'}
    errors = []
    state = project(build_root, errors)['environments'].get(environment)
    found = containers({state['context']}, errors).get((state['context'], state['compose_project']), []) \
        if state and re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]*', state['context']) else []
    if state is None or not (state['declared'] or found):
        return {'error': f'{name} has no {environment} environment here'}
    if container not in [item['name'] for item in found]:
        return {'error': f'{container} is not a container of {state["compose_project"]}' +
                         (f' ({"; ".join(errors)})' if errors else '')}
    command = ['docker', *([] if state['context'] == 'default' else ['--context', state['context']]),
               'logs', '--timestamps', '--tail', str(lines), container]
    try:
        result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=30)
    except (OSError, subprocess.TimeoutExpired) as error:
        return {'error': f'docker logs: {error}'}
    text = result.stdout[-READ_LIMIT:].decode('utf-8', 'replace')
    return {'container': container, 'context': state['context'], 'exit': result.returncode,
            'lines': text.splitlines()[-lines:]}


def files_archive(name, environment, archive):
    """The path of one files backup of a project environment, or an {'error': …}."""
    build_root = PROJECTS / name
    directory = environment_directory(build_root) if build_root.is_dir() and not build_root.is_symlink() else None
    if directory is None:
        return {'error': f'no build root {name}'}
    match = SERIES.fullmatch(archive)
    if not match or match[1] != 'files' or match[2] != environment:
        return {'error': f'{archive} is not a files backup of {environment}'}
    folder = directory / '.generated/backups'
    path = folder / archive
    if folder.is_symlink() or path.is_symlink() or not path.is_file():
        return {'error': f'{name} has no {archive}'}
    return path


def files_listing(name, environment, archive):
    """Every entry of one files backup (at most ARCHIVE_ENTRIES): path, type, size, time; nothing is extracted."""
    path = files_archive(name, environment, archive)
    if isinstance(path, dict):
        return path
    entries, truncated = [], False
    try:
        with tarfile.open(path, 'r:gz') as archive_file:
            for member in archive_file:
                if len(entries) >= ARCHIVE_ENTRIES:
                    truncated = True
                    break
                kind = 'dir' if member.isdir() else 'file' if member.isfile() else 'link' if member.issym() else 'other'
                entries.append({'path': member.name.strip('/')[:1024], 'type': kind, 'size': member.size if kind == 'file' else 0,
                                'time': int(member.mtime), 'link': member.linkname[:1024] if kind == 'link' else None})
    except (OSError, tarfile.TarError, EOFError) as error:
        return {'error': f'{archive}: {error}'}
    info = path.stat()
    return {'archive': archive, 'size': info.st_size, 'time': int(info.st_mtime), 'entries': entries, 'truncated': truncated}


def files_member(name, environment, archive, member):
    """One regular file of a files backup: its first ARCHIVE_FILE_LIMIT bytes, base64."""
    path = files_archive(name, environment, archive)
    if isinstance(path, dict):
        return path
    try:
        with tarfile.open(path, 'r:gz') as archive_file:
            for item in archive_file:
                if item.name.strip('/') != member:
                    continue
                if not item.isfile():
                    return {'error': f'{member} is not a regular file in {archive}'}
                with archive_file.extractfile(item) as handle:
                    content = handle.read(ARCHIVE_FILE_LIMIT)
                return {'archive': archive, 'path': member, 'size': item.size, 'time': int(item.mtime),
                        'truncated': item.size > len(content), 'content': base64.b64encode(content).decode()}
    except (OSError, tarfile.TarError, EOFError) as error:
        return {'error': f'{archive}: {error}'}
    return {'error': f'{archive} has no {member}'}


def metrics():
    """The exposition of the installed setup-server-metrics (--once: no server, no token)."""
    command = SBIN / 'setup-server-metrics'
    if not command.is_file():
        return {'error': f'{command} is not installed (bin/install-metrics)'}
    code, output, error = run([str(command), '--once'], timeout=60)
    if code:
        return {'error': f'setup-server-metrics --once: exit {code}: {error.strip()[:300]}'}
    return {'text': output[:READ_LIMIT]}


def deploy_key():
    """The setup account's public key, the one a deploy target authorizes (bin/add-project); nothing else of .ssh."""
    line = (read_text(ROOT / '.ssh/id_ed25519.pub') or '').strip()
    return line if re.fullmatch(r'ssh-ed25519 [A-Za-z0-9+/]+={0,3}(?: \S{1,100})?', line) else None


def tool_access():
    """bin/tool-access's state without the password hashes: who may open which project environment's tools, and the
    person behind each key (full name, the login the tools ask for)."""
    text = read_text(CONFIG / 'tool-access.json')
    try:
        state = json.loads(text) if text else {}
    except ValueError:
        ERRORS.append(f'{CONFIG}/tool-access.json: not JSON')
        state = {}
    users = state.get('users') if isinstance(state.get('users'), dict) else {}
    return {'allowed_ips': [str(item) for item in state.get('allowed_ips') or []],
            'managed': [str(item) for item in state.get('managed') or []],
            'applied': state.get('applied') if isinstance(state.get('applied'), dict) else {},
            'users': {str(name): {'password': bool(user.get('hash')), 'password_set': user.get('password_set'),
                                  'projects': [str(item) for item in user.get('projects') or []],
                                  'full_name': str(user.get('full_name') or '') or None,
                                  'login': str(user.get('login') or name)}
                      for name, user in users.items() if isinstance(user, dict)}}


def overview():
    errors = []
    found, scopes, groups = units(errors)
    part = projects_as_account()
    shown = versions()
    return {'generated': int(time.time()), 'root': str(ROOT), 'versions': shown, 'units': found, 'github_runners': scopes,
            'github_runner_details': runner_details(scopes, groups),
            'disk': disk(), 'deploy_key': deploy_key(), 'projects': part['projects'], 'keys': part.get('keys', []),
            'tool_access': tool_access(),
            'errors': list(dict.fromkeys(errors + part['errors'] + ERRORS))}


def logs(lines):
    """The journal of the setup-server units and the tails of backup-pulls.log and access.log, at most `lines` each."""
    journal = {}
    for unit in JOURNAL_UNITS:
        code, output, error = run(['journalctl', '--no-pager', '--quiet', '--output=short-iso', f'--lines={lines}',
                                   f'--unit={unit}'], timeout=30)
        journal[unit] = output.splitlines()[-lines:] if code == 0 else [f'(journalctl: {error.strip()[:200]})']
    tails = {}
    for key, name in (('backup_pulls', 'backup-pulls.log'), ('access', 'access.log')):
        tails[key] = []
        try:
            options = as_user(ACCOUNT)  # the account's file: read with its rights
            code, output, _ = run(['tail', '-n', str(lines), str(ROOT / name)], **options)
            tails[key] = output.splitlines() if code == 0 else []
        except KeyError:
            pass
    return {'journal': journal, **tails}


def main(arguments):
    if arguments == ['--projects']:
        if os.geteuid() == 0:
            result = projects_as_account()
        else:
            result = projects()
    elif arguments[:1] == ['--container-logs'] and len(arguments) in (4, 5):
        name, environment, container = arguments[1:4]
        count = arguments[4] if len(arguments) == 5 else str(CONTAINER_LINES)
        if not NAME.fullmatch(name) or not (ENVIRONMENT.fullmatch(environment) or environment == 'local') or \
                not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]{0,127}', container) or \
                not count.isdigit() or not 1 <= int(count) <= MAXIMUM_CONTAINER_LINES:
            print(f'Expected PROJECT ENV CONTAINER [LINES 1 to {MAXIMUM_CONTAINER_LINES}]', file=sys.stderr)
            return 64
        if os.geteuid() == 0:
            result = as_account([*arguments[:4], count], lambda error: {'error': f'container logs: {error}'})
        else:
            result = container_logs(name, environment, container, int(count))
    elif arguments[:1] == ['--activity'] and len(arguments) <= 2:
        if len(arguments) == 2 and not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._@-]{0,63}', arguments[1]):
            print('Expected a key name', file=sys.stderr)
            return 64
        result = as_account(arguments, lambda error: {'error': f'activity: {error}'}) if os.geteuid() == 0 \
            else activity(arguments[1] if len(arguments) == 2 else None)
    elif arguments[:1] == ['--session'] and len(arguments) == 3:
        if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._@-]{0,63}', arguments[1]) or not SESSION_FILE.fullmatch(arguments[2]):
            print('Expected KEY FILE (access-sessions/KEY/<time>-<pid>.log)', file=sys.stderr)
            return 64
        result = as_account(arguments, lambda error: {'error': f'session: {error}'}) if os.geteuid() == 0 \
            else session(arguments[1], arguments[2])
    elif arguments[:1] in (['--files'], ['--file']) and len(arguments) == (4 if arguments[0] == '--files' else 5):
        name, environment, archive = arguments[1:4]
        if not NAME.fullmatch(name) or not ENVIRONMENT.fullmatch(environment) or not SERIES.fullmatch(archive) or \
                (len(arguments) == 5 and not MEMBER.fullmatch(arguments[4])):
            print('Expected PROJECT ENV files-<env>-<time>Z.tar.gz' + (' PATH' if len(arguments) == 5 else ''), file=sys.stderr)
            return 64
        if os.geteuid() == 0:
            result = as_account(arguments, lambda error: {'error': f'files backup: {error}'})
        elif len(arguments) == 4:
            result = files_listing(name, environment, archive)
        else:
            result = files_member(name, environment, archive, arguments[4])
    elif arguments == ['--metrics']:
        result = as_account(arguments, lambda error: {'error': f'metrics: {error}'}) if os.geteuid() == 0 else metrics()
    elif arguments[:1] == ['--logs'] and len(arguments) <= 2:
        count = arguments[1] if len(arguments) == 2 else str(DEFAULT_LINES)
        if not count.isdigit() or not 1 <= int(count) <= MAXIMUM_LINES:
            print(f'LINES must be 1 to {MAXIMUM_LINES}', file=sys.stderr)
            return 64
        result = logs(int(count))
    elif not arguments:
        result = overview()
    else:
        print(__doc__.split('\n\n')[-1], file=sys.stderr)
        return 64
    json.dump(result, sys.stdout, indent=1, sort_keys=True)
    sys.stdout.write('\n')
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
